extends Node2D

@onready var sprite: AnimatedSprite2D = $Sprite
@onready var sound: AudioStreamPlayer2D = $AudioStreamPlayer2D
@onready var timer: Timer = $CleanupTimer

@onready var ring: Sprite2D = $ShockwaveRing

@onready var p1: CPUParticles2D = $CPUParticles2D
@onready var p2: CPUParticles2D = $CPUParticles2D2
@onready var p3: CPUParticles2D = $CPUParticles2D3
@onready var p4: CPUParticles2D = $CPUParticles2D4

var flicker_on := true
var finished := false

# ---------------- READY ----------------
func _ready():

	self.scale = Vector2.ZERO

	if sprite:
		sprite.play("charge")

	if sound:
		sound.play()

	start_flicker()
	start_main_animation()
	start_shockwave()
	start_particle_burst()

	# 🔥 HARD STOP TIMER (THIS IS WHAT YOU WERE MISSING)
	await get_tree().create_timer(2.8).timeout
	stop_fatality()


# ---------------- FORCE STOP EVERYTHING ----------------
func stop_fatality():

	if finished:
		return

	finished = true

	# stop sprite
	if sprite:
		sprite.stop()
		sprite.modulate = Color.WHITE

	# stop sound
	if sound:
		sound.stop()

	# stop ring
	if ring:
		ring.modulate.a = 0.0

	# stop particles instantly
	for p in [p1, p2, p3, p4]:
		if p:
			p.emitting = false

	# shrink out cleanly
	var t = create_tween()
	t.tween_property(self, "scale", Vector2.ZERO, 0.4)\
		.set_trans(Tween.TRANS_QUAD)\
		.set_ease(Tween.EASE_IN)

	await t.finished

	queue_free()


# ---------------- FLICKER ----------------
func start_flicker():

	var flicker = create_tween()
	flicker.set_loops(8)

	flicker.tween_callback(func():
		if finished:
			return

		flicker_on = !flicker_on
		sprite.modulate = Color(1, 1, 1) if flicker_on else Color(0.4, 0.8, 1.5)
	).set_delay(0.05)


# ---------------- MAIN ANIMATION ----------------
func start_main_animation():

	var t = create_tween()

	t.tween_property(self, "scale", Vector2.ONE, 0.15)\
		.set_trans(Tween.TRANS_BACK)\
		.set_ease(Tween.EASE_OUT)

	t.tween_property(self, "scale", Vector2(6, 6), 0.12)\
		.set_trans(Tween.TRANS_EXPO)\
		.set_ease(Tween.EASE_OUT)

	t.tween_property(self, "scale", Vector2.ONE, 0.18)\
		.set_trans(Tween.TRANS_SINE)\
		.set_ease(Tween.EASE_IN_OUT)

	t.tween_property(self, "scale", Vector2.ZERO, 0.2)\
		.set_trans(Tween.TRANS_QUAD)\
		.set_ease(Tween.EASE_IN)

	t.finished.connect(start_cleanup)


# ---------------- SHOCKWAVE ----------------
func start_shockwave():

	if ring == null:
		return

	ring.scale = Vector2.ZERO
	ring.modulate.a = 1.0

	var t = create_tween()

	t.tween_property(ring, "scale", Vector2(10, 10), 0.35)\
		.set_trans(Tween.TRANS_EXPO)\
		.set_ease(Tween.EASE_OUT)

	t.parallel().tween_property(ring, "modulate:a", 0.0, 0.35)


# ---------------- PARTICLES ----------------
func start_particle_burst():

	var parts = [p1, p2, p3, p4]

	for i in range(parts.size()):

		var p = parts[i]
		if p == null:
			continue

		p.emitting = false
		p.scale = Vector2.ZERO
		p.modulate.a = 0.0

		var delay = i * 0.06

		var t_in = create_tween()
		t_in.tween_interval(delay)

		t_in.tween_callback(func():
			if finished:
				return
			p.emitting = true
		)

		t_in.tween_property(p, "scale", Vector2.ONE, 0.15)

		t_in.tween_property(p, "modulate:a", 1.0, 0.1)

		var t_out = create_tween()
		t_out.tween_interval(0.25 + delay)

		t_out.tween_property(p, "scale", Vector2.ZERO, 0.2)

		t_out.tween_property(p, "modulate:a", 0.0, 0.2)

		t_out.tween_callback(func():
			p.emitting = false
		)


# ---------------- CLEANUP ----------------
func start_cleanup():

	if finished:
		return

	finished = true
	timer.start()

func _on_cleanup_timer_timeout():
	queue_free()
