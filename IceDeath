extends Area2D
class_name IceDeath

@onready var sprite: AnimatedSprite2D = $Sprite
@onready var sound: AudioStreamPlayer2D = $IceCrackSound
@onready var cleanup: Timer = $CleanupTimer

var owner_character = null

var finished := false
var damage_done := false
var flicker_on := true


# ---------------- READY ----------------
func _ready():

	add_to_group("IceDeath")
	add_to_group("HurtBox")

	cleanup.start()

	scale = Vector2.ZERO

	if sound:
		sound.play()

	sprite.play("ice")

	start_flicker()
	start_ice_animation()

	await sprite.animation_finished

	stop_effect()


# ---------------- ICE TWEEN ----------------
func start_ice_animation():

	var t = create_tween()

	# grow in
	t.tween_property(self, "scale", Vector2.ONE, 0.15)

	# huge ice burst
	t.tween_property(self, "scale", Vector2(5,5), 0.15)

	# shrink back
	t.tween_property(self, "scale", Vector2(1.5,1.5), 0.15)

	# disappear
	t.tween_property(self, "scale", Vector2.ZERO, 0.25)



# ---------------- FLICKER ----------------
func start_flicker():

	var flicker = create_tween()
	flicker.set_loops(8)

	flicker.tween_callback(func():

		if finished:
			return

		flicker_on = !flicker_on

		if flicker_on:
			sprite.modulate = Color.WHITE
		else:
			sprite.modulate = Color(0.4,0.8,1.5)

	)

	flicker.tween_interval(0.05)



# ---------------- DAMAGE ----------------
func _on_area_entered(area: Area2D):

	if damage_done:
		return

	if area.is_in_group("Fighter"):

		if area.has_method("take_damage"):

			damage_done = true

			area.take_damage(1)



# ---------------- CLEANUP ----------------
func stop_effect():

	if finished:
		return

	finished = true

	sprite.stop()
	sprite.modulate = Color.WHITE

	if sound:
		sound.stop()

	var t = create_tween()
	t.tween_property(self, "scale", Vector2.ZERO, 0.3)

	await t.finished

	queue_free()



# ---------------- TIMER ----------------
func _on_cleanup_timer_timeout():

	if not finished:
		stop_effect()
