extends Area2D
class_name ReptileAttack

@export var damage := 1
@export var lifetime := 0.05

func _ready():
	area_entered.connect(_on_area_entered)

	await get_tree().create_timer(lifetime).timeout
	queue_free()


func _on_area_entered(area: Area2D) -> void:
	if area == null:
		return

	# ONLY hit Reptile HitBox
	if area.is_in_group("HitBox"):
		var reptile = area.get_parent()

		if reptile and reptile.is_in_group("Subzero") and reptile.has_method("take_damage"):
			reptile.take_damage(damage)
