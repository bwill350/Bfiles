extends Area2D
class_name ReptileAttack

@onready var collision: CollisionShape2D = $CollisionShape2D

@export var active_time := 0.2
@export var lifetime := 0.6

var active := false
var has_hit := false
var damage := 1
var attack_owner: Node = null
var attack_name := ""
var attack_type := ""

var cam: Camera2D = null


func _ready():

	add_to_group("ReptileAttack")

	await get_tree().process_frame

	cam = get_viewport().get_camera_2d()

	area_entered.connect(_on_area_entered)

	enable_hitbox()

	await get_tree().create_timer(active_time).timeout

	if !is_inside_tree():
		return

	disable_hitbox()

	await get_tree().create_timer(lifetime).timeout

	if !is_inside_tree():
		return

	queue_free()


func enable_hitbox():

	active = true
	monitoring = true
	collision.disabled = false


func disable_hitbox():

	active = false
	monitoring = false
	collision.disabled = true


func _on_area_entered(area):

	if not active:
		return

	if has_hit:
		return

	if area == null:
		return

	var target = area.get_parent()

	if attack_owner != null and target == attack_owner:
		return

	if target == null:
		return

	if not target.is_in_group("Fighter"):
		return

	if not target.has_method("take_damage"):
		return

	has_hit = true

	# Mortal Kombat camera shake
	if cam and cam.has_method("shake"):
		cam.shake(18, 0.20)

	# =========================
	# UPPERCUT LAUNCH
	# =========================
	if attack_name == "uppercut":

		if "velocity" in target:

			var dir = 1

			if attack_owner != null:
				dir = attack_owner.facing

			target.velocity.x = dir * 400
			target.velocity.y = -600

			if "uppercut_launched" in target:
				target.uppercut_launched = true


	target.take_damage(damage)
	return

	# =========================
	# CAMERA SHAKE
	# =========================
	var cam := get_viewport().get_camera_2d()

	if cam:
		match attack_name:

			"uppercut":
				cam.shake(16, 0.18)

			"roundhousekick":
				cam.shake(12, 0.15)

			"kick", "highkick", "lowkick":
				cam.shake(8, 0.10)

			"punch", "highpunch", "lowpunch":
				cam.shake(6, 0.08)

			_:
				cam.shake(10, 0.12)

	target.take_damage(damage)
