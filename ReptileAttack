extends Area2D
class_name ReptileAttack

@export var damage := 1

@onready var collision_shape: CollisionShape2D = $CollisionShape2D

func _ready():
	add_to_group("ReptileAttack")
	collision_shape.disabled = true

	area_entered.connect(_on_area_entered)


func enable_hitbox():
	collision_shape.disabled = false


func disable_hitbox():
	collision_shape.disabled = true


func _on_area_entered(area: Area2D) -> void:
	if area == null:
		return

	# ONLY HIT CHARACTER HURTBOX
	if not area.is_in_group("HitBox"):
		return

	var target = area.get_parent()
	if target == null:
		return

	# SAFETY: ignore self / same fighter
	if target.is_in_group("Reptile"):
		return
	if target.is_in_group("Subzero"):
		return

	# extra safety: prevent double-trigger spam during attack frames
	if target.has_method("take_damage"):
		target.take_damage(damage)
