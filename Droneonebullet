extends Area2D
class_name Droneonebullet

@export var speed: float = 400.0
@export var damage: int = 1
@export var tick_damage_interval: float = 1.0

var direction: Vector2 = Vector2.DOWN
var overlapping_hitbox: Area2D = null


func _ready():
	add_to_group("enemies")

	# damage tick timer
	var timer = Timer.new()
	timer.name = "DamageTick"
	timer.wait_time = tick_damage_interval
	timer.autostart = true
	timer.one_shot = false
	timer.timeout.connect(_on_tick_damage)
	add_child(timer)

	# auto destroy after 2 seconds
	await get_tree().create_timer(2.0).timeout
	if is_instance_valid(self):
		queue_free()


func _process(delta):
	position += direction.normalized() * speed * delta


func _on_area_entered(area):
	if area.name == "HitBox":
		overlapping_hitbox = area
		if area.get_parent().has_method("take_damage"):
			area.get_parent().take_damage(damage)


func _on_area_exited(area):
	if area == overlapping_hitbox:
		overlapping_hitbox = null


func _on_tick_damage():
	if overlapping_hitbox and is_instance_valid(overlapping_hitbox):
		var player = overlapping_hitbox.get_parent()
		if player.has_method("take_damage"):
			player.take_damage(damage)
