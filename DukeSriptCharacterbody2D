extends CharacterBody2D
class_name Duke

@export var SPEED = 900.0
@export var JUMP_VELOCITY = -1800.0
@export var CLIMB_SPEED = 250.0
@export var stick_sensitivity := 800.0
@export var stick_deadzone := 0.15
@export var enable_mouse_aim := true

const GRAVITY = 5000

var health: int = 100
var current_state
var last_facing_dir = -1
var is_climbing = true
var aim_vector := Vector2.ZERO
var _mouse_pos := Vector2.ZERO

@onready var anim: AnimatedSprite2D = $Sprite
@onready var marker: Marker2D = $Marker2D
@onready var marker2: Marker2D = $Marker2D
@onready var hitbox: Area2D = $HitBox
@onready var hit_sound = $HitSound

signal Die
signal health_changed(health)

func _ready():
	add_to_group("player")
	hitbox.area_entered.connect(_on_HitBox_area_entered)
	Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
	_mouse_pos = get_viewport().get_mouse_position()

func _process(delta):
	if enable_mouse_aim:
		var stick_input = Vector2(
			Input.get_joy_axis(0, JOY_AXIS_RIGHT_X),
			Input.get_joy_axis(0, JOY_AXIS_RIGHT_Y)
		)

		if stick_input.length() < stick_deadzone:
			stick_input = Vector2.ZERO
		else:
			stick_input = stick_input.normalized()

		_mouse_pos += stick_input * stick_sensitivity * delta
		_mouse_pos.x = clamp(_mouse_pos.x, 0, get_viewport().get_visible_rect().size.x)
		_mouse_pos.y = clamp(_mouse_pos.y, 0, get_viewport().get_visible_rect().size.y)

	
	marker.look_at(get_global_mouse_position())

func _physics_process(delta):
	var on_wall = is_on_wall()
	var climb_pressed = Input.is_action_pressed("climb")
	
	if climb_pressed and not is_on_floor() and on_wall:
		is_climbing = true
	else:
		if not climb_pressed:
			is_climbing = false
			
	if is_climbing:
		if Input.is_action_pressed("shoot"):
			shoot()
		if Input.is_action_pressed("shootright"):
			shootright()
		if Input.is_action_pressed("shootleft"):
			shootleft()
		velocity.y = -CLIMB_SPEED
		if Input.is_action_pressed("right"):
			velocity.x = SPEED
			last_facing_dir = 1
			anim.play("climb")
			anim.flip_h = false
		elif Input.is_action_pressed("left"):
			velocity.x = -SPEED
			last_facing_dir = -1
			anim.play("climb")
			anim.flip_h = true
		else:
			velocity.x = 0
			anim.play("climb")
			anim.flip_h = last_facing_dir == -1
	else:
		velocity.x = 0
		velocity.y += GRAVITY * delta
		if Input.is_action_pressed("right"):
			velocity.x = SPEED
			last_facing_dir = 1
			shootright()
			anim.play("move_right")
			anim.flip_h = false
		elif Input.is_action_pressed("left"):
			velocity.x = -SPEED
			last_facing_dir = -1
			shootleft()
			if is_on_floor():
				anim.play("idle")
			anim.flip_h = false
			velocity.x = 0
			if Input.is_action_pressed("left"):
				velocity.x = -488
			anim.flip_h = last_facing_dir == 1
			anim.play("move_left")
			move_and_slide()
		else:
			anim.play("Idle")
			velocity.x = 0
			velocity.y += GRAVITY * delta
			anim.flip_h = last_facing_dir == -1
			if Input.is_action_just_pressed("jump") and not is_on_floor():
				anim.play("jump")
				$Sprite.play("jump")

		if Input.is_action_pressed("shootup") and is_on_floor():
			$Sprite.play("shootup")
			shootup()

		if Input.is_action_just_pressed("shootright") and is_on_floor():
			$Sprite.play("shootright")
			shootright()

		if Input.is_action_just_pressed("shootleft") and is_on_floor():
			$Sprite.play("shootleft")
			shootleft()

		if Input.is_action_just_pressed("shootaroundright") and is_on_floor():
			$Sprite.play("shootaroundright")
			shootaroundright()
			
		if Input.is_action_just_pressed("shootaroundleft") and is_on_floor():
			$Sprite.play("shootaroundleft")
			shootaroundleft()

		if Input.is_action_just_pressed("jump") and is_on_floor():
			$Sprite.play("jump")
			anim.play("jump")
			velocity.y = JUMP_VELOCITY
		
	if is_climbing and Input.is_action_just_pressed("jump"):
		velocity.y = 1000
		velocity.x = 1000
		is_climbing = false
		anim.play("jump")
		$Sprite.play("jump")

	if Input.is_action_pressed("shoot"):
		$Sprite.play("Idle")
		shoot()
		
	if Input.is_action_just_pressed("shootright"):
		shootright()
		
	if Input.is_action_just_pressed("shootleft"):
		shootleft()
		$Sprite.flip_h = false
	
	if Input.is_action_just_pressed("shootaroundright"):
		shootaroundright()
		
	if Input.is_action_just_pressed("shootaroundleft"):
		shootaroundleft()
		$Sprite.flip_h = false
		
	if Input.is_action_pressed("jump") and not is_on_floor():
		$Sprite.play("jump")
		anim.play("jump")
		
	if not is_on_floor and not is_climbing:
		$Sprite.play("jump")

	move_and_slide()

# ------------------------
# Shooting
# ------------------------
func shoot():
	var bullet_scene = preload("res://Scenes/Bullet.tscn")
	var bullet = bullet_scene.instantiate()
	bullet.global_position = marker.global_position
	var direction = (marker2.global_position.direction_to(get_global_mouse_position())).normalized()
	bullet.velocity = direction * bullet.speed
	bullet.look_at(bullet.global_position + bullet.velocity)
	get_tree().current_scene.add_child(bullet)

func shootup():
	if Input.is_action_just_pressed("shootup"):
		var bullet_scene = preload("res://Scenes/Bullet.tscn")
		var bullet = bullet_scene.instantiate()
		bullet.global_position = marker.global_position
		var direction = Vector2(0, -1)
		bullet.velocity = direction * bullet.speed
		get_tree().current_scene.add_child(bullet)

func shootright():
	if Input.is_action_pressed("shootright"):
		var bullet_scene = preload("res://Scenes/Bullet.tscn")
		var bullet = bullet_scene.instantiate()
		bullet.global_position = marker.global_position
		var direction = Vector2(1, 0)
		bullet.velocity = direction * bullet.speed
		get_tree().current_scene.add_child(bullet)

func shootleft():
	if Input.is_action_pressed("shootleft"):
		var bullet_scene = preload("res://Scenes/Bullet.tscn")
		var bullet = bullet_scene.instantiate()
		bullet.global_position = marker.global_position
		var direction = Vector2(-1, 0)
		bullet.velocity = direction * bullet.speed
		get_tree().current_scene.add_child(bullet)

func shootaroundright():
	if Input.is_action_just_pressed("shootaroundright"):
		$Sprite.play("shootaroundright")
		var bullet_scene = preload("res://Scenes/Bullet.tscn")
		var bullet = bullet_scene.instantiate()
		bullet.global_position = marker.global_position
		var direction = Vector2(4, -6)
		bullet.velocity = direction * bullet.speed
		get_tree().current_scene.add_child(bullet)

func shootaroundleft():
	if Input.is_action_just_pressed("shootaroundleft"):
		$Sprite.play("shootaroundleft")
		var bullet_scene = preload("res://Scenes/Bullet.tscn")
		var bullet = bullet_scene.instantiate()
		bullet.global_position = marker.global_position
		var direction = Vector2(-4, -6)
		bullet.velocity = direction * bullet.speed
		get_tree().current_scene.add_child(bullet)
	
# ------------------------
# Damage
# ------------------------
func _on_HitBox_area_entered(_area: Area2D) -> void:
	take_damage(1)

	# NEW: Drone2 collision damage
	if is_in_group("Drone2"):
		take_damage(1)

func take_damage(amount: int):
	health -= amount
	emit_signal("health_changed", health)
	if hit_sound:
		hit_sound.play()
	flash_red()
	if health <= 0:
		get_tree().change_scene_to_file("res://Scenes/GameOver.tscn")

func flash_red():
	$Sprite.modulate = Color(1, 0.2, 0.2)
	await get_tree().create_timer(0.1).timeout
	$Sprite.modulate = Color(1, 1, 1)

func die():
	print("died")
