extends CharacterBody2D
class_name Duke

@export var SPEED = 900.0
@export var JUMP_VELOCITY = -1800.0
@export var CLIMB_SPEED = 250.0
const GRAVITY = 5000

var health: int = 5
var current_state
var last_facing_dir = -1
var is_climbing = true

@onready var anim: AnimatedSprite2D = $Sprite
@onready var marker: Marker2D = $Marker2D
@onready var hitbox: Area2D = $HitBox
@onready var hit_sound = $HitSound
@onready var mark: Marker2D = $Marker2D2

signal Die
signal health_changed(health)

func _ready():
	add_to_group("player")
	hitbox.area_entered.connect(_on_hitbox_area_entered)

func shoot():
	var bullet_scene = preload("res://scenes/Bullet.tscn")
	var bullet = bullet_scene.instantiate()
	bullet.global_position = marker.global_position
	var mouse_pos = get_global_mouse_position()
	var direction = (mouse_pos - bullet.global_position).normalized()
	bullet.velocity = direction * bullet.speed
	bullet.look_at(bullet.global_position + bullet.velocity)
	get_tree().current_scene.add_child(bullet)

func shoot2():
	if Input.is_action_just_pressed("shoot2"):
		var bullet_scene = preload("res://scenes/Bullet.tscn")
		var bullet = bullet_scene.instantiate()
		bullet.global_position = marker.global_position

		var direction = Vector2(4, -6)
		bullet.velocity = direction * bullet.speed

		get_tree().current_scene.add_child(bullet)

func shootup():
	if Input.is_action_just_pressed("shootup"):
		var bullet_scene = preload("res://scenes/Bullet.tscn")
		var bullet = bullet_scene.instantiate()
		bullet.global_position = marker.global_position

		var direction = Vector2(0, -1)
		bullet.velocity = direction * bullet.speed

		get_tree().current_scene.add_child(bullet)

func shootleft():
	if Input.is_action_just_pressed("shootleft"):
		var bullet_scene = preload("res://scenes/Bullet.tscn")
		var bullet = bullet_scene.instantiate()
		bullet.global_position = marker.global_position

		var direction = Vector2(-1, 0)
		bullet.velocity = direction * bullet.speed

		get_tree().current_scene.add_child(bullet)

func shootaround():
	if Input.is_action_just_pressed("shootaround"):
		var bullet_scene = preload("res://scenes/Bullet.tscn")
		var bullet = bullet_scene.instantiate()
		bullet.global_position = marker.global_position

		var direction = Vector2(4, -6)
		bullet.velocity = direction * bullet.speed

		get_tree().current_scene.add_child(bullet)

func shootright():
	if Input.is_action_pressed("shootright"):
		var bullet_scene = preload("res://scenes/Bullet.tscn")
		var bullet = bullet_scene.instantiate()
		bullet.global_position = marker.global_position

		var direction = Vector2(1, 0)
		bullet.velocity = direction * bullet.speed

		get_tree().current_scene.add_child(bullet)

func _process(_delta: float) -> void:
	marker.look_at(get_global_mouse_position())

func _physics_process(delta: float) -> void:
	var on_wall = is_on_wall()
	var climb_pressed = Input.is_action_pressed("climb")
	
	if climb_pressed and not is_on_floor() and on_wall:
		is_climbing = true
	else:
		if not climb_pressed:
			is_climbing = false
			
	if is_climbing:
		velocity.y = -CLIMB_SPEED
		if Input.is_action_pressed("right"):
			velocity.x = SPEED
			last_facing_dir = 1
			anim.play("climb")
			anim.flip_h = false
		elif Input.is_action_pressed("left"):
			velocity.x = -SPEED
			last_facing_dir = -1
			anim.play("climb")
			anim.flip_h = true
		else:
			velocity.x = 0
			anim.play("climb")
			anim.flip_h = last_facing_dir == -1
	else:
		velocity.y += GRAVITY * delta
		if Input.is_action_pressed("right"):
			velocity.x = SPEED
			last_facing_dir = 1
			if is_on_floor():
				anim.play("move_right")
			anim.flip_h = false
		elif Input.is_action_pressed("left"):
			velocity.x = -SPEED
			last_facing_dir = -1
			if is_on_floor():
				anim.play("move_left")
			anim.flip_h = false
			if Input.is_action_just_pressed("shootup"):
				$Sprite.play("shootup")
				shootup()
			if Input.is_action_pressed("shootleft"):
				$Sprite.play("shootleft")
				
				velocity.x = 0
				shootleft()
			if Input.is_action_pressed("shootright"):
				$Sprite.play("Idle")
				shootright()
		else:
			velocity.x = 0
			if is_on_floor():
				if Input.is_action_just_pressed("left"):
					anim.play("shootleft")
				anim.flip_h = last_facing_dir == 1
				
			if Input.is_action_just_pressed("shootleft"):
				anim.play("shootleft")
				anim.flip_h = last_facing_dir == 1
			else:
				$Sprite.play("Idle")
				anim.flip_h = last_facing_dir == -1
				if Input.is_action_pressed("shootright"):
					$Sprite.play("Idle")
					
					$Sprite.flip_h = false
				if Input.is_action_pressed("shoot"):
					$Sprite.play("Idle")
					anim.flip_h = last_facing_dir == 1
					$Sprite.flip_h = false
				if Input.is_action_pressed("jump"):
					$Sprite.play("jump")
				if not is_on_floor():
					if Input.is_action_just_pressed("jump"):
						$Sprite.play("jump")
			 
	if Input.is_action_pressed("shootup") and is_on_floor():
		$Sprite.play("shootup")
		shootup()
			
	if Input.is_action_just_pressed("shootright") and is_on_floor():
		$Sprite.play("shootright")
		shootright()
			
	if Input.is_action_just_pressed("jump") and is_on_floor():
		shootup()
		velocity.y = JUMP_VELOCITY
		anim.play("jump")
		if Input.is_action_pressed("shootup"):
			$Sprite.play("shootup")
		
	if is_climbing and Input.is_action_just_pressed("jump"):
		velocity.y = 1000
		velocity.x = 1000
		is_climbing = false
		anim.play("jump")
		$Sprite.play("jump")
		
	if Input.is_action_just_pressed("shoot2"):
		shoot2()
	if Input.is_action_pressed("shoot"):
		$Sprite.play("Idle")
		shoot()
	if Input.is_action_just_pressed("shootright"):
		$Sprite.play("shootright")
		shootright()
		anim.flip_h = last_facing_dir == 1
	if Input.is_action_just_pressed("shootleft"):
		$Sprite.play("shootleft")
		shootleft()
	if Input.is_action_just_pressed("shootaround"):
		$Sprite.play("shootaround")
		shootaround()
	
	move_and_slide()

# ----------------------------------
# Damage Handling
# ----------------------------------

func _on_hitbox_area_entered(area: Area2D) -> void:
	if area.name == "Bat" or area.name == "DeadlyFlower" or area.name == "Bossone" or area.name == "DeadlyFlowerBullet" or area.name == "Bossonebullet" or area.name == "Bosstwo" or area.name == "Bosstwobullet"  or area.name == "Bossthree" or area.name == "Bossthreebullet" or area.name == "Bossthreebullet" or area.name == "Bossfour" or area.name == "Bossfourbullet" or area.is_in_group("enemies"):
		take_damage(1)

func take_damage(amount: int):
	health -= amount
	emit_signal("health_changed", health)
	print("Duke took damage! Health now: ", health)
	if hit_sound:
		hit_sound.play()
	flash_red()
	if health <= 0:
		emit_signal("Die")
		die()

func flash_red():
	$Sprite.modulate = Color(1, 0.2, 0.2)
	await get_tree().create_timer(0.1).timeout
	$Sprite.modulate = Color(1, 1, 1)

func die():
	print("Duke has died.")
	get_tree().change_scene_to_file("res://Scenes/GameOver.tscn")
