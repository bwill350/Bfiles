extends CharacterBody2D
class_name Duke

@export var SPEED = 900.0
@export var JUMP_VELOCITY = -1800.0
@export var CLIMB_SPEED = 250.0
@export var stick_sensitivity := 800.0
@export var stick_deadzone := 0.15
@export var enable_mouse_aim := true

const GRAVITY = 5000

enum State { IDLE, RUN, JUMP, CLIMB, DEAD }
var state: State = State.IDLE

var health: int = 1
var max_health: int = 300
var last_facing_dir = 1

var _mouse_pos := Vector2.ZERO

signal Die
signal health_changed(health)
signal combo_used(combo_name: String)

# ---------------- COMBO SYSTEM ----------------
var combo := []
var combo_timer := 0.0
@export var combo_reset_time := 0.6

const FIRE_COMBO = ["down", "right", "shoot"]
const ICE_COMBO = ["left", "left", "shoot"]
const ELECTRIC_COMBO = ["up", "down", "shoot"]

var locked_color := Color(1, 1, 1)
var color_locked := false

var flashing := false
var original_modulate := Color.WHITE

var can_shoot := true
@export var shoot_cooldown := 0.12

# ---------------- NODES ----------------
@onready var health_label = $HealthLabel
@onready var anim: AnimatedSprite2D = $Sprite
@onready var marker: Marker2D = $MarkerShoot
@onready var marker2: Marker2D = $MarkerAim
@onready var hitbox: Area2D = $HitBox
@onready var punch_kick_box: Area2D = $PunchKickBox
@onready var hit_sound: AudioStreamPlayer2D = $HitSound

const ICE_DEATH = preload("res://Deaths/IceDeath.tscn")
const BRUTALITY_DEATH = preload("res://Deaths/BrutalityDeath.tscn")
const BLOOD_DEATH = preload("res://Deaths/BloodDeath.tscn")

# ---------------- READY ----------------
func _ready():
	add_to_group("player")
	add_to_group("Duke")

	health_changed.emit(health)

	hitbox.area_entered.connect(_on_HitBox_area_entered)
	punch_kick_box.area_entered.connect(_on_punch_kick_box_area_entered)

	combo_used.connect(_on_combo_used)
	health_changed.connect(update_health_ui)

	Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
	_mouse_pos = get_viewport().get_mouse_position()


# ---------------- PROCESS ----------------
func _process(delta):
	handle_combo(delta)

	var stick_input = Vector2(
		Input.get_joy_axis(0, JOY_AXIS_RIGHT_X),
		Input.get_joy_axis(0, JOY_AXIS_RIGHT_Y)
	)

	if enable_mouse_aim:
		if stick_input.length() >= stick_deadzone:
			stick_input = stick_input.normalized()
			_mouse_pos += stick_input * stick_sensitivity * delta

			_mouse_pos.x = clamp(
				_mouse_pos.x,
				0,
				get_viewport().size.x
			)

			_mouse_pos.y = clamp(
				_mouse_pos.y,
				0,
				get_viewport().size.y
			)

	var aim_target: Vector2

	if stick_input.length() >= stick_deadzone:
		aim_target = get_viewport().get_canvas_transform().affine_inverse() * _mouse_pos
	else:
		aim_target = get_global_mouse_position()

	marker2.look_at(aim_target)


# ---------------- COMBO ----------------
func handle_combo(delta):
	combo_timer += delta

	if combo_timer > combo_reset_time:
		combo.clear()


func register_input(input: String):
	combo.append(input)
	combo_timer = 0.0
	check_combos()


func check_combos():

	if combo == FIRE_COMBO:
		combo_used.emit("fire")
		shootburst()
		combo.clear()

	elif combo == ICE_COMBO:
		combo_used.emit("ice")
		shootaroundleft()
		shootaroundright()
		combo.clear()

	elif combo == ELECTRIC_COMBO:
		combo_used.emit("electric")
		electric_burst()
		combo.clear()


# ---------------- COLOR LOCK ----------------
func _on_combo_used(combo_name: String):

	color_locked = true

	match combo_name:

		"fire":
			locked_color = Color(1, 0.3, 0.3)

		"ice":
			locked_color = Color(0.3, 0.6, 1.0)

		"electric":
			locked_color = Color(1, 1, 1)

	modulate = locked_color


func clear_color_lock():

	if color_locked:
		color_locked = false
		modulate = Color.WHITE


# ---------------- FLASH ----------------
func flash_red():

	if flashing:
		return

	flashing = true

	original_modulate = modulate

	modulate = Color(1, 0, 0)

	await get_tree().create_timer(0.08).timeout

	if color_locked:
		modulate = locked_color
	else:
		modulate = original_modulate

	flashing = false


# ---------------- PHYSICS ----------------
func _physics_process(delta):

	var input_dir = Input.get_axis("left", "right")
	var climb_pressed = Input.is_action_pressed("climb")
	var on_wall = is_on_wall()

	# ---------------- COMBO INPUTS ----------------
	if Input.is_action_just_pressed("left"):
		register_input("left")

	if Input.is_action_just_pressed("right"):
		register_input("right")

	if Input.is_action_just_pressed("up"):
		register_input("up")

	if Input.is_action_just_pressed("down"):
		register_input("down")

	if Input.is_action_just_pressed("shoot"):
		register_input("shoot")

	# ---------------- CLEAR COLOR ----------------
	if Input.is_action_just_pressed("jump"):
		clear_color_lock()

	if input_dir != 0:
		last_facing_dir = input_dir

	# ---------------- STATES ----------------
	if climb_pressed and not is_on_floor() and on_wall:
		state = State.CLIMB

	elif not is_on_floor():
		state = State.JUMP

	elif input_dir != 0:
		state = State.RUN

	else:
		state = State.IDLE

	# ---------------- STATE LOGIC ----------------
	match state:

		State.CLIMB:
			velocity.y = -CLIMB_SPEED
			velocity.x = input_dir * SPEED
			anim.play("climb")

		State.JUMP:
			velocity.y += GRAVITY * delta
			velocity.x = input_dir * SPEED

			anim.play("jump")
			anim.flip_h = last_facing_dir == -1

		State.RUN:

			velocity.y += GRAVITY * delta
			velocity.x = input_dir * SPEED

			if input_dir > 0:
				anim.play("move_right")
				anim.flip_h = false

			elif input_dir < 0:
				anim.play("move_right")
				anim.flip_h = true

		State.IDLE:

			velocity.y += GRAVITY * delta
			velocity.x = 0

			anim.play("Idle")
			anim.flip_h = last_facing_dir == -1

	# ---------------- JUMP ----------------
	if Input.is_action_just_pressed("jump") and is_on_floor():

		velocity.y = JUMP_VELOCITY
		state = State.JUMP

	# ---------------- SHOOT ----------------
	if Input.is_action_pressed("shoot"):
		shoot()

	if Input.is_action_just_pressed("shootright"):
		shootright()

	if Input.is_action_just_pressed("shootleft"):
		shootleft()

	if Input.is_action_just_pressed("shootaroundright"):
		shootaroundright()

	if Input.is_action_just_pressed("shootaroundleft"):
		shootaroundleft()

	if Input.is_action_just_pressed("shootburst"):
		shootburst()

	move_and_slide()

# ---------------- CREATE BULLET ----------------
func create_bullet(direction: Vector2):

	var bullet = preload("res://Projectiles/Bullet.tscn").instantiate()

	bullet.global_position = marker.global_position
	bullet.velocity = direction.normalized() * bullet.speed

	get_tree().current_scene.add_child(bullet)

	return bullet

# ---------------- SHOOT ----------------
func shoot():

	if not can_shoot:
		return
	can_shoot = false
	var dir = marker2.global_transform.x.normalized()
	create_bullet(dir)
	await get_tree().create_timer(shoot_cooldown).timeout
	can_shoot = true

func shootright():
	create_bullet(Vector2.RIGHT)

func shootleft():
	create_bullet(Vector2.LEFT)

func shootaroundright():
	create_bullet(Vector2(4, -6))

func shootaroundleft():
	create_bullet(Vector2(-4, -6))

func shootburst():

	var burst = 8
	var base = randf_range(0, TAU)

	for i in range(burst):

		var angle = base + (TAU / burst) * i

		var bullet = preload("res://Projectiles/Bullet.tscn").instantiate()

		bullet.global_position = global_position + Vector2(
			randf_range(-60, 60),
			randf_range(-60, 60)
		)

		bullet.velocity = Vector2.RIGHT.rotated(angle) * bullet.speed

		get_tree().current_scene.add_child(bullet)

func electric_burst():

	for i in range(12):

		var angle = (TAU / 12.0) * i

		var bullet = preload("res://Projectiles/Bullet.tscn").instantiate()

		bullet.global_position = global_position
		bullet.velocity = Vector2.RIGHT.rotated(angle) * bullet.speed * 1.5

		get_tree().current_scene.add_child(bullet)

# ---------------- DAMAGE ----------------
func take_damage(amount: int):
	flash_red()
	health -= amount
	health = clamp(health, 0, max_health)
	health_changed.emit(health)
	if hit_sound:
		hit_sound.play()
	if health <= 0:
		die()

# ---------------- HITBOX ----------------
func _on_HitBox_area_entered(area: Area2D):
	if area.is_in_group("ReptileAttack"):
		take_damage(1)
	elif area.is_in_group("ReptileBullet"):
		take_damage(2)
	elif area.is_in_group("EnemyExplosion"):
		take_damage(5)

func _on_punch_kick_box_area_entered(area: Area2D):
	if area.is_in_group("ReptileAttack"):
		take_damage(1)
		return
	var reptile = area.get_parent()
	if reptile \
	and reptile.is_in_group("Reptile") \
	and reptile.has_method("is_attacking"):
		take_damage(1)

# ---------------- HEAL ----------------
func heal(amount: int):

	health += amount
	health = clamp(health, 0, max_health)

	health_changed.emit(health)

# ---------------- HUD ----------------
func update_health_ui(hp):

	if health_label:
		health_label.text = "Player Health: %d / %d" % [hp, max_health]

# ---------------- DEATH ----------------
func die():

	state = State.DEAD
	velocity = Vector2.ZERO

	var death_instance = BLOOD_DEATH.instantiate()
	death_instance.global_position = global_position
	get_tree().current_scene.add_child(death_instance)

	$Timer.start()

	visible = false
	set_physics_process(false)
	set_process(false)

	

func _on_timer_timeout():
	get_tree().change_scene_to_file(
		"res://Scenes/GameOver.tscn"
	)
