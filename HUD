# ROUND WIN INDICATORS
# =========================================================

@onready var p1_round1_sprite = get_node_or_null("../Sprite2D5")
@onready var p1_round2_sprite = get_node_or_null("../Sprite2D6")

@onready var p2_round1_sprite = get_node_or_null("../Sprite2D7")
@onready var p2_round2_sprite = get_node_or_null("../Sprite2D8")


# =========================================================
# FIGHTERS
# =========================================================

var reptile
var subzero
var duke
var raiden
var liu_kang
var sonya
var kano
var johnny_cage


# =========================================================
# READY
# =========================================================

func _ready():

	add_to_group("HUD")

	hide_round_ui()
	hide_win_lose()
	hide_round_win_sprites()

	_find_fighters()


# =========================================================
# HIDE ROUND WIN SPRITES
# =========================================================

func hide_round_win_sprites():

	if p1_round1_sprite != null:
		p1_round1_sprite.visible = false

	if p1_round2_sprite != null:
		p1_round2_sprite.visible = false

	if p2_round1_sprite != null:
		p2_round1_sprite.visible = false

	if p2_round2_sprite != null:
		p2_round2_sprite.visible = false


# =========================================================
# UPDATE ROUND WIN SPRITES
# =========================================================

func update_round_wins():

	hide_round_win_sprites()

	# ---------------------------------------------------------
	# PLAYER 1
	# ---------------------------------------------------------

	if Game.p1_round_wins >= 1:

		if p1_round1_sprite != null:
			p1_round1_sprite.visible = true

	if Game.p1_round_wins >= 2:

		if p1_round2_sprite != null:
			p1_round2_sprite.visible = true


	# ---------------------------------------------------------
	# PLAYER 2 / CPU
	# ---------------------------------------------------------

	if Game.p2_round_wins >= 1:

		if p2_round1_sprite != null:
			p2_round1_sprite.visible = true

	if Game.p2_round_wins >= 2:

		if p2_round2_sprite != null:
			p2_round2_sprite.visible = true


# =========================================================
# HIDE ROUND UI
# =========================================================

func hide_round_ui():

	if round1 != null:
		round1.visible = false

	if round2 != null:
		round2.visible = false

	if round3 != null:
		round3.visible = false

	if fight != null:
		fight.visible = false


# =========================================================
# FIND FIGHTERS
# =========================================================

func _find_fighters():

	duke = get_tree().get_first_node_in_group("Duke")
	reptile = get_tree().get_first_node_in_group("Reptile")
	subzero = get_tree().get_first_node_in_group("Subzero")
	raiden = get_tree().get_first_node_in_group("Raiden")
	liu_kang = get_tree().get_first_node_in_group("LiuKang")
	sonya = get_tree().get_first_node_in_group("Sonya")
	kano = get_tree().get_first_node_in_group("Kano")
	johnny_cage = get_tree().get_first_node_in_group("JohnnyCage")

	if duke_label != null:
		duke_label.text = Game.p1_character

	if reptile_label != null:
		reptile_label.text = Game.p2_character

	if subzero_label != null:
		subzero_label.text = Game.p1_character

	if raiden_label != null:
		raiden_label.text = Game.p1_character

	if liu_kang_label != null:
		liu_kang_label.text = Game.p1_character

	if sonya_label != null:
		sonya_label.text = Game.p1_character

	if kano_label != null:
		kano_label.text = Game.p1_character

	if johnnycage_label != null:
		johnnycage_label.text = Game.p1_character


# =========================================================
# PROCESS
# =========================================================

func _process(_delta):

	if reptile == null \
	or subzero == null \
	or duke == null \
	or raiden == null \
	or liu_kang == null \
	or sonya == null \
	or kano == null \
	or johnny_cage == null:

		_find_fighters()


# =========================================================
# SHOW ROUND
# =========================================================

func show_round(round_number: int):

	hide_round_ui()

	if round_number == 1:

		if round1 != null:
			round1.visible = true

	elif round_number == 2:

		if round2 != null:
			round2.visible = true

	elif round_number == 3:

		if round3 != null:
			round3.visible = true

	else:
		return

	await get_tree().create_timer(2.0).timeout

	hide_round_ui()


# =========================================================
# SHOW FIGHT
# =========================================================

func show_fight():

	hide_round_ui()

	if fight != null:
		fight.visible = true

	await get_tree().create_timer(1.0).timeout

	if fight != null:
		fight.visible = false


# =========================================================
# RESET HEALTH
# =========================================================

func reset_all_health_bars():

	if duke_bar != null:
		duke_bar.value = duke_bar.max_value

	if reptile_bar != null:
		reptile_bar.value = reptile_bar.max_value

	if subzero_bar != null:
		subzero_bar.value = subzero_bar.max_value

	if raiden_bar != null:
		raiden_bar.value = raiden_bar.max_value

	if liu_kang_bar != null:
		liu_kang_bar.value = liu_kang_bar.max_value

	if sonya_bar != null:
		sonya_bar.value = sonya_bar.max_value

	if kano_bar != null:
		kano_bar.value = kano_bar.max_value

	if johnny_cage_bar != null:
		johnny_cage_bar.value = johnny_cage_bar.max_value

	update_p1_segments(10, 10)
	update_p2_segments(10, 10)


# =========================================================
# WIN / LOSE
# =========================================================

func show_you_win():

	if you_lose != null:
		you_lose.visible = false

	if you_win != null:
		you_win.visible = true


func show_you_lose():

	if you_win != null:
		you_win.visible = false

	if you_lose != null:
		you_lose.visible = true


func hide_win_lose():

	if you_win != null:
		you_win.visible = false

	if you_lose != null:
		you_lose.visible = false


func show_winner(character_name: String):

	show_you_win()


func hide_winner():

	if you_win != null:
		you_win.visible = false


# =========================================================
# P1 SEGMENTS
# =========================================================

func update_p1_segments(health, max_hp):

	if max_hp <= 0:
		return

	var percent = float(health) / float(max_hp)

	seg5.visible = percent > 0.00
	seg6.visible = percent > 0.01
	seg7.visible = percent > 0.02
	seg8.visible = percent > 0.03


# =========================================================
# P2 SEGMENTS
# =========================================================

func update_p2_segments(health, max_hp):

	if max_hp <= 0:
		return

	var percent = float(health) / float(max_hp)

	seg1.visible = percent > 0.00
	seg2.visible = percent > 0.01
	seg3.visible = percent > 0.02
	seg4.visible = percent > 0.03


