extends CanvasLayer

@onready var duke_label = $DukeLabel
@onready var reptile_label = $ReptileLabel
@onready var subzero_label = $SubzeroLabel
@onready var points_label = $Points

@onready var duke_bar: TextureProgressBar = $DukeHealthBar
@onready var reptile_bar: TextureProgressBar = $ReptileHealthBar
@onready var subzero_bar: TextureProgressBar = $SubzeroHealthBar
# Duke Segs (1–8)
@onready var seg5 = $Seg5
@onready var seg6 = $Seg6
@onready var seg7 = $Seg7
@onready var seg8 = $Seg8

# Reptile Segs (1–4)
@onready var seg1 = $Seg1
@onready var seg2 = $Seg2
@onready var seg3 = $Seg3
@onready var seg4 = $Seg4

# Subzero Segs (9–12)
@onready var seg9 = $Seg9
@onready var seg10 = $Seg10
@onready var seg11 = $Seg11
@onready var seg12 = $Seg12

var reptile
var subzero
var duke


func _ready():

	Game.points_changed.connect(_on_points_changed)

	duke = get_tree().get_first_node_in_group("player")
	if duke:
		duke.health_changed.connect(_on_duke_health_changed)

	reptile = get_tree().get_first_node_in_group("Reptile")
	if reptile:
		reptile.health_changed.connect(_on_reptile_health_changed)

	subzero = get_tree().get_first_node_in_group("Subzero")
	if subzero:
		subzero.health_changed.connect(_on_subzero_health_changed)


func _process(_delta):

	if reptile == null:
		reptile = get_tree().get_first_node_in_group("Reptile")
		if reptile and reptile.has_signal("health_changed"):
			reptile.health_changed.connect(_on_reptile_health_changed)

	if subzero == null:
		subzero = get_tree().get_first_node_in_group("Subzero")
		if subzero and subzero.has_signal("health_changed"):
			subzero.health_changed.connect(_on_subzero_health_changed)






# ---------------- DUKE ----------------
func _on_duke_health_changed(health):

	duke_label.text = "Duke: %d" % health
	duke_bar.value = health


# ---------------- REPTILE (Seg1–4) ----------------
func _on_reptile_health_changed(health):

	reptile_label.text = "Reptile: %d" % health
	reptile_bar.value = health

	var max_hp = reptile_bar.max_value
	if max_hp <= 0:
		return

	var percent = float(health) / float(max_hp)

	seg1.visible = percent > 0.00
	seg2.visible = percent > 0.01
	seg3.visible = percent > 0.02
	seg4.visible = percent > 0.03


# ---------------- SUBZERO (Seg9–12) ----------------
func _on_subzero_health_changed(health):

	subzero_label.text = "Subzero: %d" % health
	# hide Duke/Reptile bar if needed (optional safe swap behavior)
	subzero_bar.visible = health

	var max_hp = subzero_bar.max_value
	if max_hp <= 0:
		return

	var percent = float(health) / float(max_hp)

	seg9.visible = percent > 0.00
	seg10.visible = percent > 0.01
	seg11.visible = percent > 0.02
	seg12.visible = percent > 0.03


# ---------------- POINTS ----------------
func _on_points_changed(points):
	points_label.text = "Points: %d" % points
