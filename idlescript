# FSM - Idle State
extends PlayerState

func enter_state(player_node):
	print("Entered Idle State")
	super(player_node)	# Correct way to call parent class!
	player.change_state("idle")
	player.velocity.x = 0

func handle_input(_delta):
	if Input.is_action_just_pressed("jump") and player.is_on_floor():
		player.change_state("Jumping")	
	# Handle Movement
	if Input.is_action_pressed("left") or Input.is_action_pressed("right"):
		player.change_state("Moving")
	# Handle Crouch
	if Input.is_action_pressed("down"):
		player.change_state("Crouching")
	# Handle Slashes
	if Input.is_action_pressed("up") and Input.is_action_just_pressed("slash"):
		player.change._state("Overhead")
