# FSM - Falling State
extends PlayerState

func enter_state(player_node):
	print("Entered Falling State")
	super(player_node)
	player.anim.animation = "fall"
	player.anim.play()

func physics_update(delta):
	# Apply gravity
	player.velocity.y += player.GRAVITY * delta
	player.velocity.y = min(player.velocity.y, player.MAX_FALL_SPEED)
	player.move_and_slide()

	# Optional: If you want horizontal air control
	if Input.is_action_pressed("left"):
		player.velocity.x = -player.SPEED
		player.facing_direction = -1
	elif Input.is_action_pressed("right"):
		player.velocity.x = player.SPEED
		player.facing_direction = 1
	else:
		player.velocity.x = 0

	# Transition to Idle or Landing
	if player.is_on_floor():
		player.change_state("Idle")  # or "Landing" if you have a separate state

func handle_input(_delta):
	# Optionally allow for air attack, dash, etc.
	if Input.is_action_just_pressed("slash"):
		player.change_state("AirSlash")

	if Input.is_action_just_pressed("dash"):
		player.change_state("AirDash")
