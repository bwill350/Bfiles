# FSM jumping state
extends PlayerState

@onready var wall_check: ShapeCast2D = $"../WallCheck"
@onready var floor_check: RayCast2D = $"../FloorCheck"

func enter_state(player_node):
	print("Entered Jumping State")
	super(player_node)
	player.state_label.text = "Jumping"
	player.velocity.y = player.JUMP_VELOCITY
	# Add animation for jumping
	player.anim.animation = "jump"
	player.anim.stop() # Specific frames used for vertical movement

func handle_input(_delta):
	# Handle landing
	if player.is_on_floor():
		player.change_state("Idle")	 #landing
	# Handle Movement in air from still jump
	var direction = Input.get_axis("left", "right")
	player.last_facing_dir = sign(direction)
	player.velocity.x = direction * player.SPEED
	if player.velocity.y <= -1:
		player.anim.frame = 0 # Upward
	if player.velocity.y > -100 and player.velocity.y < 100:
		player.anim.frame = 1	#Floaty

func check_ledge_grab() -> void:
	if wall_check.is_colliding() and not floor_check.is_colliding() and player.velocity.y == 0:
		player.change_state("WallGrab")
