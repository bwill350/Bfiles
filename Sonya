func start_kick_combo():

	if action_locked:
		return

	if is_hurting:
		return

	if state == State.DEAD:
		return

	if health <= 1:
		return

	await combo_attack([
		"kick",
		"knee",
		"highkick",
		"roundhousekick",
		"lowkick",
		"roundhousekick",
		"highkick"
	])


# =========================================================
# COMBO ATTACK
# =========================================================

func combo_attack(attacks: Array):

	if state == State.DEAD:
		return

	if is_hurting:
		return

	action_locked = true
	is_attacking = true

	for attack in attacks:

		if state == State.DEAD:
			break

		if is_hurting:
			break

		if is_finish_state:
			break

		play_anim(attack)

		spawn_attack(attack)

		await sprite.animation_finished

		if state == State.DEAD:
			break

		if is_hurting:
			break


	is_attacking = false
	action_locked = false
	hurt_locked = false

	if state != State.DEAD and not is_hurting and not is_finish_state:

		current_anim = ""
		play_anim("idle")

# =========================================================
# HURT BOX
# =========================================================
func _on_sonya_hurt_box_area_entered(area: Area2D) -> void:

	if hurt_cooldown:
		return

	if area == null or !is_instance_valid(area):
		return

	if not can_take_damage:
		return

	if state == State.DEAD:
		return


	# =====================================================
	# ONLY ACCEPT REAL ATTACK GROUPS
	# =====================================================

	if not (
		area.is_in_group("HitBox")
		or area.is_in_group("ReptileAcid")
		or area.is_in_group("Grab")
		or area.is_in_group("RaidenElectricBullet")
		or area.is_in_group("FireBullet")
		or area.is_in_group("Fireball")
		or area.is_in_group("SonyaBullet")
		or area.is_in_group("JohnnyCageBullet")
		or area.is_in_group("KanoBullet")
		or area.is_in_group("IceBullet")
		or area.is_in_group("KanoAttack")
	):

		return


	hurt_cooldown = true


	# =====================================================
	# SAVE THE INCOMING ATTACK NAME
	# THIS IS WHAT ALLOWS FATALKICK TO BE DETECTED IN DIE()
	# =====================================================

	if area.get("attack_name") != null:
		set_meta(
			"last_attack_name",
			str(area.attack_name).strip_edges().to_lower()
		)
	elif has_meta("last_attack_name"):
		remove_meta("last_attack_name")


	# =====================================================
	# UPPERCUT
	# =====================================================

	if area.get("attack_name") == "uppercut":

		uppercut_launched = true
		was_uppercut = true

		is_hurting = true
		hurt_locked = true
		action_locked = true

		is_attacking = false
		is_shooting = false
		is_blocking = false

		state = State.JUMP

		knockback_x = -facing * 100

		velocity.x = knockback_x
		velocity.y = jump_velocity

		current_anim = ""

		sprite.play("wasuppercut")

		if is_instance_valid(hurt_sound):
			hurt_sound.play()

		take_damage(1)

		await get_tree().create_timer(0.10).timeout

		hurt_cooldown = false

		return


	# =====================================================
	# JUMPKICK LAUNCH
	# =====================================================

	if area.get("attack_name") == "jumpkick":

		jumpkick_launched = true
		was_jumpkick = true

		is_hurting = true
		hurt_locked = true
		action_locked = true

		is_attacking = false
		is_shooting = false
		is_blocking = false

		state = State.JUMP

		knockback_x = -facing * 100

		velocity.x = knockback_x
		velocity.y = -1000

		current_anim = ""

		sprite.play("wasjumpkick")

		if is_instance_valid(hurt_sound):
			hurt_sound.play()

		take_damage(1)

		await get_tree().create_timer(0.10).timeout

		hurt_cooldown = false

		return


	# =====================================================
	# NORMAL HIT
	# =====================================================

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	knockback_x = -facing * 100

	velocity.x = knockback_x

	current_anim = ""

	sprite.play("hurt")

	if is_instance_valid(hurt_sound):
		hurt_sound.play()

	take_damage(1)


	await get_tree().create_timer(0.2).timeout


	if state != State.DEAD:

		is_hurting = false
		hurt_locked = false
		action_locked = false

		state = State.IDLE

		velocity.x = 0

		current_anim = ""

		play_anim("idle")


	hurt_cooldown = false

