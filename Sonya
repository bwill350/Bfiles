# ---------------- INPUT ----------------
func _unhandled_input(event):

	if is_cpu:
		return

	if event.is_action_pressed("jump"):

		if is_on_floor():

			velocity.y = jump_velocity
			state = State.JUMP
			$Jump.play()

	var inputs = [
		"up",
		"down",
		"left",
		"right",
		"shoot"
	]

	for i in inputs:

		if event.is_action_pressed(i):
			register_input(i)

	_check_punch_combo()
	_check_pink_combo()


func spawn_fire_bullet():

	play_anim("shoot")

	var bullet = FIRE_BULLET.instantiate()

	get_tree().current_scene.add_child(bullet)

	bullet.global_position = $SonyaShoot.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed


func apply_stun(_duration := 4.0):

	if state == State.DEAD:
		return

	stunned = true

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	velocity = Vector2.ZERO
	knockback_x = 0

	play_anim("idle")

	await get_tree().create_timer(4.0).timeout

	stunned = false

	is_hurting = false
	hurt_locked = false
	action_locked = false


func run(input_dir: float):

	if input_dir == 0:
		return

	state = State.RUN

	velocity.x = input_dir * SPEED * 2.5

	if not is_attacking:
		play_anim("run")


# ---------------- READY ----------------
func _ready():
	$fatalkick.visible = false
	$firedeath.visible = false
	$Sprite.visible = true
	$Crispy.visible = false
	$healthzero.visible = false

	add_to_group("Fighter")
	add_to_group("enemy")
	add_to_group("Sonya")

	spawn_locked = false

	health = max_health

	health_changed.emit(health)

	play_anim("idle")

	ai_timer = randf_range(0.2, 0.6)

	facing = 1

	sprite.flip_h = -facing < 0
	$Crispy.flip_h = -facing < 0


# ---------------- PHYSICS ----------------
func _physics_process(delta):

	# =====================================================
	# DEAD
	# =====================================================

	if state == State.DEAD:
		return


	# =====================================================
	# SPEAR PULL
	# =====================================================

	if is_pulled:

		run_pull_logic(delta)

		move_and_slide()

		return


	# =====================================================
	# STUN
	# =====================================================

	if stunned:

		if not is_on_floor():
			velocity.y += GRAVITY * delta
		else:
			if velocity.y > 0:
				velocity.y = 0

		move_and_slide()

		return


	# =====================================================
	# FINISH HIM
	# =====================================================

	if is_finish_state:

		state = State.IDLE
		velocity.x = 0

		if is_on_floor() and velocity.y > 0:
			velocity.y = 0

		if not is_hurting:
			play_anim("idle")

		move_and_slide()

		return


	# =====================================================
	# GRAVITY
	# =====================================================

	if not is_on_floor():

		velocity.y += GRAVITY * delta

	else:

		if velocity.y > 0:
			velocity.y = 0


	# =====================================================
	# UPPERCUT LAUNCH
	# =====================================================

	if uppercut_launched:

		# Keep uppercut hurt animation while airborne
		if sprite.animation != "wasuppercut":
			current_anim = ""
			sprite.play("wasuppercut")

		# Do NOT allow normal movement while launched
		velocity.x = move_toward(
			velocity.x,
			400.0,
			1500.0 * delta
		)

		move_and_slide()

		# =================================================
		# LANDED AFTER UPPERCUT
		# =================================================

		if is_on_floor():

			velocity.x = 0
			velocity.y = 0

			uppercut_launched = false
			was_uppercut = false

			is_hurting = false
			hurt_locked = false
			action_locked = false

			is_attacking = false
			is_shooting = false
			is_blocking = false

			state = State.IDLE

			current_anim = ""
			play_anim("idle")

		return


	# =====================================================
	# JUMPKICK LAUNCH
	# =====================================================

	if jumpkick_launched:

		# Keep jumpkick hurt animation while airborne
		if sprite.animation != "wasjumpkick":
			current_anim = ""
			sprite.play("wasjumpkick")

		# Do NOT allow normal movement while launched
		velocity.x = move_toward(
			velocity.x,
			0.0,
			1900.0 * delta
		)

		move_and_slide()

		# =================================================
		# LANDED AFTER JUMPKICK
		# =================================================

		if is_on_floor():

			velocity.x = 0
			velocity.y = 0

			jumpkick_launched = false
			was_jumpkick = false

			is_hurting = false
			hurt_locked = false
			action_locked = false

			is_attacking = false
			is_shooting = false
			is_blocking = false

			state = State.IDLE

			current_anim = ""
			play_anim("idle")

		return


	# =====================================================
	# COOLDOWNS
	# =====================================================

	shoot_cooldown = max(
		shoot_cooldown - delta,
		0.0
	)

	combo_timer += delta

	if combo_timer > combo_reset_time:

		combo.clear()


	# =====================================================
	# CPU
	# =====================================================

	if is_cpu:

		cpu_logic(delta)

		move_and_slide()

		return


	# =====================================================
	# ACTION LOCK
	# =====================================================

	if action_locked:

		velocity.x = 0

		move_and_slide()

		return


	# =====================================================
	# PLAYER INPUT
	# =====================================================

	var input_dir := Input.get_axis(
		"left",
		"right"
	)

	var climb_pressed := Input.is_action_pressed("climb")


	# =====================================================
	# FACING
	# =====================================================

	if input_dir != 0:

		facing = sign(input_dir)

		sprite.flip_h = facing > 0
		$Crispy.flip_h = facing > 0

		$AttackMarker.position = Vector2(
			0,
			0
		)

		$SonyaShoot.position = Vector2(
			63 * facing,
			-225
		)


	# =====================================================
	# JUMP
	# =====================================================

	if (
		Input.is_action_just_pressed("jump")
		and is_on_floor()
	):

		velocity.y = jump_velocity
		state = State.JUMP

		if has_node("Jump"):
			$Jump.play()


	# =====================================================
	# AIR MOVEMENT
	# =====================================================

	if not is_on_floor():

		velocity.x = input_dir * SPEED

		if (
			Input.is_action_pressed("run")
			and input_dir != 0
		):

			velocity.x = input_dir * SPEED * 4

		# ALWAYS FORCE AIR STATE
		state = State.JUMP


	# =====================================================
	# GROUND MOVEMENT
	# =====================================================

	else:

		if (
			Input.is_action_pressed("run")
			and input_dir != 0
		):

			run(input_dir)

		else:

			velocity.x = input_dir * SPEED

			if input_dir != 0:

				state = State.WALK

			else:

				state = State.IDLE


	# =====================================================
	# ANIMATIONS
	# =====================================================

	match state:

		State.JUMP:

			if not is_attacking and not is_hurting:

				play_anim("jump")


		State.WALK:

			if not is_attacking and not is_hurting:

				play_anim("walk")


		State.RUN:

			if not is_attacking and not is_hurting:

				play_anim("run")


		State.IDLE:

			if not is_attacking and not is_hurting:

				play_anim("idle")


	# =====================================================
	# HURT LOCK
	# =====================================================

	if is_hurting and hurt_locked:

		move_and_slide()

		return


	# =====================================================
	# ATTACKS
	# =====================================================

	if Input.is_action_just_pressed("punch"):

		do_action("punch")

	elif Input.is_action_just_pressed("highpunch"):

		do_action("highpunch")

	elif Input.is_action_just_pressed("lowpunch"):

		do_action("lowpunch")

	elif Input.is_action_just_pressed("kick"):

		do_action("kick")

	elif Input.is_action_just_pressed("highkick"):

		do_action("highkick")

	elif Input.is_action_just_pressed("lowkick"):

		do_action("lowkick")

	elif Input.is_action_just_pressed("slidekick"):

		do_action("slidekick")

	elif Input.is_action_just_pressed("jumpkick"):

		do_action("jumpkick")

	elif Input.is_action_just_pressed("uppercut"):

		do_action("uppercut")

	elif Input.is_action_just_pressed("knee"):

		do_action("knee")

	elif Input.is_action_just_pressed("roundhousekick"):

		do_action("roundhousekick")

	elif Input.is_action_just_pressed("shoot"):

		shoot_player()


	# =====================================================
	# FINAL MOVEMENT
	# =====================================================

	move_and_slide()


# =========================================================
# SPEAR PULL
# =========================================================

func spear_pulled_to_p1():

	is_pulled = true
	stunned = true
	action_locked = true
	is_hurting = true

	pull_timer = 0.35

	pull_target = get_tree().get_first_node_in_group("Reptile")


func run_pull_logic(delta):

	if pull_target == null or !is_instance_valid(pull_target):

		is_pulled = false
		stunned = false
		action_locked = false

		return

	var dir = sign(
		pull_target.global_position.x -
		global_position.x
	)

	velocity.x = dir * 900
	velocity.y = -120

	pull_timer -= delta

	if pull_timer <= 0.0:

		is_pulled = false

		global_position = (
			pull_target.attack_marker.global_position
			+ Vector2(
				40 * pull_target.facing,
				0
			)
		)

		stunned = false
		is_hurting = false
		action_locked = false
		is_attacking = true

		pull_target = null


# =========================================================
# CPU
# =========================================================

func cpu_logic(delta):

	if state == State.DEAD:

		velocity.x = 0
		is_attacking = false
		is_shooting = false
		action_locked = true

		return


	if is_finish_state:

		is_attacking = false
		is_shooting = false
		action_locked = true
		velocity.x = 0
		state = State.IDLE

		if not is_hurting:
			play_anim("idle")

		return


	if is_hurting:

		velocity.x = knockback_x

		knockback_x = move_toward(
			knockback_x,
			0.0,
			1500.0 * delta
		)

		if abs(knockback_x) > 10.0:
			return

		knockback_x = 0.0

		is_hurting = false
		hurt_locked = false
		is_attacking = false
		is_shooting = false
		action_locked = false

		state = State.IDLE

		play_anim("idle")

		ai_timer = 0.1

		return


	if action_locked:

		velocity.x = 0

		return


	if target == null or not is_instance_valid(target):

		target = get_tree().get_first_node_in_group("player1")

		if target == null or not is_instance_valid(target):

			for node in get_tree().get_nodes_in_group("Fighter"):

				if node == self:
					continue

				if not is_instance_valid(node):
					continue

				if node is Node2D and not node.is_cpu:

					target = node
					break


	if target == null or not is_instance_valid(target):

		velocity.x = 0
		state = State.IDLE
		action_locked = true

		if not is_hurting:
			play_anim("idle")

		return


	if target.get("health") != null and target.health <= 0:

		velocity.x = 0
		is_attacking = false
		is_shooting = false
		is_blocking = false
		action_locked = true

		state = State.IDLE

		if not is_hurting:
			play_anim("idle")

		return


	var dist: float = (
		target.global_position.x -
		global_position.x
	)

	var distance: float = abs(dist)
	var direction: float = sign(dist)


	if direction != 0:

		facing = direction

		sprite.flip_h = facing > 0
		$Crispy.flip_h = facing > 0

		$AttackMarker.position = Vector2(
			0,
			0
		)

		$SonyaShoot.position = Vector2(
			63 * facing,
			-225
		)


	var attack_range := 110.0
	var stopping_distance := 70.0


	if distance > stopping_distance:

		velocity.x = direction * SPEED

		state = State.WALK

		if not is_attacking and not is_hurting:
			play_anim("walk")

	else:

		velocity.x = 0

		state = State.IDLE

		if not is_attacking and not is_hurting:
			play_anim("idle")


	if target.get("health") != null and target.health <= 0:

		velocity.x = 0
		is_attacking = false
		is_shooting = false
		is_blocking = false
		action_locked = true

		state = State.IDLE

		if not is_hurting:
			play_anim("idle")

		return


	ai_timer -= delta

	if ai_timer > 0.0:
		return


	if not is_instance_valid(target):
		return


	if target.get("health") != null and target.health <= 0:

		velocity.x = 0
		is_attacking = false
		is_shooting = false
		is_blocking = false
		action_locked = true

		state = State.IDLE

		if not is_hurting:
			play_anim("idle")

		return


	if (
		distance <= attack_range
		and not is_hurting
		and not is_finish_state
		and not action_locked
		and not is_attacking
	):

		velocity.x = 0

		match Game.difficulty:

			"Hard":

				ai_timer = randf_range(
					0.05,
					0.15
				)

				var choice: int = randi() % 100

				if choice < 20:

					do_action("punch")

				elif choice < 35:

					do_action("highpunch")

				elif choice < 45:

					do_action("lowpunch")

				elif choice < 60:

					do_action("slidekick")

				elif choice < 70:

					do_action("highkick")

				elif choice < 80:

					do_action("lowkick")

				elif choice < 85:

					do_action("jumpkick")

				elif choice < 88:

					do_action("uppercut")

				elif choice < 94:

					do_action("roundhousekick")

				else:

					shoot_player()


			"Easy":

				ai_timer = randf_range(
					0.5,
					0.9
				)

				var choice: int = randi() % 100

				if choice < 40:

					do_action("punch")

				elif choice < 55:

					do_action("slidekick")

				elif choice < 65:

					do_action("highkick")

				elif choice < 75:

					do_action("lowkick")

				elif choice < 80:

					do_action("jumpkick")

				elif choice < 85:

					do_action("uppercut")

				else:

					do_action("roundhousekick")


# =========================================================
# SHOOT
# =========================================================

func shoot_player():

	if health <= 1:
		return

	if is_finish_state:
		return

	if is_shooting:
		return

	is_shooting = true
	is_attacking = true
	action_locked = true

	play_anim("shoot")

	$Sonyabullet.play()

	var bullet_scene: PackedScene = SONYA_BULLET

	if special_bullet != null:

		bullet_scene = special_bullet
		special_bullet = null

	var bullet = bullet_scene.instantiate()

	get_tree().current_scene.add_child(bullet)

	await get_tree().process_frame

	bullet.global_position = $SonyaShoot.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	await get_tree().create_timer(0.25).timeout

	is_shooting = false
	is_attacking = false
	action_locked = false


# =========================================================
# BURST
# =========================================================

func spawn_burst():

	var burst = SONYA_BULLET.instantiate()

	get_tree().current_scene.add_child(burst)

	burst.global_position = attack_marker.global_position


# =========================================================
# ACTION
# =========================================================

func do_action(anim_name: String):

	if is_attacking:
		return

	if health <= 1:
		return

	if is_finish_state:
		return

	if state == State.DEAD:
		return

	if action_locked:
		return

	action_locked = true
	is_attacking = true
	lock_timer = 0.6

	play_anim(anim_name)

	if anim_name in [
		"punch",
		"highpunch",
		"lowpunch",
		"kick",
		"highkick",
		"lowkick",
		"slidekick",
		"jumpkick",
		"uppercut",
		"roundhousekick",
		"knee"
	]:

		spawn_attack(anim_name)

	await sprite.animation_finished

	is_attacking = false
	action_locked = false
	hurt_locked = false

	if state != State.DEAD and not is_hurting:

		play_anim("idle")


# =========================================================
# ATTACK
# =========================================================

func spawn_attack(anim_name: String):

	if anim_name not in [
		"punch",
		"highpunch",
		"lowpunch",
		"kick",
		"highkick",
		"lowkick",
		"slidekick",
		"jumpkick",
		"uppercut",
		"roundhousekick",
		"knee"
	]:

		return


	var attack = SONYA_ATTACK.instantiate()

	get_tree().current_scene.add_child(attack)

	attack.add_to_group("HitBox")

	attack.global_position = attack_marker.global_position
	attack.scale.x = facing

	var dmg := 1


	match anim_name:

		"punch":
			dmg = 1

		"lowpunch":
			dmg = 1

		"highpunch":
			dmg = 1

		"kick":
			dmg = 1

		"lowkick":
			dmg = 1

		"highkick":
			dmg = 1

		"slidekick":
			dmg = 1

		"jumpkick":
			dmg = 1

		"uppercut":
			dmg = 1

		"roundhousekick":
			dmg = 1

		"knee":
			dmg = 1


	if attack.has_method("set_damage"):

		attack.set_damage(dmg)

	else:

		attack.damage = dmg


	attack.owner = self
	attack.attack_owner = self
	attack.attack_name = anim_name
	attack.attack_type = anim_name

# =========================================================
# DAMAGE
# =========================================================
func take_damage(amount: int):

	# =====================================================
	# BASIC PROTECTION
	# =====================================================

	if state == State.DEAD:
		return

	if not can_take_damage:
		return

	if spawn_protection:
		return


	# =====================================================
	# DAMAGE FRAME PROTECTION
	# =====================================================

	var frame := Engine.get_physics_frames()

	if has_meta("last_damage_frame"):

		if get_meta("last_damage_frame") == frame:
			return

	set_meta(
		"last_damage_frame",
		frame
	)


	# =====================================================
	# GET ATTACK NAME
	# =====================================================

	var incoming_attack := ""

	if has_meta("last_attack_name"):

		incoming_attack = str(
			get_meta("last_attack_name")
		).strip_edges().to_lower()


	# =====================================================
	# DEBUG
	# =====================================================

	print("================================")
	print("SONYA TAKE DAMAGE")
	print("ATTACK = [", incoming_attack, "]")
	print("HEALTH BEFORE = ", health)
	print("FINISH STATE = ", is_finish_state)
	print("================================")


	# =====================================================
	# DAMAGE LOCK
	# =====================================================

	can_take_damage = false

	get_tree().create_timer(0.25).timeout.connect(
		func():

			if is_instance_valid(self):

				if state != State.DEAD:

					can_take_damage = true
	)


	# =====================================================
	# BLOCK
	# =====================================================

	if is_blocking:

		amount = max(
			amount - 1,
			0
		)


	if amount <= 0:

		return


	# =====================================================
	# APPLY DAMAGE
	# =====================================================

	health -= amount

	health = max(
		health,
		0
	)


	print(
		"SONYA TOOK DAMAGE: ",
		amount,
		" HP = ",
		health
	)

	health_changed.emit(health)


	# =====================================================
	# HIT SOUND
	# =====================================================

	if is_instance_valid(hit_sound):

		hit_sound.play()


	# =====================================================
	# DEATH
	# =====================================================

	if health <= 0:

		print("================================")
		print("SONYA HEALTH REACHED ZERO")
		print("INCOMING ATTACK = [", incoming_attack, "]")
		print("FINISH STATE = ", is_finish_state)
		print("CALLING DIE")
		print("================================")


		# -------------------------------------------------
		# STOP ALL ACTIONS
		# -------------------------------------------------

		is_attacking = false
		is_shooting = false
		is_hurting = false
		is_blocking = false

		action_locked = true
		hurt_locked = true


		# -------------------------------------------------
		# STOP LAUNCH STATES
		# -------------------------------------------------

		uppercut_launched = false
		jumpkick_launched = false
		was_uppercut = false
		was_jumpkick = false


		# -------------------------------------------------
		# HIDE FINISH LABEL
		# -------------------------------------------------

		if is_instance_valid(finish_label):

			finish_label.visible = false


		# -------------------------------------------------
		# PRESERVE ATTACK NAME FOR DIE()
		# -------------------------------------------------

		if incoming_attack != "":

			set_meta(
				"last_attack_name",
				incoming_attack
			)

		else:

			# Make sure an old attack name cannot remain
			# from a previous hit.

			if has_meta("last_attack_name"):

				remove_meta("last_attack_name")


		# -------------------------------------------------
		# DIE
		# -------------------------------------------------

		die()

		return


	# =====================================================
	# FINISH HIM AT 1 HP
	# =====================================================

	if health == 1 and not is_finish_state:

		var opponent_will_win_match := false


		if is_in_group("player1"):

			if Game.p2_round_wins >= 1:

				opponent_will_win_match = true

		else:

			if Game.p1_round_wins >= 1:

				opponent_will_win_match = true


		if opponent_will_win_match:

			is_hurting = false
			hurt_locked = false
			action_locked = false

			trigger_finish_state()

			return


	# =====================================================
	# NORMAL HURT
	# =====================================================

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	state = State.IDLE

	combo.clear()


	# =====================================================
	# HURT ANIMATION
	# =====================================================

	current_anim = ""
	play_anim("hurt")


	# =====================================================
	# HURT SOUND
	# =====================================================

	if is_instance_valid(hurt_sound):

		hurt_sound.play()


	# =====================================================
	# BLOOD EFFECT
	# =====================================================

	if has_node("BloodMarker"):

		var blood = BLOOD_EFFECT.instantiate()

		get_tree().current_scene.add_child(blood)

		blood.global_position = $BloodMarker.global_position


	# =====================================================
	# HURT RECOVERY
	# =====================================================

	await get_tree().create_timer(0.25).timeout


	if state == State.DEAD:

		return


	is_hurting = false
	hurt_locked = false
	action_locked = false


	if state != State.DEAD and not is_finish_state:

		current_anim = ""
		play_anim("idle")


func trigger_finish_state():

	if is_finish_state:
		return

	is_finish_state = true

	state = State.IDLE

	velocity.x = 0
	velocity.y = 0

	action_locked = true
	hurt_locked = false

	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

	uppercut_launched = false
	jumpkick_launched = false

	set_meta(
		"uppercut_launched",
		false
	)

	play_anim("idle")

	finish_label.visible = true

	if finish_label.has_method("start_flicker"):

		finish_label.start_flicker(
			2.0,
			0.05
		)


	await get_tree().create_timer(0.1).timeout


	while not is_on_floor():

		velocity.y += (
			5000.0 *
			get_physics_process_delta_time()
		)

		move_and_slide()

		await get_tree().physics_frame


	velocity = Vector2.ZERO

	await get_tree().create_timer(2.0).timeout


	if is_instance_valid(finish_label):

		finish_label.visible = false


# =========================================================
# DEATH
# =========================================================
func die():

	if state == State.DEAD:
		return


	# =====================================================
	# DEAD STATE
	# =====================================================

	state = State.DEAD

	velocity = Vector2.ZERO

	is_attacking = false
	is_shooting = false
	is_blocking = false
	is_hurting = false

	action_locked = true
	hurt_locked = true
	can_take_damage = false

	stunned = false
	uppercut_launched = false
	jumpkick_launched = false

	is_pulled = false
	is_spear_pulled = false

	pull_target = null
	pull_timer = 0.0

	knockback_x = 0.0

	hurt_cooldown = false
	run_locked = false

	ai_timer = 999999.0


	# =====================================================
	# WINNER
	# =====================================================

	var winner := ""

	if is_in_group("player1"):

		winner = "cpu"

	else:

		winner = "player1"


	# =====================================================
	# GET ATTACK THAT KILLED SONYA
	# =====================================================

	var incoming_attack := ""

	if has_meta("last_attack_name"):

		incoming_attack = str(
			get_meta("last_attack_name")
		).strip_edges().to_lower()

		remove_meta("last_attack_name")


	print("================================")
	print("SONYA DEATH")
	print("LAST ATTACK = [", incoming_attack, "]")
	print("FINISH STATE = ", is_finish_state)
	print("================================")


	# =====================================================
	# NORMAL ROUND DEATH
	# =====================================================

	if not is_finish_state:

		print("SONYA NORMAL ROUND DEATH")

		$Sprite.visible = false
		$Crispy.visible = false

		if has_node("healthzero"):

			$healthzero.visible = true
			$healthzero.flip_h = facing > 0

		if has_node("fatalkick"):

			$fatalkick.visible = false

		current_anim = ""

		if is_instance_valid(finish_label):

			finish_label.visible = false

		round_death.emit(winner)

		return


	# =====================================================
	# FINISH HIM DEATH
	# =====================================================

	print("SONYA FINISH HIM DEATH")


	$Sprite.visible = false
	$Crispy.visible = false
	$healthzero.visible = false

	if has_node("fatalkick"):

		$fatalkick.visible = false

	current_anim = ""


	# =====================================================
	# JOHNNY CAGE FATAL KICK
	# =====================================================

	if incoming_attack == "fatalkick":

		print("================================")
		print("SONYA FATAL KICK DETECTED")
		print("FATAL KICK SPRITE NODE = ", fatalkick)
		print("FATAL KICK BEFORE = ", fatalkick.visible)
		print("================================")


		# Hide everything else

		$Sprite.visible = false
		$Crispy.visible = false
		$healthzero.visible = false


		# Show static Sprite2D

		if is_instance_valid(fatalkick):

			fatalkick.flip_h = facing > 0
			fatalkick.visible = true


		print("================================")
		print("SONYA FATAL KICK AFTER = ", fatalkick.visible)
		print("================================")


		# Hold fatal kick image

		await get_tree().create_timer(3.0).timeout


	# =====================================================
	# ANY OTHER FINISH HIM MOVE
	# =====================================================

	else:

		print("================================")
		print("SONYA CRISPY DEATH")
		print("ATTACK = [", incoming_attack, "]")
		print("================================")


		$Sprite.visible = false
		$Crispy.visible = true
		$Crispy.flip_h = facing > 0
		$healthzero.visible = false


		# Delay BEFORE blood

		await get_tree().create_timer(0.5).timeout


	# =====================================================
	# BLOOD DEATH
	# =====================================================

	var blood = BLOOD_DEATH.instantiate()

	get_tree().current_scene.add_child(blood)

	blood.global_position = global_position


	# =====================================================
	# HIDE FINISH LABEL
	# =====================================================

	if is_instance_valid(finish_label):

		finish_label.visible = false


	# =====================================================
	# CRISPY HOLD
	# =====================================================

	if incoming_attack != "fatalkick":

		await get_tree().create_timer(3.0).timeout


	# =====================================================
	# CLEANUP
	# =====================================================

	if is_instance_valid(fatalkick):

		fatalkick.visible = false

	if has_node("Crispy"):

		$Crispy.visible = false


	# =====================================================
	# ROUND DEATH
	# =====================================================

	round_death.emit(winner)

	return


