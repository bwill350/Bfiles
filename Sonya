func _check_pink_combo():
	if input_buffer.size() < 3:
		return

	var last3 = input_buffer.slice(input_buffer.size() - 3, input_buffer.size())

	if last3 == ["left", "down", "right"]:
		input_buffer.clear() # IMPORTANT anti-spam fix
		trigger_pink_death()

func _check_fire_combo():
	if input_buffer.size() < 2:
		return

	var last2 = input_buffer.slice(input_buffer.size() - 2, input_buffer.size())

	if last2 == ["down", "up"]:
		input_buffer.clear() # IMPORTANT anti-spam fix
		trigger_fire_death()

func _check_punch_combo():

	if input_buffer.size() < 3:
		return

	var last3 = input_buffer.slice(
		input_buffer.size() - 3,
		input_buffer.size()
	)

	if last3 == ["right", "down", "right"]:

		input_buffer.clear()

		start_punch_combo()

func check_combo():

	# ---------------- FIRE ----------------
	if combo == FIRE_COMBO: 

		combo_used.emit("fire")

		spawn_fx(FIRE_DEATH)

		special_bullet = FIRE_BULLET

		combo.clear()

		shoot_player()

		return

	# ---------------- KICK ----------------
	if input_buffer.size() >= 3:
		var last3 = input_buffer.slice(input_buffer.size() - 3, input_buffer.size())

		if last3 == KICK_COMBO:

			input_buffer.clear()

			combo_used.emit("kick_combo")

			start_kick_combo()
			return

	# ---------------- PUNCH ----------------
	if input_buffer.size() >= 3:
		var last3 = input_buffer.slice(input_buffer.size() - 3, input_buffer.size())

		if last3 == PUNCH_COMBO:

			input_buffer.clear()

			combo_used.emit("punch_combo")

			start_punch_combo()
			return

func start_punch_combo():

	if action_locked:
		return

	await combo_attack([
		"punch",
		"kick",
		"punch",
		"roundhousekick",
		"uppercut"
	])

func start_kick_combo():

	if action_locked:
		return

	await combo_attack([
		"kick",
		"knee",
		"highkick",
		"roundhousekick",
		"lowkick",
		"roundhousekick",
		"highkick"
	])

func combo_attack(attacks: Array):

	action_locked = true
	is_attacking = true

	for attack in attacks:

		play_anim(attack)
		spawn_attack(attack)

		await sprite.animation_finished

	is_attacking = false
	action_locked = false

# ---------------- HURT BOX ----------------
func _on_sonya_hurt_box_area_entered(area: Area2D) -> void:
	if hurt_cooldown:
		return

	if area == null or !is_instance_valid(area):
		return

	if area.is_in_group("HurtBox"):
		return

	if area.get("attack_name") and area.attack_name == "uppercut":
		$Sprite.play("wasuppercut")
	else:
		$Sprite.play("hurt")

		$Hurt.play()

	if not can_take_damage:
		return

	if area.is_in_group("HitBox") \
		or area.is_in_group("ReptileAcid") \
		or area.is_in_group("ReptileBullet") \
		or area.is_in_group("RaidenElectricBullet") \
		or area.is_in_group("FireBullet") \
		or area.is_in_group("Fireball") \
