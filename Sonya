# ---------------- STATE ----------------
enum State { IDLE, RUN, JUMP, JUMPKICK, BLOCK, PUNCH, CLIMB, DEAD }

var state: State = State.IDLE
var special_bullet: PackedScene = null
var spawn_locked := true
var spawn_protection := false
var special_move_invincible := false
# ---------------- CPU ----------------
var is_cpu := false
var target: Node2D = null
var ai_timer := 0.0
var stunned := false
# ---------------- FLAGS ----------------
var is_blocking := false
var is_hurting := false
var is_shooting := false
var is_attacking := false
var action_locked := false
var hurt_locked := false
var can_take_damage := true
var is_finish_state := false
var lock_timer := 0.0
# ---------------- MOVEMENT ----------------
var facing := 1
var current_anim := ""
var health: int
var knockback_x := 0.0
const GRAVITY = 5000

# ---------------- COOLDOWNS ----------------
var shoot_cooldown: float = 0.0

# ---------------- EXPORTS ----------------
@export var shoot_cooldown_time: float = 0.25
@export var SPEED = 300.0
@export var CLIMB_SPEED = 250.0
@export var max_health: int = 10
@export var jump_velocity = -2200.0
@export var combo_reset_time := 0.6

# ---------------- PRELOADS ----------------
const BULLET_SCENE = preload("res://Projectiles/SonyaBullet.tscn")
const FIRE_BULLET = preload("res://Projectiles/FireBullet.tscn")
const ICE_BULLET = preload("res://Projectiles/IceBullet.tscn")
const ELECTRIC_BULLET = preload("res://Projectiles/ElectricBullet.tscn")
const ACID_BULLET = preload("res://Projectiles/Reptilesacid.tscn")

const REPTILES_ACID = preload("res://Projectiles/Reptilesacid.tscn")
const SONYA_ATTACK = preload("res://Projectiles/SonyaAttack.tscn")

const BLOOD_EFFECT = preload("res://GreenBloodEffect.tscn")

# ---------------- DEATH FX ----------------
const BLOOD_DEATH = preload("res://Deaths/BloodDeath.tscn")
const FIRE_DEATH = preload("res://Deaths/FireDeath.tscn")
const ICE_DEATH = preload("res://Deaths/IceDeath.tscn")
const ELECTRIC_DEATH = preload("res://Deaths/ElectricDeath.tscn")

# ---------------- NODES ----------------
@onready var sprite: AnimatedSprite2D = $Sprite
@onready var hit_sound: AudioStreamPlayer2D = $Hit
@onready var hit_box: Area2D = $SonyaHurtBox
@onready var shoot_marker: Marker2D = $SonyaShoot
@onready var attack_marker: Marker2D = $AttackMarker
@onready var blood_marker: Marker2D = $BloodMarker
# ---------------- COMBOS ----------------
var combo := []
var combo_timer := 0.0

@onready var finish_label: Sprite2D = $HUD/FinishLabel/Sprite2D

const ACID_COMBO = ["down", "down", "down", "right", "shoot"]
const FIRE_COMBO = ["down", "right", "shoot"]
const ICE_COMBO = ["left", "left", "shoot"]
const ELECTRIC_COMBO = ["up", "down", "shoot"]

func apply_stun(duration: float):
	if state == State.DEAD:
		return

	# already stunned → refresh timer only
	if stunned:
		return

	stunned = true
	action_locked = true
	is_attacking = false
	is_shooting = false
	velocity = Vector2.ZERO

	play_anim("freeze")

	await get_tree().create_timer(duration).timeout

	stunned = false
	action_locked = false

# ---------------- READY ----------------
func _ready():
	
	add_to_group("Fighter")
	spawn_protection = true

	

	spawn_protection = false

	add_to_group("enemy")
	add_to_group("Sonya")
	add_to_group("FireDeath")
	add_to_group("IceDeath")
	add_to_group("ElectricDeath")

	spawn_locked = false

	health = max_health
	health_changed.emit(health)

	play_anim("idle")

	ai_timer = randf_range(0.2, 0.6)

# ---------------- INPUT ----------------
func _unhandled_input(event):

	if is_cpu:
		return

	if event.is_action_pressed("up"):
		register_input("up")

	elif event.is_action_pressed("down"):
		register_input("down")

	elif event.is_action_pressed("left"):
		register_input("left")

	elif event.is_action_pressed("right"):
		register_input("right")

	elif event.is_action_pressed("shoot"):
		register_input("shoot")

# ---------------- PHYSICS ----------------
func _physics_process(delta):

	if stunned:
		velocity = Vector2.ZERO
		move_and_slide()
		return

	shoot_cooldown = max(shoot_cooldown - delta, 0.0)

	combo_timer += delta

	if combo_timer > combo_reset_time:
		combo.clear()

	if is_cpu:
		cpu_logic(delta)
		move_and_slide()
		return

	if state == State.DEAD:
		return

	velocity.y += GRAVITY * delta

	if action_locked:
		return

	var input_dir = Input.get_axis("left", "right")
	var climb_pressed = Input.is_action_pressed("climb")

	# ---------------- FACING ----------------
	if input_dir != 0:
		facing = input_dir

	sprite.flip_h = facing > 0

	$AttackMarker.position = Vector2(63 * facing, -155)
	$SonyaShoot.position = Vector2(63 * facing, -155)
	# ---------------- MOVEMENT ----------------
	velocity.x = input_dir * SPEED

	# ---------------- CLIMB ----------------
	if climb_pressed and not is_on_floor() and is_on_wall():
		state = State.CLIMB

	elif not is_on_floor():
		state = State.JUMP

	elif input_dir != 0:
		state = State.RUN

	else:
		state = State.IDLE

	# ---------------- ANIMS ----------------
	match state:

		State.CLIMB:
			velocity.y = -CLIMB_SPEED

			if not is_attacking:
				play_anim("climb")

		State.JUMP:
			if not is_attacking:
				play_anim("jump")

		State.RUN:
			if not is_attacking:
				play_anim("walk")

		State.IDLE:
			if not is_attacking:
				play_anim("idle")

	# ---------------- JUMP ----------------
	if Input.is_action_just_pressed("jump") and is_on_floor():
		velocity.y = jump_velocity

	# ---------------- ATTACKS ----------------
	if Input.is_action_just_pressed("jumpkick"):
		do_action("jumpkick")

	elif Input.is_action_just_pressed("punch"):
		do_action("punch")

	elif Input.is_action_just_pressed("roundhousekick"):
		do_action("roundhousekick")

	elif Input.is_action_just_pressed("kick"):
		do_action("kick")

	elif Input.is_action_just_pressed("uppercut"):
		do_action("uppercut")

	elif Input.is_action_pressed("shoot"):
		shoot_player()

	elif Input.is_action_just_pressed("shoot"):
		if shoot_cooldown <= 0:
			shoot_player()

	elif Input.is_action_pressed("block"):
		start_block()

	else:
		stop_block()

	move_and_slide()

# ---------------- BLOCK ----------------
func start_block():

	if state == State.DEAD:
		return

	is_blocking = true
	state = State.BLOCK

	play_anim("block")

func stop_block():

	if is_blocking:
		is_blocking = false
		state = State.IDLE

# ---------------- ACID SHOOT ----------------
func shoot_acid():

	if shoot_cooldown > 0:
		return

	shoot_cooldown = shoot_cooldown_time

	is_attacking = true
	action_locked = true

	play_anim("shoot")

	var bullet = REPTILES_ACID.instantiate()

	get_tree().current_scene.add_child(bullet)

	bullet.global_position = $SonyaShoot.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	await get_tree().create_timer(0.25).timeout

	is_attacking = false
	action_locked = false

	play_anim("idle")

# ---------------- CPU ----------------
func cpu_logic(delta):

	# ---------------- HURT PRIORITY ----------------
	if is_hurting:

		velocity.x = knockback_x

	# gradually reduce knockback
		knockback_x = move_toward(knockback_x, 0, 1500 * delta)

		if abs(knockback_x) < 10:
			knockback_x = 0
			is_hurting = false

			velocity.y += GRAVITY * delta
			move_and_slide()
			return


# GRAVITY
	velocity.y += GRAVITY * delta

	var dist = target.global_position.x - global_position.x
	var direction = sign(dist)

	# HARD LOCK (Liu Kang style behavior)
	if action_locked:
		return

# STOP ALL ACTIONS AT 1HP
	if health <= 1:
		is_attacking = false
		action_locked = true
		velocity.x = 0
		return

	if target == null or !is_instance_valid(target):
		velocity.x = 0
		return

	ai_timer -= delta

	velocity.y += GRAVITY * delta
	facing = direction
	sprite.flip_h = facing > 0

# GRAVITY
	velocity.y += GRAVITY * delta


# ---------------- MOVEMENT ----------------
	if is_hurting:

		velocity.x = knockback_x

	# gradually reduce knockback
		knockback_x = move_toward(knockback_x, 0, 1500 * delta)

		if abs(knockback_x) < 10:
			knockback_x = 0
			is_hurting = false

			velocity.y += GRAVITY * delta
			move_and_slide()
			return


	if target == null or !is_instance_valid(target):
		velocity.x = 0
		return


	if abs(dist) > 220:
		velocity.x = direction * SPEED * 0.8
		state = State.RUN
		play_anim("walk")
	else:
		velocity.x = direction * SPEED * 0.8
		state = State.RUN
		play_anim("walk")



	# ---------------- AI ACTIONS ----------------
	if ai_timer <= 0:

		ai_timer = randf_range(0.4, 0.8)

		match randi() % 5:

			0:
				do_action("punch")

			1:
				do_action("kick")

			2:
				do_action("uppercut")

			3:
				do_action("roundhousekick")

			4:
				shoot_player()

# ---------------- ACTION ----------------
func do_action(anim_name: String):
	# can't act if dead
	if state == State.DEAD:
		return

	# prevent spam actions
	if action_locked:
		return

	action_locked = true
	is_attacking = true

	play_anim(anim_name)

	# ---------------- MELEE ATTACKS ----------------
	if anim_name in [
		"punch",
		"kick",
		"uppercut",
		"roundhousekick",
		"jumpkick"
	]:
		# main hitbox system
		spawn_attack(anim_name)

		# OPTIONAL extra projectile/marker attack (only if Sonya uses it)
		if has_node("AttackMarker") and SONYA_ATTACK:
			var attack = SONYA_ATTACK.instantiate()
			get_tree().current_scene.add_child(attack)

			attack.global_position = $AttackMarker.global_position
			attack.scale.x = facing

	# wait for animation to finish
	await sprite.animation_finished

	# reset states safely
	is_attacking = false
	action_locked = false
	hurt_locked = false
# ---------------- ATTACK ----------------
func spawn_attack(anim_name: String):

	if anim_name not in [
		"punch",
		"kick",
		"uppercut",
		"roundhousekick",
		"jumpkick"
	]:
		return

	var attack = SONYA_ATTACK.instantiate()
	get_tree().current_scene.add_child(attack)

	attack.global_position = $AttackMarker.global_position
	attack.scale.x = facing  # THIS replaces facing system

	var dmg := 1

	match anim_name:
		"uppercut":
			dmg = 1
		"roundhousekick":
			dmg = 1

	if attack.has_method("set_damage"):
		attack.set_damage(dmg)
	else:
		attack.damage = dmg

	attack.owner = self

# ---------------- SHOOT ----------------
func shoot_player():
	if is_finish_state:
		return
	if is_shooting:
		return

	is_shooting = true
	is_attacking = true
	action_locked = true

	play_anim("shoot")

	var bullet_scene: PackedScene

	# ---------------- SPECIAL BULLET ----------------
	if special_bullet != null:

		bullet_scene = special_bullet

		# reset after one shot
		special_bullet = null

	else:

		bullet_scene = BULLET_SCENE

	var bullet = bullet_scene.instantiate()

	get_tree().current_scene.add_child(bullet)

	bullet.global_position = shoot_marker.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	await get_tree().create_timer(0.25).timeout

	is_shooting = false

	if is_hurting or state == State.DEAD:
		return

	is_attacking = false
	action_locked = false

	play_anim("idle")

# ---------------- DAMAGE ----------------
func take_damage(amount: int):
	if not can_take_damage:
		return

	can_take_damage = false

	if state == State.DEAD:
		can_take_damage = true
		return

	if spawn_protection:
		can_take_damage = true
		return

	# BLOCK REDUCTION
	if is_blocking:
		amount = max(amount - 1, 0)

	if amount <= 0:
		can_take_damage = true
		return

	health -= amount
	health = max(health, 0)

	print("Sonya took damage: ", amount, " HP=", health)

	health_changed.emit(health)
	hit_sound.play()

	# 💀 DEATH FIRST
	if health <= 0:
		die()
		return

	# ⚠️ FINISH STATE (ONLY ONCE)
	if health == 1 and not is_finish_state:
		trigger_finish_state()

	# 💥 HURT FX ALWAYS WORKS EXCEPT DEAD
	is_hurting = true
	hurt_locked = true
	action_locked = true

	state = State.IDLE
	play_anim("hurt")

	var blood = BLOOD_EFFECT.instantiate()
	get_tree().current_scene.add_child(blood)
	blood.global_position = blood_marker.global_position

	await sprite.animation_finished

	is_hurting = false
	hurt_locked = false
	action_locked = false

	await get_tree().create_timer(0.4).timeout

	can_take_damage = true

	# ⚠️ FINISH HIM
	if health == 0:
		if not is_finish_state:
			trigger_finish_state()
		finish_label.visible = true
	else:
		finish_label.visible = false

func trigger_finish_state():
	if is_finish_state:
		return

	is_finish_state = true

	is_attacking = false
	is_shooting = false
	is_hurting = false

	action_locked = true
	hurt_locked = true

	state = State.IDLE
	velocity = Vector2.ZERO

	finish_label.visible = true

# ---------------- COMBOS ----------------
func register_input(input: String):

	combo.append(input)

	combo_timer = 0.0

	check_combos()

func spawn_fx(scene: PackedScene):

	var fx = scene.instantiate()

	# IMPORTANT: set owner BEFORE it can collide
	fx.owner_character = self
	fx.damage_done = false

	get_tree().current_scene.call_deferred("add_child", fx)

	await get_tree().process_frame

	if target and is_instance_valid(target):
		fx.global_position = target.global_position + Vector2(60 * facing, 0)
	else:
		fx.global_position = global_position + Vector2(80 * facing, 0)

func check_combos():

	# ---------------- ACID ----------------
	if combo == ACID_COMBO:

		combo_used.emit("acid")

		special_bullet = ACID_BULLET

		combo.clear()
		return

	# ---------------- FIRE ----------------
	elif combo == FIRE_COMBO:

		combo_used.emit("fire")

		spawn_fx(FIRE_DEATH)

		special_bullet = FIRE_BULLET

		combo.clear()
		return

	# ---------------- ICE ----------------
	elif combo == ICE_COMBO:

		combo_used.emit("ice")

		spawn_fx(ICE_DEATH)

		special_bullet = ICE_BULLET

		combo.clear()
		return

	# ---------------- ELECTRIC ----------------
	elif combo == ELECTRIC_COMBO:

		combo_used.emit("electric")

		spawn_fx(ELECTRIC_DEATH)

		special_bullet = ELECTRIC_BULLET

		combo.clear()
		return

# ---------------- DEATH ----------------
func die():

	state = State.DEAD

	velocity = Vector2.ZERO

	var death = BLOOD_DEATH.instantiate()

	get_tree().current_scene.add_child(death)

	death.global_position = global_position

	queue_free()

# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):
	if current_anim == anim_name:
		return

	current_anim = anim_name

	sprite.play(anim_name)


# ---------------- HURT BOX ----------------
func _on_sonya_hurt_box_area_entered(area):

	if area == null or !is_instance_valid(area):
		return

	if not can_take_damage:
		return

	# SPEAR
	if area.is_in_group("ReptileSpear"):
		take_damage(1)
		is_hurting = true
		velocity.x = -1200

		await get_tree().create_timer(0.25).timeout

		velocity.x = 0
		is_hurting = false
		return

	# MELEE
	if area.is_in_group("HitBox"):
		take_damage(1)
		is_hurting = true
		velocity.x = -facing * 600

		await get_tree().create_timer(0.25).timeout

		velocity.x = 0
		is_hurting = false
		return

	# BULLET
	if area.is_in_group("ReptileBullet"):
		take_damage(1)

		var dir = sign(global_position.x - area.global_position.x)

		is_hurting = true
		velocity.x = dir * 600

		await get_tree().create_timer(0.25).timeout

		velocity.x = 0
		is_hurting = false
		return

	if area.is_in_group("SubzeroBullet"):
		apply_stun(3.0)
		take_damage(1)
		return

	if area.is_in_group("ReptileAcid"):
		take_damage(1)
		return

	if area.is_in_group("RaidenElectricBullet"):
		take_damage(1)
		return

	if area.is_in_group("ElectricForceField"):
		take_damage(1)
		return

	if area.is_in_group("ElectricBurst"):
		take_damage(1)
		return

	if area.is_in_group("ElectricBullet"):
		take_damage(1)
		return

	if area.is_in_group("ElectricForceHurtBox"):
		take_damage(1)
		return

	if area.is_in_group("KanoBullet"):
		take_damage(1)
		return

	if area.is_in_group("IceBullet"):
		take_damage(1)
		return

	if area.is_in_group("FireBullet"):
		take_damage(1)
		return

	if area.is_in_group("JohnnyCageBullet"):
		take_damage(1)
		return

	if area.is_in_group("SonyaBullet"):
		return
