func _check_pink_combo():
	if input_buffer.size() < 3:
		return

	var last3 = input_buffer.slice(input_buffer.size() - 3, input_buffer.size())

	if last3 == ["left", "down", "right"]:
		input_buffer.clear() # IMPORTANT anti-spam fix
		trigger_pink_death()

func _check_punch_combo():

	if input_buffer.size() < 3:
		return

	var last3 = input_buffer.slice(
		input_buffer.size() - 3,
		input_buffer.size()
	)

	if last3 == ["right", "down", "right"]:

		input_buffer.clear()

		start_punch_combo()

func check_combo():

	# ---------------- FIRE ----------------
	if combo == FIRE_COMBO: 

		combo_used.emit("fire")

		special_bullet = FIRE_BULLET

		combo.clear()

		shoot_player()

		return

	# ---------------- KICK ----------------
	if input_buffer.size() >= 3:
		var last3 = input_buffer.slice(input_buffer.size() - 3, input_buffer.size())

		if last3 == KICK_COMBO:

			input_buffer.clear()

			combo_used.emit("kick_combo")

			start_kick_combo()
			return

	# ---------------- PUNCH ----------------
	if input_buffer.size() >= 3:
		var last3 = input_buffer.slice(input_buffer.size() - 3, input_buffer.size())

		if last3 == PUNCH_COMBO:

			input_buffer.clear()

			combo_used.emit("punch_combo")

			start_punch_combo()
			return

func start_punch_combo():

	if action_locked or is_hurting or state == State.DEAD:
		return

	await combo_attack([
		"punch",
		"lowpunch",
		"punch",
		"uppercut",
		"highpunch",
		"uppercut"
	])

func start_kick_combo():

	if action_locked or is_hurting or state == State.DEAD:
		return

	await combo_attack([
		"kick",
		"knee",
		"highkick",
		"roundhousekick",
		"lowkick",
		"roundhousekick",
		"highkick"
	])

func combo_attack(attacks: Array):

	action_locked = true
	is_attacking = true

	for attack in attacks:

		# STOP COMBO IF HIT
		if is_hurting or state == State.DEAD:
			break

		play_anim(attack)
		spawn_attack(attack)

		await sprite.animation_finished

	is_attacking = false
	action_locked = false

	if not is_hurting:
		play_anim("idle")

# ---------------- HURT BOX ----------------
func _on_sonya_hurt_box_area_entered(area: Area2D) -> void:

	if hurt_cooldown:
		return

	if area == null or not is_instance_valid(area):
		return

	if not can_take_damage:
		return

	if state == State.DEAD:
		return

	# =====================================================
	# ONLY ACCEPT REAL ATTACK GROUPS
	# =====================================================

	if not (
		area.is_in_group("HitBox")
		or area.is_in_group("ReptileAcid")
		or area.is_in_group("Grab")
		or area.is_in_group("RaidenElectricBullet")
		or area.is_in_group("FireBullet")
		or area.is_in_group("Fireball")
		or area.is_in_group("SonyaBullet")
		or area.is_in_group("JohnnyCageBullet")
		or area.is_in_group("KanoBullet")
		or area.is_in_group("IceBullet")
		or area.is_in_group("KanoAttack")
	):
		return

	hurt_cooldown = true

	# =====================================================
	# UPPERCUT
	# =====================================================

	# =====================================================
# UPPERCUT
# =====================================================

	if area.get("attack_name") == "uppercut":

		uppercut_launched = true
		was_uppercut = true

		is_hurting = true
		hurt_locked = true
		action_locked = true

		is_attacking = false
		is_shooting = false
		is_blocking = false

		state = State.JUMP

		# Launch Reptile backwards
		knockback_x = -facing * 100

		velocity.x = knockback_x
		velocity.y = jump_velocity

		current_anim = ""
		sprite.play("wasuppercut")

	if is_instance_valid(hurt_sound):
		hurt_sound.play()

	take_damage(1)

	# Let _physics_process() handle the landing.
	# It will return Reptile to IDLE when he touches the floor.

	hurt_cooldown = false

	return

		# =================================================
		# RETURN TO IDLE
		# =================================================

	if state != State.DEAD:
		uppercut_launched = false
		velocity.x = 0
		velocity.y = 0
		is_hurting = false
		hurt_locked = false
		action_locked = false
		is_attacking = false
		is_shooting = false
		is_blocking = false
		state = State.IDLE
		current_anim = ""
		play_anim("idle")
		await get_tree().create_timer(0.2).timeout
		hurt_cooldown = false
		return

	# =====================================================
	# NORMAL HIT
	# =====================================================

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	knockback_x = -facing * 100
	velocity.x = knockback_x

	current_anim = ""
	sprite.play("hurt")

	if is_instance_valid(hurt_sound):
		hurt_sound.play()

	take_damage(1)

	await get_tree().create_timer(0.2).timeout

	if state != State.DEAD:

		is_hurting = false
		hurt_locked = false
		action_locked = false

		state = State.IDLE
		velocity.x = 0

		current_anim = ""
		play_anim("idle")

	hurt_cooldown = false
