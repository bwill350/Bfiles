var state: State = State.IDLE
var special_bullet: PackedScene = null
var spawn_locked := true
var spawn_protection := false
var special_move_invincible := false
var tap_time := 0.25
var last_tap_time := 0.0
var last_tap_dir := 0
var input_buffer: Array[String] = []
const COMBO_TIME := 0.6

# ---------------- CPU ----------------
var is_cpu := false
var target: Node2D = null
var ai_timer := 0.0
var stunned := false
# ---------------- FLAGS ----------------
var is_blocking := false
var is_hurting := false
var is_shooting := false
var is_attacking := false
var action_locked := false
var hurt_locked := false
var can_take_damage := true
var is_finish_state := false
var lock_timer := 0.0
var hurt_cooldown := false
# ---------------- MOVEMENT ----------------
var facing := 1
var current_anim := ""
var health: int
var knockback_x := 0.0
const GRAVITY = 5000
var special_move := false
var special_move_timer := 0.0
var finish_shown := false
var finish_cooldown := 0.0
var last_hit_id := -1
var run_locked := false
var cannonkick_active := false
var cannonkick_timer := 0.0
var electricfly_active := false
var jump_requested := false

@onready var finish_label: Sprite2D = $HUD/FinishLabel/Sprite2D
var speed
var shoot_cooldown := 0.0

# ---------------- EXPORTS ----------------
@export var SPEED = 300.0
@export var CLIMB_SPEED = 250.0
@export var jump_velocity = -1800.0
@export var max_health: int = 10
@export var shoot_cooldown_time := 0.01
@export var combo_reset_time := 0.6

# ---------------- PRELOADS ----------------
const PINK_DEATH_SCENE = preload("res://PinkDeath.tscn")
const BULLET_SCENE = preload("res://Projectiles/SonyaBullet.tscn")
const SONYA_BULLET = preload("res://Projectiles/SonyaBullet.tscn")

const SONYA_ATTACK = preload("res://Projectiles/SonyaAttack.tscn")

const BLOOD_EFFECT = preload("res://GreenBloodEffect.tscn")

# ---------------- DEATH FX ----------------
const BLOOD_DEATH = preload("res://Deaths/BloodDeath.tscn")
const FIRE_DEATH_SCENE = preload("res://Deaths/FireDeath.tscn")
const ICE_DEATH = preload("res://Deaths/IceDeath.tscn")
const ELECTRIC_DEATH = preload("res://Deaths/ElectricDeath.tscn")
const PUNCH_COMBO = ["right", "down", "right"]
var combo := []
var combo_timer := 0.0


# ---------------- NODES ----------------
@onready var sprite: AnimatedSprite2D = $Sprite
@onready var hit_sound: AudioStreamPlayer2D = $Hit
@onready var hurt_sound: AudioStreamPlayer2D = $Hurt
@onready var hit_box: Area2D = $SonyaHurtBox
@onready var shoot_marker: Marker2D = $SonyaShoot
@onready var attack_marker: Marker2D = $AttackMarker
@onready var blood_marker: Marker2D = $BloodMarker
# ---------------- COMBOS ----------------


func _process(delta):
	combo_timer -= delta

	if combo_timer <= 0:
		input_buffer.clear()

	if Input.is_action_just_pressed("left"):
		_register_input("L")

	if Input.is_action_just_pressed("down"):
		_register_input("D")

	if Input.is_action_just_pressed("right"):
		_register_input("R")

	_check_punch_combo()
	_check_pink_combo()
	_check_fire_combo()

func _register_input(i: String):
	if combo_timer <= 0:
		input_buffer.clear()

	input_buffer.append(i)
	combo_timer = COMBO_TIME

func apply_stun(_duration := 4.0):

	if state == State.DEAD:
		return

	stunned = true

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	velocity = Vector2.ZERO
	knockback_x = 0

	play_anim("idle")

	await get_tree().create_timer(4.0).timeout

	stunned = false

	is_hurting = false
	hurt_locked = false
	action_locked = false

func run(input_dir: float):
	if input_dir == 0:
		return

	state = State.RUN
	velocity.x = input_dir * SPEED * 4  # faster than walk

	if not is_attacking:
		play_anim("run")

# ---------------- READY ----------------
func _ready():

	$Sprite.visible = true
	$Crispy.visible = false

	add_to_group("Fighter")
	add_to_group("enemy")
	add_to_group("Sonya")

	spawn_locked = false

	health = max_health
	health_changed.emit(health)

	play_anim("idle")

	ai_timer = randf_range(0.2, 0.6)

	facing = 1
	sprite.flip_h = -facing < 0

# ---------------- INPUT ----------------
func _physics_process(delta):

	if state == State.DEAD:
		return

	# ---------------- STUN ----------------
	if stunned:
		velocity = Vector2.ZERO
		return

	# ---------------- DEATH / FINISH ----------------
	if state == State.DEAD:
		return

	if is_finish_state:
		state = State.IDLE
		velocity.x = 0
		if not is_hurting:
			play_anim("idle")
		return

	# ---------------- GRAVITY ----------------
	velocity.y += GRAVITY * delta

	# ---------------- COOLDOWNS ----------------
	shoot_cooldown = max(shoot_cooldown - delta, 0.0)

	combo_timer += delta
	if combo_timer > combo_reset_time:
		combo.clear()

	# ---------------- CPU ----------------
	if is_cpu:
		cpu_logic(delta)
		move_and_slide()
		return

	if state == State.DEAD:
		return

	if is_finish_state:
		state = State.IDLE
		velocity.x = 0

		if not is_hurting:
			play_anim("idle")

		move_and_slide()
		return

	if action_locked:
		return

	var input_dir = Input.get_axis("left", "right")
	var climb_pressed = Input.is_action_pressed("climb")

	# ---------------- FACING ----------------
	if input_dir != 0:
		facing = input_dir

	sprite.flip_h = facing > 0

	$AttackMarker.position = Vector2(63 * facing, -155)
	$SonyaShoot.position = Vector2(63 * facing, -155)

	# =========================================================
	# 🟢 MOVEMENT (RUN ADDED HERE)
	# =========================================================
	if Input.is_action_pressed("run") and input_dir != 0:
		run(input_dir)   # 🔥 CALLS YOUR NEW RUN FUNCTION
	else:
		velocity.x = input_dir * SPEED

		# ---------------- STATE ----------------
		if not is_on_floor():
			state = State.JUMP
		elif input_dir != 0:
			state = State.WALK
		elif input_dir != 0:
			state = State.RUN
		else:
			state = State.IDLE

	# ---------------- ANIMS ----------------
	match state:

		State.CLIMB:
			velocity.y = -CLIMB_SPEED
			if not is_attacking:
				play_anim("idle")

		State.JUMP:
			if not is_attacking:
				play_anim("jump")

		State.WALK:
			if not is_attacking:
				play_anim("walk")

		State.RUN:
			if not is_attacking:
				play_anim("run")

		State.IDLE:
			if not is_attacking:
				play_anim("idle")

	if is_hurting and hurt_locked:
		return

	# ---------------- JUMP ----------------
	if Input.is_action_just_pressed("jump") and is_on_floor():
		velocity.y = jump_velocity

	move_and_slide()

	# =====================================================
	# ATTACKS
	# =====================================================

	if Input.is_action_just_pressed("punch"):
		do_action("punch")

	elif Input.is_action_just_pressed("kick"):
		do_action("kick")

	elif Input.is_action_just_pressed("uppercut"):
		do_action("uppercut")

	elif Input.is_action_just_pressed("roundhousekick"):
		do_action("roundhousekick")

	elif Input.is_action_just_pressed("shoot"):
		do_action("shoot")
		var bullet = SONYA_BULLET.instantiate()
		get_tree().current_scene.add_child(bullet)

		bullet.global_position = $SonyaShoot.global_position
		bullet.velocity = Vector2(facing, 0) * bullet.speed

	move_and_slide()

func cpu_logic(delta):
	# ---------------- HURT PRIORITY ----------------
	if is_hurting:

		if is_spear_pulled:
				velocity.x = -facing * -600
		else:
			velocity.x = -facing * 100

	# gradually reduce knockback
		knockback_x = move_toward(knockback_x, 0, 1500 * delta)

		if abs(knockback_x) < 10:
			knockback_x = 0
			is_hurting = false

			velocity.y += GRAVITY * delta
			move_and_slide()
			return

	if target == null or !is_instance_valid(target):
		velocity.x = 0
		return

# GRAVITY
	velocity.y += GRAVITY * delta

	var dist = target.global_position.x - global_position.x
	var direction = sign(dist)

	# HARD LOCK (Liu Kang style behavior)
	if action_locked:
		return

# STOP ALL ACTIONS AT 1HP
	if is_finish_state:
		is_attacking = false
		action_locked = true
		velocity.x = 0
		move_and_slide()
		return

	ai_timer -= delta

	velocity.y += GRAVITY * delta
	facing = direction
	sprite.flip_h = facing > 0

# GRAVITY
	velocity.y += GRAVITY * delta

# ---------------- MOVEMENT ----------------
	if abs(dist) > 220:

		velocity.x = direction * SPEED * 0.8

	if state != State.RUN:
		state = State.RUN

	if not is_attacking:
		play_anim("walk")

	if abs(dist) > 220:
		velocity.x = direction * SPEED * 0.8
		state = State.RUN
		play_anim("walk")
	else:
		velocity.x = direction * SPEED * 0.8
		state = State.RUN
		play_anim("walk")

# ---------------- AI ACTIONS ----------------
	if ai_timer <= 0:

		match Game.difficulty:

			"Hard":

				# Very fast reactions
				ai_timer = randf_range(0.05, 0.15)

				var choice = randi() % 100

				if choice < 20:
					do_action("punch")
				elif choice < 40:
					do_action("kick")
				elif choice < 65:
					do_action("uppercut")
				elif choice < 80:
					do_action("roundhousekick")
				else:
					shoot_player()

			"Easy":

				ai_timer = randf_range(0.5, 0.9)

				var choice = randi() % 100

				if choice < 40:
					do_action("punch")
				elif choice < 70:
					do_action("kick")
				elif choice < 85:
					do_action("uppercut")
				else:
					do_action("roundhousekick")

# ---------------- SHOOT ----------------
func shoot_player():

	if health <= 1:
		return

	if is_finish_state:
		return

	if is_shooting:
		return

	is_shooting = true
	is_attacking = true
	action_locked = true

	play_anim("shoot")

	var bullet_scene: PackedScene = SONYA_BULLET

	if special_bullet != null:
		bullet_scene = special_bullet
		special_bullet = null

	var bullet = bullet_scene.instantiate()
	get_tree().current_scene.add_child(bullet)

	await get_tree().process_frame

	bullet.global_position = $SonyaShoot.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	await get_tree().create_timer(0.25).timeout

	is_shooting = false
	is_attacking = false
	action_locked = false

# ---------------- BURST ----------------
func spawn_burst():

	var burst = SONYA_BULLET.instantiate()

	get_tree().current_scene.add_child(burst)

	burst.global_position = attack_marker.global_position

# ---------------- ACTION ----------------
func do_action(anim_name: String):

	if is_attacking:
		return

	if health <= 1:
		return

	if is_finish_state:
		return

	if state == State.DEAD:
		return

	if action_locked:
		return

	action_locked = true
	is_attacking = true
	lock_timer = 0.6

	play_anim(anim_name)

	if anim_name in [
		"punch",
		"kick",
		"uppercut",
		"roundhousekick"
	]:
		spawn_attack(anim_name)

	await sprite.animation_finished

	is_attacking = false
	action_locked = false
	hurt_locked = false

	play_anim("idle")

# ---------------- ATTACK ----------------
func spawn_attack(anim_name: String):

	if anim_name not in [
		"punch",
		"kick",
		"uppercut",
		"roundhousekick"
	]:
		return

	var attack = SONYA_ATTACK.instantiate()
	get_tree().current_scene.add_child(attack)

	attack.global_position = $AttackMarker.global_position
	attack.scale.x = facing  # THIS replaces facing system

	var dmg := 1

	match anim_name:
		"punch":
			dmg = 1
		"kick":
			dmg = 1
		"uppercut":
			dmg = 1
		"roundhousekick":
			dmg = 1

	if attack.has_method("set_damage"):
		attack.set_damage(dmg)
	else:
		attack.damage = dmg

	attack.owner = self

# ---------------- DAMAGE ----------------
func take_damage(amount: int):

	if not can_take_damage:
		return

	can_take_damage = false

	await get_tree().create_timer(0.25).timeout

	can_take_damage = true

	if state == State.DEAD:
		return

	if spawn_protection:
		return

	# BLOCK REDUCTION
	if is_blocking:
		amount = max(amount - 1, 0)

	if amount <= 0:
		return

	health -= amount
	health = max(health, 0)

	print("Sonya took damage: ", amount, " HP=", health)

	health_changed.emit(health)
	hit_sound.play()

# ---------------- FINISH HIM ----------------
	if health == 1 and not is_finish_state:
		trigger_finish_state()
		return

	# ---------------- FINAL HIT ----------------
	if health <= 0:

		finish_label.visible = false
		die()
		await get_tree().create_timer(0.5).timeout

		get_tree().change_scene_to_file("res://Scenes/MainMenu.tscn")
		return

	# ---------------- NORMAL HURT ----------------
	is_hurting = true
	hurt_locked = true
	action_locked = true

	state = State.IDLE

	play_anim("hurt")

	var blood = BLOOD_EFFECT.instantiate()
	get_tree().current_scene.add_child(blood)
	blood.global_position = $BloodMarker.global_position

	await get_tree().create_timer(0.25).timeout

	is_hurting = false
	hurt_locked = false
	action_locked = false

func trigger_finish_state():

	if is_finish_state:
		return

	is_finish_state = true

	state = State.IDLE
	velocity = Vector2.ZERO

	action_locked = true
	hurt_locked = false
	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

	play_anim("idle")

	finish_label.visible = true

	if finish_label.has_method("start_flicker"):
		finish_label.start_flicker(2.0, 0.05)
		die()
	await get_tree().create_timer(2.0).timeout

	if is_instance_valid(finish_label):
		finish_label.visible = false

	state = State.IDLE
	velocity = Vector2.ZERO

	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

# ---------------- DEATH ----------------
func die():

	if state == State.DEAD:
		return

	state = State.DEAD

	var death = BLOOD_DEATH.instantiate()
	get_tree().current_scene.add_child(death)
	death.global_position = global_position

	velocity = Vector2.ZERO

	is_attacking = false
	is_shooting = false
	is_hurting = false

	action_locked = true
	hurt_locked = true

	$Sprite.visible = false
	$Crispy.visible = true

	await get_tree().create_timer(1.5).timeout

	get_tree().change_scene_to_file("res://Scenes/MainMenu.tscn")

# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):

	if current_anim == anim_name:
		return

	current_anim = anim_name
	sprite.play(anim_name)

func spawn_fx(scene: PackedScene):
	if scene == null:
		return

	var fx = scene.instantiate()
	get_tree().current_scene.add_child(fx)

	await get_tree().process_frame

	fx.global_position = global_position + Vector2(80 * facing, 0)

func trigger_pink_death():
	if target == null or !is_instance_valid(target):
		return

	var pink = preload("res://PinkDeath.tscn").instantiate()
	get_tree().current_scene.add_child(pink)

	pink.global_position = target.global_position
	pink.owner_character = self

func trigger_fire_death():
	if target == null or !is_instance_valid(target):
		return

	var fire = preload("res://Deaths/FireDeath.tscn").instantiate()
	get_tree().current_scene.add_child(fire)

	fire.global_position = target.global_position
	fire.owner_character = self

func _check_pink_combo():
	if input_buffer.size() < 3:
		return

	var last3 = input_buffer.slice(input_buffer.size() - 3, input_buffer.size())

	if last3 == ["L", "D", "R"]:
		input_buffer.clear() # IMPORTANT anti-spam fix
		trigger_pink_death()

func _check_fire_combo():
	if input_buffer.size() < 3:
		return

	var last3 = input_buffer.slice(input_buffer.size() - 3, input_buffer.size())

	if last3 == ["L", "L", "R"]:
		input_buffer.clear() # IMPORTANT anti-spam fix
		trigger_fire_death()

func _check_punch_combo():

	if input_buffer.size() < 3:
		return

	var last3 = input_buffer.slice(
		input_buffer.size() - 3,
		input_buffer.size()
	)

	if last3 == ["R", "D", "R"]:

		input_buffer.clear()

		start_punch_combo()

func _check_combo():
	if combo == PUNCH_COMBO:

		combo_used.emit("punch_combo")

		combo.clear()

		start_punch_combo()


func start_punch_combo():

	if action_locked:
		return

	await combo_attack([
		"punch",
		"kick",
		"punch",
		"roundhousekick",
		"uppercut"
	])

func combo_attack(attacks: Array):

	action_locked = true
	is_attacking = true

	for attack in attacks:

		play_anim(attack)
		spawn_attack(attack)

		await sprite.animation_finished

	is_attacking = false
	action_locked = false

# ---------------- HURT BOX ----------------
func _on_sonya_hurt_box_area_entered(area: Area2D) -> void:

	if hurt_cooldown:
		return

	if area == null or !is_instance_valid(area):
		return

	if area.is_in_group("HurtBox"):
		return

		$Hurt.play()

	# ---------------- SPEAR PRIORITY ----------------
	if area.is_in_group("ReptileSpear"):
		hurt_cooldown = true
		knockback_x = -facing * -600
		health -= 1
		health_changed.emit(health)

		is_spear_pulled = true
		is_hurting = true
		action_locked = true

		await get_tree().create_timer(0.8).timeout

		is_spear_pulled = false
		is_hurting = false
		action_locked = false
		hurt_cooldown = false
		return

	if not can_take_damage:
		return

	if area.is_in_group("HitBox") \
		or area.is_in_group("ReptileAcid") \
		or area.is_in_group("RaidenElectricBullet") \
		or area.is_in_group("FireBullet") \
		or area.is_in_group("Fireball") \
		or area.is_in_group("SonyaBullet") \
		or area.is_in_group("JohnnyCageBullet") \
		or area.is_in_group("KanoBullet") \
		or area.is_in_group("IceBullet") \
		or area.is_in_group("KanoAttack"):

		hurt_cooldown = true

		knockback_x = -facing * 100
		take_damage(1)

		await get_tree().create_timer(0.15).timeout
		hurt_cooldown = false
