func _unhandled_input(event):

	var inputs = ["up", "down", "left", "right", "shoot"]

	for i in inputs:
		if event.is_action_pressed(i):
			register_input(i)

	_check_punch_combo()
	_check_pink_combo()
	_check_fire_combo()

func spawn_fire_bullet():

	play_anim("shoot")

	var bullet = FIRE_BULLET.instantiate()
	get_tree().current_scene.add_child(bullet)

	bullet.global_position = $SonyaShoot.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

func apply_stun(_duration := 4.0):

	if state == State.DEAD:
		return

	stunned = true

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	velocity = Vector2.ZERO
	knockback_x = 0

	play_anim("idle")

	await get_tree().create_timer(4.0).timeout

	stunned = false

	is_hurting = false
	hurt_locked = false
	action_locked = false

func run(input_dir: float):
	if input_dir == 0:
		return

	state = State.RUN
	velocity.x = input_dir * SPEED * 2.5  # faster than walk

	if not is_attacking:
		play_anim("walk")

# ---------------- READY ----------------
func _ready():
	$Sprite.visible = true
	$Crispy.visible = false

	add_to_group("Fighter")
	add_to_group("enemy")
	add_to_group("Sonya")

	spawn_locked = false

	health = max_health
	health_changed.emit(health)

	play_anim("idle")

	ai_timer = randf_range(0.2, 0.6)

	facing = 1
	sprite.flip_h = -facing < 0

# ---------------- INPUT ----------------
func _physics_process(delta):

	if state == State.DEAD:
		return

	if is_pulled:
		run_pull_logic(delta)
		move_and_slide()
		return

	# ---------------- STUN ----------------
	if stunned:
		velocity = Vector2.ZERO
		return

	# ---------------- DEATH / FINISH ----------------
	if state == State.DEAD:
		return

	if is_finish_state:
		state = State.IDLE
		velocity.x = 0
		if not is_hurting:
			play_anim("idle")
		return

	# ---------------- GRAVITY ----------------
	velocity.y += GRAVITY * delta

	if uppercut_launched:

		move_and_slide()

		if is_on_floor():
			uppercut_launched = false

		return

	# ---------------- COOLDOWNS ----------------
	shoot_cooldown = max(shoot_cooldown - delta, 0.0)

	combo_timer += delta
	if combo_timer > combo_reset_time:
		combo.clear()

	# ---------------- CPU ----------------
	if is_cpu:
		cpu_logic(delta)
		move_and_slide()
		return

	if state == State.DEAD:
		return

	if is_finish_state:
		state = State.IDLE
		velocity.x = 0

		if not is_hurting:
			play_anim("idle")

		move_and_slide()
		return

	if action_locked:
		return

	var input_dir = Input.get_axis("left", "right")
	var climb_pressed = Input.is_action_pressed("climb")

	# ---------------- FACING ----------------
	if input_dir != 0:
		facing = input_dir

	sprite.flip_h = facing > 0

	$AttackMarker.position = Vector2(63 * facing, -155)
	$SonyaShoot.position = Vector2(63 * facing, -225)

	# =========================================================
	# 🟢 MOVEMENT (RUN ADDED HERE)
	# =========================================================
	if Input.is_action_pressed("run") and input_dir != 0:
		run(input_dir)   # 🔥 CALLS YOUR NEW RUN FUNCTION
	else:
		velocity.x = input_dir * SPEED

		# ---------------- STATE ----------------
		if not is_on_floor():
			state = State.JUMP
		elif input_dir != 0:
			state = State.WALK
		elif input_dir != 0:
			state = State.RUN
		else:
			state = State.IDLE

	# ---------------- ANIMS ----------------
	match state:

		State.CLIMB:
			velocity.y = -CLIMB_SPEED
			if not is_attacking:
				play_anim("idle")

		State.JUMP:
			if not is_attacking:
				play_anim("jump")

		State.WALK:
			if not is_attacking:
				play_anim("walk")

		State.RUN:
			if not is_attacking:
				play_anim("run")

		State.IDLE:
			if not is_attacking:
				play_anim("idle")

	if is_hurting and hurt_locked:
		return

	# ---------------- JUMP ----------------
	if Input.is_action_just_pressed("jump") and is_on_floor():
		velocity.y = jump_velocity

	# =====================================================
	# ATTACKS
	# =====================================================

	if Input.is_action_just_pressed("punch"):
		do_action("punch")

	if Input.is_action_just_pressed("highpunch"):
		do_action("highpunch")

	if Input.is_action_just_pressed("lowpunch"):
		do_action("lowpunch")

	elif Input.is_action_just_pressed("kick"):
		do_action("kick")

	elif Input.is_action_just_pressed("highkick"):
		do_action("highkick")

	elif Input.is_action_just_pressed("lowkick"):
		do_action("lowkick")

	elif Input.is_action_just_pressed("uppercut"):
		do_action("uppercut")

	elif Input.is_action_just_pressed("roundhousekick"):
		do_action("roundhousekick")

	elif Input.is_action_just_pressed("shoot"):
		do_action("shoot")
		var bullet = SONYA_BULLET.instantiate()
		get_tree().current_scene.add_child(bullet)

		bullet.global_position = $SonyaShoot.global_position
		bullet.velocity = Vector2(facing, 0) * bullet.speed

	move_and_slide()

func spear_pulled_to_p1():
	print("START PULL")

	is_pulled = true
	stunned = true
	action_locked = true
	is_hurting = true

	pull_timer = 0.35

	pull_target = get_tree().get_first_node_in_group("Reptile")

func run_pull_logic(delta):
	print("Running pull logic")
	if pull_target == null or !is_instance_valid(pull_target):
		is_pulled = false
		stunned = false
		action_locked = false
		return

	var dir = sign(pull_target.global_position.x - global_position.x)

	velocity.x = dir * 900
	velocity.y = -120

	pull_timer -= delta

	if pull_timer <= 0.0:

		is_pulled = false

		# SNAP to Reptile AttackMarker (THIS IS MK MOMENT)
		global_position = pull_target.attack_marker.global_position + Vector2(40 * pull_target.facing, 0)

		stunned = false
		is_hurting = false
		action_locked = false
		is_attacking = true

		pull_target = null

func cpu_logic(delta):
	# ---------------- HURT PRIORITY ----------------
	if is_hurting:

		if is_spear_pulled:
				velocity.x = -facing * -600
		else:
			velocity.x = -facing * 100

	# gradually reduce knockback
		knockback_x = move_toward(knockback_x, 0, 1500 * delta)

		if abs(knockback_x) < 10:
			knockback_x = 0
			is_hurting = false

			velocity.y += GRAVITY * delta
			move_and_slide()
			return

	if target == null or !is_instance_valid(target):
		velocity.x = 0
		return

	var dist = target.global_position.x - global_position.x
	var direction = sign(dist)

	# HARD LOCK (Liu Kang style behavior)
	if action_locked:
		return

# STOP ALL ACTIONS AT 1HP
	if is_finish_state:
		is_attacking = false
		action_locked = true
		velocity.x = 0
		move_and_slide()
		return

	ai_timer -= delta

	velocity.y += GRAVITY * delta
	facing = direction
	sprite.flip_h = facing > 0

# ---------------- MOVEMENT ----------------
	if abs(dist) > 220:

		velocity.x = direction * SPEED * 0.8

	if state != State.RUN:
		state = State.RUN

	if not is_attacking:
		play_anim("walk")

	if abs(dist) > 220:
		velocity.x = direction * SPEED * 0.8
		state = State.RUN
		play_anim("walk")
	else:
		velocity.x = direction * SPEED * 0.8
		state = State.RUN
		play_anim("walk")

# ---------------- AI ACTIONS ----------------
	if ai_timer <= 0:

		match Game.difficulty:

			"Hard":

				# Very fast reactions
				ai_timer = randf_range(0.05, 0.15)

				var choice = randi() % 100

				if choice < 20:
					do_action("punch")
				elif choice < 40:
					do_action("kick")
				elif choice < 65:
					do_action("uppercut")
				elif choice < 80:
					do_action("roundhousekick")
				else:
					shoot_player()

			"Easy":

				ai_timer = randf_range(0.5, 0.9)

				var choice = randi() % 100

				if choice < 40:
					do_action("punch")
				elif choice < 70:
					do_action("kick")
				elif choice < 85:
					do_action("uppercut")
				else:
					do_action("roundhousekick")

# ---------------- SHOOT ----------------
func shoot_player():

	if health <= 1:
		return

	if is_finish_state:
		return

	if is_shooting:
		return

	is_shooting = true
	is_attacking = true
	action_locked = true

	play_anim("shoot")

	var bullet_scene: PackedScene = SONYA_BULLET

	if special_bullet != null:
		bullet_scene = special_bullet
		special_bullet = null

	var bullet = bullet_scene.instantiate()
	get_tree().current_scene.add_child(bullet)

	await get_tree().process_frame

	bullet.global_position = $SonyaShoot.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	await get_tree().create_timer(0.25).timeout

	is_shooting = false
	is_attacking = false
	action_locked = false

# ---------------- BURST ----------------
func spawn_burst():

	var burst = SONYA_BULLET.instantiate()

	get_tree().current_scene.add_child(burst)

	burst.global_position = attack_marker.global_position

# ---------------- ACTION ----------------
func do_action(anim_name: String):

	if is_attacking:
		return

	if health <= 1:
		return

	if is_finish_state:
		return

	if state == State.DEAD:
		return

	if action_locked:
		return

	action_locked = true
	is_attacking = true
	lock_timer = 0.6

	play_anim(anim_name)

	if anim_name in [
		"punch",
		"highpunch",
		"lowpunch",
		"kick",
		"highkick",
		"lowkick",
		"uppercut",
		"roundhousekick",
		"knee"
	]:
		spawn_attack(anim_name)

	await sprite.animation_finished

	is_attacking = false
	action_locked = false
	hurt_locked = false

	play_anim("idle")

# ---------------- ATTACK ----------------
func spawn_attack(anim_name: String):

	if anim_name not in [
		"punch",
		"highpunch",
		"lowpunch",
		"kick",
		"highkick",
		"lowkick",
		"uppercut",
		"roundhousekick",
		"knee"
	]:
		return


	var attack = SONYA_ATTACK.instantiate()

	get_tree().current_scene.add_child(attack)

	attack.add_to_group("HitBox")

	attack.global_position = attack_marker.global_position
	attack.scale.x = facing  # THIS replaces facing system


	var dmg := 1


	match anim_name:
		"punch":
			dmg = 1
		"kick":
			dmg = 1
		"lowkick":
			dmg = 1
		"uppercut":
			dmg = 1
		"roundhousekick":
			dmg = 1


	if attack.has_method("set_damage"):
		attack.set_damage(dmg)
	else:
		attack.damage = dmg


	# UPPERCUT KNOCKBACK SYSTEM
	attack.owner = self
	attack.attack_owner = self
	attack.attack_name = anim_name
	attack.attack_type = anim_name

# ---------------- DAMAGE ----------------
func take_damage(amount: int):

	if not can_take_damage:
		return

	can_take_damage = false

	await get_tree().create_timer(0.2).timeout

	can_take_damage = true

	if state == State.DEAD:
		return

	if spawn_protection:
		return

	# BLOCK REDUCTION
	if is_blocking:
		amount = max(amount - 1, 0)

	if amount <= 0:
		return

	health -= amount
	health = max(health, 0)

	print("Sonya took damage: ", amount, " HP=", health)

	health_changed.emit(health)
	hit_sound.play()

# ---------------- FINISH HIM ----------------
	if health == 1 and not is_finish_state:
		trigger_finish_state()
		return

	# ---------------- FINAL HIT ----------------
	if health <= 0:

		finish_label.visible = false
		die()
		await get_tree().create_timer(0.2).timeout

		return

	# ---------------- NORMAL HURT ----------------
	is_hurting = true
	hurt_locked = true
	action_locked = true

	state = State.IDLE

	play_anim("hurt")

	var blood = BLOOD_EFFECT.instantiate()
	get_tree().current_scene.add_child(blood)
	blood.global_position = $BloodMarker.global_position

	await get_tree().create_timer(0.2).timeout

	is_hurting = false
	hurt_locked = false
	action_locked = false

func trigger_finish_state():

	if is_finish_state:
		return

	is_finish_state = true

	state = State.IDLE

	# force them to fall back down
	velocity.x = 0
	velocity.y = 0

	action_locked = true
	hurt_locked = false
	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

	# cancel any uppercut/fly state
	set_meta("uppercut_launched", false)

	play_anim("idle")

	finish_label.visible = true

	if finish_label.has_method("start_flicker"):
		finish_label.start_flicker(2.0, 0.05)

	# let gravity work
	await get_tree().create_timer(0.1).timeout

	while not is_on_floor():
		velocity.y += 5000.0 * get_physics_process_delta_time()
		move_and_slide()
		await get_tree().physics_frame

	velocity = Vector2.ZERO

	await get_tree().create_timer(2.0).timeout

	if is_instance_valid(finish_label):
		finish_label.visible = false

# ---------------- DEATH ----------------
func die():

	if state == State.DEAD:
		return

	state = State.DEAD

	var death = BLOOD_DEATH.instantiate()
	get_tree().current_scene.add_child(death)
	death.global_position = global_position

	velocity = Vector2.ZERO

	is_attacking = false
	is_shooting = false
	is_hurting = false

	action_locked = true
	hurt_locked = true

	$Sprite.visible = false
	$Crispy.visible = true

	await get_tree().create_timer(4.5).timeout

	get_tree().change_scene_to_file("res://Scenes/MainMenu.tscn")

# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):

	if current_anim == anim_name:
		return

	current_anim = anim_name
	sprite.play(anim_name)

# ---------------- COMBOS ----------------
func register_input(input: String):

	if combo_timer <= 0:
		input_buffer.clear()

	input_buffer.append(input)
	combo_timer = COMBO_TIME

	check_combo()

func spawn_fx(scene: PackedScene):
	if scene == null:
