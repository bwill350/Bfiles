# =========================================================

func get_last_inputs(count: int) -> Array:

	if input_buffer.size() < count:
		return []

	return input_buffer.slice(
		input_buffer.size() - count,
		input_buffer.size()
	)


# =========================================================
# CHECK PINK COMBO
# LEFT DOWN RIGHT
# =========================================================

func _check_pink_combo():

	if input_buffer.size() < 3:
		return

	var last3 = get_last_inputs(3)

	if last3 == [
		"left",
		"down",
		"right"
	]:

		input_buffer.clear()
		combo.clear()
		combo_timer = 0.0

		combo_used.emit("pink_death")

		trigger_pink_death()


# =========================================================
