# =========================================================
# SPAWN FX
# =========================================================

func spawn_fx(scene: PackedScene):

	if scene == null:
		return

	var fx = scene.instantiate()

	if fx == null:
		return

	fx.owner_character = self
	fx.damage_done = false

	get_tree().current_scene.call_deferred(
		"add_child",
		fx
	)

	if is_instance_valid(fatality_sound):
		fatality_sound.play()

	await get_tree().process_frame

	if not is_instance_valid(fx):
		return

	var victim = null

	for fighter in get_tree().get_nodes_in_group("Fighter"):

		if fighter == self:
			continue

		if not is_instance_valid(fighter):
			continue

		if fighter is Node2D:
			victim = fighter
			break

	if victim != null:

		fx.global_position = (
			victim.global_position +
			Vector2(
				60 * facing,
				0
			)
		)

	else:

		fx.global_position = (
			global_position +
			Vector2(
				80 * facing,
				0
			)
		)


