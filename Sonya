func _check_punch_combo():

	if input_buffer.size() < 3:
		return

	var last3 = get_last_inputs(3)

	if last3 == [
		"right",
		"down",
		"right"
	]:

		input_buffer.clear()
		combo.clear()
		combo_timer = 0.0

		combo_used.emit("punch_combo")

		start_punch_combo()


# =========================================================
# MAIN COMBO CHECK
# =========================================================

func check_combo():

	# ---------------------------------------------------------
	# DO NOT ACCEPT COMBOS FROM CPU
	# ---------------------------------------------------------

	if is_cpu:
		return

	if not is_in_group("player1"):
		return

	if state == State.DEAD:
		return

	if is_finish_state:
		return

	# ---------------------------------------------------------
	# FIRE
	# DOWN UP
	# ---------------------------------------------------------

	if input_buffer.size() >= 2:

		var last2 = get_last_inputs(2)

		if last2 == FIRE_COMBO:

			input_buffer.clear()
			combo.clear()
			combo_timer = 0.0

			combo_used.emit("fire")

			special_bullet = FIRE_BULLET

			# -------------------------------------------------
			# FIRE ANIMATION
			# -------------------------------------------------

			if has_node("firedeath"):

				$firedeath.visible = true
				$firedeath.play("fire")

			$Sprite.visible = false

			# -------------------------------------------------
			# SHOOT FIRE BULLET
			# -------------------------------------------------

			shoot_player()

			return


	# ---------------------------------------------------------
	# ICE
	# UP DOWN
	# ---------------------------------------------------------

	if input_buffer.size() >= 2:

		var last2_ice = get_last_inputs(2)

		if last2_ice == ICE_COMBO:

			input_buffer.clear()
			combo.clear()
			combo_timer = 0.0

			combo_used.emit("ice")

			# Use special bullet if assigned.
			# Otherwise do nothing.
			if special_bullet != null:

				shoot_player()

			return


	# ---------------------------------------------------------
	# KICK COMBO
	# RIGHT DOWN DOWN
	# ---------------------------------------------------------

	if input_buffer.size() >= 3:

		var last3_kick = get_last_inputs(3)

		if last3_kick == KICK_COMBO:

			input_buffer.clear()
			combo.clear()
			combo_timer = 0.0

			combo_used.emit("kick_combo")

			start_kick_combo()

			return


	# ---------------------------------------------------------
	# ELECTRIC COMBO
	# UP DOWN RIGHT
	# ---------------------------------------------------------

	if input_buffer.size() >= 3:

		var last3_electric = get_last_inputs(3)

		if last3_electric == ELECTRIC_COMBO:

			input_buffer.clear()
			combo.clear()
			combo_timer = 0.0

			combo_used.emit("electric")

			# Sonya does not have an electric attack scene,
			# so only execute this if a special bullet exists.

			if special_bullet != null:

				shoot_player()

			return


	# ---------------------------------------------------------
	# PUNCH COMBO
	# RIGHT DOWN RIGHT
	# ---------------------------------------------------------

	if input_buffer.size() >= 3:

		var last3_punch = get_last_inputs(3)

		if last3_punch == PUNCH_COMBO:

			input_buffer.clear()
			combo.clear()
			combo_timer = 0.0

			combo_used.emit("punch_combo")

			start_punch_combo()

			return


	# ---------------------------------------------------------
	# FATALITY
	# DOWN RIGHT UP
	# ---------------------------------------------------------

	if input_buffer.size() >= 3:

		var last3_fatality = get_last_inputs(3)

		if last3_fatality == FATALITY_COMBO:

			input_buffer.clear()
			combo.clear()
			combo_timer = 0.0

			# -------------------------------------------------
			# FATALITY ONLY WHEN FINISH HIM IS ACTIVE
			# -------------------------------------------------

			if is_finish_state:

				combo_used.emit("fatality")

				trigger_fire_death()

			return


# =========================================================
# PUNCH COMBO
# =========================================================

func start_punch_combo():

	if action_locked:
		return

	if is_hurting:
		return

	if state == State.DEAD:
		return

	if health <= 1:
		return

	await combo_attack([
		"punch",
		"lowpunch",
		"punch",
		"uppercut",
		"highpunch",
		"uppercut"
	])


