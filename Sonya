func apply_stun(_duration := 4.0):

	if state == State.DEAD:
		return

	stunned = true

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	velocity = Vector2.ZERO
	knockback_x = 0

	play_anim("idle")

	await get_tree().create_timer(4.0).timeout

	stunned = false

	is_hurting = false
	hurt_locked = false
	action_locked = false

func run(input_dir: float):
	if input_dir == 0:
		return

	state = State.RUN
	velocity.x = input_dir * SPEED * 2.5  # faster than walk

	if not is_attacking:
		play_anim("walk")

# ---------------- READY ----------------
func _ready():
	$Sprite.visible = true
	$Crispy.visible = false

	add_to_group("Fighter")
	add_to_group("enemy")
	add_to_group("Sonya")

	spawn_locked = false

	health = max_health
	health_changed.emit(health)

	play_anim("idle")

	ai_timer = randf_range(0.2, 0.6)

	facing = 1
	sprite.flip_h = -facing < 0
	$Crispy.flip_h = -facing < 0

# ---------------- INPUT ----------------
func _physics_process(delta):

	if state == State.DEAD:
		return

	if is_pulled:
		run_pull_logic(delta)
		move_and_slide()
		return

	# ---------------- STUN ----------------
	if stunned:
		velocity = Vector2.ZERO
		return

	# ---------------- DEATH / FINISH ----------------
	if state == State.DEAD:
		return

	if is_finish_state:
		state = State.IDLE
		velocity.x = 0

		if not is_hurting:
			play_anim("idle")

		move_and_slide()
		return

	# ---------------- GRAVITY ----------------
	velocity.y += GRAVITY * delta

	# =====================================================
	# UPPERCUT LAUNCH
	# =====================================================

	if uppercut_launched:

		# Keep uppercut hurt animation while airborne
		if sprite.animation != "wasuppercut":
			current_anim = ""
			sprite.play("wasuppercut")

		# Do NOT allow normal movement while launched
		velocity.x = move_toward(
			velocity.x,
			0.0,
			1500.0 * delta
		)

		move_and_slide()

		# =================================================
		# LANDED AFTER UPPERCUT
		# =================================================

		if is_on_floor():

			velocity.x = 0
			velocity.y = 0

			uppercut_launched = false
			was_uppercut = false

			is_hurting = false
			hurt_locked = false
			action_locked = false

			is_attacking = false
			is_shooting = false
			is_blocking = false

			state = State.IDLE

			current_anim = ""
			play_anim("idle")

		return

# =====================================================
# JUMPKICK LAUNCH
# =====================================================

	if jumpkick_launched:

		# Keep jumpkick hurt animation while airborne
		if sprite.animation != "wasjumpkick":
			current_anim = ""
			sprite.play("wasjumpkick")

		# Do NOT allow normal movement while launched
		velocity.x = move_toward(
			velocity.x,
			0.0,
			1500.0 * delta
		)

		move_and_slide()

		# Stop launch when Johnny lands
		if is_on_floor():
			jumpkick_launched = false
			velocity.x = 0
			velocity.y = 0
			state = State.IDLE
			current_anim = ""
			sprite.play("idle")

		return

	# =====================================================
	# FINISH HIM
	# =====================================================

	if is_finish_state:

		state = State.IDLE
		velocity.x = 0

		if is_on_floor():
			velocity.y = 0

		if not is_hurting:
			play_anim("idle")

		move_and_slide()
		return

	# ---------------- COOLDOWNS ----------------
	shoot_cooldown = max(
		shoot_cooldown - delta,
		0.0
	)

	combo_timer += delta

	if combo_timer > combo_reset_time:
		combo.clear()

	# ---------------- CPU ----------------
	if is_cpu:

		cpu_logic(delta)

		move_and_slide()

		return

	# ---------------- ACTION LOCK ----------------
	if action_locked:
		return

	var input_dir := Input.get_axis(
		"left",
		"right"
	)

	var climb_pressed := Input.is_action_pressed("climb")

	# =====================================================
	# FACING
	# =====================================================
	#
	# Works both on the ground and in the air.
	# Pressing LEFT/RIGHT changes facing but does NOT
	# change the jump animation.
	# =====================================================

	if input_dir != 0:

		facing = sign(input_dir)

		sprite.flip_h = facing > 0
		$Crispy.flip_h = facing > 0

		$AttackMarker.position = Vector2(
			0,
			0
		)

		$SonyaShoot.position = Vector2(
			63 * facing,
			-225
		)

	# =====================================================
	# JUMP
	# =====================================================

	if (
		Input.is_action_just_pressed("jump")
		and is_on_floor()
	):

		velocity.y = jump_velocity
		state = State.JUMP
		$Jump.play()

	# =====================================================
	# AIR MOVEMENT
	# =====================================================
	#
	# LEFT/RIGHT works in the air.
	#
	# RUN in the air makes Sonya move faster, but she
	# stays in the JUMP animation.
	# =====================================================

	if not is_on_floor():

		velocity.x = input_dir * SPEED

		if Input.is_action_pressed("run") and input_dir != 0:

			velocity.x = input_dir * SPEED * 4

		state = State.JUMP

	# =====================================================
	# GROUND MOVEMENT
	# =====================================================

	else:

		if Input.is_action_pressed("run") and input_dir != 0:

			run(input_dir)

		else:

			velocity.x = input_dir * SPEED

			if input_dir != 0:

				state = State.WALK

			else:

				state = State.IDLE

	# =====================================================
	# ANIMATIONS
	# =====================================================

	match state:

		State.JUMP:

			if not is_attacking and not is_hurting:
				play_anim("jump")

		State.WALK:

			if not is_attacking and not is_hurting:
				play_anim("walk")

		State.RUN:

			if not is_attacking and not is_hurting:
				play_anim("run")

		State.IDLE:

			if not is_attacking and not is_hurting:
				play_anim("idle")

	# =====================================================
	# HURT LOCK
	# =====================================================

	if is_hurting and hurt_locked:
		return

	# =====================================================
	# ATTACKS
	# =====================================================

	if Input.is_action_just_pressed("punch"):

		do_action("punch")

	if Input.is_action_just_pressed("highpunch"):

		do_action("highpunch")

	if Input.is_action_just_pressed("lowpunch"):

		do_action("lowpunch")

	elif Input.is_action_just_pressed("kick"):

		do_action("kick")

	elif Input.is_action_just_pressed("highkick"):

		do_action("highkick")

	elif Input.is_action_just_pressed("lowkick"):

		do_action("lowkick")

	elif Input.is_action_just_pressed("slidekick"):

		do_action("slidekick")

	elif Input.is_action_just_pressed("jumpkick"):

		do_action("jumpkick")

	elif Input.is_action_just_pressed("uppercut"):

		do_action("uppercut")

	elif Input.is_action_just_pressed("knee"):

		do_action("knee")

	elif Input.is_action_just_pressed("roundhousekick"):

		do_action("roundhousekick")

	elif Input.is_action_just_pressed("shoot"):

		shoot_player()

	# =====================================================
	# MOVE
	# =====================================================

	move_and_slide()

func spear_pulled_to_p1():

	is_pulled = true
	stunned = true
	action_locked = true
	is_hurting = true

	pull_timer = 0.35

	pull_target = get_tree().get_first_node_in_group("Reptile")

func run_pull_logic(delta):
	if pull_target == null or !is_instance_valid(pull_target):
		is_pulled = false
		stunned = false
		action_locked = false
		return

	var dir = sign(pull_target.global_position.x - global_position.x)

	velocity.x = dir * 900
	velocity.y = -120

	pull_timer -= delta

	if pull_timer <= 0.0:

		is_pulled = false

		# SNAP to Reptile AttackMarker (THIS IS MK MOMENT)
		global_position = pull_target.attack_marker.global_position + Vector2(40 * pull_target.facing, 0)

		stunned = false
		is_hurting = false
		action_locked = false
		is_attacking = true

		pull_target = null

func cpu_logic(delta):

	# =========================================================
	# DEAD
	# =========================================================
	if state == State.DEAD:
		return

	# =========================================================
	# FINISH HIM
	# =========================================================
	if is_finish_state:
		is_attacking = false
		action_locked = true
		velocity.x = 0
		state = State.IDLE

		if not is_hurting:
			play_anim("idle")

		return

	# =========================================================
	# HURT
	# =========================================================
	if is_hurting:

		velocity.x = knockback_x

		knockback_x = move_toward(
			knockback_x,
			0.0,
			1500.0 * delta
		)

		move_and_slide()

		if abs(knockback_x) > 10.0:
			return

		knockback_x = 0.0
		is_hurting = false
		hurt_locked = false
		is_attacking = false
		is_shooting = false
		action_locked = false

		state = State.IDLE
		play_anim("idle")

		ai_timer = 0.1

		return

	# =========================================================
	# ACTION LOCK
	# =========================================================
	if action_locked:
		velocity.x = 0
		return

	# =========================================================
	# FIND PLAYER 1
	# =========================================================
	if target == null or not is_instance_valid(target):

		target = get_tree().get_first_node_in_group("player1")

		# Backup: find human Fighter
		if target == null or not is_instance_valid(target):

			for node in get_tree().get_nodes_in_group("Fighter"):

				if node == self:
					continue

				if not is_instance_valid(node):
					continue

				if node is Node2D and not node.is_cpu:
					target = node
					break

	# =========================================================
	# NO TARGET
	# =========================================================
	if target == null or not is_instance_valid(target):

		velocity.x = 0
		state = State.IDLE
		play_anim("idle")

		return

	# =========================================================
	# DISTANCE TO PLAYER 1
	# =========================================================
	var dist: float = target.global_position.x - global_position.x
	var distance: float = abs(dist)
	var direction: float = sign(dist)

	# =========================================================
	# FACE PLAYER 1
	# =========================================================
	if direction != 0:

		facing = direction

		sprite.flip_h = facing > 0
		$Crispy.flip_h = facing > 0

		$AttackMarker.position = Vector2(0, 0)
		$SonyaShoot.position = Vector2(63 * facing, -225)

	# =========================================================
	# CPU DISTANCES
	# =========================================================
	var attack_range := 110.0
	var stopping_distance := 90.0

	# =========================================================
	# WALK TOWARD PLAYER 1
	# =========================================================
	if distance > stopping_distance:

		velocity.x = direction * SPEED

		state = State.WALK

		if not is_attacking and not is_hurting:
			play_anim("walk")

	# =========================================================
	# AI ATTACK TIMER
	# =========================================================
	ai_timer -= delta

	if ai_timer > 0.0:
		return

	# =========================================================
	# ATTACK ONLY WHEN CLOSE
	# =========================================================
	if (
		distance <= attack_range
		and not is_hurting
		and not is_finish_state
		and not action_locked
		and not is_attacking
	):

		match Game.difficulty:

			"Hard":

				# Very fast reactions
				ai_timer = randf_range(0.05, 0.15)

				var choice = randi() % 100

				if choice < 20:

					do_action("punch")

				elif choice < 35:

					do_action("highpunch")

				elif choice < 45:

					do_action("lowpunch")

				elif choice < 60:

					do_action("slidekick")

				elif choice < 70:

					do_action("highkick")

				elif choice < 80:

					do_action("lowkick")

				elif choice < 88:

					do_action("jumpkick")

				elif choice < 88:

					do_action("uppercut")

				elif choice < 94:

					do_action("roundhousekick")
				else:
					shoot_player()

			"Easy":

				ai_timer = randf_range(0.5, 0.9)

				var choice = randi() % 100

				if choice < 40:

					do_action("punch")

				elif choice < 55:

					do_action("slidekick")

				elif choice < 65:

					do_action("highkick")

				elif choice < 75:

					do_action("lowkick")

				elif choice < 75:

					do_action("jumpkick")

				elif choice < 85:

					do_action("uppercut")
				else:
					do_action("roundhousekick")

# ---------------- SHOOT ----------------
func shoot_player():

	if health <= 1:
		return

	if is_finish_state:
		return

	if is_shooting:
		return

	is_shooting = true
	is_attacking = true
	action_locked = true

	play_anim("shoot")

	# PLAY SONYA BULLET SOUND
	$Sonyabullet.play()

	var bullet_scene: PackedScene = SONYA_BULLET

	if special_bullet != null:
		bullet_scene = special_bullet
		special_bullet = null

	var bullet = bullet_scene.instantiate()
	get_tree().current_scene.add_child(bullet)

	await get_tree().process_frame

	bullet.global_position = $SonyaShoot.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	await get_tree().create_timer(0.25).timeout

	is_shooting = false
	is_attacking = false
	action_locked = false

# ---------------- BURST ----------------
func spawn_burst():

	var burst = SONYA_BULLET.instantiate()

	get_tree().current_scene.add_child(burst)

	burst.global_position = attack_marker.global_position

# ---------------- ACTION ----------------
func do_action(anim_name: String):

	if is_attacking:
		return

	if health <= 1:
		return

	if is_finish_state:
		return

	if state == State.DEAD:
		return

	if action_locked:
		return

	action_locked = true
	is_attacking = true
	lock_timer = 0.6

	play_anim(anim_name)

	if anim_name in [
		"punch",
		"highpunch",
		"lowpunch",
		"kick",
		"highkick",
		"lowkick",
		"slidekick",
		"jumpkick",
		"uppercut",
		"roundhousekick",
		"knee"
	]:
		spawn_attack(anim_name)

	await sprite.animation_finished

	is_attacking = false
	action_locked = false
	hurt_locked = false

	play_anim("idle")

# ---------------- ATTACK ----------------
func spawn_attack(anim_name: String):

	if anim_name not in [
		"punch",
		"highpunch",
		"lowpunch",
		"kick",
		"highkick",
		"lowkick",
		"slidekick",
		"jumpkick",
		"uppercut",
		"roundhousekick",
		"knee"
	]:
		return


	var attack = SONYA_ATTACK.instantiate()

	get_tree().current_scene.add_child(attack)

	attack.add_to_group("HitBox")

	attack.global_position = attack_marker.global_position
	attack.scale.x = facing  # THIS replaces facing system


	var dmg := 1


	match anim_name:
		"punch":
			dmg = 1
		"lowpunch":
			dmg = 1
		"highpunch":
			dmg = 1
		"kick":
			dmg = 1
		"lowkick":
			dmg = 1
		"highkick":
			dmg = 1
		"slidekick":
			dmg = 1
		"jumpkick":
			dmg = 1
		"uppercut":
			dmg = 1
		"roundhousekick":
			dmg = 1


	if attack.has_method("set_damage"):
		attack.set_damage(dmg)
	else:
		attack.damage = dmg


	# UPPERCUT KNOCKBACK SYSTEM
	attack.owner = self
	attack.attack_owner = self
	attack.attack_name = anim_name
	attack.attack_type = anim_name

# ---------------- DAMAGE ----------------
# =========================================================
# TAKE DAMAGE
# =========================================================

func take_damage(amount: int):

	# =====================================================
	# BASIC DAMAGE LOCKS
	# =====================================================

	if state == State.DEAD:
		return

	if not can_take_damage:
		return

	if spawn_protection:
		return


	# =====================================================
	# PREVENT MULTIPLE DAMAGE ON SAME PHYSICS FRAME
	# =====================================================

	var frame := Engine.get_physics_frames()

	if has_meta("last_damage_frame"):
		if get_meta("last_damage_frame") == frame:
			return

	set_meta("last_damage_frame", frame)


	# =====================================================
	# TEMPORARY DAMAGE COOLDOWN
	# =====================================================

	can_take_damage = false

	get_tree().create_timer(0.25).timeout.connect(func():

		if is_instance_valid(self) and state != State.DEAD:
			can_take_damage = true

	)


	# =====================================================
	# BLOCK REDUCTION
	# =====================================================

	if is_blocking:

		amount = max(
			amount - 1,
			0
		)

	if amount <= 0:
		return


	# =====================================================
	# APPLY DAMAGE
	# =====================================================

	health -= amount
	health = max(
		health,
		0
	)

	print("Sonya took damage: ", amount, " HP=", health)

	health_changed.emit(health)


	# =====================================================
	# HIT SOUND
	# =====================================================

	if is_instance_valid(hit_sound):
		hit_sound.play()


	# =====================================================
	# FINAL HIT
	# =====================================================

	if health <= 0:

		is_attacking = false
		is_shooting = false
		is_hurting = false
		is_blocking = false

		if is_instance_valid(finish_label):
			finish_label.visible = false

		die()

		return


	# =====================================================
	# FINISH HIM
	#
	# Only trigger when the opponent already has
	# 1 round win.
	#
	# This means this death will give the opponent
	# their SECOND round win.
	#
	# Do NOT use Game.current_round here.
	# =====================================================

	if health == 1 and not is_finish_state:

		var opponent_will_win_match := false


		# =================================================
		# SONYA IS PLAYER 1
		# =================================================

		if is_in_group("player1"):

			if Game.p2_round_wins >= 1:
				opponent_will_win_match = true


		# =================================================
		# SONYA IS CPU
		# =================================================

		else:

			if Game.p1_round_wins >= 1:
				opponent_will_win_match = true


		# =================================================
		# TRIGGER FINISH HIM
		# =================================================

		if opponent_will_win_match:

			is_hurting = false
			hurt_locked = false
			action_locked = false

			trigger_finish_state()

			return


	# =====================================================
	# NORMAL HURT
	# =====================================================

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	state = State.IDLE

	combo.clear()

	play_anim("hurt")


	# =====================================================
	# HURT SOUND
	# =====================================================

	if is_instance_valid(hurt_sound):
		hurt_sound.play()


	# =====================================================
	# BLOOD EFFECT
	# =====================================================

	if has_node("BloodMarker"):

		var blood = BLOOD_EFFECT.instantiate()

		get_tree().current_scene.add_child(blood)

		blood.global_position = $BloodMarker.global_position


	# =====================================================
	# HURT DURATION
	# =====================================================

	await get_tree().create_timer(0.25).timeout

	if state == State.DEAD:
		return

	is_hurting = false
	hurt_locked = false
	action_locked = false


	# =====================================================
	# RETURN TO IDLE
	# =====================================================

	if state != State.DEAD and not is_finish_state:

		play_anim("idle")

func trigger_finish_state():

	if is_finish_state:
		return

	is_finish_state = true

	state = State.IDLE

	# force them to fall back down
	velocity.x = 0
	velocity.y = 0

	action_locked = true
	hurt_locked = false
	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

	# cancel any uppercut/fly state
	set_meta("uppercut_launched", false)

	play_anim("idle")

	finish_label.visible = true

	if finish_label.has_method("start_flicker"):
		finish_label.start_flicker(2.0, 0.05)

	# let gravity work
	await get_tree().create_timer(0.1).timeout

	while not is_on_floor():
		velocity.y += 5000.0 * get_physics_process_delta_time()
		move_and_slide()
		await get_tree().physics_frame

	velocity = Vector2.ZERO

	await get_tree().create_timer(2.0).timeout

	if is_instance_valid(finish_label):
		finish_label.visible = false

# ---------------- DEATH ----------------
# =========================================================
# DEATH
# =========================================================

func die():

	# =====================================================
	# ALREADY DEAD
	# =====================================================

	if state == State.DEAD:
		return

	# =====================================================
	# LOCK SONYA AS DEAD
	# =====================================================

	state = State.DEAD

	velocity = Vector2.ZERO

	is_attacking = false
	is_shooting = false
	is_blocking = false
	is_hurting = false

	action_locked = true
	hurt_locked = true

	can_take_damage = false

	stunned = false
	is_pulled = false
	is_spear_pulled = false

	pull_target = null
	pull_timer = 0.0

	knockback_x = 0.0
	uppercut_launched = false
	hurt_cooldown = false

	run_locked = false

	# =====================================================
	# STOP CPU ACTIONS
	# =====================================================

	ai_timer = 999999.0

	# =====================================================
	# HIDE FINISH HIM
	# =====================================================

	if is_instance_valid(finish_label):
		finish_label.visible = false

	# =====================================================
	# DETERMINE ROUND WINNER
	# =====================================================
	#
	# If Sonya is P1:
	#     CPU wins.
	#
	# Otherwise:
	#     P1 wins.
	# =====================================================

	var winner := ""

	if is_in_group("player1"):

		winner = "cpu"

	else:

		winner = "player1"

	# =====================================================
	# DEBUG
	# =====================================================

	print("================================")
	print("SONYA DIED")
	print("ROUND: ", Game.current_round)
	print(
		"CURRENT SCORE: ",
		Game.p1_round_wins,
		" - ",
		Game.p2_round_wins
	)
	print("ROUND WINNER: ", winner)
	print("================================")

	# =====================================================
	# DETERMINE IF THIS DEATH ENDS THE MATCH
	# =====================================================
	#
	# Level1 has not awarded this round yet.
	#
	# If the winner already has one round win,
	# this death will give them their second win.
	# =====================================================

	var match_will_end := false

	if winner == "player1":

		if Game.p1_round_wins >= 1:
			match_will_end = true

	else:

		if Game.p2_round_wins >= 1:
			match_will_end = true

	print("MATCH WILL END: ", match_will_end)

	# =====================================================
	# HIDE NORMAL SPRITE / SHOW DEAD SPRITE
	# =====================================================

	$Sprite.visible = false
	$Crispy.visible = true

	$Crispy.flip_h = facing > 0

	# =====================================================
	# FINAL MATCH DEATH
	# =====================================================

	if match_will_end:

		print("================================")
		print("SONYA FINAL DEATH")
		print("FATALITY ALLOWED")
		print("================================")

		# -------------------------------------------------
		# BLOOD DEATH EFFECT
		# -------------------------------------------------

		var blood = BLOOD_DEATH.instantiate()

		get_tree().current_scene.add_child(blood)

		blood.global_position = global_position

		# -------------------------------------------------
		# MAKE SURE DEAD SPRITE IS SHOWN
		# -------------------------------------------------

		$Sprite.visible = false
		$Crispy.visible = true

		$Crispy.flip_h = facing > 0

		# -------------------------------------------------
		# HIDE FINISH HIM
		# -------------------------------------------------

		if is_instance_valid(finish_label):
			finish_label.visible = false

		# -------------------------------------------------
		# WAIT FOR FINAL DEATH / FATALITY
		# -------------------------------------------------

		await get_tree().create_timer(3.0).timeout

		# -------------------------------------------------
		# TELL LEVEL1 WHO WON
		# -------------------------------------------------

		round_death.emit(winner)

		return

	# =====================================================
	# NORMAL ROUND DEATH
	# =====================================================
	#
	# Match is NOT over.
	#
	# Level1 handles:
	#   - awarding the round
	#   - updating the score
	#   - starting Round 2
	#   - resetting fighters
	#   - resetting health bars
	#   - showing Round 2
	# =====================================================

	print("================================")
	print("SONYA ROUND DEATH")
	print("NO FATALITY")
	print("LEVEL1 WILL HANDLE NEXT ROUND")
	print("================================")

	# =====================================================
	# HIDE FINISH HIM
	# =====================================================

	if is_instance_valid(finish_label):
		finish_label.visible = false

	# =====================================================
	# GIVE LEVEL1 CONTROL
	# =====================================================

	round_death.emit(winner)

	return

# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):

	if current_anim == anim_name:
		return

	current_anim = anim_name
	sprite.play(anim_name)

# ---------------- COMBOS ----------------
func register_input(input: String):

	if not is_in_group("player1"):
		return

	combo.append(input)
	input_buffer.append(input)

	combo_timer = 0.0

	check_combo()
	_check_pink_combo()
	_check_punch_combo()

func spawn_fx(scene: PackedScene):

	var fx = scene.instantiate()

	fx.owner_character = self
	fx.damage_done = false

	get_tree().current_scene.call_deferred("add_child", fx)
	if is_instance_valid(fatality_sound):
		fatality_sound.play()
		await get_tree().process_frame


	await get_tree().process_frame

	if target and is_instance_valid(target):

		fx.global_position = (
			target.global_position +
			Vector2(60 * facing, 0)
		)

	else:

		fx.global_position = (
			global_position +
			Vector2(80 * facing, 0)
		)

func trigger_pink_death():

	var victim = null

	for fighter in get_tree().get_nodes_in_group("Fighter"):
		if fighter != self:
			victim = fighter
			break

	if victim == null:
		return

	var pink = PINK_DEATH_SCENE.instantiate()

	get_tree().current_scene.add_child(pink)

	pink.global_position = victim.global_position
	pink.owner_character = self
	if is_instance_valid(fatality_sound):
		fatality_sound.play()
		await get_tree().process_frame
		print("================================")
		print("===========FATALITY=============")
		print("================================")

func trigger_fire_death():
	if target == null or !is_instance_valid(target):
		return

	var fire = preload("res://Deaths/FireDeath.tscn").instantiate()
	get_tree().current_scene.add_child(fire)
	print("================================")
	print("===========FATALITY=============")
