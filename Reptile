# =========================================================
# STUN
# =========================================================

func apply_stun(_duration := 4.0):

	if state == State.DEAD:
		return

	stunned = true

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	velocity = Vector2.ZERO
	knockback_x = 0

	play_anim("idle")

	await get_tree().create_timer(4.0).timeout

	if state == State.DEAD:
		return

	stunned = false

	is_hurting = false
	hurt_locked = false
	action_locked = false

# =========================================================
# RUN
# =========================================================

func run(input_dir: float):

	if input_dir == 0:
		return

	state = State.RUN
	velocity.x = input_dir * SPEED * 4.0

	if not is_attacking:
		play_anim("run")

# =========================================================
# READY
# =========================================================

func _ready():

	$Sprite.visible = true
	$Crispy.visible = false
	$healthzero.visible = false
	facing = 1

	sprite.flip_h = facing > 0
	$Crispy.flip_h = facing < 0
	$healthzero.flip_h = facing < 0
	add_to_group("Fighter")
	add_to_group("enemy")
	add_to_group("Reptile")

	spawn_locked = false

	health = max_health

	health_changed.emit(health)

	play_anim("idle")

	ai_timer = randf_range(0.2, 0.6)


# =========================================================
# INPUT
# =========================================================

func _unhandled_input(event):

	# =====================================================
	# CPU MUST NOT RECEIVE PLAYER INPUT
	# =====================================================

	if is_cpu:
		return

	# =====================================================
	# PLAYER 1 JUMP
	# =====================================================

	if event.is_action_pressed("jump"):
		if is_on_floor():
			velocity.y = jump_velocity

	# =====================================================
	# COMBO INPUT
	# =====================================================

	var inputs = [
		"up",
		"down",
		"left",
		"right",
		"shoot"
	]

	for i in inputs:
		if event.is_action_pressed(i):
			register_input(i)

# =========================================================
# PHYSICS
# =========================================================

func _physics_process(delta):

	if state == State.DEAD:
		return

	# =====================================================
	# STUN
	# =====================================================

	if stunned:

		if not is_on_floor():
			velocity.y += GRAVITY * delta
		else:
			velocity.y = 0

		move_and_slide()
		return

	# =====================================================
	# GRAVITY
	# =====================================================

	if not is_on_floor():

		velocity.y += GRAVITY * delta

	else:

		if velocity.y > 0:
			velocity.y = 0

	# =====================================================
	# UPPERCUT LAUNCH
	# =====================================================

	if uppercut_launched:

		# Keep uppercut hurt animation while airborne
		if sprite.animation != "wasuppercut":
			current_anim = ""
			sprite.play("wasuppercut")

		# Do NOT allow normal movement while launched
		velocity.x = move_toward(
			velocity.x,
			0.0,
			1500.0 * delta
		)

		move_and_slide()

		# =================================================
		# LANDED AFTER UPPERCUT
		# =================================================

		if is_on_floor():

			velocity.x = 0
			velocity.y = 0

			uppercut_launched = false
			was_uppercut = false

			is_hurting = false
			hurt_locked = false
			action_locked = false

			is_attacking = false
			is_shooting = false
			is_blocking = false

			state = State.IDLE

			current_anim = ""
			play_anim("idle")

		return

# =====================================================
# JUMPKICK LAUNCH
# =====================================================

	if jumpkick_launched:

		# Keep jumpkick hurt animation while airborne
		if sprite.animation != "wasjumpkick":
			current_anim = ""
			sprite.play("wasjumpkick")

		# Do NOT allow normal movement while launched
		velocity.x = move_toward(
			velocity.x,
			0.0,
			1500.0 * delta
		)

		move_and_slide()

		# Stop launch when Johnny lands
		if is_on_floor():
			jumpkick_launched = false
			velocity.x = 0
			velocity.y = 0
			state = State.IDLE
			current_anim = ""
			sprite.play("idle")

		return

	# =====================================================
	# FINISH HIM
	# =====================================================

	if is_finish_state:

		state = State.IDLE
		velocity.x = 0

		if is_on_floor():
			velocity.y = 0

		if not is_hurting:
			play_anim("idle")

		move_and_slide()
		return

	# =====================================================
	# COOLDOWNS
	# =====================================================

	shoot_cooldown = max(
		shoot_cooldown - delta,
		0.0
	)

	combo_timer += delta

	if combo_timer > combo_reset_time:
		combo.clear()

	# =====================================================
	# CPU
	# =====================================================
	#
	# IMPORTANT:
	# CPU does NOT copy Player 1's jump.
	#
	# cpu_logic() controls CPU movement only.
	# =====================================================

	if is_cpu:

		cpu_logic(delta)

		move_and_slide()

		return

	# =====================================================
	# ACTION LOCK
	# =====================================================

	if action_locked:

		velocity.x = 0

		move_and_slide()

		return

	# =====================================================
	# PLAYER MOVEMENT
	# =====================================================

	var input_dir := Input.get_axis(
		"left",
		"right"
	)

	# =====================================================
	# PLAYER FACING
	# =====================================================
	#
	# Only change facing when the player actually presses
	# left or right.
	#
	# This prevents the target from changing Reptile's
	# direction while jumping.
	# =====================================================

	if input_dir != 0:

		facing = input_dir

		sprite.flip_h = facing > 0
		$Crispy.flip_h = facing > 0

		$AttackMarker.position = Vector2.ZERO

		$Reptileshoot.position = Vector2(
			63 * facing,
			-211
		)

	# =====================================================
	# WALK / RUN / JUMP
	# =====================================================

	# JUMP ALWAYS HAS PRIORITY OVER WALK/RUN
	if not is_on_floor():

		state = State.JUMP

	# Keep horizontal movement while airborne
		velocity.x = input_dir * SPEED

	else:

		# ON GROUND
		if Input.is_action_pressed("run") and input_dir != 0:

			state = State.RUN
			velocity.x = input_dir * SPEED * 4.0

		elif input_dir != 0:

			state = State.WALK
			velocity.x = input_dir * SPEED

		else:

			state = State.IDLE
			velocity.x = 0


	# =====================================================
	# ANIMATIONS
	# =====================================================

	match state:

		State.JUMP:

			if not is_attacking and not is_hurting:
				play_anim("jump")

		State.WALK:

			if not is_attacking and not is_hurting:
				play_anim("walk")

		State.RUN:

			if not is_attacking and not is_hurting:
				play_anim("run")

		State.IDLE:

			if not is_attacking and not is_hurting:
				play_anim("idle")

	# =====================================================
	# HURT LOCK
	# =====================================================

	if is_hurting and hurt_locked:

		move_and_slide()

		return

	# =====================================================
	# PLAYER JUMP ONLY
	# =====================================================
	#
	# This is ONLY reached for a human-controlled Reptile.
	# CPU returns above before getting here.
	# =====================================================

	if (
		Input.is_action_just_pressed("jump")
		and is_on_floor()
	):

		velocity.y = jump_velocity
		state = State.JUMP
		$Jump.play()

	# =====================================================
	# ATTACKS
	# =====================================================

	if Input.is_action_just_pressed("punch"):

		do_action("punch")

	if Input.is_action_just_pressed("highpunch"):

		do_action("highpunch")

	if Input.is_action_just_pressed("lowpunch"):

		do_action("punch")

	elif Input.is_action_just_pressed("roundhousekick"):

		do_action("roundhousekick")

	elif Input.is_action_just_pressed("lowkick"):

		do_action("lowkick")

	elif Input.is_action_just_pressed("highkick"):

		do_action("highkick")

	elif Input.is_action_just_pressed("slidekick"):

		do_action("slidekick")

	elif Input.is_action_just_pressed("jumpkick"):

		do_action("jumpkick")

	elif Input.is_action_just_pressed("uppercut"):

		do_action("uppercut")

	elif Input.is_action_pressed("Reptilesacid"):

		shoot_acid()

	elif Input.is_action_just_pressed("knee"):

		do_action("knee")

	elif Input.is_action_just_pressed("shoot"):

		if shoot_cooldown <= 0:
			shoot_player()

	elif Input.is_action_pressed("block"):

		start_block()

	elif Input.is_action_pressed("fatalitycombo"):

		do_action("fatalitycombo")
		# PLAY FATALITY SOUND
		if is_instance_valid(fatality_sound):
			fatality_sound.play()
			print("================================")
			print("===========FATALITY=============")
			print("================================")

	elif Input.is_action_pressed("FATALITY_COMBO"):

		do_action("fatalitycombo")
		# PLAY FATALITY SOUND
		if is_instance_valid(fatality_sound):
			fatality_sound.play()
			print("================================")
			print("===========FATALITY=============")
			print("================================")

	elif Input.is_action_just_pressed("spear"):

		start_spear()

	elif Input.is_action_pressed("invisible"):

		invisible()

	elif Input.is_action_pressed("visible"):

		sprite.visible = true

	else:

		stop_block()

	# =====================================================
	# FINAL MOVEMENT
	# =====================================================

	move_and_slide()


# =========================================================
# BLOCK
# =========================================================

func start_block():

	if state == State.DEAD:
		return

	if is_finish_state:
		return

	is_blocking = true
	state = State.BLOCK

	play_anim("block")


func stop_block():

	if is_blocking:

		is_blocking = false

		if state != State.DEAD:
			state = State.IDLE


# =========================================================
# ACID
# =========================================================

func shoot_acid():

	if shoot_cooldown > 0:
		return

	if health <= 1:
		return

	shoot_cooldown = shoot_cooldown_time

	is_attacking = true
	action_locked = true

	play_anim("shoot")

	var bullet = REPTILES_ACID.instantiate()

	get_tree().current_scene.add_child(bullet)

	bullet.global_position = $Reptileshoot.global_position
	bullet.velocity = Vector2.RIGHT * facing * bullet.speed

	await get_tree().create_timer(0.2).timeout

	if state == State.DEAD:
		return

	is_attacking = false
	action_locked = false


# =========================================================
# INVISIBLE
# =========================================================

func invisible():

	sprite.visible = false


# =========================================================
# CPU LOGIC
# =========================================================

func cpu_logic(delta):

	# =========================================================
	# DEAD
	# =========================================================
	if state == State.DEAD:
		return

	# =========================================================
	# FINISH HIM
	# =========================================================
	if is_finish_state:
		is_attacking = false
		action_locked = true
		velocity.x = 0
		state = State.IDLE

		if not is_hurting:
			play_anim("idle")

		return

	# =========================================================
	# HURT
	# =========================================================
	if is_hurting:

		velocity.x = knockback_x

		knockback_x = move_toward(
			knockback_x,
			0.0,
			1500.0 * delta
		)

		move_and_slide()

		if abs(knockback_x) > 10.0:
			return

		knockback_x = 0.0
		is_hurting = false
		hurt_locked = false
		is_attacking = false
		is_shooting = false
		action_locked = false

		state = State.IDLE
		play_anim("idle")

		ai_timer = 0.1

		return

	# =========================================================
	# ACTION LOCK
	# =========================================================
	if action_locked:
		velocity.x = 0
		return

	# =========================================================
	# FIND PLAYER 1
	# =========================================================
	if target == null or not is_instance_valid(target):

		target = get_tree().get_first_node_in_group("player1")

		# Backup: find human Fighter
		if target == null or not is_instance_valid(target):

			for node in get_tree().get_nodes_in_group("Fighter"):

				if node == self:
					continue

				if not is_instance_valid(node):
					continue

				if node is Node2D and not node.is_cpu:
					target = node
					break

	# =========================================================
	# NO TARGET
	# =========================================================
	if target == null or not is_instance_valid(target):

		velocity.x = 0
		state = State.IDLE
		play_anim("idle")

		return

# =========================================================
# DISTANCE TO PLAYER 1
# =========================================================
	var dist: float = target.global_position.x - global_position.x
	var distance: float = abs(dist)
	var direction: float = sign(dist)

# =========================================================
# FACE OPPOSITE PLAYER 1
# =========================================================
	if direction != 0:

		# CPU faces opposite the direction of Player 1
		facing = direction

		# Same flip convention used by Sub-Zero's player controls
		sprite.flip_h = facing > 0
		$Crispy.flip_h = facing > 0
		$healthzero.flip_h = facing > 0

		$AttackMarker.position = Vector2(0, 0)
		$Reptileshoot.position = Vector2(63 * -facing, -211)

	# =========================================================
	# CPU DISTANCES
	# =========================================================
	var attack_range := 110.0
	var stopping_distance := 90.0

	# =========================================================
	# WALK TOWARD PLAYER 1
	# =========================================================
	if distance > stopping_distance:

		velocity.x = direction * SPEED

		state = State.WALK

		if not is_attacking and not is_hurting:
			play_anim("walk")

	else:

		velocity.x = 0

		if not is_attacking and not is_hurting:
			state = State.IDLE
			play_anim("idle")

	# =========================================================
	# AI ATTACK TIMER
	# =========================================================
	ai_timer -= delta

	if ai_timer > 0.0:
		return

	# =========================================================
	# ATTACK ONLY WHEN CLOSE
	# =========================================================
	if (
		distance <= attack_range
		and not is_hurting
		and not is_finish_state
		and not action_locked
		and not is_attacking
	):

		match Game.difficulty:

			"Hard":

				ai_timer = randf_range(
					0.05,
					0.15
				)

				var choice = randi() % 100

				if choice < 20:

					do_action("punch")

				elif choice < 35:

					do_action("highpunch")

				elif choice < 45:

					do_action("lowpunch")

				elif choice < 60:

					do_action("slidekick")

				elif choice < 70:

					do_action("highkick")

				elif choice < 80:

					do_action("lowkick")

				elif choice < 80:

					do_action("jumpkick")

				elif choice < 88:

					do_action("uppercut")

				elif choice < 94:

					do_action("roundhousekick")

				elif choice < 97:

					start_spear()

				else:

					shoot_player()

			"Easy":

				ai_timer = randf_range(
					0.5,
					0.9
				)

				var choice = randi() % 100

				if choice < 40:

					do_action("punch")

				elif choice < 55:

					do_action("slidekick")

				elif choice < 65:

					do_action("highkick")

				elif choice < 75:

					do_action("lowkick")

				elif choice < 75:

					do_action("jumpkick")

				elif choice < 85:

					do_action("uppercut")

				elif choice < 92:

					start_spear()

				else:

					do_action("roundhousekick")

			_:

				ai_timer = randf_range(
					0.25,
					0.5
				)

				var choice = randi() % 100

				if choice < 50:

					do_action("punch")

				elif choice < 75:

					do_action("lowkick")

				elif choice < 90:

					do_action("uppercut")

				else:

					shoot_player()


# =========================================================
# PULL ENEMY
# =========================================================

func pull_enemy(enemy: CharacterBody2D):
	if enemy == null or not is_instance_valid(enemy):
		return

	enemy.velocity = Vector2.ZERO
	enemy.action_locked = true
	enemy.is_attacking = false
	enemy.is_hurting = true
	enemy.stunned = true

	var target_pos = $AttackMarker.global_position

	while is_instance_valid(enemy) and enemy.global_position.distance_to(target_pos) > 8:

		enemy.global_position = enemy.global_position.move_toward(
			target_pos,
			1800 * get_process_delta_time()
		)

		await get_tree().process_frame

	if not is_instance_valid(enemy):
		return

	enemy.global_position = target_pos
	enemy.velocity = Vector2.ZERO

	enemy.facing = -facing
	enemy.sprite.flip_h = enemy.facing > 0

	await get_tree().create_timer(0.1).timeout

	enemy.take_damage(1)

	enemy.stunned = false
	enemy.is_hurting = false
	enemy.action_locked = false


# =========================================================
# START SPEAR
# =========================================================

func start_spear():

	if state == State.DEAD:
		return

	if health <= 1:
		return

	if action_locked and not is_hurting:
		return

	action_locked = true
	is_attacking = true

	play_anim("spear")

	# PLAY GET OVER HERE SOUND
	getoverhere_sound.play()

	# PLAY SPEAR SOUND
	$Spear.play()

	await get_tree().create_timer(0.15).timeout

	if state == State.DEAD:
		return

	spawn_spear()

	await get_tree().create_timer(0.5).timeout

	if state == State.DEAD:
		return

	is_attacking = false
	action_locked = false
	state = State.IDLE
	velocity.x = 0

	if is_on_floor():
		play_anim("idle")


# =========================================================
# SPAWN SPEAR
# =========================================================

