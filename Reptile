# =========================================================
# COMBO ATTACK
# =========================================================

func combo_attack(attacks: Array):

	if health <= 1:
		return

	action_locked = true
	is_attacking = true

	for attack in attacks:

		if health <= 1:
			break

		if is_hurting or state == State.DEAD:
			break

		play_anim(attack)

		spawn_attack(attack)

		await sprite.animation_finished

	is_attacking = false
	action_locked = false

	if not is_hurting and state != State.DEAD:

		play_anim("idle")


# =========================================================
# DO ACTION
# =========================================================

func do_action(anim_name: String):

	if health <= 1:
		return

	if is_finish_state:
		return

	if state == State.DEAD:
		return

	if action_locked and not is_hurting:
		return

	action_locked = true
	is_attacking = true
	lock_timer = 0.3

	play_anim(anim_name)

	# =====================================================
	# NORMAL ATTACKS
	# =====================================================

	if anim_name in [
		"punch",
		"highpunch",
		"lowpunch",
		"kick",
		"highkick",
		"lowkick",
		"uppercut",
		"roundhousekick",
		"knee",
		"fatalitycombo"
	]:

		spawn_attack(anim_name)

	await get_tree().create_timer(0.5).timeout

	if state == State.DEAD:
		return

	is_attacking = false
	action_locked = false
	hurt_locked = false

	if not is_hurting and not is_finish_state:
		play_anim("idle")


# =========================================================
# SPAWN ATTACK
# =========================================================

func spawn_attack(anim_name: String):

	if anim_name not in [
		"punch",
		"highpunch",
		"lowpunch",
		"kick",
		"highkick",
		"lowkick",
		"uppercut",
		"roundhousekick",
		"knee",
		"fatalitycombo",
		"FATALITY_COMBO"
	]:

		return

	var attack = REPTILE_ATTACK.instantiate()

	get_tree().current_scene.add_child(attack)

	attack.add_to_group("HitBox")

	attack.global_position = attack_marker.global_position
	attack.scale.x = facing

	var dmg := 1

	match anim_name:

		"punch":
			dmg = 1

		"highpunch":
			dmg = 1

		"lowpunch":
			dmg = 1

		"kick":
			dmg = 1

		"highkick":
			dmg = 1

		"lowkick":
			dmg = 1

		"uppercut":
			dmg = 1

		"roundhousekick":
			dmg = 1

		"knee":
			dmg = 1

		"fatalitycombo":
			dmg = 1

		"FATALITY_COMBO":
			dmg = 1

	if attack.has_method("set_damage"):

		attack.set_damage(dmg)

	else:

		attack.damage = dmg

	attack.owner = self
	attack.attack_owner = self
	attack.attack_name = anim_name
	attack.attack_type = anim_name


# =========================================================
# TAKE DAMAGE
# =========================================================

func take_damage(amount: int):

	if state == State.DEAD:
		return

	if is_hurting:
		return

	if not can_take_damage:
		return

	if spawn_protection:
		return

	can_take_damage = false

	await get_tree().create_timer(0.25).timeout

	can_take_damage = true

	if state == State.DEAD:
		return

	# =====================================================
	# BLOCK
	# =====================================================

	if is_blocking:

		amount = max(
			amount - 1,
			0
		)

	if amount <= 0:
		return

	# =====================================================
	# DAMAGE
	# =====================================================

	health -= amount
	health = max(
		health,
		0
	)

	print("Reptile HP: ", health)

	health_changed.emit(health)

	if is_instance_valid(hit_sound):
		hit_sound.play()

	# =====================================================
	# FINISH HIM AT 1 HP
	# =====================================================

	if health == 1 and Game.current_round == 2 and not is_finish_state:

		trigger_finish_state()

		return

	# =====================================================
	# DEAD
	# =====================================================

	if health <= 0:

		is_attacking = false

		die()

		return

	# =====================================================
	# NORMAL HURT
	# =====================================================

	is_hurting = true
	hurt_locked = true
	action_locked = true

	combo.clear()

	is_attacking = false
	is_shooting = false
	is_blocking = false

	state = State.IDLE

	play_anim("hurt")

	if has_node("BloodMarker"):

		var blood = BLOOD_EFFECT.instantiate()

		get_tree().current_scene.add_child(blood)

		blood.global_position = $BloodMarker.global_position

	await get_tree().create_timer(0.25).timeout

	if state == State.DEAD:
		return

	is_hurting = false
	hurt_locked = false
	action_locked = false


# =========================================================
# FINISH HIM
# =========================================================

func trigger_finish_state():

	if is_finish_state:
		return

	is_finish_state = true

	state = State.IDLE

	velocity.x = 0
	velocity.y = 0

	action_locked = true
	hurt_locked = false

	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

	uppercut_launched = false

	play_anim("idle")

	if is_instance_valid(finish_label):

		finish_label.visible = true

		if finish_label.has_method("start_flicker"):

			finish_label.start_flicker(
				2.0,
				0.05
			)

	# =====================================================
	# ALLOW GRAVITY TO DROP REPTILE
	# =====================================================

	await get_tree().create_timer(0.1).timeout

	while not is_on_floor():

		velocity.y += (
			5000.0 *
			get_physics_process_delta_time()
		)

		move_and_slide()

		await get_tree().physics_frame

		if state == State.DEAD:
			return

	velocity = Vector2.ZERO

	await get_tree().create_timer(2.0).timeout

	if is_instance_valid(finish_label):

		finish_label.visible = false


# =========================================================
# DEATH
# =========================================================

func die():

	if state == State.DEAD:
		return

	# =====================================================
	# LOCK DEAD
	# =====================================================

	state = State.DEAD

	velocity = Vector2.ZERO

	is_attacking = false
	is_shooting = false
	action_locked = true
	hurt_locked = true
	is_hurting = false
	is_blocking = false

	can_take_damage = false

	# =====================================================
	# HIDE NORMAL SPRITE
	# =====================================================

	$Sprite.visible = false
	$Crispy.visible = true

	# =====================================================
	# ROUND 1
	# =====================================================

	if Game.current_round == 1:

		if is_in_group("player1"):

			round_death.emit("cpu")

		else:

			round_death.emit("player1")

		await get_tree().create_timer(3.0).timeout

		# =================================================
		# ROUND 2
		# =================================================

		Game.current_round = 2

		# =================================================
		# FIND EXISTING FIGHTERS
		# =================================================

		var p1 = get_tree().get_first_node_in_group(
			"player1"
		)

		var p2 = get_tree().get_first_node_in_group(
			"enemy"
		)

		# =================================================
		# RESET P1
		# =================================================

		if p1 != null and is_instance_valid(p1):

			p1.global_position = Vector2(
				603,
				496
			)

			p1.health = p1.max_health

			p1.velocity = Vector2.ZERO

			p1.state = p1.State.IDLE

			p1.is_hurting = false
			p1.is_attacking = false
			p1.is_shooting = false
			p1.action_locked = false
			p1.hurt_locked = false
			p1.can_take_damage = true

			if "is_finish_state" in p1:
				p1.is_finish_state = false

			if "finish_triggered" in p1:
				p1.finish_triggered = false

			if "dead_locked" in p1:
				p1.dead_locked = false

			if p1.has_node("Sprite"):
				p1.get_node("Sprite").visible = true

			if p1.has_node("Crispy"):
				p1.get_node("Crispy").visible = false

			if p1.has_signal("health_changed"):
				p1.health_changed.emit(
					p1.health
				)

			if p1.has_method("play_anim"):
				p1.play_anim("idle")

		# =================================================
		# RESET P2
		# =================================================

		if p2 != null and is_instance_valid(p2):

			p2.global_position = Vector2(
				1890,
				496
			)

			p2.health = p2.max_health

			p2.velocity = Vector2.ZERO

			p2.state = p2.State.IDLE

			p2.is_hurting = false
			p2.is_attacking = false
			p2.is_shooting = false
			p2.action_locked = false
			p2.hurt_locked = false
			p2.can_take_damage = true

			if "is_finish_state" in p2:
				p2.is_finish_state = false

			if "finish_triggered" in p2:
				p2.finish_triggered = false

			if "dead_locked" in p2:
				p2.dead_locked = false

			if p2.has_node("Sprite"):
				p2.get_node("Sprite").visible = true

			if p2.has_node("Crispy"):
				p2.get_node("Crispy").visible = false

			if p2.has_signal("health_changed"):
				p2.health_changed.emit(
					p2.health
				)

			if p2.has_method("play_anim"):
				p2.play_anim("idle")

		# =================================================
		# RESET THIS REPTILE
		# =================================================

		health = max_health

		global_position = Vector2(
			1890,
			496
		)

		velocity = Vector2.ZERO

		state = State.IDLE

		is_hurting = false
		is_attacking = false
		is_shooting = false
		action_locked = false
		hurt_locked = false
		can_take_damage = true

		is_finish_state = false
		finish_triggered = false
		dead_locked = false
		is_blocking = false
		stunned = false
		is_pulled = false

		pull_target = null
		knockback_x = 0

		$Sprite.visible = true
		$Crispy.visible = false

		health_changed.emit(health)

		play_anim("idle")

		# =================================================
		# RESET HUD
		# =================================================

		var hud = get_tree().get_first_node_in_group(
			"HUD"
		)

		if hud != null and is_instance_valid(hud):

			if hud.has_method("_find_fighters"):
				hud._find_fighters()

			# ONLY RESET THE ACTUAL HEALTH BARS
			# AND Seg1-8.
			# Seg9-32 ARE NOT TOUCHED.

			if hud.has_method("reset_all_health_bars"):
				hud.reset_all_health_bars()

			# =================================================
			# SHOW ROUND 2
			# =================================================

			if hud.has_method("show_round"):

				hud.show_round(2)

		return

	# =====================================================
	# ROUND 2 FINAL DEATH
	# =====================================================

	if Game.current_round == 2:

		var blood = BLOOD_DEATH.instantiate()

		get_tree().current_scene.add_child(blood)

		blood.global_position = global_position

		$Sprite.visible = false
		$Crispy.visible = true

		await get_tree().create_timer(3.0).timeout

		if is_in_group("player1"):

			round_death.emit("cpu")

		else:

			round_death.emit("player1")

		return


# =========================================================
# ANIMATION
# =========================================================

func play_anim(anim_name: String):

	if current_anim == anim_name:
		return

	current_anim = anim_name

	sprite.play(anim_name)


# =========================================================
# ATTACK BULLET
# =========================================================

func spawn_attack_bullet(anim_name: String):

	if anim_name not in [
		"punch",
		"kick",
		"roundhousekick",
		"uppercut"
	]:

		return

	var bullet = BULLET_SCENE.instantiate()

	get_tree().current_scene.add_child(bullet)

	bullet.global_position = $AttackMarker.global_position
	bullet.scale.x = facing

	if "velocity" in bullet:

		bullet.velocity = (
			Vector2(facing, 0) *
			bullet.speed
		)

	if "damage" in bullet:

		bullet.damage = 1

	bullet.owner = self


# =========================================================
# HURT BOX
# =========================================================

func _on_reptile_hurt_box_area_entered(area: Area2D) -> void:

	if hurt_cooldown:
		return

	if area == null or not is_instance_valid(area):
		return

	if not can_take_damage:
		return

	# =====================================================
	# ONLY ACCEPT REAL ATTACK GROUPS
	# =====================================================

	if not (
		area.is_in_group("HitBox")
		or area.is_in_group("ReptileAcid")
		or area.is_in_group("Grab")
		or area.is_in_group("RaidenElectricBullet")
		or area.is_in_group("FireBullet")
		or area.is_in_group("Fireball")
		or area.is_in_group("SonyaBullet")
		or area.is_in_group("JohnnyCageBullet")
		or area.is_in_group("KanoBullet")
		or area.is_in_group("IceBullet")
		or area.is_in_group("KanoAttack")
	):

		return

	hurt_cooldown = true

	# =====================================================
	# ANIMATION
	# =====================================================

	var attack_name = area.get("attack_name")

	if attack_name == "uppercut":

		sprite.play("wasuppercut")

	else:

		sprite.play("hurt")

	# =====================================================
	# SOUND
	# =====================================================

	if is_instance_valid(hurt_sound):
		hurt_sound.play()

	# =====================================================
	# KNOCKBACK
	# =====================================================

	knockback_x = -facing * 100

	# =====================================================
	# DAMAGE
	# =====================================================

	take_damage(1)

	await get_tree().create_timer(0.2).timeout

	hurt_cooldown = false
