func run_pull_logic(delta):

	if pull_target == null or not is_instance_valid(pull_target):

		is_pulled = false
		stunned = false
		action_locked = false

		return

	var dir = sign(
		pull_target.global_position.x -
		global_position.x
	)

	velocity.x = dir * 900
	velocity.y = 0

	pull_timer -= delta

	if pull_timer <= 0.0:

		is_pulled = false

		global_position = (
			pull_target.attack_marker.global_position +
			Vector2(40 * pull_target.facing, 0)
		)

		stunned = false
		is_hurting = false
		action_locked = false
		is_attacking = true

		pull_target = null


