# =========================================================
# STUN
# =========================================================

func apply_stun(_duration := 4.0):

	if state == State.DEAD:
		return

	stunned = true

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	velocity = Vector2.ZERO
	knockback_x = 0

	play_anim("idle")

	await get_tree().create_timer(4.0).timeout

	if state == State.DEAD:
		return

	stunned = false

	is_hurting = false
	hurt_locked = false
	action_locked = false


# =========================================================
# RUN
# =========================================================

func run(input_dir: float):

	if input_dir == 0:
		return

	state = State.RUN
	velocity.x = input_dir * SPEED * 4.0

	if not is_attacking:
		play_anim("run")


# =========================================================
# READY
# =========================================================

func _ready():

	$Sprite.visible = true
	$Crispy.visible = false

	facing = 1

	sprite.flip_h = facing > 0
	$Crispy.flip_h = facing > 0

	add_to_group("Fighter")
	add_to_group("enemy")
	add_to_group("Reptile")

	spawn_locked = false

	health = max_health

	health_changed.emit(health)

	play_anim("idle")

	ai_timer = randf_range(0.2, 0.6)

	if Input.is_action_pressed("jump"):
		velocity.y = jump_velocity


# =========================================================
# INPUT
# =========================================================

func _unhandled_input(event):

	if event.is_action_pressed("jump"):
		velocity.y = jump_velocity

	var inputs = [
		"up",
		"down",
		"left",
		"right",
		"shoot"
	]

	for i in inputs:

		if event.is_action_pressed(i):
			register_input(i)


# =========================================================
# PHYSICS
# =========================================================

func _physics_process(delta):

	if state == State.DEAD:
		return

	# =====================================================
	# STUN
	# =====================================================

	if stunned:

		velocity = Vector2.ZERO
		move_and_slide()

		return

	# =====================================================
	# FINISH HIM STATE
	# =====================================================

	if is_finish_state:

		state = State.IDLE
		velocity.x = 0

		if not is_hurting:
			play_anim("idle")

		velocity.y += GRAVITY * delta

		move_and_slide()

		return

	# =====================================================
	# GRAVITY
	# =====================================================

	velocity.y += GRAVITY * delta

	# =====================================================
	# UPPERCUT LAUNCH
	# =====================================================

	if uppercut_launched:

		move_and_slide()

		if is_on_floor():
			uppercut_launched = false

		return

	# =====================================================
	# COOLDOWNS
	# =====================================================

	shoot_cooldown = max(
		shoot_cooldown - delta,
		0.0
	)

	combo_timer += delta

	if combo_timer > combo_reset_time:
		combo.clear()

	# =====================================================
	# CPU
	# =====================================================

	if is_cpu:

		cpu_logic(delta)

		move_and_slide()

		return

	# =====================================================
	# DEAD
	# =====================================================

	if state == State.DEAD:
		return

	# =====================================================
	# FINISH STATE
	# =====================================================

	if is_finish_state:

		state = State.IDLE
		velocity.x = 0

		if not is_hurting:
			play_anim("idle")

		move_and_slide()

		return

	# =====================================================
	# ACTION LOCK
	# =====================================================

	if action_locked:
		move_and_slide()
		return

	var input_dir = Input.get_axis("left", "right")
	var climb_pressed = Input.is_action_pressed("climb")

	# =====================================================
	# FACING
	# =====================================================

	if input_dir != 0:
		facing = sign(input_dir)

	sprite.flip_h = facing > 0
	$Crispy.flip_h = facing > 0

	$AttackMarker.position = Vector2(
		0 * facing,
		0
	)

	$Reptileshoot.position = Vector2(
		63 * facing,
		-225
	)

	# =====================================================
	# MOVEMENT
	# =====================================================

	if Input.is_action_pressed("run") and input_dir != 0:

		run(input_dir)

	else:

		velocity.x = input_dir * SPEED

		if not is_on_floor():

			state = State.JUMP

		elif input_dir != 0:

			state = State.WALK

		else:

			state = State.IDLE

	# =====================================================
	# ANIMATIONS
	# =====================================================

	match state:

		State.JUMP:

			if not is_attacking:
				play_anim("jump")

		State.WALK:

			if not is_attacking:
				play_anim("walk")

		State.RUN:

			if not is_attacking:
				play_anim("run")

		State.IDLE:

			if not is_attacking:
				play_anim("idle")

	# =====================================================
	# HURT LOCK
	# =====================================================

	if is_hurting and hurt_locked:
		move_and_slide()
		return

	# =====================================================
	# JUMP
	# =====================================================

	if Input.is_action_just_pressed("jump") and is_on_floor():

		velocity.y = jump_velocity

	# =====================================================
	# ATTACKS
	# =====================================================

	if Input.is_action_just_pressed("punch"):

		do_action("punch")

	if Input.is_action_just_pressed("highpunch"):

		do_action("highpunch")

	if Input.is_action_just_pressed("lowpunch"):

		do_action("punch")

	elif Input.is_action_just_pressed("roundhousekick"):

		do_action("roundhousekick")

	elif Input.is_action_just_pressed("kick"):

		do_action("kick")

	elif Input.is_action_just_pressed("highkick"):

		do_action("highkick")

	elif Input.is_action_just_pressed("lowkick"):

		do_action("lowkick")

	elif Input.is_action_just_pressed("uppercut"):

		do_action("uppercut")

	elif Input.is_action_pressed("Reptilesacid"):

		shoot_acid()

	elif Input.is_action_pressed("knee"):

		do_action("knee")

	elif Input.is_action_just_pressed("shoot"):

		if shoot_cooldown <= 0:
			shoot_player()

	elif Input.is_action_pressed("block"):

		start_block()

	elif Input.is_action_pressed("fatalitycombo"):

		do_action("fatalitycombo")

	elif Input.is_action_pressed("FATALITY_COMBO"):

		do_action("fatalitycombo")

	elif Input.is_action_just_pressed("spear"):

		start_spear()

	elif Input.is_action_pressed("invisible"):

		invisible()

	elif Input.is_action_pressed("visible"):

		sprite.visible = true

	else:

		stop_block()

	move_and_slide()


# =========================================================
# BLOCK
# =========================================================

func start_block():

	if state == State.DEAD:
		return

	if is_finish_state:
		return

	is_blocking = true
	state = State.BLOCK

	play_anim("block")


func stop_block():

	if is_blocking:

		is_blocking = false

		if state != State.DEAD:
			state = State.IDLE


# =========================================================
# ACID
# =========================================================

func shoot_acid():

	if shoot_cooldown > 0:
		return

	if health <= 1:
		return

	shoot_cooldown = shoot_cooldown_time

	is_attacking = true
	action_locked = true

	play_anim("shoot")

	var bullet = REPTILES_ACID.instantiate()

	get_tree().current_scene.add_child(bullet)

	bullet.global_position = $Reptileshoot.global_position
	bullet.velocity = Vector2.RIGHT * facing * bullet.speed

	await get_tree().create_timer(0.2).timeout

	if state == State.DEAD:
		return

	is_attacking = false
	action_locked = false


# =========================================================
# INVISIBLE
# =========================================================

func invisible():

	sprite.visible = false


# =========================================================
# CPU LOGIC
# =========================================================

func cpu_logic(delta):

	# =====================================================
	# HURT HAS ABSOLUTE PRIORITY
	# =====================================================

	if is_hurting:

		if is_pulled:

			velocity.x = -facing * -600

		else:

			velocity.x = -facing * 100

		knockback_x = move_toward(
			knockback_x,
			0,
			1500 * delta
		)

		if abs(knockback_x) < 10:

			knockback_x = 0
			is_hurting = false
			is_pulled = false

		return

	# =====================================================
	# TARGET
	# =====================================================

	if target == null or not is_instance_valid(target):

		velocity.x = 0

		return

	# =====================================================
	# FINISH HIM / 1 HP
	# =====================================================

	if health <= 1:

		health = 1

		is_attacking = false
		is_shooting = false
		is_blocking = false
		velocity.x = 0

		combo.clear()

		# Do NOT disable is_cpu.
		# The CPU must remain alive so the finish state works.

		if not is_finish_state:

			if Game.current_round == 2:
				trigger_finish_state()

		return

	# =====================================================
	# ACTION LOCK
	# =====================================================

	if action_locked:
		return

	var dist = target.global_position.x - global_position.x
	var direction = sign(dist)

	if direction == 0:
		direction = facing

	# =====================================================
	# TIMER
	# =====================================================

	ai_timer -= delta

	# =====================================================
	# FACING
	# =====================================================

	facing = direction

	sprite.flip_h = facing > 0
	$Crispy.flip_h = facing > 0

	# =====================================================
	# MOVEMENT
	# =====================================================

	if not is_attacking:

		if abs(dist) > 220:

			velocity.x = direction * SPEED * 0.8
			state = State.WALK

			play_anim("walk")

		else:

			velocity.x = direction * SPEED * 0.8
			state = State.WALK

			play_anim("walk")

	# =====================================================
	# AI ACTIONS
	# =====================================================

	if ai_timer > 0:
		return

	match Game.difficulty:

		"Hard":

			ai_timer = randf_range(
				0.05,
				0.15
			)

			var choice = randi() % 100

			if choice < 20:

				do_action("punch")

			elif choice < 35:

				do_action("highpunch")

			elif choice < 45:

				do_action("lowpunch")

			elif choice < 60:

				do_action("kick")

			elif choice < 70:

				do_action("highkick")

			elif choice < 80:

				do_action("lowkick")

			elif choice < 88:

				do_action("uppercut")

			elif choice < 94:

				do_action("roundhousekick")

			elif choice < 97:

				start_spear()

			else:

				shoot_player()

		"Easy":

			ai_timer = randf_range(
				0.5,
				0.9
			)

			var choice = randi() % 100

			if choice < 40:

				do_action("punch")

			elif choice < 55:

				do_action("kick")

			elif choice < 65:

				do_action("highkick")

			elif choice < 75:

				do_action("lowkick")

			elif choice < 85:

				do_action("uppercut")

			elif choice < 92:

				start_spear()

			else:

				do_action("roundhousekick")

		_:

			ai_timer = randf_range(
				0.25,
				0.5
			)

			var choice = randi() % 100

			if choice < 50:

				do_action("punch")

			elif choice < 75:

				do_action("kick")

			elif choice < 90:

				do_action("uppercut")

			else:

				shoot_player()


# =========================================================
# PULL ENEMY
# =========================================================

func pull_enemy(enemy: CharacterBody2D):

	if enemy == null or not is_instance_valid(enemy):
		return

	enemy.velocity = Vector2.ZERO
	enemy.action_locked = true
	enemy.is_attacking = false
	enemy.is_hurting = true
	enemy.stunned = true

	var target_pos = $AttackMarker.global_position

	while is_instance_valid(enemy) and enemy.global_position.distance_to(target_pos) > 8:

		enemy.global_position = enemy.global_position.move_toward(
			target_pos,
			1800 * get_process_delta_time()
		)

		await get_tree().process_frame

	if not is_instance_valid(enemy):
		return

	enemy.global_position = target_pos
	enemy.velocity = Vector2.ZERO

	enemy.facing = -facing
	enemy.sprite.flip_h = enemy.facing > 0

	await get_tree().create_timer(0.1).timeout

	enemy.take_damage(1)

	enemy.stunned = false
	enemy.is_hurting = false
	enemy.action_locked = false


# =========================================================
# START SPEAR
# =========================================================

func start_spear():

	if state == State.DEAD:
		return

	if health <= 1:
		return

	if action_locked and not is_hurting:
		return

	action_locked = true
	is_attacking = true

	play_anim("spear")

	await get_tree().create_timer(0.15).timeout

	if state == State.DEAD:
		return

	spawn_spear()

	await get_tree().create_timer(0.5).timeout

	if state == State.DEAD:
		return

	is_attacking = false
	action_locked = false
	state = State.IDLE
	velocity.x = 0

	if is_on_floor():
		play_anim("idle")


# =========================================================
# SPAWN SPEAR
# =========================================================

func spawn_spear():

	var spear = SPEAR_SCENE.instantiate()

	get_tree().current_scene.add_child(spear)

	spear.global_position = $Reptileshoot.global_position
	spear.velocity = Vector2(facing, 0) * 2000
	spear.owner_character = self


# =========================================================
# SPEAR PULL
# =========================================================

func spear_pulled_to_p1():

	is_pulled = true
	pull_timer = 0.35
	stunned = true
	action_locked = true

	pull_target = get_tree().get_first_node_in_group("P1")


func run_pull_logic(delta):

	if pull_target == null or not is_instance_valid(pull_target):

		is_pulled = false
		stunned = false
		action_locked = false

		return

	var dir = sign(
		pull_target.global_position.x -
		global_position.x
	)

	velocity.x = dir * 900
	velocity.y = 0

	pull_timer -= delta

	if pull_timer <= 0.0:

		is_pulled = false

		global_position = (
			pull_target.attack_marker.global_position +
			Vector2(40 * pull_target.facing, 0)
		)

		stunned = false
		is_hurting = false
		action_locked = false
		is_attacking = true

		pull_target = null


# =========================================================
# SHOOT
# =========================================================

func shoot_player():

	if health <= 1:
		return

	if is_finish_state:
		return

	if state == State.DEAD:
		return

	if is_shooting:
		return

	is_shooting = true
	is_attacking = true
	action_locked = true

	play_anim("shoot")

	$Reptileshoot.position = Vector2(
		88.9 * facing,
		-225
	)

	var bullet_scene: PackedScene = BULLET_SCENE

	if special_bullet != null:

		bullet_scene = special_bullet
		special_bullet = null

	var bullet = bullet_scene.instantiate()

	get_tree().current_scene.add_child(bullet)

	await get_tree().process_frame

	if state == State.DEAD:
		return

	bullet.global_position = $Reptileshoot.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	await get_tree().create_timer(0.25).timeout

	if state == State.DEAD:
		return

	is_shooting = false
	is_attacking = false
	action_locked = false

	if not is_hurting and not is_finish_state:
		play_anim("idle")


# =========================================================
# REGISTER INPUT
# =========================================================

func register_input(input: String):

	if not is_in_group("player1"):
		return

	if health <= 1:
		return

	combo.append(input)

	combo_timer = 0.0

	check_combos()


# =========================================================
# SPAWN FX
# =========================================================

func spawn_fx(scene: PackedScene):

	var fx = scene.instantiate()

	fx.owner_character = self
	fx.damage_done = false

	get_tree().current_scene.call_deferred(
		"add_child",
		fx
	)

	await get_tree().process_frame

	if target and is_instance_valid(target):

		fx.global_position = (
			target.global_position +
			Vector2(60 * facing, 0)
		)

	else:

		fx.global_position = (
			global_position +
			Vector2(80 * facing, 0)
		)


# =========================================================
# CHECK COMBOS
# =========================================================

func check_combos():

	# =====================================================
	# FIRE
	# =====================================================

	if combo == FIRE_COMBO:

		combo_used.emit("fire")

		special_bullet = FIRE_BULLET

		combo.clear()

		shoot_player()

		return

	# =====================================================
	# ELECTRIC
	# =====================================================

	elif combo == ELECTRIC_COMBO:

		combo_used.emit("electric")

		spawn_fx(ELECTRIC_DEATH)

		special_bullet = ELECTRIC_BULLET

		combo.clear()

		return

	# =====================================================
	# KICK
	# =====================================================

	elif combo == KICK_COMBO:

		combo_used.emit("kick_combo")

		combo.clear()

		start_kick_combo()

		return

	# =====================================================
	# PUNCH
	# =====================================================

	elif combo == PUNCH_COMBO:

		combo_used.emit("punch_combo")

		combo.clear()

		start_punch_combo()

		return

	# =====================================================
	# FATALITY
	# =====================================================

	elif combo == FATALITY_COMBO:

		combo_used.emit("fatality_combo")

		combo.clear()

		do_action("fatalitycombo")

		return


# =========================================================
# FATALITY
# =========================================================

func start_fatality():

	if state == State.DEAD:
		return

	action_locked = true
	is_attacking = true

	play_anim("fatalitycombo")

	spawn_attack("fatalitycombo")

	await sprite.animation_finished

	is_attacking = false
	action_locked = false


