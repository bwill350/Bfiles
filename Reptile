# =========================================================
# TAKE DAMAGE
# =========================================================

func take_damage(amount: int):

	# =====================================================
	# BASIC DAMAGE LOCKS
	# =====================================================

	if not can_take_damage:
		return

	if state == State.DEAD:
		return

	if spawn_protection:
		return


	# =====================================================
	# PREVENT MULTIPLE DAMAGE ON SAME PHYSICS FRAME
	# =====================================================

	var frame := Engine.get_physics_frames()

	if has_meta("last_damage_frame"):

		if get_meta("last_damage_frame") == frame:
			return

	set_meta("last_damage_frame", frame)


	# =====================================================
	# TEMPORARY DAMAGE COOLDOWN
	# =====================================================

	can_take_damage = false

	get_tree().create_timer(0.25).timeout.connect(
		func():

			if is_instance_valid(self) and state != State.DEAD:
				can_take_damage = true
	)


	# =====================================================
	# BLOCK REDUCTION
	# =====================================================

	if is_blocking:

		amount = max(
			amount - 1,
			0
		)

	if amount <= 0:
		return


	# =====================================================
	# APPLY DAMAGE
	# =====================================================

	health -= amount
	health = max(
		health,
		0
	)

	print("================================")
	print("REPTILE TOOK DAMAGE: ", amount)
	print("REPTILE HP: ", health)
	print("ROUND: ", Game.current_round)
	print("================================")

	health_changed.emit(health)


	# =====================================================
	# HIT SOUND
	# =====================================================

	if is_instance_valid(hit_sound):
		hit_sound.play()


	# =====================================================
	# FINAL HIT
	# =====================================================

	if health <= 0:

		is_attacking = false
		is_shooting = false
		is_hurting = false
		is_blocking = false

		if is_instance_valid(finish_label):
			finish_label.visible = false

		die()

		return


	# =====================================================
	# FINISH HIM
	# =====================================================
	#
	# ONLY trigger FINISH HIM when the opponent already
	# has 1 round win.
	#
	# This means killing Reptile will give the opponent
	# their SECOND round win.
	#
	# Game.current_round is NOT used here.
	# =====================================================

	if health == 1 and not is_finish_state:

		var opponent_will_win_match := false


		# =================================================
		# REPTILE IS PLAYER 1
		# =================================================

		if is_in_group("player1"):

			# CPU already has 1 round win.
			if Game.p2_round_wins >= 1:
				opponent_will_win_match = true


		# =================================================
		# REPTILE IS CPU
		# =================================================

		else:

			# Player 1 already has 1 round win.
			if Game.p1_round_wins >= 1:
				opponent_will_win_match = true


		# =================================================
		# TRIGGER FINISH HIM
		# =================================================

		if opponent_will_win_match:

			is_hurting = false
			hurt_locked = false
			action_locked = false

			trigger_finish_state()

			return


	# =====================================================
	# NORMAL HURT
	# =====================================================

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	state = State.IDLE

	combo.clear()

	play_anim("hurt")


	# =====================================================
	# HURT SOUND
	# =====================================================

	if is_instance_valid(hurt_sound):
		hurt_sound.play()


	# =====================================================
	# BLOOD EFFECT
	# =====================================================

	if has_node("BloodMarker"):

		var blood = BLOOD_EFFECT.instantiate()

		get_tree().current_scene.add_child(blood)

		blood.global_position = $BloodMarker.global_position


	# =====================================================
	# HURT DURATION
	# =====================================================

	await get_tree().create_timer(0.25).timeout

	if state == State.DEAD:
		return

	is_hurting = false
	hurt_locked = false
	action_locked = false


	# =====================================================
	# RETURN TO IDLE
	# =====================================================

	if state != State.DEAD and not is_finish_state:

		play_anim("idle")


# =========================================================
# FINISH HIM
# =========================================================



func trigger_finish_state():

	if is_finish_state:
		return

	is_finish_state = true

	state = State.IDLE

	velocity.x = 0
	velocity.y = 0

	action_locked = true
	hurt_locked = false

	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

	uppercut_launched = false

	play_anim("idle")

	if is_instance_valid(finish_label):

		finish_label.visible = true

		if finish_label.has_method("start_flicker"):

			finish_label.start_flicker(
				2.0,
				0.05
			)

	# =====================================================
	# ALLOW GRAVITY TO DROP REPTILE
	# =====================================================

	await get_tree().create_timer(0.1).timeout

	while not is_on_floor():

		velocity.y += (
			5000.0 *
			get_physics_process_delta_time()
		)

		move_and_slide()

		await get_tree().physics_frame

		if state == State.DEAD:
			return

	velocity = Vector2.ZERO

	await get_tree().create_timer(2.0).timeout

	if is_instance_valid(finish_label):

		finish_label.visible = false


# =========================================================
# DEATH
# =========================================================

func die():

	# =====================================================
	# ALREADY DEAD
	# =====================================================

	if state == State.DEAD:
		return

	# =====================================================
	# LOCK REPTILE AS DEAD
	# =====================================================

	state = State.DEAD

	velocity = Vector2.ZERO

	is_attacking = false
	is_shooting = false
	is_blocking = false
	is_hurting = false

	action_locked = true
	hurt_locked = true

	can_take_damage = false

	stunned = false
	special_move_invincible = false

	uppercut_launched = false
	jumpkick_launched = false

	is_pulled = false
	pull_timer = 0.0
	pull_target = null

	knockback_x = 0.0

	# =====================================================
	# STOP CPU
	# =====================================================

	ai_timer = 999999.0

	# =====================================================
	# HIDE FINISH HIM
	# =====================================================

	if is_instance_valid(finish_label):
		finish_label.visible = false

	# =====================================================
	# DETERMINE ROUND WINNER
	# =====================================================

	var winner := ""

	if is_in_group("player1"):
		winner = "cpu"
	else:
		winner = "player1"

	# =====================================================
	# DEBUG
	# =====================================================

	print("================================")
	print("REPTILE DIED")
	print("ROUND: ", Game.current_round)
	print(
		"CURRENT SCORE: ",
		Game.p1_round_wins,
		" - ",
		Game.p2_round_wins
	)
	print("ROUND WINNER: ", winner)
	print("================================")

	# =====================================================
	# DETERMINE IF THIS DEATH ENDS THE MATCH
	# =====================================================

	var match_will_end := false

	if winner == "player1":

		if Game.p1_round_wins >= 1:
			match_will_end = true

	else:

		if Game.p2_round_wins >= 1:
			match_will_end = true

	print("MATCH WILL END: ", match_will_end)

	# =====================================================
	# DEATH VISUAL
	# =====================================================
	#
	# ROUND 1 = HEALTHZERO
	# ROUND 2+ = CRISPY
	#
	# THIS IS DONE ONLY ONCE.
	# NOTHING BELOW CHANGES THE DEATH SPRITE.
	# =====================================================

	if Game.current_round == 1:

		# -------------------------------------------------
		# ROUND 1
		# PLAY HEALTHZEROa
		# -------------------------------------------------

		$Crispy.visible = false
		$Sprite.visible = false

		current_anim = ""
		$healthzero.flip_h = facing > 0
		$healthzero.visible = true

		print("================================")
		print("REPTILE ROUND 1 DEATH")
		print("PLAYING HEALTHZERO")
		print("================================")

	else:

		# -------------------------------------------------
		# ROUND 2 / ROUND 3
		# PLAY CRISPY
		# -------------------------------------------------

		$Sprite.visible = false
		$Crispy.visible = true

		$Crispy.flip_h = facing > 0

		print("================================")
		print("REPTILE ROUND ", Game.current_round, " DEATH")
		print("PLAYING CRISPY")
		print("================================")

	# =====================================================
	# FINAL MATCH DEATH
	# =====================================================

	if match_will_end:

		print("================================")
		print("REPTILE FINAL DEATH")
		print("FATALITY ALLOWED")
		print("================================")

		# -------------------------------------------------
		# BLOOD DEATH EFFECT
		# -------------------------------------------------

		if BLOOD_DEATH != null:

			var blood = BLOOD_DEATH.instantiate()

			get_tree().current_scene.add_child(blood)

			blood.global_position = global_position

		# -------------------------------------------------
		# WAIT FOR FINAL DEATH / FATALITY
		# -------------------------------------------------

		await get_tree().create_timer(13.0).timeout

		# -------------------------------------------------
		# TELL LEVEL1 WHO WON
		# -------------------------------------------------

		round_death.emit(winner)

		# -------------------------------------------------
		# WAIT 5 MORE SECONDS
		# -------------------------------------------------

		print("================================")
		print("WAITING 5 SECONDS BEFORE MAIN MENU")
		print("================================")

		await get_tree().create_timer(5.0).timeout

		# -------------------------------------------------
		# GO TO MAIN MENU
		# -------------------------------------------------

		print("================================")
		print("REPTILE FATALITY COMPLETE")
		print("RETURNING TO MAIN MENU")
		print("================================")

		get_tree().change_scene_to_file("res://MainMenu.tscn")

		return

	# =====================================================
	# NORMAL ROUND DEATH
	# =====================================================
	#
	# Match is NOT over.
	#
	# IMPORTANT:
	# DO NOT CHANGE $Sprite OR $Crispy HERE.
	# The death visual was already selected above.
	# =====================================================

	print("================================")
	print("REPTILE ROUND DEATH")
	print("NO FATALITY")
	print("LEVEL1 WILL HANDLE NEXT ROUND")
	print("================================")

	# =====================================================
	# HIDE FINISH HIM
	# =====================================================

	if is_instance_valid(finish_label):
		finish_label.visible = false

	# =====================================================
	# TELL LEVEL1
	# =====================================================

	round_death.emit(winner)

	return

