var combo_timer := 0.0

@onready var finish_label: Sprite2D = $HUD/FinishLabel/Sprite2D

const ACID_COMBO = ["down", "down", "down", "right", "shoot"]
const FIRE_COMBO = ["down", "right", "shoot"]
const ICE_COMBO = ["left", "left", "shoot"]
const ELECTRIC_COMBO = ["up", "down", "shoot"]

func apply_stun(duration: float):
	if state == State.DEAD:
		return

	# already stunned → refresh timer only
	if stunned:
		return

	stunned = true
	action_locked = true
	is_attacking = false
	is_shooting = false
	velocity = Vector2.ZERO



	await get_tree().create_timer(duration).timeout

	stunned = false
	action_locked = false

func run(input_dir: float):
	if input_dir == 0:
		return

	state = State.RUN
	velocity.x = input_dir * SPEED * 4  # faster than walk

	if not is_attacking:
		play_anim("walk")

# ---------------- READY ----------------
func _ready():

	add_to_group("Fighter")
	add_to_group("enemy")
	add_to_group("Reptile")

	spawn_locked = false

	health = max_health
	health_changed.emit(health)

	play_anim("idle")

	ai_timer = randf_range(0.2, 0.6)
# ---------------- INPUT ----------------
func _unhandled_input(event):

	if is_cpu:
		return

	if event.is_action_pressed("up"):
		register_input("up")

	elif event.is_action_pressed("down"):
		register_input("down")

	elif event.is_action_pressed("left"):
		register_input("left")

	elif event.is_action_pressed("right"):
		register_input("right")

	elif event.is_action_pressed("shoot"):
		register_input("shoot")

# ---------------- PHYSICS ----------------
func _physics_process(delta):

	# ---------------- STUN ----------------
	if stunned:
		velocity = Vector2.ZERO
		move_and_slide()
		return

	shoot_cooldown = max(shoot_cooldown - delta, 0.0)

	combo_timer += delta

	if combo_timer > combo_reset_time:
		combo.clear()

	if is_cpu:
		
		if is_pulled:
			run_pull_logic(delta)
			move_and_slide()
			return
		
		cpu_logic(delta)
		move_and_slide()
		return

	if state == State.DEAD:
		return

	if is_finish_state:
		state = State.IDLE
		velocity.x = 0

		if not is_hurting:
			play_anim("idle")

		move_and_slide()
		return

	# ---------------- GRAVITY ----------------
	velocity.y += GRAVITY * delta

	if action_locked:
		return

	var input_dir = Input.get_axis("left", "right")
	var climb_pressed = Input.is_action_pressed("climb")

	# ---------------- FACING ----------------
	if input_dir != 0:
		facing = input_dir

	sprite.flip_h = facing > 0

	$AttackMarker.position = Vector2(63 * facing, -155)
	$Reptileshoot.position = Vector2(63 * facing, -155)

	# =========================================================
	# 🟢 MOVEMENT (RUN ADDED HERE)
	# =========================================================
	if Input.is_action_pressed("run") and input_dir != 0:
		run(input_dir)   # 🔥 CALLS YOUR NEW RUN FUNCTION
	else:
		velocity.x = input_dir * SPEED

		# ---------------- STATE ----------------
		if not is_on_floor():
			state = State.JUMP
		elif input_dir != 0:
			state = State.WALK
		elif input_dir != 0:
			state = State.RUN
		else:
			state = State.IDLE

	# ---------------- ANIMS ----------------
	match state:

		State.CLIMB:
			velocity.y = -CLIMB_SPEED
			if not is_attacking:
				play_anim("idle")

		State.JUMP:
			if not is_attacking:
				play_anim("jump")

		State.WALK:
			if not is_attacking:
				play_anim("walk")

		State.RUN:
			if not is_attacking:
				play_anim("run")

		State.IDLE:
			if not is_attacking:
				play_anim("idle")

	if is_hurting and hurt_locked:
		return

	# ---------------- JUMP ----------------
	if Input.is_action_just_pressed("jump") and is_on_floor():
		velocity.y = jump_velocity

	# ---------------- ATTACKS ----------------
	if Input.is_action_just_pressed("jumpkick"):
		do_action("jumpkick")

	elif Input.is_action_just_pressed("punch"):
		do_action("punch")

	elif Input.is_action_just_pressed("roundhousekick"):
		do_action("roundhousekick")

	elif Input.is_action_just_pressed("kick"):
		do_action("kick")

	elif Input.is_action_just_pressed("uppercut"):
		do_action("uppercut")

	elif Input.is_action_pressed("Reptilesacid"):
		shoot_acid()

	elif Input.is_action_just_pressed("shoot"):
		if shoot_cooldown <= 0:
			shoot_player()

	elif Input.is_action_pressed("block"):
		start_block()

	elif Input.is_action_just_pressed("spear"):
		do_action("spear")

	elif Input.is_action_just_pressed("run"):
		do_action("run")

	else:
		stop_block()

	move_and_slide()

# ---------------- BLOCK ----------------
func start_block():

	if state == State.DEAD:
		return

	is_blocking = true
	state = State.BLOCK

	play_anim("block")

func stop_block():

	if is_blocking:
		is_blocking = false
		state = State.IDLE

# ---------------- ACID SHOOT ----------------
func shoot_acid():

	if shoot_cooldown > 0:
		return

	shoot_cooldown = shoot_cooldown_time
	is_attacking = true
	action_locked = true

	play_anim("shoot")

	var bullet = REPTILES_ACID.instantiate()
	get_tree().current_scene.add_child(bullet)

	bullet.global_position = $Reptileshoot.global_position
	bullet.velocity = Vector2.RIGHT * facing * bullet.speed

	await get_tree().create_timer(0.2).timeout

	is_attacking = false
	action_locked = false


# ---------------- CPU ----------------
func cpu_logic(delta):
	# ---------------- HURT PRIORITY ----------------
	if is_hurting:

		
		velocity.x = -facing * 400

	# gradually reduce knockback
		knockback_x = move_toward(knockback_x, 0, 1500 * delta)

		if abs(knockback_x) < 10:
			knockback_x = 0
			is_hurting = false

			velocity.y += GRAVITY * delta
			move_and_slide()
			return

	if target == null or !is_instance_valid(target):
		velocity.x = 0
		return

# GRAVITY
	velocity.y += GRAVITY * delta

	var dist = target.global_position.x - global_position.x
	var direction = sign(dist)

	# HARD LOCK (Liu Kang style behavior)
	if action_locked:
		return

# STOP ALL ACTIONS AT 1HP
	if is_finish_state:
		is_attacking = false
		action_locked = true
		velocity.x = 0
		move_and_slide()
		return

	ai_timer -= delta

	velocity.y += GRAVITY * delta
	facing = direction
	sprite.flip_h = facing > 0

# GRAVITY
	velocity.y += GRAVITY * delta


# ---------------- MOVEMENT ----------------
	if abs(dist) > 220:

		velocity.x = direction * SPEED * 0.8

	if state != State.RUN:
		state = State.RUN

	if not is_attacking:
		play_anim("walk")

	if abs(dist) > 220:
		velocity.x = direction * SPEED * 0.8
		state = State.RUN
		play_anim("walk")
	else:
		velocity.x = direction * SPEED * 0.8
		state = State.RUN
		play_anim("walk")

	# ---------------- AI ACTIONS ----------------
	if ai_timer <= 0:

		ai_timer = randf_range(0.4, 0.8)

		match randi() % 5:

			0:
				do_action("punch")

			1:
				do_action("kick")

			2:
				do_action("uppercut")

			3:
				do_action("roundhousekick")

			4:
				shoot_player()

# ---------------- ACTION ----------------
func do_action(anim_name: String):

	if state == State.DEAD:
		return

	if is_finish_state:
		return

	if spawn_protection:
		return

	if action_locked:
		return

	action_locked = true
	is_attacking = true
	lock_timer = 0.6


	play_anim(anim_name)

	if anim_name == "spear":
		spawn_spear()

	elif anim_name in [
		"punch",
		"kick",
		"roundhousekick",
		"uppercut",
		"jumpkick"
	]:
		spawn_attack(anim_name)

	await get_tree().create_timer(0.3).timeout

	is_attacking = false
	action_locked = false



func pull_enemy(enemy: Node2D):

	if enemy == null:
		return

	if not is_instance_valid(enemy):
		return

	enemy.velocity = Vector2.ZERO
	enemy.action_locked = true
	enemy.is_attacking = false
	enemy.is_hurting = true

	var pull_time := 0.25
	var t := 0.0

	while t < pull_time and is_instance_valid(enemy):

		var dir = sign(global_position.x - enemy.global_position.x)

		enemy.velocity.x = dir * 900
		enemy.velocity.y = -120

		enemy.move_and_slide()

		await get_tree().process_frame
		t += get_process_delta_time()

	# SNAP to attacker (Scorpion grab finish)
	enemy.global_position = global_position + Vector2(40 * facing, 0)

	enemy.is_hurting = false
	enemy.action_locked = false

	# OPTIONAL: force hit after pull
	enemy.take_damage(1)

func start_spear():

	if state == State.DEAD:
		return

	if action_locked:
		return

	action_locked = true
	is_attacking = true

	play_anim("spear")

	await get_tree().create_timer(0.15).timeout

	spawn_spear()

	await sprite.animation_finished

	is_attacking = false
	action_locked = false

func spawn_spear():

	var spear = SPEAR_SCENE.instantiate()
	get_tree().current_scene.add_child(spear)

	spear.global_position = $Reptileshoot.global_position
	spear.velocity = Vector2(facing, 0) * 2000

	spear.owner_character = self



func spear_pulled_to_p1():
	is_pulled = true
	pull_timer = 0.35
	stunned = true
	action_locked = true
	pull_target = get_tree().get_first_node_in_group("P1")

func run_pull_logic(delta):

	if pull_target == null or !is_instance_valid(pull_target):
		is_pulled = false
		stunned = false
		action_locked = false
		return

	var dir = sign(pull_target.global_position.x - global_position.x)

	velocity.x = dir * 900
	velocity.y = -120

	pull_timer -= delta

	if pull_timer <= 0.0:

		is_pulled = false

		# SNAP to Reptile AttackMarker (THIS IS MK MOMENT)
		global_position = pull_target.attack_marker.global_position + Vector2(40 * pull_target.facing, 0)

		stunned = false
		is_hurting = false
		action_locked = false
		is_attacking = true

		pull_target = null

# ---------------- ATTACK ----------------
func spawn_attack(anim_name: String):

	# ---------------- NORMAL MELEE ----------------
	if anim_name in [
		"punch",
		"kick",
		"uppercut",
		"roundhousekick",
		"jumpkick"
	]:

		var attack = REPTILE_ATTACK.instantiate()
		get_tree().current_scene.add_child(attack)

		attack.global_position = $AttackMarker.global_position
		attack.scale.x = facing

		var dmg := 1

		match anim_name:
			"uppercut":
				dmg = 1
			"roundhousekick":
				dmg = 1
			"punch":
				dmg = 1

		if attack.has_method("set_damage"):
			attack.set_damage(dmg)
		else:
			attack.damage = dmg

		attack.owner = self
		return


	# ---------------- SPEAR ATTACK ----------------
	if anim_name == "spear":

		var spear = SPEAR_SCENE.instantiate()
		get_tree().current_scene.add_child(spear)

		# spawn from marker (important for MK feel)
		spear.global_position = $Reptileshoot.global_position

		spear.scale.x = facing

		# damage
		if spear.has_method("set_damage"):
			spear.set_damage(1)
		else:
			spear.damage = 1

		# optional movement
		if spear.has_variable("velocity"):
			spear.velocity = Vector2(facing, 0) * 1200

		spear.owner = self

# ---------------- SHOOT ----------------
func shoot_player():

	if is_finish_state:
		return

	if state == State.DEAD:
		return

	if is_shooting:
		return

	is_shooting = true
	is_attacking = true
	action_locked = true

	play_anim("shoot")

	# ✅ MOVE MARKER FIRST
	$Reptileshoot.position = Vector2(88.9 * facing, -14.6)

	var bullet_scene: PackedScene

	if special_bullet != null:
		bullet_scene = special_bullet
		special_bullet = null
	else:
		bullet_scene = BULLET_SCENE

	var bullet = bullet_scene.instantiate()
	get_tree().current_scene.add_child(bullet)

	# optional but safe after add
	await get_tree().process_frame

	# ✅ NOW POSITION IS CORRECT
	bullet.global_position = $Reptileshoot.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	if bullet.has_node("Sprite2D"):
		bullet.get_node("Sprite2D").flip_h = facing < 0

	if bullet.has_node("AnimatedSprite2D"):
		bullet.get_node("AnimatedSprite2D").flip_h = facing < 0

	await get_tree().create_timer(0.25).timeout

	is_shooting = false

	if is_hurting:
		is_attacking = false
		action_locked = false
		return

	if state == State.DEAD:
		return

	is_attacking = false
	action_locked = false

	play_anim("idle")

# ---------------- DAMAGE ----------------
func take_damage(amount: int):

	if not can_take_damage:
		return

	can_take_damage = false

	await get_tree().create_timer(0.25).timeout

	can_take_damage = true

	if state == State.DEAD:
		return

	if spawn_protection:
		return

# Allow fatal blow during Finish Him state
	if is_finish_state and health > 1:
		return

	# BLOCK REDUCTION
	if is_blocking:
		amount = max(amount - 1, 0)

	if amount <= 0:
		return

	health -= amount
	health = max(health, 0)

	print("Reptile took damage: ", amount, " HP=", health)

	health_changed.emit(health)
	hit_sound.play()

# ---------------- FINISH HIM ----------------
	if health == 1 and not is_finish_state:
		trigger_finish_state()
		return

	# ---------------- FINAL HIT ----------------
	if health <= 0:

		finish_label.visible = false

		await get_tree().create_timer(0.5).timeout

		get_tree().change_scene_to_file("res://CharacterSelect.tscn")
		return

	# ---------------- NORMAL HURT ----------------
	is_hurting = true
	hurt_locked = true
	action_locked = true

	state = State.IDLE

	play_anim("hurt")

	var blood = BLOOD_EFFECT.instantiate()
	get_tree().current_scene.add_child(blood)
	blood.global_position = $BloodMarker.global_position

	await get_tree().create_timer(0.25).timeout

	is_hurting = false
	hurt_locked = false
	action_locked = false

func trigger_finish_state():

	if is_finish_state:
		return

	is_finish_state = true

	state = State.IDLE
	velocity = Vector2.ZERO

	action_locked = true
	hurt_locked = false
	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

	play_anim("idle")

	finish_label.visible = true

	if finish_label.has_method("start_flicker"):
		finish_label.start_flicker(2.0, 0.05)
		die()
	await get_tree().create_timer(2.0).timeout

	if is_instance_valid(finish_label):
		finish_label.visible = false

	# KEEP SONYA IDLE AT 1 HP
	state = State.IDLE
	velocity = Vector2.ZERO

	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

	play_anim("idle")

# ---------------- COMBOS ----------------
func register_input(input: String):

	combo.append(input)

	combo_timer = 0.0

	check_combos()

func spawn_fx(scene: PackedScene):

	var fx = scene.instantiate()

	# IMPORTANT: set owner BEFORE it can collide
	fx.owner_character = self
	fx.damage_done = false

	get_tree().current_scene.call_deferred("add_child", fx)

	await get_tree().process_frame

	if target and is_instance_valid(target):
		fx.global_position = target.global_position + Vector2(60 * facing, 0)
	else:
		fx.global_position = global_position + Vector2(80 * facing, 0)

func check_combos():

	# ---------------- ACID ----------------
	if combo == ACID_COMBO:

		combo_used.emit("acid")

		special_bullet = ACID_BULLET

		combo.clear()
		return

	# ---------------- FIRE ----------------
	elif combo == FIRE_COMBO:

		combo_used.emit("fire")

		spawn_fx(FIRE_DEATH)

		special_bullet = FIRE_BULLET

		combo.clear()
		return

	# ---------------- ICE ----------------
	elif combo == ICE_COMBO:

		combo_used.emit("ice")

		spawn_fx(ICE_DEATH)

		special_bullet = ICE_BULLET

		combo.clear()
		return

	# ---------------- ELECTRIC ----------------
	elif combo == ELECTRIC_COMBO:

		combo_used.emit("electric")

		spawn_fx(ELECTRIC_DEATH)

		special_bullet = ELECTRIC_BULLET

		combo.clear()
		return

# ---------------- DEATH ----------------
func die():

	if state == State.DEAD:
		return

	state = State.DEAD

	var death = BLOOD_DEATH.instantiate()
	get_tree().current_scene.add_child(death)
	death.global_position = global_position

	velocity = Vector2.ZERO

	is_attacking = false
	is_shooting = false
	action_locked = true
	hurt_locked = true

	hide() # optional, hides fighter while blood effect plays

	# Let BloodDeath animation play
	await get_tree().create_timer(2.0).timeout

	get_tree().change_scene_to_file("res://CharacterSelect.tscn")

# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):
	if current_anim == anim_name:
		return

	current_anim = anim_name

	sprite.play(anim_name)
	return

func _on_reptile_hurt_box_area_entered(area: Area2D) -> void:

	if area == null or !is_instance_valid(area):
		return

	# ---------------- BASIC BLOCKS ----------------
	if hurt_cooldown:
		return

	if not can_take_damage:
		return

	# Allow fatal blow during Finish Him state
	if is_finish_state and health > 1:
		return

	# ---------------- GENERIC IGNORES ----------------
	if area.is_in_group("HurtBox"):
		return

	if area.is_in_group("ReptileSpear"):
		return

	if area.is_in_group("ReptileBullet"):
		return
	if area.is_in_group("ReptileAcid"):
		return

	# ---------------- HITBOX ----------------
	if area.is_in_group("HitBox"):
		hurt_cooldown = true

		knockback_x = -facing * 400
		velocity.y = -200

		take_damage(1)

		is_hurting = true
		action_locked = true
		is_attacking = false

		await get_tree().create_timer(0.15).timeout
		hurt_cooldown = false
		return

	# ---------------- SUBZERO BULLET ----------------
	if area.is_in_group("SubzeroBullet"):
		hurt_cooldown = true

		apply_stun(3.0)

		knockback_x = -facing * 400
		take_damage(1)

		is_hurting = true
		action_locked = true
		is_attacking = false

		await get_tree().create_timer(0.15).timeout
		hurt_cooldown = false
		return

	# ---------------- ELEMENTAL / PROJECTILES ----------------
	if area.is_in_group("RaidenElectricBullet") \
	or area.is_in_group("ElectricForceField") \
	or area.is_in_group("ElectricBurst") \
	or area.is_in_group("ElectricBullet") \
	or area.is_in_group("KanoBullet") \
	or area.is_in_group("FireBullet") \
	or area.is_in_group("Fireball") \
	or area.is_in_group("JohnnyCageBullet"):

		hurt_cooldown = true

