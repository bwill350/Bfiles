extends CharacterBody2D
class_name Reptile

signal health_changed(health)
signal combo_used(combo_name: String)

enum State { IDLE, JRUN, JJUMP, JJUMPKICK, JBLOCK, JPUNCH, JCLIMB, DEAD }

var state: State = State.IDLE

var is_hurting := false
var is_shooting := false
var can_shoot := false
var action_locked := false
var hurt_locked := false

var facing := -1
var last_facing_dir := -1
var current_anim := ""

var health: int
var can_take_damage := true
var already_hit := false

const GRAVITY = 5000

@export var SPEED = 900.0
@export var JCLIMB_SPEED = 250.0
@export var max_health: int = 300
@export var jjump_velocity = -1800.0
@export var combo_reset_time := 0.6

const FIRE_DEATH = preload("res://Deaths/FireDeath.tscn")
const ICE_DEATH = preload("res://Deaths/IceDeath.tscn")
const ELECTRIC_DEATH = preload("res://Deaths/ElectricDeath.tscn")
const BRUTALITY_DEATH = preload("res://Deaths/FireDeath.tscn")

const FATALITY_1 = preload("res://Deaths/Fatality1.tscn")
const FATALITY_2 = preload("res://Deaths/Fatality2.tscn")
const FATALITY_3 = preload("res://Deaths/Fatality3.tscn")

const BULLET_SCENE = preload("res://Projectiles/Reptilebullet.tscn")

@onready var sprite: AnimatedSprite2D = $Sprite
@onready var hit_sound: AudioStreamPlayer2D = $Hit
@onready var hit_box: Area2D = $HitBox
@onready var shoot_marker: Marker2D = $Reptileshoot

# ---------------- COMBO SYSTEM ----------------
var combo := []
var combo_timer := 0.0

const FIRE_COMBO = ["jdown", "jright", "jshoot"]
const ICE_COMBO = ["jleft", "jleft", "jshoot"]
const ELECTRIC_COMBO = ["jup", "jdown", "jshoot"]

# ---------------- READY ----------------
func _ready():
	add_to_group("enemy")
	health = max_health
	play_anim("jidle")

	hit_box.area_entered.connect(_on_hit_box_area_entered)
	hit_box.body_entered.connect(_on_hit_box_body_entered)
	hit_box.body_exited.connect(_on_hit_box_body_exited)

# ---------------- INPUT (COMBOS ONLY) ----------------
func _unhandled_input(event):
	if event.is_action_pressed("jup"):
		register_input("jup")
	elif event.is_action_pressed("jdown"):
		register_input("jdown")
	elif event.is_action_pressed("jleft"):
		$Sprite.play("jwalk")
		register_input("jleft")
	elif event.is_action_pressed("jright"):
		$Sprite.play("jwalk")
		register_input("jright")
	elif event.is_action_pressed("jshoot"):
		register_input("jshoot")

# ---------------- PHYSICS ----------------
func _physics_process(delta):

	# STOP EVERYTHING IF HURT OR ACTION LOCKED
	if action_locked or hurt_locked:
		move_and_slide()
		return

	var input_dir = Input.get_axis("jleft", "jright")
	var jclimb_pressed = Input.is_action_pressed("jclimb")
	var on_wall = is_on_wall()

	velocity.y += GRAVITY * delta

	# ---------------- FACING ----------------
	if input_dir != 0:
		facing = input_dir
		last_facing_dir = input_dir

	velocity.x = input_dir * SPEED
	sprite.flip_h = facing > 0

	# ---------------- STATE ----------------
	if jclimb_pressed and not is_on_floor() and on_wall:
		state = State.JCLIMB
	elif not is_on_floor():
		state = State.JJUMP
	elif input_dir != 0:
		state = State.JRUN
	else:
		state = State.IDLE

	# ---------------- ANIMATIONS ----------------
	match state:
		State.JCLIMB:
			velocity.y = -JCLIMB_SPEED
			play_anim("jclimb")

		State.JJUMP:
			play_anim("jjump")

		State.JRUN:
			play_anim("jright")

		State.IDLE:
			play_anim("jidle")

	# ---------------- ACTIONS ----------------
	if Input.is_action_just_pressed("jjump") and is_on_floor():
		velocity.y = jjump_velocity

	if Input.is_action_just_pressed("jjumpkick"):
		do_action("jjumpkick")

	elif Input.is_action_pressed("jblock"):
		do_action("jblock")

	elif Input.is_action_just_pressed("jpunch"):
		do_action("jpunch")

	elif Input.is_action_just_pressed("jshoot"):
		shoot_player()

	move_and_slide()

# ---------------- ACTION HANDLER ----------------
func do_action(anim_name: String):
	action_locked = true
	play_anim(anim_name)
	await sprite.animation_finished
	action_locked = false
	state = State.IDLE
	play_anim("jidle")

# ---------------- SHOOT ----------------
func shoot_player():
	if state == State.DEAD or is_shooting:
		return

	is_shooting = true
	play_anim("jshoot")

	var bullet = BULLET_SCENE.instantiate()
	get_tree().current_scene.add_child(bullet)
	bullet.global_position = shoot_marker.global_position

	var dir = Vector2(facing, 0)
	if "velocity" in bullet:
		bullet.velocity = dir * bullet.speed

	await sprite.animation_finished
	is_shooting = false
	play_anim("jidle")

# ---------------- DAMAGE ----------------
func take_damage(amount: int):
	if state == State.DEAD or not can_take_damage:
		return

	can_take_damage = false
	is_hurting = true
	hurt_locked = true

	hit_sound.play()

	health -= amount
	health = max(health, 0)
	health_changed.emit(health)

	state = State.IDLE
	play_anim("jhurt")

	sprite.modulate = Color(1, 0, 0)

	await sprite.animation_finished

	sprite.modulate = Color.WHITE
	is_hurting = false
	can_take_damage = true
	already_hit = false
	hurt_locked = false

	if health <= 0:
		die()
	else:
		state = State.IDLE
		play_anim("jidle")

# ---------------- HITBOX ----------------
func _on_hit_box_body_entered(body):
	if body.is_in_group("player"):
		can_shoot = true

func _on_hit_box_body_exited(body):
	if body.is_in_group("player"):
		can_shoot = false

func _on_hit_box_area_entered(area):
	if already_hit:
		return

	if area.is_in_group("Bullet"):
		already_hit = true
		area.queue_free()
		take_damage(10)

# ---------------- DEATH ----------------
func die():
	state = State.DEAD
	velocity = Vector2.ZERO

	var death_instance = BRUTALITY_DEATH.instantiate()
	death_instance.global_position = global_position
	get_tree().current_scene.add_child(death_instance)

	queue_free()

# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):
	if current_anim == anim_name:
		return
	current_anim = anim_name
	sprite.play(anim_name)

# ---------------- COMBOS ----------------
func register_input(input: String):
	combo.append(input)
	combo_timer = 0.0
	check_combos()

func check_combos():
	if combo == FIRE_COMBO:
		combo_used.emit("fire")
		combo.clear()
	elif combo == ICE_COMBO:
		combo_used.emit("ice")
		combo.clear()
	elif combo == ELECTRIC_COMBO:
		combo_used.emit("electric")
		combo.clear()
