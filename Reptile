extends CharacterBody2D
class_name Reptile

signal health_changed(health)

enum State { PATROL, AGGRESSIVE, DEAD }

var state: State = State.PATROL
var is_hurting := false
var is_shooting := false
var can_shoot := false

var current_anim := ""
var facing := -1 # -1 left, 1 right

@export var max_health: int = 300
@export var move_speed: float = 140.0
@export var shoot_interval: float = 2.0

var health: int

const BULLET_SCENE = preload("res://Projectiles/Reptilebullet.tscn")

@onready var sprite: AnimatedSprite2D = $Sprite
@onready var hit_sound: AudioStreamPlayer2D = $Hit
@onready var hit_box: Area2D = $HitBox
@onready var shoot_timer: Timer = $ShootTimer
@onready var flash_timer: Timer = $HitFlashTimer
@onready var shoot_marker: Marker2D = $Reptileshoot

# ---------------- DAMAGE COOLDOWN FIX ----------------
var damage_cooldown := 0.0
@export var damage_cooldown_time := 0.25


# ---------------- READY ----------------
func _ready():
	add_to_group("enemy")

	health = max_health
	play_anim("idle")

	hit_box.area_entered.connect(_on_hit_box_area_entered)
	hit_box.body_entered.connect(_on_hit_box_body_entered)

	shoot_timer.wait_time = shoot_interval
	shoot_timer.timeout.connect(shoot_player)
	shoot_timer.start()

	flash_timer.timeout.connect(_end_flash)


# ---------------- PHYSICS (CHASE DUKE) ----------------
func _physics_process(delta):
	if state == State.DEAD:
		return

	# cooldown timer
	if damage_cooldown > 0:
		damage_cooldown -= delta

	var players = get_tree().get_nodes_in_group("player")
	if players.is_empty():
		return

	var player = players[0]

	var dir = (player.global_position - global_position).normalized()

	velocity = dir * move_speed
	move_and_slide()

	# facing fix
	if dir.x != 0:
		facing = 1 if dir.x > 0 else -1
		sprite.flip_h = facing == 1

	if not is_hurting and not is_shooting:
		play_anim("walk")


# ---------------- SHOOT SYSTEM ----------------
func shoot_player():
	if state == State.DEAD:
		return

	if not can_shoot:
		return

	is_shooting = true
	play_anim("shoot")

	var bullet = BULLET_SCENE.instantiate()
	bullet.global_position = shoot_marker.global_position

	# direction toward Duke
	var players = get_tree().get_nodes_in_group("player")
	if players.is_empty():
		return

	var player = players[0]
	var dir = (player.global_position - shoot_marker.global_position).normalized()

	# keep your bullet system intact
	if "velocity" in bullet:
		bullet.velocity = dir * bullet.speed

	# GREEN BULLET FIX
	if "modulate" in bullet:
		bullet.modulate = Color(0.2, 1, 0.2)

	bullet.rotation = dir.angle()

	get_tree().current_scene.add_child(bullet)

	await sprite.animation_finished

	is_shooting = false

	if state != State.DEAD and not is_hurting:
		play_anim("idle")


# ---------------- DETECTION ----------------
func _on_hit_box_body_entered(body):
	if body.is_in_group("player"):
		can_shoot = true
		shoot_player()


func _on_hit_box_area_entered(area):
	if area.is_in_group("Bullet"):
		area.queue_free()
		take_damage(10)


# ---------------- DAMAGE (FIXED - NO STUCK STATE) ----------------
func take_damage(amount: int):
	if state == State.DEAD:
		return

	# cooldown prevents spam but NEVER breaks detection
	if damage_cooldown > 0:
		return

	damage_cooldown = damage_cooldown_time

	hit_sound.play()

	health -= amount
	health = max(health, 0)
	health_changed.emit(health)

	is_hurting = true
	play_anim("hurt")

	sprite.modulate = Color(1, 0, 0)
	flash_timer.start(0.12)

	await sprite.animation_finished

	is_hurting = false

	if health <= 0:
		die()
		return

	play_anim("idle")


func _end_flash():
	sprite.modulate = Color(1, 1, 1)


# ---------------- DEATH ----------------
func die():
	if state == State.DEAD:
		return

	state = State.DEAD
	shoot_timer.stop()
	velocity = Vector2.ZERO
	queue_free()


# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):
	if current_anim == anim_name:
		return

	current_anim = anim_name
	sprite.play(anim_name)
