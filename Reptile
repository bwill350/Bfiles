extends CharacterBody2D
class_name Reptile

signal health_changed(health)
signal combo_used(combo_name: String)

var shoot_cooldown: float = 0.0
# ---------------- STATE ----------------
enum State { IDLE, JRUN, JJUMP, JJUMPKICK, JBLOCK, JPUNCH, JCLIMB, DEAD }
var special_bullet: PackedScene = null
var state: State = State.IDLE

# ---------------- CPU ----------------
var is_cpu := false
var target: Node2D = null
var ai_timer := 0.0

# ---------------- COMBAT FLAGS ----------------
var is_hurting := false
var is_shooting := false
var is_attacking := false
var action_locked := false
var hurt_locked := false

var facing := 1
var current_anim := ""

var health: int
var can_take_damage := true

const GRAVITY = 5000
const REPTILES_ACID = preload("res://Projectiles/Reptilesacid.tscn")
const BLOOD_EFFECT = preload("res://GreenBloodEffect.tscn")
# ---------------- EXPORTS ----------------
@export var shoot_cooldown_time: float = 0.25
@export var SPEED = 900.0
@export var JCLIMB_SPEED = 250.0
@export var max_health: int = 10
@export var jjump_velocity = -1800.0
@export var combo_reset_time := 0.6

# ---------------- PRELOADS ----------------
const BULLET_SCENE = preload("res://Projectiles/Reptilebullet.tscn")

const FIRE_BULLET = preload("res://Projectiles/FireBullet.tscn")
const ICE_BULLET = preload("res://Projectiles/IceBullet.tscn")
const ELECTRIC_BULLET = preload("res://Projectiles/ElectricBullet.tscn")

const REPTILE_ATTACK = preload("res://Projectiles/ReptileAttack.tscn")
const BLOOD_DEATH = preload("res://Deaths/BloodDeath.tscn")
const ICE_DEATH = preload("res://Deaths/IceDeath.tscn")
# ---------------- COMBO FX ----------------
const FIRE_DEATH = preload("res://Deaths/FireDeath.tscn")
const ELECTRIC_DEATH = preload("res://Deaths/ElectricDeath.tscn")

# ---------------- NODES ----------------
@onready var sprite: AnimatedSprite2D = $Sprite
@onready var hit_sound: AudioStreamPlayer2D = $Hit
@onready var hurt_box: Area2D = $ReptileHurtBox
@onready var shoot_marker: Marker2D = $Reptileshoot
@onready var attack_marker: Marker2D = $AttackMarker
@onready var blood_marker: Marker2D = $BloodMarker

# ---------------- COMBOS ----------------
var combo := []
var combo_timer := 0.0

const FIRE_COMBO = ["jdown", "jright", "jshoot"]
const ICE_COMBO = ["jleft", "jleft", "jshoot"]
const ELECTRIC_COMBO = ["jup", "jdown", "jshoot"]

var current_combo_element := "fire"

# ---------------- READY ----------------
func _ready():

	add_to_group("enemy")
	add_to_group("Reptile")

	health = max_health
	health_changed.emit(health)

	play_anim("jidle")

	if hurt_box:
		if not hurt_box.area_entered.is_connected(_on_Reptile_Hurt_Box_area_entered):
			hurt_box.area_entered.connect(_on_Reptile_Hurt_Box_area_entered)

# ---------------- INPUT ----------------
func _unhandled_input(event):

	if is_cpu:
		return

	if event.is_action_pressed("jup"):
		register_input("jup")

	elif event.is_action_pressed("jdown"):
		register_input("jdown")

	elif event.is_action_pressed("jleft"):
		register_input("jleft")

	elif event.is_action_pressed("jright"):
		register_input("jright")

	elif event.is_action_pressed("jshoot"):
		register_input("jshoot")

# ---------------- PHYSICS ----------------
func _physics_process(delta):
	move_and_slide()
	velocity.x = move_toward(velocity.x, 0, 0)
	shoot_cooldown = max(shoot_cooldown - delta, 0.0)
	combo_timer += delta

	if combo_timer > combo_reset_time:
		combo.clear()

	if is_cpu:
		cpu_logic(delta)
		move_and_slide()
		return

	if state == State.DEAD:
		return

	if action_locked or hurt_locked:
		move_and_slide()
		return

	var input_dir = Input.get_axis("jleft", "jright")
	var climb_pressed = Input.is_action_pressed("jclimb")

	velocity.y += GRAVITY * delta

	if input_dir != 0:
		facing = input_dir

	velocity.x = input_dir * SPEED

	sprite.flip_h = facing > 0

	if climb_pressed and not is_on_floor() and is_on_wall():
		state = State.JCLIMB

	elif not is_on_floor():
		state = State.JJUMP

	elif input_dir != 0:
		state = State.JRUN

	else:
		state = State.IDLE

	match state:

		State.JCLIMB:
			velocity.y = -JCLIMB_SPEED
			play_anim("jclimb")

		State.JJUMP:
			play_anim("jjump")

		State.JRUN:
			play_anim("jwalk")

		State.IDLE:
			play_anim("jidle")

	if Input.is_action_just_pressed("jjump") and is_on_floor():
		velocity.y = jjump_velocity

	if Input.is_action_just_pressed("jjumpkick"):
		do_action("jjumpkick")

	elif Input.is_action_pressed("jblock"):
		do_action("jblock")

	elif Input.is_action_just_pressed("jpunch"):
		do_action("jpunch")

	elif Input.is_action_pressed("jroundhousekick"):
		do_action("jroundhousekick")

	elif Input.is_action_pressed("jkick"):
		do_action("jkick")

	elif Input.is_action_pressed("juppercut"):
		do_action("juppercut")

	elif Input.is_action_just_pressed("jshoot"):
		shoot_player()

	elif Input.is_action_just_pressed("Reptilesacid"):
		if shoot_cooldown <= 0:
			shoot_acid()
	
	move_and_slide()

func shoot_acid():

	if shoot_cooldown > 0:
		return

	shoot_cooldown = shoot_cooldown_time

	is_attacking = true

	play_anim("jshoot")

	var bullet = REPTILES_ACID.instantiate()
	get_tree().current_scene.add_child(bullet)

	bullet.global_position = shoot_marker.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	await sprite.animation_finished

	is_attacking = false
	play_anim("jidle")

# ---------------- CPU ----------------
func cpu_logic(delta):

	if target == null:
		return

	if action_locked or hurt_locked:
		return

	ai_timer -= delta

	var dist = target.global_position.x - global_position.x
	var dir = sign(dist)
	var abs_dist = abs(dist)

	facing = dir

	sprite.flip_h = facing > 0

	velocity.y += GRAVITY * delta

	if abs_dist > 220:

		velocity.x = dir * SPEED * 0.8

		if state != State.JRUN:
			state = State.JRUN
			play_anim("jwalk")

	else:

		velocity.x = 0

		if state != State.IDLE:
			state = State.IDLE
			play_anim("jidle")

		if ai_timer <= 0:
			ai_timer = randf_range(0.4, 0.8)
			do_action("jpunch")

# ---------------- ACTION ----------------
func do_action(anim_name: String):

	if state == State.DEAD:
		return

	if action_locked:
		return

	action_locked = true
	is_attacking = true

	play_anim(anim_name)

	if anim_name in ["jpunch", "jkick", "jroundhousekick", "juppercut"]:

		$ReptileAttack.enable_hitbox()
		spawn_attack()

	await sprite.animation_finished

	$ReptileAttack.disable_hitbox()

	is_attacking = false
	action_locked = false

	play_anim("jidle")

# ---------------- ATTACK ----------------
func spawn_attack():

	var attack = REPTILE_ATTACK.instantiate()

	get_tree().current_scene.add_child(attack)

	attack.global_position = attack_marker.global_position

# ---------------- SHOOT ----------------
func shoot_player():

	if is_shooting:
		return

	is_shooting = true
	is_attacking = true

	play_anim("jshoot")

	var bullet_scene: PackedScene

	# ---------------- SPECIAL BULLET ----------------
	if special_bullet != null:

		bullet_scene = special_bullet

		# reset back to normal after one special shot
		special_bullet = null

	else:

		# normal default projectile
		bullet_scene = BULLET_SCENE

	var bullet = bullet_scene.instantiate()

	get_tree().current_scene.add_child(bullet)

	bullet.global_position = shoot_marker.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	await sprite.animation_finished

	is_shooting = false
	is_attacking = false

	play_anim("jidle")

# ---------------- DAMAGE ----------------
func take_damage(amount: int):

	if state == State.DEAD:
		return

	if not can_take_damage:
		return

	can_take_damage = false

	is_hurting = true
	hurt_locked = true

	health -= amount
	health = max(health, 0)

	health_changed.emit(health)

	hit_sound.play()
	play_anim("jhurt")

	# short guaranteed hurt time
	await get_tree().create_timer(0.15).timeout

	is_hurting = false
	hurt_locked = false
	can_take_damage = true

	var blood = BLOOD_EFFECT.instantiate()
	get_tree().current_scene.add_child(blood)
	blood.global_position = blood_marker.global_position

	if health <= 0:
		die()
	else:
		play_anim("jidle")

# ---------------- COMBOS ----------------
func register_input(input: String):

	combo.append(input)

	combo_timer = 0.0

	check_combos()

func spawn_fx(scene: PackedScene):

	var fx = scene.instantiate()

	get_tree().current_scene.add_child(fx)

	if target and target.has_node("FIRE"):
		fx.global_position = target.get_node("FIRE").global_position

	else:
		fx.global_position = global_position + Vector2(80, 0)

	get_tree().create_timer(1.0).timeout.connect(func():
		if is_instance_valid(fx):
			fx.queue_free()
	)

func check_combos():

	if combo == FIRE_COMBO:

		combo_used.emit("fire")

		spawn_fx(FIRE_DEATH)

		special_bullet = FIRE_BULLET

		combo.clear()

	elif combo == ICE_COMBO:

		combo_used.emit("ice")

		spawn_fx(ICE_DEATH)

		special_bullet = ICE_BULLET

		combo.clear()

	elif combo == ELECTRIC_COMBO:

		combo_used.emit("electric")

		spawn_fx(ELECTRIC_DEATH)

		special_bullet = ELECTRIC_BULLET

		combo.clear()
# ---------------- DEATH ----------------
func die():

	state = State.DEAD

	velocity = Vector2.ZERO

	var death = BLOOD_DEATH.instantiate()

	death.global_position = global_position

	get_tree().current_scene.add_child(death)

	queue_free()

# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):

	if current_anim == anim_name:
		return

	current_anim = anim_name

	sprite.play(anim_name)



func _on_Reptile_Hurt_Box_area_entered(area: Area2D) -> void:

	if area == null:
		return

	# Subzero melee attack
	if area.is_in_group("SubzeroAttack"):
		take_damage(1)
		return

	# Subzero bullets
	if area.is_in_group("Subzerobullet"):
		take_damage(1)
		return

	# Elemental deaths
	if area.is_in_group("FireDeath"):
		take_damage(1)
		return

	if area.is_in_group("IceDeath"):
		take_damage(1)
		return

	if area.is_in_group("ElectricDeath"):
		take_damage(1)
		return
