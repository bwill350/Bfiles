# =========================================================
# COMBO ATTACK
# =========================================================

func combo_attack(attacks: Array):

	if health <= 1:
		return

	if state == State.DEAD:
		return

	if is_hurting or is_finish_state:
		return

	action_locked = true
	is_attacking = true
	state = State.PUNCH

	for attack in attacks:

		# -----------------------------------------
		# STOP COMBO IF INTERRUPTED
		# -----------------------------------------

		if health <= 1:
			break

		if state == State.DEAD:
			break

		if is_hurting:
			break

		if is_finish_state:
			break

		# -----------------------------------------
		# PLAY ATTACK
		# -----------------------------------------

		current_anim = ""
		play_anim(attack)

		spawn_attack(attack)

		# -----------------------------------------
		# WAIT FOR THIS ATTACK TO FINISH
		# -----------------------------------------

		await sprite.animation_finished

		# -----------------------------------------
		# CHECK AGAIN AFTER ANIMATION
		# -----------------------------------------

		if health <= 1:
			break

		if state == State.DEAD:
			break

		if is_hurting:
			break

		if is_finish_state:
			break

	# =================================================
	# COMBO FINISHED
	# =================================================

	is_attacking = false
	action_locked = false
	hurt_locked = false

	if state != State.DEAD and not is_hurting and not is_finish_state:

		state = State.IDLE
		velocity.x = 0

		current_anim = ""
		play_anim("idle")


