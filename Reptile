extends CharacterBody2D
class_name Reptile

signal health_changed(health)

enum State { PATROL, AGGRESSIVE, DEAD }
enum DeathType { NONE, FIRE, ICE, ELECTRIC, BRUTALITY, FATALITY_1, FATALITY_2, FATALITY_3 }

var state: State = State.PATROL

var is_hurting := false
var is_shooting := false
var can_shoot := false

var facing := -1
var current_anim := ""

var health: int

# 🔒 DAMAGE LOCK FIX
var can_take_damage := true
var already_hit := false

@export var max_health: int = 300
@export var move_speed: float = 140.0
@export var shoot_interval: float = 2.0

# 💀 DEATH SCENES
const FIRE_DEATH = preload("res://Deaths/FireDeath.tscn")
const ICE_DEATH = preload("res://Deaths/IceDeath.tscn")
const ELECTRIC_DEATH = preload("res://Deaths/ElectricDeath.tscn")
const BRUTALITY_DEATH = preload("res://Deaths/FireDeath.tscn")

const FATALITY_1 = preload("res://Deaths/Fatality1.tscn")
const FATALITY_2 = preload("res://Deaths/Fatality2.tscn")
const FATALITY_3 = preload("res://Deaths/Fatality3.tscn")

const BULLET_SCENE = preload("res://Projectiles/Reptilebullet.tscn")

@onready var sprite: AnimatedSprite2D = $Sprite
@onready var hit_sound: AudioStreamPlayer2D = $Hit
@onready var hit_box: Area2D = $HitBox
@onready var shoot_timer: Timer = $ShootTimer
@onready var flash_timer: Timer = $HitFlashTimer
@onready var shoot_marker: Marker2D = $Reptileshoot

# ---------------- COMBO SYSTEM ----------------
var queued_death: DeathType = DeathType.NONE
var waiting_finisher := false


# ---------------- READY ----------------
func _ready():
	add_to_group("enemy")

	health = max_health
	play_anim("idle")

	hit_box.area_entered.connect(_on_hit_box_area_entered)
	hit_box.body_entered.connect(_on_hit_box_body_entered)
	hit_box.body_exited.connect(_on_hit_box_body_exited)

	shoot_timer.wait_time = shoot_interval
	shoot_timer.timeout.connect(shoot_player)
	shoot_timer.start()

	flash_timer.timeout.connect(_end_flash)

	var dukes = get_tree().get_nodes_in_group("Duke")
	if not dukes.is_empty():
		dukes[0].combo_used.connect(_on_duke_combo_used)


# ---------------- DUKE COMBO ----------------
func _on_duke_combo_used(combo_name: String):
	match combo_name:
		"fire":
			queued_death = DeathType.FIRE
		"ice":
			queued_death = DeathType.ICE
		"electric":
			queued_death = DeathType.ELECTRIC

	waiting_finisher = true


# ---------------- UPDATE ----------------
func _physics_process(_delta):
	if state == State.DEAD:
		return

	var players = get_tree().get_nodes_in_group("player")
	if players.is_empty():
		return

	var player = players[0]
	var dir = (player.global_position - global_position).normalized()

	velocity = dir * move_speed
	move_and_slide()

	if dir.x != 0:
		facing = 1 if dir.x > 0 else -1
		sprite.flip_h = facing == 1

	if not is_hurting and not is_shooting:
		play_anim("walk")


# ---------------- SHOOT ----------------
func shoot_player():
	if state == State.DEAD:
		return
	if not can_shoot:
		return
	if is_shooting:
		return

	is_shooting = true
	play_anim("shoot")

	var bullet = BULLET_SCENE.instantiate()
	bullet.global_position = shoot_marker.global_position

	var dir = Vector2(facing, 0)

	if bullet.has_method("set_velocity") or "velocity" in bullet:
		bullet.velocity = dir * bullet.speed

	bullet.rotation = dir.angle()

	get_tree().current_scene.add_child(bullet)

	await sprite.animation_finished

	is_shooting = false

	if state != State.DEAD and not is_hurting:
		play_anim("idle")


# ---------------- HIT ----------------
func _on_hit_box_body_entered(body):
	if body.is_in_group("player"):
		can_shoot = true
		shoot_player()


func _on_hit_box_body_exited(body):
	if body.is_in_group("player"):
		can_shoot = false


func _on_hit_box_area_entered(area):
	if already_hit:
		return

	if area.is_in_group("Bullet"):
		already_hit = true
		area.queue_free()
		take_damage(10)


# ---------------- DAMAGE ----------------
func take_damage(amount: int):
	if state == State.DEAD:
		return
	if not can_take_damage:
		return

	can_take_damage = false
	is_hurting = true

	hit_sound.play()

	health -= amount
	health = max(health, 0)
	health_changed.emit(health)

	play_anim("hurt")

	sprite.modulate = Color(1, 0, 0)
	flash_timer.start(0.12)

	await sprite.animation_finished

	is_hurting = false
	can_take_damage = true
	already_hit = false

	if health <= 0:
		die()
		return

	play_anim("idle")


# ---------------- FLASH RESET ----------------
func _end_flash():
	sprite.modulate = Color(1, 1, 1)


# ---------------- DEATH ----------------
func die():
	if state == State.DEAD:
		return

	state = State.DEAD
	shoot_timer.stop()
	velocity = Vector2.ZERO

	if waiting_finisher:
		return

	play_death(DeathType.BRUTALITY)


# ---------------- FINISHER ----------------
func _process(_delta):
	if Input.is_action_just_pressed("finisher") and waiting_finisher:
		execute_finisher()


func execute_finisher():
	waiting_finisher = false
	play_death(queued_death)


# ---------------- DEATH EXECUTION ----------------
func play_death(type: DeathType):
	if state == State.DEAD and not waiting_finisher:
		pass

	var death_instance

	match type:
		DeathType.FIRE:
			death_instance = FIRE_DEATH.instantiate()
		DeathType.ICE:
			death_instance = ICE_DEATH.instantiate()
		DeathType.ELECTRIC:
			death_instance = ELECTRIC_DEATH.instantiate()
		DeathType.BRUTALITY:
			death_instance = BRUTALITY_DEATH.instantiate()
		DeathType.FATALITY_1:
			death_instance = FATALITY_1.instantiate()
		DeathType.FATALITY_2:
			death_instance = FATALITY_2.instantiate()
		DeathType.FATALITY_3:
			death_instance = FATALITY_3.instantiate()
		_:
			queue_free()
			return

	death_instance.global_position = global_position
	get_tree().current_scene.add_child(death_instance)

	queue_free()


# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):
	if current_anim == anim_name:
		return

	current_anim = anim_name
	sprite.play(anim_name)
