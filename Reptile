func apply_stun(_duration := 4.0):

	if state == State.DEAD:
		return

	stunned = true

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	velocity = Vector2.ZERO
	knockback_x = 0

	play_anim("idle")

	await get_tree().create_timer(4.0).timeout

	stunned = false

	is_hurting = false
	hurt_locked = false
	action_locked = false

func run(input_dir: float):
	if input_dir == 0:
		return

	state = State.RUN
	velocity.x = input_dir * SPEED * 4  # faster than walk

	if not is_attacking:
		play_anim("walk")

# ---------------- READY ----------------
func _ready():
	$Sprite.visible = true
	$Crispy.visible = false
	facing = 1
	sprite.flip_h = -facing < 0
	$Crispy.flip_h = -facing < 0
	add_to_group("Fighter")
	add_to_group("enemy")
	add_to_group("Reptile")

	spawn_locked = false

	health = max_health
	health_changed.emit(health)

	play_anim("idle")

	ai_timer = randf_range(0.2, 0.6)

# ---------------- INPUT ----------------
func _unhandled_input(event):

	var inputs = ["up", "down", "left", "right", "shoot"]

	for i in inputs:
		if event.is_action_pressed(i):
			register_input(i)

# ---------------- PHYSICS ----------------
func _physics_process(delta):

	if state == State.DEAD:
		return

	# ---------------- STUN ----------------
	if stunned:
		velocity = Vector2.ZERO
		move_and_slide()
		return

	# ---------------- DEATH / FINISH ----------------
	if state == State.DEAD:
		return

	if is_finish_state:
		state = State.IDLE
		velocity.x = 0
		if not is_hurting:
			play_anim("idle")
		move_and_slide()
		return

	# ---------------- GRAVITY ----------------
	velocity.y += GRAVITY * delta

	if uppercut_launched:

		move_and_slide()

		if is_on_floor():
			uppercut_launched = false

		return

	# ---------------- COOLDOWNS ----------------
	shoot_cooldown = max(shoot_cooldown - delta, 0.0)

	combo_timer += delta
	if combo_timer > combo_reset_time:
		combo.clear()

	# ---------------- CPU ----------------
	if is_cpu:
		cpu_logic(delta)
		move_and_slide()
		return

	if state == State.DEAD:
		return

	if is_finish_state:
		state = State.IDLE
		velocity.x = 0

		if not is_hurting:
			play_anim("idle")

		move_and_slide()
		return

	if action_locked:
		return

	var input_dir = Input.get_axis("left", "right")
	var climb_pressed = Input.is_action_pressed("climb")

	# ---------------- FACING ----------------
	if input_dir != 0:
		facing = sign(input_dir)

	sprite.flip_h = facing > 0
	$Crispy.flip_h = facing > 0

	$AttackMarker.position = Vector2(63 * facing, -155)
	$Reptileshoot.position = Vector2(63 * facing, -225)

	# =========================================================
	# 🟢 MOVEMENT (RUN ADDED HERE)
	# =========================================================
	if Input.is_action_pressed("run") and input_dir != 0:
		run(input_dir)   # 🔥 CALLS YOUR NEW RUN FUNCTION
	else:
		velocity.x = input_dir * SPEED

		# ---------------- STATE ----------------
		if not is_on_floor():
			state = State.JUMP
		elif input_dir != 0:
			state = State.WALK
		elif input_dir != 0:
			state = State.RUN
		else:
			state = State.IDLE

	# ---------------- ANIMS ----------------
	match state:

		State.CLIMB:
			velocity.y = -CLIMB_SPEED
			if not is_attacking:
				play_anim("idle")

		State.JUMP:
			if not is_attacking:
				play_anim("jump")

		State.WALK:
			if not is_attacking:
				play_anim("walk")

		State.RUN:
			if not is_attacking:
				play_anim("run")

		State.IDLE:
			if not is_attacking:
				play_anim("idle")

	if is_hurting and hurt_locked:
		return

	# ---------------- JUMP ----------------
	if Input.is_action_just_pressed("jump") and is_on_floor():
		velocity.y = jump_velocity

	# ---------------- ATTACKS ----------------
	if Input.is_action_just_pressed("punch"):
		do_action("punch")

	if Input.is_action_just_pressed("highpunch"):
		do_action("highpunch")

	if Input.is_action_just_pressed("lowpunch"):
		do_action("punch")

	elif Input.is_action_just_pressed("roundhousekick"):
		do_action("roundhousekick")

	elif Input.is_action_just_pressed("kick"):
		do_action("kick")

	elif Input.is_action_just_pressed("highkick"):
		do_action("highkick")

	elif Input.is_action_just_pressed("lowkick"):
		do_action("lowkick")

	elif Input.is_action_just_pressed("uppercut"):
		do_action("uppercut")

	elif Input.is_action_pressed("Reptilesacid"):
		shoot_acid()

	elif Input.is_action_pressed("knee"):
		do_action("knee")

	elif Input.is_action_just_pressed("shoot"):
		if shoot_cooldown <= 0:
			shoot_player()

	elif Input.is_action_pressed("block"):
		start_block()

	elif Input.is_action_pressed("fatalitycombo"):
		do_action("fatalitycombo")

	elif Input.is_action_pressed("FATALITY_COMBO"):
		do_action("fatalitycombo")

	elif Input.is_action_just_pressed("spear"):
		start_spear()

	elif Input.is_action_pressed("invisible"):
		invisible()

	elif Input.is_action_pressed("visible"):
		sprite.visible = true

	else:
		stop_block()

	move_and_slide()

# ---------------- BLOCK ----------------
func start_block():

	if state == State.DEAD:
		return

	is_blocking = true
	state = State.BLOCK

	play_anim("block")

func stop_block():

	if is_blocking:
		is_blocking = false
		state = State.IDLE

# ---------------- ACID SHOOT ----------------
func shoot_acid():

	if shoot_cooldown > 0:
		return

	shoot_cooldown = shoot_cooldown_time
	is_attacking = true
	action_locked = true

	play_anim("shoot")

	var bullet = REPTILES_ACID.instantiate()
	get_tree().current_scene.add_child(bullet)

	bullet.global_position = $Reptileshoot.global_position
	bullet.velocity = Vector2.RIGHT * facing * bullet.speed

	await get_tree().create_timer(0.2).timeout

	is_attacking = false
	action_locked = false

func invisible():
	sprite.visible = false

# ---------------- CPU ----------------
func cpu_logic(delta):
# ---------------- HURT PRIORITY ----------------
	if is_hurting:

		if is_pulled:
			# opposite of normal knockback
			velocity.x = -facing * -600
		else:
			# normal knockback
			velocity.x = -facing * 100

		knockback_x = move_toward(knockback_x, 0, 1500 * delta)

		if abs(knockback_x) < 10:
			knockback_x = 0
			is_hurting = false
			is_pulled = false

		return

	if target == null or !is_instance_valid(target):
		velocity.x = 0
		return

	var dist = target.global_position.x - global_position.x
	var direction = sign(dist)

	# HARD LOCK (Liu Kang style behavior)
	if action_locked:
		return

# STOP ALL ACTIONS AT 1HP
	if health <= 1:
		is_attacking = false
		action_locked = true
		velocity.x = 0
		combo.clear()
		return

	ai_timer -= delta
	facing = direction
	sprite.flip_h = facing > 0
	$Crispy.flip_h = facing > 0

# ---------------- MOVEMENT ----------------
	if not is_attacking:
		play_anim("walk")

	if abs(dist) > 220:
		velocity.x = direction * SPEED * 0.8
		state = State.WALK
		play_anim("walk")
	else:
		velocity.x = direction * SPEED * 0.8
		state = State.WALK
		play_anim("walk")

# ---------------- AI ACTIONS ----------------
	if ai_timer <= 0:

		match Game.difficulty:

			"Hard":

				# Very fast reactions
				ai_timer = randf_range(0.05, 0.15)

				var choice = randi() % 100

				if choice < 20:
					do_action("punch")
				elif choice < 20:
					do_action("highpunch")
				elif choice < 20:
					do_action("lowpunch")
				elif choice < 20:
					do_action("kick")
				elif choice < 20:
					do_action("highkick")
				elif choice < 20:
					do_action("lowkick")
				elif choice < 65:
					do_action("uppercut")
				elif choice < 80:
					do_action("roundhousekick")
				elif choice < 80:
					do_action("spear")
				else:
					shoot_player()

			"Easy":

				ai_timer = randf_range(0.5, 0.9)

				var choice = randi() % 100

				if choice < 40:
					do_action("punch")
				elif choice < 40:
					do_action("highpunch")
				elif choice < 40:
					do_action("lowpunch")
				elif choice < 70:
					do_action("kick")
				elif choice < 70:
					do_action("highkick")
				elif choice < 70:
					do_action("lowkick")
				elif choice < 85:
					do_action("spear")
				elif choice < 85:
					do_action("uppercut")
				else:
					do_action("roundhousekick")

func pull_enemy(enemy: CharacterBody2D):

	if enemy == null or !is_instance_valid(enemy):
		return

	enemy.velocity = Vector2.ZERO
	enemy.action_locked = true
	enemy.is_attacking = false
	enemy.is_hurting = true
	enemy.stunned = true

	var target_pos = $AttackMarker.global_position + Vector2(5 * facing, -5)

	while is_instance_valid(enemy) and enemy.global_position.distance_to(target_pos) > 8:

		enemy.global_position = enemy.global_position.move_toward(
			target_pos,
			1800 * get_process_delta_time()
		)

		await get_tree().process_frame

	# Snap perfectly into place
	enemy.global_position = target_pos
	enemy.velocity = Vector2.ZERO

	# Face Reptile
	enemy.facing = -facing
	enemy.sprite.flip_h = enemy.facing > 0

	# Hold briefly like MK
	await get_tree().create_timer(0.1).timeout

	enemy.take_damage(1)

	enemy.stunned = false
	enemy.is_hurting = false
	enemy.action_locked = false


func start_spear():

	if state == State.DEAD:
		return

	if action_locked and not is_hurting:
		return

	action_locked = true
	is_attacking = true

	play_anim("spear")

	await get_tree().create_timer(0.15).timeout

	spawn_spear()

	await get_tree().create_timer(0.5).timeout

	is_attacking = false
	action_locked = false
	state = State.IDLE
	velocity.x = 0

	if is_on_floor():
		play_anim("idle")

func spawn_spear():

	var spear = SPEAR_SCENE.instantiate()
	get_tree().current_scene.add_child(spear)

	spear.global_position = $Reptileshoot.global_position
	spear.velocity = Vector2(facing, 0) * 2000

	spear.owner_character = self

func spear_pulled_to_p1():
	is_pulled = true
	pull_timer = 0.35
	stunned = true
	action_locked = true
	pull_target = get_tree().get_first_node_in_group("P1")

func run_pull_logic(delta):

	if pull_target == null or !is_instance_valid(pull_target):
		is_pulled = false
		stunned = false
		action_locked = false
		return

	var dir = sign(pull_target.global_position.x - global_position.x)

	velocity.x = dir * 900
	velocity.y = 0

	pull_timer -= delta

	if pull_timer <= 0.0:

		is_pulled = false

		# SNAP to Reptile AttackMarker (THIS IS MK MOMENT)
		global_position = pull_target.attack_marker.global_position + Vector2(40 * pull_target.facing, 0)

		stunned = false
		is_hurting = false
		action_locked = false
		is_attacking = true

		pull_target = null

# ---------------- SHOOT ----------------
func shoot_player():

	if is_finish_state:
		return

	if state == State.DEAD:
		return

	if is_shooting:
		return

	is_shooting = true
	is_attacking = true
	action_locked = true

	play_anim("shoot")

	$Reptileshoot.position = Vector2(88.9 * facing, -225)

	var bullet_scene: PackedScene = BULLET_SCENE
	if special_bullet != null:
		bullet_scene = special_bullet
		special_bullet = null

	var bullet = bullet_scene.instantiate()
	get_tree().current_scene.add_child(bullet)

	await get_tree().process_frame

	bullet.global_position = $Reptileshoot.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	# wait shot lock
	await get_tree().create_timer(0.25).timeout

	# 🔥 HARD RESET (this is the important fix)
	is_shooting = false
	is_attacking = false
	action_locked = false

	if state != State.DEAD and not is_hurting:
		play_anim("idle")

# ---------------- COMBOS ----------------
func register_input(input: String):

	# only human player can enter combos
	if not is_in_group("player1"):
		return

	combo.append(input)

	combo_timer = 0.0

	check_combos()

func spawn_fx(scene: PackedScene):

	var fx = scene.instantiate()

	# IMPORTANT: set owner BEFORE it can collide
	fx.owner_character = self
	fx.damage_done = false

	get_tree().current_scene.call_deferred("add_child", fx)

	await get_tree().process_frame

	if target and is_instance_valid(target):
		fx.global_position = target.global_position + Vector2(60 * facing, 0)
	else:
		fx.global_position = global_position + Vector2(80 * facing, 0)


func check_combos():

	# ---------------- FIRE ----------------
	if combo == FIRE_COMBO: 

		combo_used.emit("fire")

		special_bullet = FIRE_BULLET

		combo.clear()

		shoot_player()

		return

	# ---------------- ELECTRIC ----------------
	elif combo == ELECTRIC_COMBO:

		combo_used.emit("electric")

		spawn_fx(ELECTRIC_DEATH)

		special_bullet = ELECTRIC_BULLET

		combo.clear()
		return

	# ---------------- kick ----------------
	elif combo == KICK_COMBO:

		combo_used.emit("kick_combo")

		combo.clear()

		start_kick_combo()
		return

	# ---------------- PUNCH ----------------
	elif combo == PUNCH_COMBO:

		combo_used.emit("punch_combo")

		combo.clear()

		start_punch_combo()
		return

	# ---------------- FATALITY_COMBO ----------------
	elif combo == FATALITY_COMBO:

		combo_used.emit("fatality_combo")

		combo.clear()

		do_action("fatalitycombo")
		return

func start_fatality():

	action_locked = true
	is_attacking = true

	play_anim("fatalitycombo")
	spawn_attack("fatalitycombo")

	await sprite.animation_finished

	is_attacking = false
	action_locked = false

func start_punch_combo():

	if action_locked or is_hurting or state == State.DEAD:
		return

	await combo_attack([
		"punch",
		"lowpunch",
		"punch",
		"uppercut",
		"highpunch",
		"uppercut"
	])

func start_kick_combo():

	if action_locked or is_hurting or state == State.DEAD:
		return

	await combo_attack([
		"kick",
		"knee",
		"highkick",
		"roundhousekick",
		"lowkick",
		"roundhousekick",
		"highkick"
	])

func combo_attack(attacks: Array):

	action_locked = true
	is_attacking = true

	for attack in attacks:

		# STOP COMBO IF HIT
		if is_hurting or state == State.DEAD:
			break

		play_anim(attack)
		spawn_attack(attack)

		await sprite.animation_finished

	is_attacking = false
	action_locked = false

	if not is_hurting:
		play_anim("idle")

func do_action(anim_name: String):

	if health <= 1:
		return

	if is_finish_state:
		return

	if action_locked and not is_hurting:
		return

	action_locked = true
	is_attacking = true
	lock_timer = 0.3

	play_anim(anim_name)

	# ---------------- NORMAL ATTACKS ----------------
	if anim_name in [
		"punch",
		"highpunch",
		"lowpunch",
		"kick",
		"highkick",
		"lowkick",
		"uppercut",
		"roundhousekick",
		"knee",
		"fatalitycombo"
	]:
		spawn_attack(anim_name)

	# ---------------- OPTIONAL ELECTRIC BURST ----------------
	elif anim_name == "walk":

		if has_node("AttackMarker"):
			var attack = REPTILE_ATTACK.instantiate()
			get_parent().add_child(attack)

			attack.global_position = $AttackMarker.global_position
			attack.scale.x = facing

	await get_tree().create_timer(0.5).timeout

	is_attacking = false
	action_locked = false
	hurt_locked = false
	play_anim("idle")

# ---------------- ATTACK ----------------
func spawn_attack(anim_name: String):

	if anim_name not in [
		"punch",
		"highpunch",
		"lowpunch",
		"kick",
		"highkick",
		"lowkick",
		"uppercut",
		"roundhousekick",
		"knee",
		"fatalitycombo",
		"FATALITY_COMBO"
	]:
		return


	var attack = REPTILE_ATTACK.instantiate()

	get_tree().current_scene.add_child(attack)

	attack.add_to_group("HitBox")

	attack.global_position = attack_marker.global_position
	attack.scale.x = facing  # THIS replaces facing system


	var dmg := 1


	match anim_name:
		"punch":
			dmg = 1
		"highpunch":
			dmg = 1
		"lowpunch":
			dmg = 1
		"kick":
			dmg = 1
		"highkick":
			dmg = 1
		"lowkick":
			dmg = 1
		"uppercut":
			dmg = 1
		"roundhousekick":
			dmg = 1
		"knee":
			dmg = 1
		"fatalitycombo":
			dmg = 1
		"FATALITY_COMBO":
			dmg = 1


	if attack.has_method("set_damage"):
		attack.set_damage(dmg)
	else:
		attack.damage = dmg


	# UPPERCUT KNOCKBACK SYSTEM
	attack.owner = self
	attack.attack_owner = self
	attack.attack_name = anim_name
	attack.attack_type = anim_name

# ---------------- AI ACTIONS ----------------
	if ai_timer <= 0:

		match Game.difficulty:

			"Hard":

				# Very fast reactions
				ai_timer = randf_range(0.05, 0.15)

				var choice = randi() % 100

				if choice < 20:
					do_action("punch")
				elif choice < 40:
					do_action("kick")
				elif choice < 65:
					do_action("uppercut")
				elif choice < 80:
					do_action("roundhousekick")
				elif choice < 80:
					do_action("spear")
				elif choice < 85:
					do_action("knee")
				else:
					shoot_player()

			"Easy":

				ai_timer = randf_range(0.5, 0.9)

				var choice = randi() % 100

				if choice < 40:
					do_action("punch")
				elif choice < 70:
					do_action("kick")
				elif choice < 85:
					do_action("uppercut")
				elif choice < 85:
					do_action("spear")
				elif choice < 90:
					do_action("knee")
				else:
					do_action("roundhousekick")


	# ---------------- SPEAR ATTACK ----------------
	if anim_name == "spear":

		var spear = SPEAR_SCENE.instantiate()
		get_tree().current_scene.add_child(spear)

		# spawn from marker (important for MK feel)
		spear.global_position = $Reptileshoot.global_position

		spear.scale.x = facing

		# damage
		if spear.has_method("set_damage"):
			spear.set_damage(1)
		else:
			spear.damage = 1

		# optional movement
		if spear.has_variable("velocity"):
			spear.velocity = Vector2(facing, 0) * 1200

		spear.owner = self

func take_damage(amount: int):

	# ALREADY DEAD / INVINCIBLE
	if state == State.DEAD:
		return

	if is_hurting:
		return

	if not can_take_damage:
		return

	if spawn_protection:
		return

	can_take_damage = false

	# hit cooldown
	await get_tree().create_timer(0.25).timeout

	can_take_damage = true


	# BLOCK REDUCTION
	if is_blocking:
		amount = max(amount - 1, 0)

	if amount <= 0:
		return


	health -= amount
	health = max(health, 0)

	print("Reptile HP:", health)

	health_changed.emit(health)
	hit_sound.play()


	# ==========================
	# FINISH HIM STATE
	# ==========================
	if health == 1 and not is_finish_state:
		trigger_finish_state()
		return

	# ==========================
	# DEAD
	# ==========================
	if health <= 0:
		die()
		return

	# ==========================
	# NORMAL HIT
	# ==========================
	is_hurting = true
	hurt_locked = true
	action_locked = true

	combo.clear()

	is_attacking = false
	is_shooting = false
	is_blocking = false

	state = State.IDLE

	play_anim("hurt")

	if has_node("BloodMarker"):
		var blood = BLOOD_EFFECT.instantiate()
		get_tree().current_scene.add_child(blood)
		blood.global_position = $BloodMarker.global_position

	await get_tree().create_timer(0.25).timeout

	is_hurting = false
	hurt_locked = false
	action_locked = false

func trigger_finish_state():

	if is_finish_state:
		return

	is_finish_state = true

	state = State.IDLE

	# force them to fall back down
	velocity.x = 0
	velocity.y = 0

	action_locked = true
	hurt_locked = false
	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

	# cancel any uppercut/fly state
	set_meta("uppercut_launched", false)

	play_anim("idle")

	finish_label.visible = true

	if finish_label.has_method("start_flicker"):
		finish_label.start_flicker(2.0, 0.05)

	# let gravity work
	await get_tree().create_timer(0.1).timeout

	while not is_on_floor():
		velocity.y += 5000.0 * get_physics_process_delta_time()
		move_and_slide()
		await get_tree().physics_frame

	velocity = Vector2.ZERO

	await get_tree().create_timer(2.0).timeout

	if is_instance_valid(finish_label):
		finish_label.visible = false

# ---------------- DEATH ----------------
func die():

	if state == State.DEAD:
		return

	state = State.DEAD

	var death = BLOOD_DEATH.instantiate()
	get_tree().current_scene.add_child(death)
	death.global_position = global_position

	# stop everything
	velocity = Vector2.ZERO
	is_attacking = false
	is_shooting = false
	action_locked = true
	hurt_locked = true
	is_hurting = false

	# 🔥 HARD SWAP SPRITES
	$Sprite.visible = false          # AnimatedSprite2D OFF
	$Crispy.visible = true         # static image ON

	# optional delay before menu
	await get_tree().create_timer(4).timeout

	get_tree().change_scene_to_file("res://Scenes/MainMenu.tscn")

# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):

	if current_anim == anim_name:
		return

	current_anim = anim_name
	sprite.play(anim_name)

func spawn_attack_bullet(anim_name: String):

	if anim_name not in [
		"punch",
		"kick",
		"roundhousekick",
		"uppercut"
	]:
		return

	var bullet = BULLET_SCENE.instantiate()
	get_tree().current_scene.add_child(bullet)

	bullet.global_position = $AttackMarker.global_position
	bullet.scale.x = facing

	if bullet.has_variable("velocity"):
		bullet.velocity = Vector2(facing, 0) * bullet.speed

	if bullet.has_variable("damage"):
		bullet.damage = 1

	bullet.owner = self

func _on_reptile_hurt_box_area_entered(area: Area2D) -> void:
	if hurt_cooldown:
		return

	if area == null or !is_instance_valid(area):
		return

	if not can_take_damage:
		return

	if area.get("attack_name") and area.attack_name == "uppercut":
		$Sprite.play("wasuppercut")
	else:
		$Sprite.play("hurt")

	$Hurt.play()

	if area.is_in_group("HitBox") \
		or area.is_in_group("ReptileAcid") \
		or area.is_in_group("RaidenElectricBullet") \
		or area.is_in_group("FireBullet") \
		or area.is_in_group("Fireball") \
		or area.is_in_group("SonyaBullet") \
		or area.is_in_group("JohnnyCageBullet") \
		or area.is_in_group("KanoBullet") \
		or area.is_in_group("IceBullet") \
		or area.is_in_group("KanoAttack"):

		hurt_cooldown = true

	$Hurt.play()
	knockback_x = -facing * 100
	take_damage(1)

	await get_tree().create_timer(0.2).timeout
	hurt_cooldown = false
