extends Area2D
class_name RaidenAttack

@onready var collision: CollisionShape2D = $CollisionShape2D

@export var lifetime := 0.1

var damage := 1
var active := false

func _ready():

	add_to_group("RaidenAttack")

	area_entered.connect(_on_area_entered)

	enable_hitbox()

	await get_tree().create_timer(lifetime).timeout

	queue_free()

func enable_hitbox():
	active = true
	monitoring = true

	if collision:
		collision.disabled = false

func disable_hitbox():
	active = false
	monitoring = false

	if collision:
		collision.disabled = true

func _on_area_entered(area: Area2D) -> void:

	if area == null:
		return

	var target = area.get_parent()

	if target == null:
		return

	if target.is_in_group("Raiden"):
		return

	if target.is_in_group("Subzero") or target.is_in_group("Reptile"):

		if target.has_method("take_damage"):
			target.take_damage(damage)
