extends Area2D
class_name DeadlyFlower

signal Die

@export var health: int = 11
const BULLET_SCENE = preload("res://DeadlyFlowerBullet.tscn")  # Adjust path as needed
@export var shoot_interval: float = 5.0  # Shoot every 5 seconds

func _ready():
	$Sprite.play("default")
	start_shooting()

func _on_area_entered(area):
	if area.is_in_group("Bullet"):
		take_damage(1)

func take_damage(amount: int):
	health -= amount
	print("DeadlyFlower took damage! Health now: ", health)
	if health <= 0:
		emit_signal("Die")
		die()

func die():
	print("DeadlyFlower has died.")
	queue_free()

func shoot_bullet():
	var bullet = BULLET_SCENE.instantiate()
	bullet.global_position = global_position + Vector2(0, -10)  # optional offset
	get_tree().current_scene.add_child(bullet)

func start_shooting():
	var timer = Timer.new()
	timer.wait_time = shoot_interval
	timer.autostart = true
	timer.one_shot = false
	timer.timeout.connect(shoot_bullet)
	add_child(timer)
