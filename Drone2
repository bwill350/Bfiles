extends Area2D
class_name Drone2

signal Die
signal health_changed(new_health)

@export var point: int = 0
@export var health: int = 15
@export var shoot_interval: float = 5.0

const BULLET_SCENE = preload("res://Dronetwobullet.tscn")

@onready var sprite: AnimatedSprite2D = $Sprite

var timer: Timer = null  # Declare timer globally

func _ready():
	sprite.play("alive")
	start_shooting()

# -------------------------
# DAMAGE SYSTEM
# -------------------------
func _on_area_entered(area):
	if area.is_in_group("Bullet") or area.is_in_group("Duke"):
		take_damage(1)
		sprite.play("dead")
		
func _on_body_entered(body):
	if body.is_in_group("Bullet") or body.is_in_group("Duke"):
		take_damage(1)
		sprite.play("dead")

func take_damage(amount: int):
	point -= amount
	health -= amount
	emit_signal("health_changed", health)
	emit_signal("point_changed", point)
	print("Drone2 took damage! Health now: ", health)

	if point <= 0:
		emit_signal("Die")
		die()

	if health <= 0:
		emit_signal("Die")
		die()


# -------------------------
# DEATH SYSTEM
# -------------------------
func die():
	print("Drone2 has died.")
	sprite.play("dead")
	
	if timer:
		timer.stop()


# -------------------------
# SHOOTING SYSTEM
# -------------------------
func shoot_bullet():
	var bullet = BULLET_SCENE.instantiate()
	bullet.global_position = global_position + Vector2(0, 10)
	bullet.direction = Vector2.DOWN
	get_tree().current_scene.add_child(bullet)

func start_shooting():
	if not timer:
		timer = Timer.new()
		timer.wait_time = shoot_interval
		timer.autostart = true
		timer.one_shot = false
		timer.timeout.connect(shoot_bullet)
		add_child(timer)
