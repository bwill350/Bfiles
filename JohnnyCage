var spawn_locked := true
var spawn_protection := false
signal health_changed(health)
signal combo_used(combo_name: String)
var special_move := false
var special_move_timer := 0.0
var finish_shown := false
var finish_cooldown := 0.0
var is_spear_pulled := false
var last_hit_id := -1
var tap_time := 0.25
var last_tap_time := 0.0
var last_tap_dir := 0
var run_locked := false

# ---------------- STATE ----------------
enum State { IDLE, WALK, RUN, JUMP, KICK, BLOCK, PUNCH, CLIMB, DEAD }

var state: State = State.IDLE
var special_bullet: PackedScene = null

# ---------------- CPU ----------------
var is_cpu := false
var target: Node2D = null
var ai_timer := 0.0
var stunned := false
# ---------------- FLAGS ----------------
var is_blocking := false
var is_hurting := false
var is_shooting := false
var is_attacking := false
var action_locked := false
var hurt_locked := false
var can_take_damage := true
var is_finish_state := false
var lock_timer := 0.0
var cannonkick_active := false
var cannonkick_timer := 0.0
var hurt_cooldown := false
# ---------------- MOVEMENT ----------------
var facing := 1
var current_anim := ""
var health: int
var knockback_x := 0.0
const GRAVITY = 5000

# ---------------- COOLDOWNS ----------------
var shoot_cooldown: float = 0.0

# ---------------- EXPORTS ----------------
@export var shoot_cooldown_time: float = 0.25
@export var SPEED = 300.0
@export var CLIMB_SPEED = 250.0
@export var max_health: int = 10
@export var jump_velocity = -2200.0
@export var combo_reset_time := 0.6

# ---------------- PRELOADS ----------------
const BULLET_SCENE = preload("res://JohnnyCageBullet.tscn")
const FIRE_BULLET = preload("res://Projectiles/FireBullet.tscn")
const ICE_BULLET = preload("res://Projectiles/IceBullet.tscn")
const ELECTRIC_BULLET = preload("res://Projectiles/ElectricBullet.tscn")
const ACID_BULLET = preload("res://Projectiles/Reptilesacid.tscn")
const JOHNNY_CAGE_BULLET = preload("res://JohnnyCageBullet.tscn")
const REPTILES_ACID = preload("res://Projectiles/Reptilesacid.tscn")
const JOHNNY_CAGE_ATTACK = preload("res://JohnnyCageAttack.tscn")

const BLOOD_EFFECT = preload("res://GreenBloodEffect.tscn")

# ---------------- DEATH FX ----------------
const BLOOD_DEATH = preload("res://Deaths/BloodDeath.tscn")
const FIRE_DEATH = preload("res://Deaths/FireDeath.tscn")
const ICE_DEATH = preload("res://Deaths/IceDeath.tscn")
const ELECTRIC_DEATH = preload("res://Deaths/ElectricDeath.tscn")

# ---------------- NODES ----------------
@onready var sprite: AnimatedSprite2D = $Sprite
@onready var hit_sound: AudioStreamPlayer2D = $Hit
@onready var hurt_sound: AudioStreamPlayer2D = $Hurt
@onready var hit_box: Area2D = $JohnnyCageHurtBox
@onready var shoot_marker: Marker2D = $JohnnyShoot
@onready var attack_marker: Marker2D = $AttackMarker
@onready var blood_marker: Marker2D = $BloodMarker
# ---------------- COMBOS ----------------
var combo := []
var combo_timer := 0.0
var is_running := false
@onready var finish_label: Sprite2D = $HUD/FinishLabel/Sprite2D
@onready var character = get_parent()
const PUNCH_COMBO = ["right", "down", "right"]
const ACID_COMBO = ["down", "down", "down", "right", "shoot"]
const FIRE_COMBO = ["down", "right", "shoot"]
const ICE_COMBO = ["left", "left", "shoot"]
const ELECTRIC_COMBO = ["up", "down", "shoot"]

func apply_stun(_duration := 4.0):

	if state == State.DEAD:
		return

	stunned = true

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	velocity = Vector2.ZERO
	knockback_x = 0

	play_anim("idle")

	await get_tree().create_timer(4.0).timeout

	stunned = false

	is_hurting = false
	hurt_locked = false
	action_locked = false

func run(input_dir: float):
	if input_dir == 0:
		return

	state = State.RUN
	velocity.x = input_dir * SPEED * 4  # faster than walk

	if not is_attacking:
		play_anim("walk")

# ---------------- READY ----------------
func _ready():
	$Sprite.visible = true
	$Crispy.visible = false
	add_to_group("Fighter")
	add_to_group("enemy")
	add_to_group("JohnnyCage")

	spawn_locked = false

	health = max_health
	health_changed.emit(health)

	play_anim("idle")

	ai_timer = randf_range(0.2, 0.6)
	facing = 1
	sprite.flip_h = -facing < 0

# ---------------- INPUT ----------------
func _unhandled_input(event):

	if is_cpu:
		return

	if event.is_action_pressed("up"):
		register_input("up")

	elif event.is_action_pressed("down"):
		register_input("down")

	elif event.is_action_pressed("left"):
		register_input("left")

	elif event.is_action_pressed("right"):
		register_input("right")

	elif event.is_action_pressed("shoot"):
		register_input("shoot")

# ---------------- PHYSICS ----------------
func _physics_process(delta):

	if state == State.DEAD:
		return

	# ---------------- STUN ----------------
	if stunned:
		velocity = Vector2.ZERO
		move_and_slide()
		return

	if cannonkick_active:
		move_and_slide()
		return

	# ---------------- DEATH / FINISH ----------------
	if state == State.DEAD:
		return

	if is_finish_state:
		state = State.IDLE
		velocity.x = 0
		if not is_hurting:
			play_anim("idle")
		move_and_slide()
		return

	# ---------------- GRAVITY ----------------
	velocity.y += GRAVITY * delta


	# ---------------- COOLDOWNS ----------------
	shoot_cooldown = max(shoot_cooldown - delta, 0.0)

	combo_timer += delta
	if combo_timer > combo_reset_time:
		combo.clear()

	# ---------------- CPU ----------------
	if is_cpu:
		cpu_logic(delta)
		move_and_slide()
		return

	if state == State.DEAD:
		return

	if is_finish_state:
		state = State.IDLE
		velocity.x = 0

		if not is_hurting:
			play_anim("idle")

		move_and_slide()
		return

	# ---------------- GRAVITY ----------------
	velocity.y += GRAVITY * delta

	if action_locked:
		return

	var input_dir = Input.get_axis("left", "right")
	var climb_pressed = Input.is_action_pressed("climb")

	# ---------------- FACING ----------------
	if input_dir != 0:
		facing = input_dir

	sprite.flip_h = facing > 0

	$AttackMarker.position = Vector2(63 * facing, -155)
	$JohnnyShoot.position = Vector2(63 * facing, -155)

	# =========================================================
	# 🟢 MOVEMENT (RUN ADDED HERE)
	# =========================================================
	if Input.is_action_pressed("run") and input_dir != 0:
		run(input_dir)   # 🔥 CALLS YOUR NEW RUN FUNCTION
	else:
		velocity.x = input_dir * SPEED

		# ---------------- STATE ----------------
		if not is_on_floor():
			state = State.JUMP
		elif input_dir != 0:
			state = State.WALK
		elif input_dir != 0:
			state = State.RUN
		else:
			state = State.IDLE

	# ---------------- ANIMS ----------------
	match state:

		State.CLIMB:
			velocity.y = -CLIMB_SPEED
			if not is_attacking:
				play_anim("idle")

		State.JUMP:
			if not is_attacking:
				play_anim("jump")

		State.WALK:
			if not is_attacking:
				play_anim("walk")

		State.RUN:
			if not is_attacking:
				play_anim("run")

		State.IDLE:
			if not is_attacking:
				play_anim("idle")

	if is_hurting and hurt_locked:
		return

	# ---------------- JUMP ----------------
	if Input.is_action_just_pressed("jump") and is_on_floor():
		velocity.y = jump_velocity

	# ---------------- ATTACKS ----------------
	if Input.is_action_just_pressed("kick"):
		do_action("kick")

	elif Input.is_action_just_pressed("punch"):
		do_action("punch")

	elif Input.is_action_just_pressed("roundhousekick"):
		do_action("roundhousekick")

	elif Input.is_action_just_pressed("cannonkick"):
		do_action("cannonkick")
		var dir := Input.get_axis("left", "right")

		# fallback if no directional input
		if dir == 0:
			dir = facing

		cannonkick(dir)

	elif Input.is_action_just_pressed("uppercut"):
		do_action("uppercut")

	elif Input.is_action_just_pressed("nutcracker"):
		do_action("nutcracker")

	elif Input.is_action_just_pressed("shoot"):	
		if shoot_cooldown <= 0:
			shoot_player()

	elif Input.is_action_pressed("block"):
			start_block()

	else:
		stop_block()

	move_and_slide()

# ---------------- BLOCK ----------------
func start_block():

	if state == State.DEAD:
		return

	is_blocking = true
	state = State.BLOCK

	play_anim("block")

func stop_block():

	if is_blocking:
		is_blocking = false
		state = State.IDLE

# ---------------- ACID SHOOT ----------------
func shoot_acid():

	if shoot_cooldown > 0:
		return

	shoot_cooldown = shoot_cooldown_time

	is_attacking = true
	action_locked = true

	play_anim("shoot")

	var bullet = REPTILES_ACID.instantiate()

	get_tree().current_scene.add_child(bullet)

	bullet.global_position = $JohnnyShoot.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	# 🔴 ONLY KANO'S VERSION IS RED
	if bullet.has_node("Sprite2D"):
		bullet.get_node("Sprite2D").modulate = Color(1, 0.2, 0.2)
	elif bullet.has_node("AnimatedSprite2D"):
		bullet.get_node("AnimatedSprite2D").modulate = Color(1, 0.2, 0.2)

	await get_tree().create_timer(0.25).timeout

	is_attacking = false
	action_locked = false

	play_anim("idle")

# ---------------- CPU ----------------
func cpu_logic(delta):
	# ---------------- HURT PRIORITY ----------------
	if is_hurting:

		if is_spear_pulled:
				velocity.x = -facing * -600
		else:
			velocity.x = -facing * 100

	# gradually reduce knockback
		knockback_x = move_toward(knockback_x, 0, 1500 * delta)

		if abs(knockback_x) < 10:
			knockback_x = 0
			is_hurting = false

			velocity.y += GRAVITY * delta
			move_and_slide()
			return

	if target == null or !is_instance_valid(target):
		velocity.x = 0
		return

# GRAVITY
	velocity.y += GRAVITY * delta

	var dist = target.global_position.x - global_position.x
	var direction = sign(dist)

	# HARD LOCK (Liu Kang style behavior)
	if action_locked:
		return

# STOP ALL ACTIONS AT 1HP
	if is_finish_state:
		is_attacking = false
		action_locked = true
		velocity.x = 0
		move_and_slide()
		return

	ai_timer -= delta

	velocity.y += GRAVITY * delta
	facing = direction
	sprite.flip_h = facing > 0

# GRAVITY
	velocity.y += GRAVITY * delta


# ---------------- MOVEMENT ----------------
	if abs(dist) > 220:

		velocity.x = direction * SPEED * 0.8

	if state != State.RUN:
		state = State.RUN

	if not is_attacking:
		play_anim("walk")

	if abs(dist) > 220:
		velocity.x = direction * SPEED * 0.8
		state = State.RUN
		play_anim("walk")
	else:
		velocity.x = direction * SPEED * 0.8
		state = State.RUN
		play_anim("walk")

# ---------------- AI ACTIONS ----------------
	if ai_timer <= 0:

		match Game.difficulty:

			"Hard":

				# Very fast reactions
				ai_timer = randf_range(0.05, 0.15)

				var choice = randi() % 100

				if choice < 20:
					do_action("punch")
				elif choice < 40:
					do_action("kick")
				elif choice < 65:
					do_action("uppercut")
				elif choice < 80:
					do_action("roundhousekick")
				elif choice < 80:
					do_action("cannonkick")
				else:
					shoot_player()

			"Easy":

				ai_timer = randf_range(0.5, 0.9)

				var choice = randi() % 100

				if choice < 40:
					do_action("punch")
				elif choice < 70:
					do_action("kick")
				elif choice < 85:
					do_action("uppercut")
				elif choice < 90:
					do_action("cannonkick")
				else:
					do_action("roundhousekick")

# ---------------- ACTION ----------------
func do_action(anim_name: String):

	if is_attacking:
		return

	if health <= 1:
		return

	if is_finish_state:
		return

	if state == State.DEAD:
		return

	if action_locked:
		return

	action_locked = true
	is_attacking = true
	lock_timer = 0.6

	play_anim(anim_name)

	if anim_name in [
		"punch",
		"kick",
		"uppercut",
		"roundhousekick",
		"nutcracker",
		"cannonkick"
	]:
		spawn_attack(anim_name)

	await sprite.animation_finished

	is_attacking = false
	action_locked = false
	hurt_locked = false

	play_anim("idle")

# ---------------- ATTACK ----------------
func spawn_attack(anim_name: String):

	if anim_name not in [
		"punch",
		"kick",
		"uppercut",
		"roundhousekick",
		"nutcracker",
		"cannonkick"
	]:
		return

	var attack = JOHNNY_CAGE_ATTACK.instantiate()
	get_tree().current_scene.add_child(attack)

	attack.global_position = $AttackMarker.global_position
	attack.scale.x = facing  # THIS replaces facing system

	var dmg := 1

	match anim_name:
		"punch":
			dmg = 1
		"kick":
			dmg = 1
		"uppercut":
			dmg = 1
		"roundhousekick":
			dmg = 1
		"nutcracker":
			dmg = 1
		"cannonkick":
			dmg = 1

	if attack.has_method("set_damage"):
		attack.set_damage(dmg)
	else:
		attack.damage = dmg

	attack.owner = self

func cannonkick(dir := 0):

	if state == State.DEAD:
		return

	if action_locked:
		return

	# default direction
	if dir == 0:
		dir = facing

	facing = dir
	sprite.flip_h = facing > 0

	# lock movement/state
	cannonkick_active = true
	action_locked = true
	is_attacking = true

	# 🔥 turn green instantly
	sprite.modulate = Color(0, 1, 0)
	await get_tree().process_frame  # forces visual update immediately

	# animation + state
	state = State.RUN
	play_anim("cannonkick")

	# movement burst
	velocity.x = facing * 1400
	velocity.y = 0

	# duration of move
	await get_tree().create_timer(0.4).timeout

	# 🔥 RESET COLOR (THIS FIXES “stays green”)
	sprite.modulate = Color(1, 1, 1)

	# unlock
	cannonkick_active = false
	is_attacking = false
	action_locked = false

	if state != State.DEAD:
		state = State.IDLE

# ---------------- SHOOT ----------------
func shoot_player():

	if health <= 1:
		return

	if is_finish_state:
		return
	if is_shooting:
		return

	is_shooting = true
	is_attacking = true
	action_locked = true

	play_anim("shoot")

	var bullet_scene: PackedScene

	if special_bullet != null:
		bullet_scene = special_bullet
		special_bullet = null
	else:
		bullet_scene = JOHNNY_CAGE_BULLET

	var bullet = bullet_scene.instantiate()

	get_tree().current_scene.add_child(bullet)

	bullet.global_position = $JohnnyShoot.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	# Flip sprite when facing right
	if bullet.has_node("Sprite2D"):
		bullet.get_node("Sprite2D").flip_h = facing > 0

	await get_tree().create_timer(0.25).timeout

	is_shooting = false

	if is_hurting or state == State.DEAD:
		return

	is_attacking = false
	action_locked = false

# ---------------- DAMAGE ----------------
func take_damage(amount: int):

	if not can_take_damage:
		return

	can_take_damage = false

	await get_tree().create_timer(0.25).timeout

	can_take_damage = true

	if state == State.DEAD:
		return

	var frame := Engine.get_physics_frames()

	if has_meta("last_damage_frame") and get_meta("last_damage_frame") == frame:
		return

	if spawn_protection:
		return

	# BLOCK REDUCTION
	if is_blocking:
		amount = max(amount - 1, 0)

	if amount <= 0:
		return

	health -= amount
	health = max(health, 0)

	print("JohnnyCage took damage: ", amount, " HP=", health)

	health_changed.emit(health)
	hit_sound.play()

	# ---------------- FINISH HIM ----------------
	if health == 1 and not is_finish_state:

		trigger_finish_state()
		return

	# ---------------- FINAL HIT ----------------
	if health <= 0:

		finish_label.visible = false
		die()
		await get_tree().create_timer(0.5).timeout

		get_tree().change_scene_to_file("res://Scenes/MainMenu.tscn")
		return

	# ---------------- NORMAL HURT ----------------
	is_hurting = true
	hurt_locked = true
	action_locked = true

	state = State.IDLE

	play_anim("hurt")

	var blood = BLOOD_EFFECT.instantiate()
	get_tree().current_scene.add_child(blood)
	blood.global_position = $BloodMarker.global_position

# ---------------- NORMAL HURT ----------------
	is_hurting = true
	hurt_locked = true
	action_locked = true
	state = State.IDLE
	play_anim("hurt")
	await get_tree().create_timer(0.25).timeout

	is_hurting = false
	hurt_locked = false
	action_locked = false

	if state != State.DEAD:
		play_anim("idle")

func trigger_finish_state():

	if is_finish_state:
		return

	is_finish_state = true

	state = State.IDLE
	velocity = Vector2.ZERO

	action_locked = true
	hurt_locked = false
	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

	play_anim("idle")

	finish_label.visible = true

	if finish_label.has_method("start_flicker"):
		finish_label.start_flicker(2.0, 0.05)
		die()
	await get_tree().create_timer(2.0).timeout

	if is_instance_valid(finish_label):
		finish_label.visible = false

	state = State.IDLE
	velocity = Vector2.ZERO

	is_attacking = true
	is_shooting = false
	is_hurting = false
	is_blocking = false

# ---------------- COMBOS ----------------
func register_input(input: String):

	combo.append(input)

	combo_timer = 0.0

	check_combos()

func spawn_fx(scene: PackedScene) -> void:

	if scene == null:
		return

	var fx = scene.instantiate()
	get_tree().current_scene.add_child(fx)

	# safe setup for FX scripts that support it
	if "owner_character" in fx:
		fx.owner_character = self

	if "damage_done" in fx:
		fx.damage_done = false

	await get_tree().process_frame

	var spawn_pos: Vector2

	if target and is_instance_valid(target):
		spawn_pos = target.global_position
	else:
		spawn_pos = global_position

	# forward offset based on facing
	spawn_pos += Vector2(80 * facing, -10)

	fx.global_position = spawn_pos

func check_combos():

	# ---------------- ACID ----------------
	if combo == ACID_COMBO:

		combo_used.emit("acid")

		special_bullet = ACID_BULLET

		combo.clear()
		return

	# ---------------- FIRE ----------------
	elif combo == FIRE_COMBO:

		combo_used.emit("fire")

		spawn_fx(FIRE_DEATH)

		special_bullet = FIRE_BULLET

		combo.clear()

		shoot_player()
		return

	# ---------------- ICE ----------------
	elif combo == ICE_COMBO:

		combo_used.emit("ice")

		spawn_fx(ICE_DEATH)

		special_bullet = ICE_BULLET

		combo.clear()
		return

	# ---------------- ELECTRIC ----------------
	elif combo == ELECTRIC_COMBO:

		combo_used.emit("electric")

		spawn_fx(ELECTRIC_DEATH)

		special_bullet = ELECTRIC_BULLET

		combo.clear()
		return

	elif combo == PUNCH_COMBO:

		combo_used.emit("punch_combo")

		combo.clear()

		start_punch_combo()
		return

func start_punch_combo():

	if action_locked:
		return

	await combo_attack([
		"punch",
		"kick",
		"punch",
		"roundhousekick",
		"uppercut",
		"nutcracker"
	])

func combo_attack(attacks: Array):

	action_locked = true
	is_attacking = true

	for attack in attacks:

		play_anim(attack)
		spawn_attack(attack)

		await sprite.animation_finished

	is_attacking = false
	action_locked = false

# ---------------- DEATH ----------------
func die():

	if state == State.DEAD:
		return

	state = State.DEAD

	var death = BLOOD_DEATH.instantiate()
	get_tree().current_scene.add_child(death)
	death.global_position = global_position

	# stop everything
	velocity = Vector2.ZERO
	is_attacking = false
	is_shooting = false
	action_locked = true
	hurt_locked = true
	is_hurting = false

	# 🔥 HARD SWAP SPRITES
	$Sprite.visible = false          # AnimatedSprite2D OFF
	$Crispy.visible = true         # static image ON


	# optional delay before menu
	await get_tree().create_timer(1.5).timeout

	get_tree().change_scene_to_file("res://Scenes/MainMenu.tscn")

# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):

	if current_anim == anim_name:
		return

	current_anim = anim_name

	sprite.play(anim_name)

# ---------------- HURT BOX ----------------
func _on_johnny_cage_hurt_box_area_entered(area: Area2D) -> void:

	if hurt_cooldown:
		return

	if area == null or !is_instance_valid(area):
		return

	if not can_take_damage:
		return

		$Hurt.play()

	# ---------------- SPEAR PRIORITY ----------------
	if area.is_in_group("ReptileSpear"):
		hurt_cooldown = true
		knockback_x = -facing * -600
		health -= 1
		health_changed.emit(health)

		is_spear_pulled = true
		is_hurting = true
		action_locked = true

		await get_tree().create_timer(0.8).timeout

		is_spear_pulled = false
		is_hurting = false
		action_locked = false
		hurt_cooldown = false
		return

	# ---------------- NORMAL DAMAGE SOURCES ----------------
	if area.is_in_group("HitBox") \
	or area.is_in_group("ReptileAcid") \
