extends Area2D
class_name Bossthree

signal Die
@export var heart = 40
@export var health: int = 100
@export var shoot_interval: float = 5.0
@export var move_speed: float = 100.0
@export var left_boundary: float
@export var right_boundary: float

const BULLET_SCENE = preload("res://BossoneBullet.tscn")
const DRONE_SCENE = preload("res://Drone2.tscn")

var direction := 1
var shooting_timer: Timer
var radial_timer: Timer

# --- HUD Heart Control ---
func bosslivesone():
	$"../../HUD/Bossheartsone".visible = false
func bosslivestwo():
	$"../../HUD/Bossheartstwo".visible = false
func bosslivesthree():
	$"../../HUD/Bossheartsthree".visible = false
func bosslivesfour():
	$"../../HUD/Bossheartsfour".visible = false

# --- Setup ---
func _ready():
	$Sprite.play("default")
	$Explosion1.stop()
	$Sprite2D.visible = false
	left_boundary = position.x - 500
	right_boundary = position.x + 500
	start_shooting()

func _physics_process(delta):
	position.x += direction * move_speed * delta
	if position.x <= left_boundary:
		direction = 1
		$Sprite.flip_h = true
	elif position.x >= right_boundary:
		direction = -1
		$Sprite.flip_h = false

# --- Damage Handling ---
func _on_area_entered(area):
	if area.is_in_group("Bullet"):
		take_damage(1)

func take_damage(amount: int):
	health -= amount
	print("Bossthree took damage! Health now: ", health)

	if health <= 100:
		bosslivesfour()
	if health <= 75:
		bosslivesthree()
		start_radial_shooting()
	if health <= 50:
		bosslivestwo()
	if health <= 0:
		bosslivesone()
		_die_sequence()

# --- Death Sequence ---
func _die_sequence():
	emit_signal("Die")
	print("Bossthree has died.")
	
	if shooting_timer:
		shooting_timer.stop()
	if radial_timer:
		radial_timer.stop()

	# shrink down
	var shrink_tween = create_tween()
	shrink_tween.tween_property(self, "scale", Vector2(0,0), 1.0).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN)
	shrink_tween.finished.connect(_on_shrink_finished)

func _on_shrink_finished():
	print("Boss scaled to 0 -> explosions triggered")
	$Sprite2D.visible = false
	$Sprite.play("explode")
	spawn_explosions()
	radial_bullet_burst()

	# wait for explosions, then change scene
	var timer = Timer.new()
	timer.wait_time = 3.0
	timer.one_shot = true
	timer.timeout.connect(Callable(self, "_finish_boss"))
	get_tree().root.add_child(timer)
	timer.start()

func _finish_boss():
	print("Boss finish triggered -> free + change scene")
	queue_free()
	call_deferred("_change_scene")

func _change_scene():
	get_tree().change_scene_to_file("res://Scenes/Levels/lvl_04.tscn")

# --- Regular Shooting ---
func shoot_bullet():
	var bullet = BULLET_SCENE.instantiate()
	bullet.global_position = global_position + Vector2(0, -10)
	var duke_candidates = get_tree().get_nodes_in_group("player")
	if duke_candidates.size() > 0:
		bullet.target = duke_candidates[0]
	get_tree().current_scene.add_child(bullet)

func start_shooting():
	shooting_timer = Timer.new()
	shooting_timer.wait_time = shoot_interval
	shooting_timer.autostart = true
	shooting_timer.one_shot = false
	shooting_timer.timeout.connect(shoot_bullet)
	add_child(shooting_timer)

# --- Radial Shooting ---
func start_radial_shooting():
	if radial_timer:
		return
	radial_timer = Timer.new()
	radial_timer.wait_time = 3.0
	radial_timer.autostart = true
	radial_timer.one_shot = false
	radial_timer.timeout.connect(radial_bullet_burst)
	add_child(radial_timer)

func radial_bullet_burst():
	var center_pos = global_position
	var bullet_count = 16
	var radius = 400

	for i in range(bullet_count):
		var angle = TAU * i / bullet_count
		var direction = Vector2(cos(angle), sin(angle)).normalized()

		var drone = DRONE_SCENE.instantiate()
		drone.global_position = center_pos
		drone.scale = Vector2(0, 0)
		get_tree().current_scene.add_child(drone)

		var final_pos = center_pos + direction * radius
		var tween = drone.create_tween()
		tween.tween_property(drone, "scale", Vector2(1,1), 0.3).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
		tween.tween_property(drone, "global_position", final_pos, 0.8).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
		tween.finished.connect(Callable(drone, "queue_free"))

# --- Explosion Sequence ---
func spawn_explosions():
	$Explosion1.play()
	var center_pos = global_position
	var distance = 500
	var num_images_per_direction = 3
	var delay_between_directions = 0.2

	var directions = [
		Vector2(-1, 0),
		Vector2(0, -1),
		Vector2(1, 0),
		Vector2(0, 1)
	]

	for dir_index in range(directions.size()):
		var dir = directions[dir_index]
		var timer = Timer.new()
		timer.wait_time = dir_index * delay_between_directions
		timer.one_shot = true
		timer.autostart = true
		timer.timeout.connect(Callable(self, "_spawn_direction").bind(dir, center_pos, distance, num_images_per_direction))
		add_child(timer)

func _spawn_direction(dir: Vector2, center_pos: Vector2, distance: float, num_images: int):
	for i in range(num_images):
		var offset = Vector2(randf_range(-50,50), randf_range(-50,50))
		var pos = center_pos + offset

		var drone = DRONE_SCENE.instantiate()
		drone.global_position = pos
		drone.scale = Vector2(0.5,0.5)
		get_tree().current_scene.add_child(drone)
		$Sprite2D.visible = false

		var final_pos = pos + dir * randf_range(distance*0.5, distance) + Vector2(randf_range(-50,50), randf_range(-50,50))

		var tween = drone.create_tween()
		tween.tween_property(drone, "scale", Vector2(1.0,1.0), 0.5).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
		tween.tween_property(drone, "global_position", final_pos, 0.5).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
		tween.finished.connect(Callable(drone, "queue_free"))
