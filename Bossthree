extends CharacterBody2D
class_name Bossthree

signal health_changed(health)

enum State { PHASE1, PHASE2, PHASE3, DEAD }
var state: State = State.PHASE1

@export var max_health: int = 320
@export var total_lives: int = 9

@export var phase1_delay: float = 1.6
@export var phase2_delay: float = 1.2
@export var phase3_delay: float = 0.9

var health: int
var current_life: int = 1
var finishing := false
var can_shoot := true

var flash_enabled := false
var flash_timer := 0.0
var flash_state := false
const FLASH_RATE := 0.12

var explosion_running := false

const SPIKE = preload("res://Scenes/Boss/Bosstwospikeballone.tscn")
const EXPLODE = preload("res://Scenes/Boss/Explosion.tscn")

@onready var sprite_node: AnimatedSprite2D = $Sprite
@onready var hit_area: Area2D = $Bossthree
@onready var ground_node: Node2D = get_node_or_null("ground")


# ---------------- READY ----------------
func _ready():
	health = max_health
	add_to_group("Boss")

	hit_area.area_entered.connect(_on_area_entered)

	sprite_node.play("default")

	call_deferred("start_attack_loop")


# ---------------- FLASH ----------------
func _process(delta):
	if finishing or not flash_enabled:
		return

	flash_timer += delta
	if flash_timer >= FLASH_RATE:
		flash_timer = 0.0
		flash_state = !flash_state
		sprite_node.modulate = Color(1, 0.3, 0.3) if flash_state else Color(1, 1, 1)


# ---------------- ATTACK LOOP ----------------
func start_attack_loop():
	while not finishing:

		if can_shoot:
			can_shoot = false

			play_attack_animation()
			shoot()

			await get_tree().create_timer(get_attack_delay()).timeout

			can_shoot = true
		else:
			await get_tree().process_frame


# ---------------- SHOOT SYSTEM ----------------
func shoot():
	if finishing:
		return

	var player = get_tree().get_first_node_in_group("player")
	if player == null:
		return

	var dir = (player.global_position - global_position).normalized()

	# 🔵 LIFE 1–3: HOMING SHOTS
	if current_life <= 3:
		var spike = SPIKE.instantiate()
		spike.global_position = global_position
		spike.target = player
		get_tree().current_scene.add_child(spike)

	# 🟡 LIFE 4–6: RADIAL BURST
	elif current_life <= 6:
		var burst = 8
		var base = randf_range(0, TAU)

		for i in range(burst):
			var angle = base + (TAU / burst) * i

			var spike = SPIKE.instantiate()
			spike.global_position = global_position + Vector2(randf_range(-260, 60), randf_range(-260, 60))
			spike.direction = Vector2.RIGHT.rotated(angle)

			get_tree().current_scene.add_child(spike)

	# 💀 LIFE 7: SCREEN INVASION (CAMERA)
	elif current_life == 7:
		var camera = get_viewport().get_camera_2d()
		var screen_size = get_viewport().get_visible_rect().size
		var top_left = camera.global_position - screen_size / 2

		for i in range(14):
			var spike = SPIKE.instantiate()

			spike.global_position = Vector2(
				randf_range(top_left.x, top_left.x + screen_size.x),
				randf_range(top_left.y, top_left.y + screen_size.y)
			)

			spike.target = player
			get_tree().current_scene.add_child(spike)

	# 🌋 LIFE 8: GROUND ERUPTION (ground CHILD nodes)
	elif current_life == 8:
		var ground_points = get_tree().get_nodes_in_group("ground_spawns")

		for p in ground_points:
			if p is Node2D:
				var spike = SPIKE.instantiate()
				spike.global_position = p.global_position
				spike.target = player
				get_tree().current_scene.add_child(spike)

	# ☠️ LIFE 9: BOSSTHREE GROUND CORE RING (LOCKED)
	else:
		if ground_node == null:
			return

		var origin = ground_node.global_position

		var burst = 18
		var base = randf_range(0, TAU)

		for i in range(burst):
			var angle = base + (TAU / burst) * i

			var spike = SPIKE.instantiate()

			# 🔒 locked ground-centered burst (no floating)
			spike.global_position = origin + Vector2(randf_range(-8, 8), 0)

			spike.direction = Vector2.RIGHT.rotated(angle)
			spike.target = player

			get_tree().current_scene.add_child(spike)


# ---------------- ANIMATION ----------------
func play_attack_animation():
	if state == State.PHASE3:
		sprite_node.play("panicattack")
	else:
		sprite_node.play("attackleft" if randi() % 2 == 0 else "attackright")


# ---------------- SPEED ----------------
func get_attack_delay() -> float:
	match state:
		State.PHASE1:
			return phase1_delay
		State.PHASE2:
			return phase2_delay
		State.PHASE3:
			return phase3_delay
	return 1.0


# ---------------- DAMAGE ----------------
func _on_area_entered(area):
	if finishing:
		return

	if area.is_in_group("Bullet"):
		area.queue_free()
		take_damage(1)


func take_damage(amount: int):
	if finishing:
		return

	health -= amount
	health = max(health, 0)

	health_changed.emit(health)

	update_phase()

	if health <= 0:
		call_deferred("next_life")


# ---------------- PHASE ----------------
func update_phase():
	if current_life >= total_lives * 0.7:
		state = State.PHASE1
	elif current_life >= total_lives * 0.4:
		state = State.PHASE2
	else:
		state = State.PHASE3


# ---------------- LIFE ----------------
func next_life():
	if finishing:
		return

	if current_life < total_lives:
		current_life += 1
		health = max_health

		if current_life >= 7:
			flash_enabled = true
	else:
		call_deferred("die")


# ---------------- DEATH ----------------
func die():
	if finishing:
		return

	finishing = true
	state = State.DEAD
	can_shoot = false
	flash_enabled = false

	var tween = get_tree().create_tween()
	tween.tween_property(sprite_node, "scale", Vector2.ZERO, 0.6)

	await tween.finished
	await explosion_storm()
	queue_free()


# ---------------- EXPLOSION STORM ----------------
func explosion_storm():
	if explosion_running:
		return

	explosion_running = true

	var camera = get_viewport().get_camera_2d()
	var screen_size = get_viewport().get_visible_rect().size

	var timer := 0.0
	var duration := 4.0

	while timer < duration:

		var explode = EXPLODE.instantiate()

		var random_pos = Vector2(
			randf_range(0, screen_size.x),
			randf_range(0, screen_size.y)
		)

		explode.global_position = random_pos + camera.global_position - screen_size / 2

		get_tree().current_scene.add_child(explode)

		await get_tree().create_timer(0.08).timeout
		timer += 0.08
