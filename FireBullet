extends Area2D
class_name FireBullet

@export var speed: float = 1600.0
@export var lifetime: float = 3.0
@export var damage: int = 1

var velocity: Vector2 = Vector2.ZERO
var owner_character = null
var has_hit := false

func _ready():
	add_to_group("FireBullet")

	area_entered.connect(_on_area_entered)

	# Destroy after lifetime
	await get_tree().create_timer(lifetime).timeout

	if is_instance_valid(self):
		queue_free()

func _physics_process(delta):
	if has_hit:
		return

	global_position += velocity * delta

func _on_area_entered(area: Area2D):
	if has_hit:
		return

	# Ignore itself
	if area.is_in_group("FireBullet"):
		return

	var fighter = area.get_parent()

	if fighter == null:
		return

	# Don't hit owner
	if fighter == owner_character:
		return

	# Only hit fighters
	if !fighter.is_in_group("Fighter"):
		return

	has_hit = true

	if fighter.has_method("take_damage"):
		fighter.take_damage(damage)

	queue_free()
