func _unhandled_input(event):

	# =====================================================
	# CPU MUST NOT RECEIVE PLAYER INPUT
	# =====================================================

	if is_cpu:
		return

	# =====================================================
	# PLAYER 1 JUMP
	# =====================================================

	if event.is_action_pressed("jump"):
		if is_on_floor():
			velocity.y = jump_velocity

	# =====================================================
	# COMBO INPUT
	# =====================================================

	var inputs = [
		"up",
		"down",
		"left",
		"right",
		"shoot"
	]

	for i in inputs:
		if event.is_action_pressed(i):
			register_input(i)

func apply_stun(_duration := 4.0):

	if state == State.DEAD:
		return

	stunned = true

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	velocity = Vector2.ZERO
	knockback_x = 0

	play_anim("idle")

	await get_tree().create_timer(4.0).timeout

	stunned = false

	is_hurting = false
	hurt_locked = false
	action_locked = false

func start_electricfly(dir: float):

	if state == State.DEAD:
		return

	if action_locked:
		return

	facing = dir
	sprite.flip_h = facing > 0

	electricfly_active = true
	spawn_protection = true
	is_attacking = true
	action_locked = true

	play_anim("electricfly")

	# Fly straight across the screen
	velocity = Vector2(facing * 2200, 0)

	# Stop after 1 second
	get_tree().create_timer(1.0).timeout.connect(func():
		electricfly_active = false
	)

	while electricfly_active:
		spawn_attack("electricfly")
		await get_tree().create_timer(0.08).timeout

	velocity.x = 0
	velocity.y = 0

	state = State.IDLE
	spawn_protection = false
	is_attacking = false
	action_locked = false
	play_anim("idle")

func end_electricfly():
	electricfly_active = false
	spawn_protection = false
	action_locked = false
	is_attacking = false

	if state != State.DEAD:
		play_anim("idle")

