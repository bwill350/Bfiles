func take_damage(amount: int):

	# =====================================================
	# BASIC DAMAGE LOCKS
	# =====================================================

	if not can_take_damage:
		return

	if state == State.DEAD:
		return

	if spawn_protection:
		return

	# =====================================================
	# PREVENT MULTIPLE DAMAGE ON SAME PHYSICS FRAME
	# =====================================================

	var frame := Engine.get_physics_frames()

	if has_meta("last_damage_frame"):

		if get_meta("last_damage_frame") == frame:
			return

	set_meta("last_damage_frame", frame)

	# =====================================================
	# TEMPORARY DAMAGE COOLDOWN
	# =====================================================

	can_take_damage = false

	get_tree().create_timer(0.25).timeout.connect(
		func():

			if is_instance_valid(self) and state != State.DEAD:
				can_take_damage = true
	)

	# =====================================================
	# BLOCK REDUCTION
	# =====================================================

	if is_blocking:

		amount = max(
			amount - 1,
			0
		)

	if amount <= 0:
		return

	# =====================================================
	# APPLY DAMAGE
	# =====================================================

	health -= amount

	health = max(
		health,
		0
	)

	print("================================")
	print("RAIDEN TOOK DAMAGE: ", amount)
	print("RAIDEN HP: ", health)
	print("ROUND: ", Game.current_round)
	print("================================")

	health_changed.emit(health)

	# =====================================================
	# HIT SOUND
	# =====================================================

	if is_instance_valid(hit_sound):
		hit_sound.play()

	# =====================================================
	# FINAL HIT
	# =====================================================

	if health <= 0:

		is_attacking = false
		is_shooting = false
		is_hurting = false
		is_blocking = false

		action_locked = true
		hurt_locked = true

		velocity = Vector2.ZERO

		if is_instance_valid(finish_label):
			finish_label.visible = false

		die()

		return

	# =====================================================
	# FINISH HIM CHECK
	# =====================================================
	#
	# Finish Him only happens when the opponent already
	# has one round win.
	#
	# =====================================================

	if health == 1 and not is_finish_state:

		var opponent_will_win_match := false

		# =================================================
		# RAIDEN IS PLAYER 1
		# =================================================

		if is_in_group("player1"):

			if Game.p2_round_wins >= 1:
				opponent_will_win_match = true

		# =================================================
		# RAIDEN IS CPU
		# =================================================

		else:

			if Game.p1_round_wins >= 1:
				opponent_will_win_match = true

		# =================================================
		# TRIGGER FINISH HIM
		# =================================================

		if opponent_will_win_match:

			# ---------------------------------------------
			# STOP HURT / ATTACK / MOVEMENT
			# ---------------------------------------------

			is_hurting = false
			hurt_locked = false
			action_locked = false

			is_attacking = false
			is_shooting = false
			is_blocking = false

			stunned = false

			knockback_x = 0.0
			velocity = Vector2.ZERO

			# ---------------------------------------------
			# FORCE IDLE BEFORE FINISH HIM
			# ---------------------------------------------

			state = State.IDLE

			current_anim = ""

			if is_instance_valid(sprite):

				sprite.visible = true
				sprite.play("idle")

			if has_node("Crispy"):
				$Crispy.visible = false

			# ---------------------------------------------
			# FINISH HIM
			# ---------------------------------------------

			trigger_finish_state()

			return

	# =====================================================
	# NORMAL HURT
	# =====================================================

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	state = State.IDLE

	velocity.x = 0
	knockback_x = 0.0

	combo.clear()

	# =====================================================
	# HURT ANIMATION
	# =====================================================

	# IMPORTANT:
	# If Raiden is at 1 HP, do NOT leave him in hurt/laying.
	# The 1 HP state must return him to idle.

	if health > 1:

		current_anim = ""

		if is_instance_valid(sprite):
			sprite.play("hurt")

	# =====================================================
	# ELECTRIC HIT EFFECT
	# =====================================================

	if has_node("Electric"):

		var electric_audio = get_node("Electric")

		if electric_audio is AudioStreamPlayer \
		or electric_audio is AudioStreamPlayer2D:

			electric_audio.play()

	# =====================================================
	# BLOOD EFFECT
	# =====================================================

	if has_node("BloodMarker"):

		var blood = BLOOD_EFFECT.instantiate()

		get_tree().current_scene.add_child(blood)

		blood.global_position = $BloodMarker.global_position

	# =====================================================
	# HURT DURATION
	# =====================================================

	await get_tree().create_timer(0.25).timeout

	# =====================================================
	# DEAD CHECK
	# =====================================================

	if state == State.DEAD:
		return

	# =====================================================
	# 1 HP — FORCE RAiden BACK TO IDLE
	# =====================================================

	if health == 1:

		is_hurting = false
		hurt_locked = false
		action_locked = false

		is_attacking = false
		is_shooting = false
		is_blocking = false

		stunned = false

		knockback_x = 0.0
		velocity = Vector2.ZERO

		state = State.IDLE

		# ---------------------------------------------
		# CANCEL LAYING / HURT ANIMATION
		# ---------------------------------------------

		current_anim = ""

		if is_instance_valid(sprite):

			sprite.visible = true
			sprite.play("idle")

		if has_node("Crispy"):
			$Crispy.visible = false

		return

	# =====================================================
	# NORMAL RETURN TO IDLE
	# =====================================================

	is_hurting = false
	hurt_locked = false
	action_locked = false

	is_attacking = false
	is_shooting = false

	knockback_x = 0.0

	state = State.IDLE

	velocity.x = 0

	if state != State.DEAD and not is_finish_state:

		current_anim = ""

		if is_instance_valid(sprite):
			sprite.play("idle")

func trigger_finish_state():

	if is_finish_state:
		return

	is_finish_state = true

	state = State.IDLE

	# Force them to stop moving
	velocity.x = 0
	velocity.y = 0

	action_locked = true
	hurt_locked = false
	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

	# Cancel any uppercut/fly state
	set_meta("uppercut_launched", false)

	# Return to idle
	play_anim("idle")

	# =====================================================
	# SHOW FINISH HIM
	# =====================================================

	finish_label.visible = true

	if finish_label.has_method("start_flicker"):
		finish_label.start_flicker(2.0, 0.05)

	# =====================================================
	# LET RAiden FALL BACK TO THE FLOOR
	# =====================================================

	await get_tree().create_timer(0.1).timeout

	while not is_on_floor():

		velocity.y += 5000.0 * get_physics_process_delta_time()

		move_and_slide()

		await get_tree().physics_frame

	velocity = Vector2.ZERO

	# =====================================================
	# KEEP FINISH HIM ON SCREEN
	# =====================================================

	await get_tree().create_timer(2.0).timeout

	# =====================================================
	# HIDE FINISH HIM
	# =====================================================

	if is_instance_valid(finish_label):
		finish_label.visible = false

	# =====================================================
	# WAIT A FEW SECONDS AFTER FINISH HIM
	# =====================================================

	await get_tree().create_timer(2.0).timeout

	# =====================================================
	# PLAY FATALITY SOUND
	# =====================================================

	if is_instance_valid(fatality_sound):
		fatality_sound.play()

func die():

	# =====================================================
	# ALREADY DEAD
	# =====================================================

	if state == State.DEAD:
		return

	# =====================================================
	# LOCK RAIDEN AS DEAD
	# =====================================================

	state = State.DEAD

	velocity = Vector2.ZERO

	is_attacking = false
	is_shooting = false
	is_blocking = false
	is_hurting = false

	action_locked = true
	hurt_locked = true

	can_take_damage = false

	# =====================================================
	# STOP RAIDEN-SPECIFIC ACTIONS
	# =====================================================

	electricfly_active = false
	special_move = false
	special_move_timer = 0.0

	stunned = false

	knockback_x = 0.0
	uppercut_launched = false
	run_locked = false

	# =====================================================
	# STOP CPU ACTIONS
	# =====================================================

	ai_timer = 999999.0

	# =====================================================
	# HIDE FINISH HIM
	# =====================================================

	if is_instance_valid(finish_label):
		finish_label.visible = false

	# =====================================================
	# DETERMINE ROUND WINNER
	# =====================================================
	#
	# If Raiden is P1:
	#     CPU wins.
	#
	# Otherwise:
	#     P1 wins.
	# =====================================================

	var winner := ""

	if is_in_group("player1"):

		winner = "cpu"

	else:

		winner = "player1"

	# =====================================================
	# DEBUG
	# =====================================================

	print("================================")
	print("RAIDEN DIED")
	print("ROUND: ", Game.current_round)
	print(
		"CURRENT SCORE: ",
		Game.p1_round_wins,
		" - ",
		Game.p2_round_wins
	)
	print("ROUND WINNER: ", winner)
	print("================================")

	# =====================================================
	# DETERMINE IF THIS DEATH ENDS THE MATCH
	# =====================================================
	#
	# Level1 has not awarded this round yet.
	#
	# If the winner already has one round win,
	# this death will give them their second win.
	# =====================================================

	var match_will_end := false

	if winner == "player1":

		if Game.p1_round_wins >= 1:
			match_will_end = true

	else:

		if Game.p2_round_wins >= 1:
			match_will_end = true

	print("MATCH WILL END: ", match_will_end)

	# =====================================================
	# HIDE NORMAL SPRITE / SHOW DEAD SPRITE
	# =====================================================

	$Sprite.visible = false
	$Crispy.visible = true

	$Crispy.flip_h = facing > 0

	# =====================================================
	# FINAL MATCH DEATH
	# =====================================================

	if match_will_end:

		print("================================")
		print("RAIDEN FINAL DEATH")
		print("FATALITY ALLOWED")
		print("================================")

		# -------------------------------------------------
		# BLOOD DEATH EFFECT
		# -------------------------------------------------

		var blood = BLOOD_DEATH.instantiate()

		get_tree().current_scene.add_child(blood)

		blood.global_position = global_position

		# -------------------------------------------------
		# MAKE SURE DEAD SPRITE IS SHOWN
		# -------------------------------------------------

		$Sprite.visible = false
		$Crispy.visible = true

		$Crispy.flip_h = facing > 0

		# -------------------------------------------------
		# HIDE FINISH HIM
		# -------------------------------------------------

		if is_instance_valid(finish_label):
			finish_label.visible = false

		# -------------------------------------------------
		# WAIT FOR FINAL DEATH / FATALITY
		# -------------------------------------------------

		await get_tree().create_timer(3.0).timeout

		# -------------------------------------------------
		# TELL LEVEL1 WHO WON
		# -------------------------------------------------

		round_death.emit(winner)

		return

	# =====================================================
	# NORMAL ROUND DEATH
	# =====================================================
	#
	# Match is NOT over.
	#
	# Level1 handles:
	#   - awarding the round
	#   - updating the score
	#   - starting Round 2
	#   - resetting fighters
	#   - resetting health bars
	#   - showing Round 2
	# =====================================================

	print("================================")
	print("RAIDEN ROUND DEATH")
	print("NO FATALITY")
	print("LEVEL1 WILL HANDLE NEXT ROUND")
	print("================================")

	# =====================================================
	# HIDE FINISH HIM
	# =====================================================

	if is_instance_valid(finish_label):
		finish_label.visible = false

	# =====================================================
	# GIVE LEVEL1 CONTROL
	# =====================================================

	round_death.emit(winner)

	return

# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):

	if current_anim == anim_name:
		return

	current_anim = anim_name
	sprite.play(anim_name)

func spawn_fx(scene: PackedScene):

	var fx = scene.instantiate()

	# IMPORTANT: set owner BEFORE it can collide
	fx.owner_character = self
	fx.damage_done = false

	get_tree().current_scene.call_deferred("add_child", fx)

	await get_tree().process_frame

	if target and is_instance_valid(target):
		fx.global_position = target.global_position + Vector2(60 * facing, 0)
	else:
		fx.global_position = global_position + Vector2(80 * facing, 0)

func check_combos():

	# ---------------- FIRE ----------------
	if combo == FIRE_COMBO:

		combo_used.emit("fire")

		special_bullet = FIRE_BULLET

		combo.clear()

		shoot_player()
		return

	elif combo == ELECTRIC_COMBO:

		combo_used.emit("electric")

		spawn_fx(ELECTRIC_DEATH)

		special_bullet = ELECTRIC_BULLET

		combo.clear()

		shoot_player()
		return

	# ---------------- kick ----------------
	elif combo == KICK_COMBO:

		combo_used.emit("kick_combo")

		combo.clear()

		start_kick_combo()
		return

	# ---------------- PUNCH ----------------
	elif combo == PUNCH_COMBO:

		combo_used.emit("punch_combo")

		combo.clear()

		start_punch_combo()
		return

func start_punch_combo():

	if action_locked or is_hurting or state == State.DEAD:
		return

	await combo_attack([
		"punch",
		"lowpunch",
		"punch",
		"uppercut",
		"highpunch",
		"uppercut"
	])


func start_kick_combo():

	if kick_combo_active:
		return

	if action_locked or is_hurting or state == State.DEAD:
		return

	if health <= 1:
		return

	kick_combo_active = true
	can_take_damage = false

	await combo_attack([
		"kick",
		"knee",
		"highkick",
		"roundhousekick",
		"lowkick",
		"roundhousekick",
		"highkick"
	])

	# Combo is completely finished
	kick_combo_active = false

	if state != State.DEAD:
		can_take_damage = true

