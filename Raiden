# COMBO ATTACK
# =========================================================
func combo_attack(attacks: Array):

	action_locked = true
	is_attacking = true

	for attack in attacks:

		# STOP COMBO IF HIT
		if is_hurting or state == State.DEAD:
			break

		play_anim(attack)
		spawn_attack(attack)

		await sprite.animation_finished

	is_attacking = false
	action_locked = false

	if not is_hurting:
		play_anim("idle")

func _on_raiden_hurt_box_area_entered(area: Area2D) -> void:

	# =====================================================
	# BASIC CHECKS
	# =====================================================

	if hurt_cooldown:
		return

	if area == null or not is_instance_valid(area):
		return

	if state == State.DEAD:
		return

	if spawn_protection:
		return

	# Ignore hurt boxes
	if area.is_in_group("HurtBox"):
		return

	# =====================================================
	# ELECTRIC FLY DAMAGE
	# =====================================================

	if electricfly_active:

		if area.has_method("take_damage"):
			area.take_damage(1)

		elif area.get_parent() and area.get_parent().has_method("take_damage"):
			area.get_parent().take_damage(1)

		end_electricfly()
		return

	# =====================================================
	# VALID ATTACK / PROJECTILE
	# =====================================================

	var valid_attack := (
		area.is_in_group("HitBox")
		or area.is_in_group("ReptileAcid")
		or area.is_in_group("ReptileBullet")
		or area.is_in_group("RaidenElectricBullet")
		or area.is_in_group("FireBullet")
		or area.is_in_group("Fireball")
		or area.is_in_group("SonyaBullet")
		or area.is_in_group("JohnnyCageBullet")
		or area.is_in_group("KanoBullet")
		or area.is_in_group("IceBullet")
		or area.is_in_group("KanoAttack")
	)

	if not valid_attack:
		return

	# =====================================================
	# DAMAGE COOLDOWN
	# =====================================================

	hurt_cooldown = true

	# =====================================================
	# UPPERCUT CHECK
	# =====================================================

	var was_uppercut := false

	if area.get("attack_name") != null:
		if area.attack_name == "uppercut":
			was_uppercut = true

	# =====================================================
	# KNOCKBACK
	# =====================================================

	knockback_x = -facing * 100

	# =====================================================
	# PLAY HIT ANIMATION
	# =====================================================

	if was_uppercut:

		current_anim = ""
		sprite.play("wasuppercut")

	else:

		current_anim = ""
		sprite.play("hurt")

	# =====================================================
	# APPLY DAMAGE
	# =====================================================

	take_damage(1)

	# =====================================================
	# WAIT FOR HIT ANIMATION
	# =====================================================

	if state != State.DEAD and health > 1 and not is_finish_state:

		if was_uppercut:

			await sprite.animation_finished

		else:

			await get_tree().create_timer(0.2).timeout

	# =====================================================
	# FINISH HIM / 1 HP
	# =====================================================

	if state == State.DEAD:
		hurt_cooldown = false
		return

	if is_finish_state:
		hurt_cooldown = false
		return

	if health <= 1:

		is_hurting = false
		hurt_locked = false
		action_locked = false
		is_attacking = false
		is_shooting = false
		is_blocking = false

		velocity = Vector2.ZERO
		knockback_x = 0.0

		state = State.IDLE

		current_anim = ""

		if is_instance_valid(sprite):
			sprite.visible = true
			sprite.play("idle")

		hurt_cooldown = false
		return

	# =====================================================
	# RETURN TO IDLE AFTER UPPERCUT
	# =====================================================

	is_hurting = false
	hurt_locked = false
	action_locked = false
	is_attacking = false

	state = State.IDLE
	velocity.x = 0
	knockback_x = 0

	current_anim = ""

	if is_instance_valid(sprite):
		sprite.visible = true
		sprite.play("idle")

	# =====================================================
	# RELEASE DAMAGE COOLDOWN
	# =====================================================

	await get_tree().create_timer(0.2).timeout

	hurt_cooldown = false
