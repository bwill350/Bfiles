	pull_target = get_tree().get_first_node_in_group("Reptile")

func run_pull_logic(delta):
	if pull_target == null or !is_instance_valid(pull_target):
		is_pulled = false
		stunned = false
		action_locked = false
		return

	var dir = sign(pull_target.global_position.x - global_position.x)

	velocity.x = dir * 900
	velocity.y = -120

	pull_timer -= delta

	if pull_timer <= 0.0:

		is_pulled = false

		# SNAP to Reptile AttackMarker (THIS IS MK MOMENT)
		global_position = pull_target.attack_marker.global_position + Vector2(40 * pull_target.facing, 0)

		stunned = false
		is_hurting = false
		action_locked = false
		is_attacking = true

		pull_target = null

func cpu_logic(delta):

	# =========================================================
	# DEAD
	# =========================================================
	if state == State.DEAD:
		return

	# =========================================================
	# FINISH HIM
	# =========================================================
	if is_finish_state:
		is_attacking = false
		action_locked = true
		velocity.x = 0
		state = State.IDLE

		if not is_hurting:
			play_anim("idle")

		return

	# =========================================================
	# HURT
	# =========================================================
	if is_hurting:

		velocity.x = knockback_x

		knockback_x = move_toward(
			knockback_x,
			0.0,
			1500.0 * delta
		)

		move_and_slide()

		if abs(knockback_x) > 10.0:
			return

		knockback_x = 0.0
		is_hurting = false
		hurt_locked = false
		is_attacking = false
		is_shooting = false
		action_locked = false

		state = State.IDLE
		play_anim("idle")

		ai_timer = 0.1

		return

	# =========================================================
	# ACTION LOCK
	# =========================================================
	if action_locked:
		velocity.x = 0
		return

	# =========================================================
	# FIND PLAYER 1
	# =========================================================
	if target == null or not is_instance_valid(target):

		target = get_tree().get_first_node_in_group("player1")

		# Backup: find human Fighter
		if target == null or not is_instance_valid(target):

			for node in get_tree().get_nodes_in_group("Fighter"):

				if node == self:
					continue

				if not is_instance_valid(node):
					continue

				if node is Node2D and not node.is_cpu:
					target = node
					break

	# =========================================================
	# NO TARGET
	# =========================================================
	if target == null or not is_instance_valid(target):

		velocity.x = 0
		state = State.IDLE
		play_anim("idle")

		return

	# =========================================================
	# DISTANCE TO PLAYER 1
	# =========================================================
	var dist: float = target.global_position.x - global_position.x
	var distance: float = abs(dist)
	var direction: float = sign(dist)

	# =========================================================
	# FACE PLAYER 1
	# =========================================================
	if direction != 0:

		facing = direction

		sprite.flip_h = facing > 0
		$Crispy.flip_h = facing > 0

		$AttackMarker.position = Vector2(0, 0)
		$Raidenshoot.position = Vector2(63 * facing, -225)

	# =========================================================
	# CPU DISTANCES
	# =========================================================
	var attack_range := 120.0
	var stopping_distance := 100.0

	# =========================================================
	# WALK TOWARD PLAYER 1
	# =========================================================
	if distance > stopping_distance:

		# Move toward Player 1
		velocity.x = direction * SPEED

		# Set walking state
		state = State.WALK

		# Play walk animation
		if not is_attacking and not is_hurting:
			play_anim("walk")

	# =========================================================
	# STOP WHEN CLOSE ENOUGH
	# =========================================================
	else:

		velocity.x = 0
		state = State.IDLE

		if not is_attacking and not is_hurting:
			play_anim("idle")

	# =========================================================
	# AI ATTACK TIMER
	# =========================================================
	ai_timer -= delta

	if ai_timer > 0.0:
		return

	# =========================================================
	# ATTACK ONLY WHEN CLOSE
	# =========================================================
	if (
		distance <= attack_range
		and not is_hurting
		and not is_finish_state
		and not action_locked
		and not is_attacking
	):

		match Game.difficulty:

			"Hard":

				# Very fast reactions
				ai_timer = randf_range(0.05, 0.15)

				var choice = randi() % 100

				if choice < 20:
					do_action("punch")
				elif choice < 20:
					do_action("highpunch")
				elif choice < 20:
					do_action("lowpunch")
				elif choice < 20:
					do_action("kick")
				elif choice < 20:
					do_action("highkick")
				elif choice < 20:
					do_action("lowkick")
				elif choice < 65:
					do_action("uppercut")
				elif choice < 80:
					do_action("roundhousekick")
				elif choice < 85:
					do_action("electricfly")
				else:
					shoot_player()

			"Easy":

				ai_timer = randf_range(0.5, 0.9)

				var choice = randi() % 100

				if choice < 40:
					do_action("punch")
				elif choice < 40:
					do_action("highpunch")
				elif choice < 40:
					do_action("lowpunch")
				elif choice < 70:
					do_action("kick")
				elif choice < 70:
					do_action("highkick")
				elif choice < 70:
					do_action("lowkick")
				elif choice < 85:
					do_action("uppercut")
				elif choice < 95:
