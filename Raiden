# ---------------- REGISTER INPUT ----------------
func register_input(input: String):

	# only human player can enter combos
	if not is_in_group("player1"):
		return

	combo.append(input)

	combo_timer = 0.0

	check_combos()

func handle_double_tap_run(input_dir: float, delta: float) -> bool:
	if input_dir == 0:
		return false

	var now := Time.get_ticks_msec() / 1000.0

	if input_dir == last_tap_dir:
		if now - last_tap_time <= tap_time:
			run_locked = true
			return true

	last_tap_time = now
	last_tap_dir = input_dir

	return false

func run(input_dir: float):
	if input_dir == 0:
		return

	if state == State.DEAD:
		return

	state = State.RUN
	velocity.x = input_dir * SPEED * 4

	if not is_attacking and not is_hurting:
		play_anim("run")

# ---------------- PHYSICS ----------------
func _physics_process(delta):

	if state == State.DEAD:
		return

	if is_pulled:
		run_pull_logic(delta)
		move_and_slide()
		return

	# ---------------- STUN ----------------
	if stunned:
		velocity = Vector2.ZERO
		velocity.x = 0
		return

	# ---------------- DEATH / FINISH ----------------
	if state == State.DEAD:
		return

	if is_finish_state:
		state = State.IDLE
		velocity.x = 0
		if not is_hurting:
			play_anim("idle")
		move_and_slide()
		return

	# ---------------- GRAVITY ----------------
	velocity.y += GRAVITY * delta

	if uppercut_launched:

		move_and_slide()

		if is_on_floor():
			uppercut_launched = false

		return

	# ---------------- COOLDOWNS ----------------
	shoot_cooldown = max(shoot_cooldown - delta, 0.0)

	combo_timer += delta
	if combo_timer > combo_reset_time:
		combo.clear()

	# ---------------- CPU ----------------
	if is_cpu:
		cpu_logic(delta)
		move_and_slide()
		return

	if state == State.DEAD:
		return

	if is_finish_state:
		state = State.IDLE
		velocity.x = 0

		if not is_hurting:
			play_anim("idle")

		move_and_slide()
		return

	var input_dir = Input.get_axis("left", "right")
	var climb_pressed = Input.is_action_pressed("climb")

	# ---------------- FACING ----------------
	if input_dir != 0:
		facing = input_dir

	sprite.flip_h = facing > 0
	$Crispy.flip_h = facing > 0

	$AttackMarker.position = Vector2(0 * facing, 0)
	$Raidenshoot.position = Vector2(63 * facing, -225)

	# =========================================================
	# 🟢 MOVEMENT (RUN ADDED HERE)
	# =========================================================
	if Input.is_action_pressed("run") and input_dir != 0:
		run(input_dir)   # 🔥 CALLS YOUR NEW RUN FUNCTION
	else:
		velocity.x = input_dir * SPEED

		# ---------------- STATE ----------------
		if not is_on_floor():
			state = State.JUMP
		elif input_dir != 0:
			state = State.WALK
		else:
			state = State.IDLE

	# ---------------- ELECTRIC FLY ----------------
	if electricfly_active:
		velocity.y = 0
		velocity.x = facing * 1300
		move_and_slide()
		return

	if action_locked:
		return

	# ---------------- ANIMS ----------------
	match state:

		State.JUMP:
			if not is_attacking:
				play_anim("jump")

		State.WALK:
			if not is_attacking:
				play_anim("walk")

		State.RUN:
			if not is_attacking:
				play_anim("run")

		State.IDLE:
			if not is_attacking:
				play_anim("idle")

	if is_hurting and hurt_locked:
		return

	# ---------------- JUMP ----------------
	if Input.is_action_just_pressed("jump") and is_on_floor():
		velocity.y = jump_velocity
		$Jump.play()

	# ---------------- ATTACKS ----------------
	if Input.is_action_just_pressed("punch"):
		do_action("punch")

	if Input.is_action_just_pressed("highpunch"):
		do_action("highpunch")

	if Input.is_action_just_pressed("lowpunch"):
		do_action("lowpunch")

	elif Input.is_action_just_pressed("kick"):
		do_action("kick")

	elif Input.is_action_just_pressed("highkick"):
		do_action("highkick")

	elif Input.is_action_just_pressed("lowkick"):
		do_action("lowkick")

	elif Input.is_action_just_pressed("uppercut"):
		do_action("uppercut")

	elif Input.is_action_just_pressed("roundhousekick"):
		do_action("roundhousekick")

	elif Input.is_action_just_pressed("electricfly"):
		$Hurt.play()
		do_action("electricfly")
		spawn_raiden_bullet()

	elif Input.is_action_just_pressed("electricburst"):
		do_action("electricburst")
		spawn_burst()
		# PLAY FATALITY SOUND
		if is_instance_valid(fatality_sound):
			fatality_sound.play()
		print("================================")
		print("===========FATALITY=============")
		print("================================")

	elif Input.is_action_just_pressed("doublepalmshocker"):
		play_anim("doublepalmshocker")
		do_action("doublepalmshocker")
		print("================================")
		print("===========FATALITY=============")
		print("================================")

		# PLAY FATALITY SOUND
		if is_instance_valid(fatality_sound):
			fatality_sound.play()

		var bullet = RAIDEN_ELECTRIC_BULLET.instantiate()
		get_tree().current_scene.add_child(bullet)

		bullet.global_position = shoot_marker.global_position
		bullet.velocity = Vector2(facing, 0) * bullet.speed

	elif Input.is_action_just_pressed("electricforcefield"):
		do_action("electricforcefield")

	elif Input.is_action_just_pressed("shoot"):
		shoot_player()

	move_and_slide()

func spear_pulled_to_p1():

	is_pulled = true
	stunned = true
