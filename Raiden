		return

	match sprite.animation:

		"electricfly":
			if sprite.frame == 1: # or whatever frame you want
				bullet_spawned = true
				spawn_raiden_bullet()



func _on_health_changed(h):

	# =========================================================
	# 1 HP — RAiden MUST RETURN TO IDLE
	# =========================================================
	if h == 1 and not is_finish_state:

		# -----------------------------------------------------
		# STOP ALL HURT / ATTACK STATES
		# -----------------------------------------------------

		is_attacking = false
		is_shooting = false
		is_hurting = false
		is_blocking = false

		action_locked = false
		hurt_locked = false
		hurt_cooldown = false

		stunned = false
		knockback_x = 0.0
		velocity = Vector2.ZERO

		# -----------------------------------------------------
		# FORCE RAiden BACK TO NORMAL STATE
		# -----------------------------------------------------

		state = State.IDLE

		# Make sure the normal sprite is visible
		if is_instance_valid(sprite):
			sprite.visible = true

		# Hide dead sprite if it was showing
		if has_node("Crispy"):
			$Crispy.visible = false

		# -----------------------------------------------------
		# IMPORTANT:
		# Cancel hurt/laying animation and return to IDLE
		# -----------------------------------------------------

		current_anim = ""

		if is_instance_valid(sprite):
			sprite.play("idle")

		# -----------------------------------------------------
		# FINISH HIM
		# -----------------------------------------------------

		is_finish_state = true

		# Small delay before showing FINISH HIM
		await get_tree().create_timer(0.2).timeout

		# -----------------------------------------------------
		# CHECK AGAIN
		# -----------------------------------------------------

		if health != 1:
			return

		if state == State.DEAD:
			return

		# -----------------------------------------------------
		# FORCE IDLE ONE MORE TIME
		# -----------------------------------------------------

		is_hurting = false
		hurt_locked = false
		action_locked = false
		is_attacking = false
		is_shooting = false
		velocity = Vector2.ZERO
		state = State.IDLE

		current_anim = ""

		if is_instance_valid(sprite):
			sprite.visible = true
			sprite.play("idle")

		# -----------------------------------------------------
		# SHOW FINISH HIM
		# -----------------------------------------------------

		if is_instance_valid(finish_label):

			finish_label.visible = true

			if finish_label.has_method("start_flicker"):
				finish_label.start_flicker(2.0, 0.05)

		# -----------------------------------------------------
		# KEEP RAiden IDLE DURING FINISH HIM
		# -----------------------------------------------------

		await get_tree().create_timer(2.0).timeout

		if is_instance_valid(finish_label):
			finish_label.visible = false

