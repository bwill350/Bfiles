extends CharacterBody2D
class_name Raiden

#Raiden (CharacterBody2D)
#├── Sprite (AnimatedSprite2D)
#├── CollisionShape2D
#├── RaidenHurtBox (Area2D)
#│   └── CollisionShape2D
#├── AttackMarker (Marker2D)
#├── Raidenshoot (Marker2D)
#├── BloodMarker (Marker2D)
#├── ShootTimer (Timer)
#├── PhaseTimer (Timer)
#├── HitFlashTimer (Timer)
#├── Hit (AudioStreamPlayer2D)
#├── Agent (NavigationAgent2D)
#├── HUD (CanvasLayer)
#│   └── FinishLabel (Label)
#└── Sprite2D

var spawn_locked := true
var special_move := false
var special_move_timer := 0.0
var electricfly_active := false
var special_move_invincible := false
var spawn_protection := false
var is_spear_pulled = false

# ---------------- SIGNALS ----------------
signal health_changed(health)
signal combo_used(combo_name: String)

@onready var finish_label: Sprite2D = $HUD/FinishLabel/Sprite2D

# ---------------- STATE ----------------
enum State { IDLE, RUN, JUMP, JUMPKICK, ROUNDHOUSEKICK, BLOCK, PUNCH, CLIMB, DEAD }

var state: State = State.IDLE
var speed
# ---------------- FLAGS ----------------
var is_blocking := false
var is_hurting := false
var is_shooting := false
var is_attacking := false
var action_locked := false
var hurt_locked := false
var can_take_damage := true
var is_finish_state := false
var lock_timer := 0.0
var stunned := false
var hurt_cooldown := false

# ---------------- CPU ----------------
var is_cpu := false
var target: Node2D = null
var ai_timer := 0.0

# ---------------- MOVEMENT ----------------
var facing := 1
var current_anim := ""
var health: int
var shoot_cooldown := 0.0
var knockback_x := 0.0
const GRAVITY = 5000

# ---------------- EXPORTS ----------------
@export var SPEED = 300.0
@export var CLIMB_SPEED = 250.0
@export var jump_velocity = -1800.0
@export var max_health: int = 10
@export var shoot_cooldown_time := 0.01
@export var combo_reset_time := 0.6
# ---------------- PROJECTILES ----------------
const RAIDEN_ELECTRIC_BULLET = preload("res://Projectiles/RaidenElectricBullet.tscn")
const RAIDEN_ATTACK = preload("res://Projectiles/RaidenAttack.tscn")
const ELECTRIC_FORCE_FIELD = preload("res://Projectiles/ElectricForceField.tscn")
const ELECTRIC_BURST = preload("res://Projectiles/ElectricBurst.tscn")

const BLOOD_EFFECT = preload("res://GreenBloodEffect.tscn")
const BLOOD_DEATH = preload("res://Deaths/BloodDeath.tscn")

# ---------------- NODES ----------------
@onready var sprite: AnimatedSprite2D = $Sprite
@onready var hit_sound: AudioStreamPlayer2D = $Hit
@onready var hit_box: Area2D = $RaidenHurtBox
@onready var shoot_marker: Marker2D = $Raidenshoot
@onready var attack_marker: Marker2D = $AttackMarker
@onready var blood_marker: Marker2D = $BloodMarker

# ---------------- COMBOS ----------------
var combo := []
var combo_timer := 0.0
var electricfly_y := 0.0
const ACID_COMBO = ["down", "down", "down", "right", "shoot"]
const FIRE_COMBO = ["down", "right", "shoot"]
const ICE_COMBO = ["left", "left", "shoot"]
const ELECTRIC_COMBO = ["up", "down", "shoot"]

func start_electricfly():
	electricfly_y = global_position.y - 30
	electricfly_active = true
	special_move = true
	special_move_invincible = true
	special_move_timer = 0.4

	velocity.x = facing * 1800
	velocity.y = -300

func apply_stun(duration: float):
	if stunned:
		play_anim("freeze")
		return

	stunned = true
	velocity = Vector2.ZERO

	await get_tree().create_timer(duration).timeout

	stunned = false

func _on_health_changed(h):

	if h == 1 and not is_finish_state:

		is_finish_state = true

		is_attacking = false
		is_shooting = false
		is_hurting = false

		action_locked = false
		hurt_locked = false

		state = State.IDLE
		velocity = Vector2.ZERO

		# ---------------- DELAYED CONFIRMATION ----------------
		await get_tree().create_timer(0.2).timeout

		# double-check health didn’t change again
		if health == 1 and state != State.DEAD:

			if finish_label:
				finish_label.visible = true

				if finish_label.has_method("start_flicker"):
					finish_label.start_flicker(2.0, 0.05)

			await get_tree().create_timer(2.0).timeout

			if is_instance_valid(finish_label):
				finish_label.visible = false

# ---------------- READY ----------------
func _ready():

	add_to_group("Fighter")
	add_to_group("enemy")
	add_to_group("Raiden")

	add_to_group("FireDeath")
	add_to_group("IceDeath")
	add_to_group("ElectricDeath")

	spawn_locked = false

	health = max_health
	health_changed.emit(health)

	play_anim("idle")

	ai_timer = randf_range(0.2, 0.6)

# ---------------- INPUT ----------------
func _unhandled_input(event):

	if is_cpu:
		return

	if event.is_action_pressed("up"):
		register_input("up")
	elif event.is_action_pressed("down"):
		register_input("down")
	elif event.is_action_pressed("left"):
		register_input("left")
	elif event.is_action_pressed("right"):
		register_input("right")
	elif event.is_action_pressed("shoot"):
		register_input("shoot")

# ---------------- REGISTER INPUT ----------------
func register_input(input: String):
	combo.append(input)
	combo_timer = 0.0
	check_combos()

# ---------------- CHECK COMBOS ----------------
func check_combos():

	if combo == FIRE_COMBO:
		combo_used.emit("fire")
		combo.clear()

	elif combo == ICE_COMBO:
		combo_used.emit("ice")
		combo.clear()

	elif combo == ELECTRIC_COMBO:
		combo_used.emit("electric")
		combo.clear()

	elif combo == ACID_COMBO:
		combo_used.emit("acid")
		combo.clear()

# ---------------- PHYSICS ----------------
func _physics_process(delta):

	if stunned:
		velocity = Vector2.ZERO
		move_and_slide()
		return

	shoot_cooldown = max(shoot_cooldown - delta, 0.0)

	combo_timer += delta

	if combo_timer > combo_reset_time:
		combo.clear()

	if is_cpu:
		cpu_logic(delta)
		move_and_slide()
		return

	if state == State.DEAD:
		return

	if health <= 1:
		state = State.IDLE
		velocity.x = 0

		if not is_hurting:
			play_anim("idle")

		move_and_slide()
		return

	velocity.y += GRAVITY * delta

	if action_locked:
		return

	# ---------------- ELECTRIC FLY ----------------
	if electricfly_active:
		play_anim("electricfly")

		special_move_timer -= delta

		velocity.x = facing * 1300
		velocity.y += GRAVITY * delta

		move_and_slide()

		if special_move_timer <= 0:
			electricfly_active = false
			special_move = false
			special_move_invincible = false
			velocity = Vector2.ZERO

		return

	# ---------------- DEAD ----------------
	if state == State.DEAD:
		return

	# NORMAL GRAVITY
	velocity.y += GRAVITY * delta

	# ---------------- FINISH HIM ----------------
	if is_finish_state:

		velocity.x = 0

		if not is_on_floor():
			velocity.y += GRAVITY * delta
		else:
			velocity.y = 0

		state = State.IDLE
		play_anim("idle")

		move_and_slide()
		return

	# ---------------- LOCK TIMER SAFETY ----------------
	if action_locked:
		lock_timer -= delta
		if lock_timer <= 0:
			action_locked = false
			is_attacking = false
			hurt_locked = false

	# ---------------- GRAVITY ----------------
	if not electricfly_active:
		velocity.y += GRAVITY * delta

	# ---------------- LOCKED ----------------
	if action_locked or hurt_locked:
		velocity.x = move_toward(velocity.x, 0, SPEED * 8 * delta)
		move_and_slide()
		return

	# ---------------- CPU ----------------
	if is_cpu:
		if target == null:
			target = get_tree().get_first_node_in_group("Fighter")

		cpu_logic(delta)
		move_and_slide()
		return

	# ---------------- INPUT ----------------
	var input_dir = Input.get_axis("left", "right")
	var climb_pressed = Input.is_action_pressed("climb")

	# ---------------- FACING (FIXED LIKE REPTILE) ----------------
	if input_dir != 0:
		facing = sign(input_dir)

	sprite.flip_h = -facing < 0

	$AttackMarker.position = Vector2(63 * facing, -155)
	$Raidenshoot.position = Vector2(63 * facing, -155)
	# ---------------- MOVEMENT ----------------
	velocity.x = input_dir * SPEED

	# ---------------- STATE ----------------
	if climb_pressed and not is_on_floor() and is_on_wall():
		state = State.CLIMB

	elif not is_on_floor():
		state = State.JUMP

	elif input_dir != 0:
		state = State.RUN

	else:
		state = State.IDLE

	move_and_slide()

	# ---------------- STATES (ONLY WHEN FREE) ----------------
	if not is_hurting and not is_attacking:
		if not is_on_floor():
			state = State.JUMP

	# ---------------- ANIMS (ONLY ONCE) ----------------
	if is_hurting:
		play_anim("hurt")
		return
	elif is_attacking:
		true # attack system controls animation
	else:
		match state:
			State.JUMP:
				play_anim("jump")
			State.RUN:
				play_anim("walk")
			State.IDLE:
				play_anim("idle")

	# ---------------- ANIMATION ----------------
	if not is_attacking:
		match state:
			State.CLIMB:
				play_anim("climb")
			State.JUMP:
				play_anim("jump")
			State.RUN:
				play_anim("walk")
			State.IDLE:
				play_anim("idle")

	# ---------------- ATTACKS ----------------
	if Input.is_action_just_pressed("punch"):
		do_action("punch")

	elif Input.is_action_just_pressed("kick"):
		do_action("kick")

	elif Input.is_action_just_pressed("jumpkick"):
		do_action("jumpkick")

	elif Input.is_action_just_pressed("uppercut"):
		do_action("uppercut")

	elif Input.is_action_just_pressed("roundhousekick"):
		do_action("roundhousekick")

	elif Input.is_action_just_pressed("electricfly"):
		do_action("electricfly")

	elif Input.is_action_just_pressed("electricburst"):
		do_action("electricburst")
		spawn_burst()

	elif Input.is_action_just_pressed("doublepalmshocker"):
		play_anim("doublepalmshocker")
		do_action("doublepalmshocker")
		var bullet = RAIDEN_ELECTRIC_BULLET.instantiate()
		get_tree().current_scene.add_child(bullet)

		bullet.global_position = shoot_marker.global_position
		bullet.velocity = Vector2(facing, 0) * bullet.speed

	elif Input.is_action_just_pressed("electricforcefield"):
		do_action("electricforcefield")

	elif Input.is_action_just_pressed("shoot"):
		shoot_player()

	if Input.is_action_just_pressed("jump") and is_on_floor():
		velocity.y = jump_velocity
		state = State.JUMP

	move_and_slide()

	# ---------------- SPECIAL MOVES ----------------
	if special_move:

		if electricfly_active:
			global_position.y = lerp(global_position.y, electricfly_y, 0.2)
			special_move_timer -= delta
			velocity.x = facing * 1300
			velocity.y += GRAVITY * delta * 0.4
			move_and_slide()

func cpu_logic(delta):
# ---------------- HURT PRIORITY ----------------
	if is_hurting:

		if is_spear_pulled:
			# opposite of normal knockback
			velocity.x = -facing * -600
		else:
			# normal knockback
			velocity.x = -facing * 600

		knockback_x = move_toward(knockback_x, 0, 1500 * delta)

		if abs(knockback_x) < 10:
			knockback_x = 0
			is_hurting = false
			is_spear_pulled = false

		return

	if target == null or !is_instance_valid(target):
		velocity.x = 0
		return

# GRAVITY
	velocity.y += GRAVITY * delta

	var dist = target.global_position.x - global_position.x
	var direction = sign(dist)

	# HARD LOCK (Liu Kang style behavior)
	if action_locked:
		return

# STOP ALL ACTIONS AT 1HP
	if health <= 1:
		is_attacking = false
		action_locked = true
		velocity.x = 0
		move_and_slide()
		return

	ai_timer -= delta

	velocity.y += GRAVITY * delta
	facing = direction
	sprite.flip_h = facing > 0

# GRAVITY
	velocity.y += GRAVITY * delta


# ---------------- MOVEMENT ----------------
	if not is_attacking:
		play_anim("walk")

	if abs(dist) > 220:
		velocity.x = direction * SPEED * 0.8
		state = State.RUN
		play_anim("walk")
	else:
		velocity.x = direction * SPEED * 0.8
		state = State.RUN
		play_anim("walk")

	# ---------------- AI ACTIONS ----------------
	if ai_timer <= 0:

		ai_timer = randf_range(0.4, 0.8)

		match randi() % 5:

			0:
				do_action("punch")

			1:
				do_action("kick")

			2:
				do_action("uppercut")

			3:
				do_action("roundhousekick")

			4:
				shoot_player()

# ---------------- SHOOT ----------------
func shoot_player():
	if spawn_locked:
		return
	if is_shooting:
		return

	is_shooting = true
	is_attacking = true
	action_locked = true

	play_anim("shoot")

	var bullet = RAIDEN_ELECTRIC_BULLET.instantiate()
	get_tree().current_scene.add_child(bullet)

	# 🔥 SPAWN FROM MARKER
	bullet.global_position = $Raidenshoot.global_position

	# 🔥 FIXED DIRECTION
	bullet.velocity = Vector2.RIGHT * sign(facing) * bullet.speed

	await get_tree().create_timer(0.25).timeout

	is_shooting = false

	if is_hurting or state == State.DEAD:
		return

	is_attacking = false
	action_locked = false

	play_anim("idle")

func spawn_fx(scene: PackedScene):

	var fx = scene.instantiate()

	# Tell the effect who spawned it
	fx.owner_character = self

	get_tree().current_scene.call_deferred("add_child", fx)

	await get_tree().process_frame

	if target and is_instance_valid(target):
		fx.global_position = target.global_position + Vector2(60 * facing, 0)
	else:
		fx.global_position = global_position + Vector2(80 * facing, 0)

# ---------------- BURST ----------------
func spawn_burst():

	var burst = ELECTRIC_BURST.instantiate()

	get_tree().current_scene.add_child(burst)

	burst.global_position = attack_marker.global_position

# ---------------- FORCE FIELD ----------------
func spawn_force_field():

	if action_locked:
		return

	action_locked = true
	is_attacking = true

	play_anim("doublepalmshocker")

	var field = ELECTRIC_FORCE_FIELD.instantiate()
	get_tree().current_scene.add_child(field)

	# spawn from Raidenshoot marker
	field.global_position = $Raidenshoot.global_position

	await sprite.animation_finished

	action_locked = false
	is_attacking = false
# ---------------- ACTION ----------------
func do_action(anim_name: String):

	if spawn_locked:
		return

	if action_locked:
		return

	action_locked = true
	is_attacking = true
	lock_timer = 0.3

	play_anim(anim_name)

	# ---------------- NORMAL ATTACKS ----------------
	if anim_name in [
		"punch",
		"kick",
		"jumpkick",
		"uppercut",
		"roundhousekick"
	]:
		spawn_attack(anim_name)

	# ---------------- RAIDEN SPECIAL ----------------
	elif anim_name == "electricfly":
		start_electricfly()

		if has_node("AttackMarker"):
			var attack = RAIDEN_ATTACK.instantiate()
			get_parent().add_child(attack)

			attack.global_position = $AttackMarker.global_position
			attack.scale.x = facing

	# ---------------- OPTIONAL ELECTRIC BURST ----------------
	elif anim_name == "electricburst":

		if has_node("AttackMarker"):
			var attack = RAIDEN_ATTACK.instantiate()
			get_parent().add_child(attack)

			attack.global_position = $AttackMarker.global_position
			attack.scale.x = facing

	await sprite.animation_finished

	is_attacking = false
	action_locked = false
	hurt_locked = false

# ---------------- ATTACK ----------------
func spawn_attack(anim_name: String):

	if anim_name not in [
		"punch",
		"kick",
		"uppercut",
		"roundhousekick",
		"jumpkick"
	]:
		return

	var attack = RAIDEN_ATTACK.instantiate()
	get_tree().current_scene.add_child(attack)

	attack.global_position = $AttackMarker.global_position
	attack.scale.x = facing  # THIS replaces facing system

	var dmg := 1

	match anim_name:
		"uppercut":
			dmg = 1
		"roundhousekick":
			dmg = 1

	if attack.has_method("set_damage"):
		attack.set_damage(dmg)
	else:
		attack.damage = dmg

	attack.owner = self

# ---------------- DAMAGE ----------------
func take_damage(amount: int):

	if not can_take_damage:
		return

	can_take_damage = false

	await get_tree().create_timer(0.25).timeout

	can_take_damage = true

	if state == State.DEAD:
		return

	if spawn_protection:
		return

	# BLOCK REDUCTION
	if is_blocking:
		amount = max(amount - 1, 0)

	if amount <= 0:
		return

	health -= amount
	health = max(health, 0)

	print("Subzero took damage: ", amount, " HP=", health)

	health_changed.emit(health)
	hit_sound.play()

# ---------------- FINISH HIM ----------------
	if health == 1 and not is_finish_state:
		trigger_finish_state()
		return

	# ---------------- FINAL HIT ----------------
	if health <= 0:

		finish_label.visible = false

		await get_tree().create_timer(0.5).timeout

		get_tree().change_scene_to_file("res://CharacterSelect.tscn")
		return

	# ---------------- NORMAL HURT ----------------
	is_hurting = true
	hurt_locked = true
	action_locked = true

	state = State.IDLE

	play_anim("hurt")

	var blood = BLOOD_EFFECT.instantiate()
	get_tree().current_scene.add_child(blood)
	blood.global_position = $BloodMarker.global_position

	await get_tree().create_timer(0.25).timeout

	is_hurting = false
	hurt_locked = false
	action_locked = false

func trigger_finish_state():

	if is_finish_state:
		return

	is_finish_state = true

	state = State.IDLE
	velocity = Vector2.ZERO

	action_locked = true
	hurt_locked = false
	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

	play_anim("idle")

	finish_label.visible = true

	if finish_label.has_method("start_flicker"):
		finish_label.start_flicker(2.0, 0.05)

	await get_tree().create_timer(2.0).timeout

	if is_instance_valid(finish_label):
		finish_label.visible = false

	# KEEP SONYA IDLE AT 1 HP
	state = State.IDLE
	velocity = Vector2.ZERO

	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

	play_anim("idle")

# ---------------- DEATH ----------------
func die():
	state = State.DEAD
	velocity = Vector2.ZERO

	var death = BLOOD_DEATH.instantiate()
	get_tree().current_scene.add_child(death)
	death.global_position = global_position

	await get_tree().create_timer(1.0).timeout

	get_tree().change_scene_to_file("res://Scenes/CharacterSelect.tscn")

	queue_free()

# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):

	if current_anim == anim_name:
		return

	current_anim = anim_name
	sprite.play(anim_name)

func _on_raiden_hurt_box_area_entered(area: Area2D) -> void:

	if hurt_cooldown:
		return

	if area == null or !is_instance_valid(area):
		return

	if area.is_in_group("HurtBox"):
		return

	# ---------------- SPEAR PRIORITY ----------------
	if area.is_in_group("ReptileSpear"):
		hurt_cooldown = true

		health -= 1
		health_changed.emit(health)

		is_spear_pulled = true
		is_hurting = true
		action_locked = true

		play_anim("hurt")

		await get_tree().create_timer(0.8).timeout

		is_spear_pulled = false
		is_hurting = false
		action_locked = false
		hurt_cooldown = false
		return

	if not can_take_damage:
		return

	if area.is_in_group("HitBox") \
	or area.is_in_group("ReptileAcid") \
	or area.is_in_group("KanoBullet") \
	or area.is_in_group("FireBullet") \
	or area.is_in_group("Fireball") \
	or area.is_in_group("JohnnyCageBullet") \
	or area.is_in_group("SonyaBullet"):

		hurt_cooldown = true

		knockback_x = -facing * 700
		take_damage(1)

		await get_tree().create_timer(0.15).timeout
		hurt_cooldown = false
