extends Area2D
class_name KanoBullet

@export var speed: float = 1600.0
@export var lifetime: float = 3.0
@export var spin_speed: float = 15.0
@export var damage: int = 1

var velocity: Vector2 = Vector2.ZERO
var has_hit := false

@onready var sprite: AnimatedSprite2D = $Sprite2D

func _ready():
	sprite.play("default")

	add_to_group("KanoBullet")

	await get_tree().create_timer(lifetime).timeout

	if is_instance_valid(self):
		queue_free()

func _physics_process(delta):
	global_position += velocity * delta
	rotation += spin_speed * delta

func _on_area_entered(area: Area2D) -> void:
	print("Kano bullet hit:", area.name)
	if has_hit:
		return

	# Ignore other Kano bullets
	if area.is_in_group("KanoBullet"):
		return

	var fighter = area.get_parent()

	if fighter == null:
		return

	# Only hit fighters
	if not fighter.is_in_group("Fighter"):
		return

	# Don't hit Kano himself
	if fighter.is_in_group("Kano"):
		return

	has_hit = true

	if fighter.has_method("take_damage"):
		fighter.take_damage(damage)
