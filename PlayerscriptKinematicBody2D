extends KinematicBody2D
class_name Player

signal died

var hud
var SPEED = 210
var velocity = Vector2(0,0)
var input_vector = Vector2.ZERO
var coins = 0
enum States {AIR, FLOOR}
var state = States.AIR
const RUNSPEED = 400
const JUMPFORCE = -800
const GRAVITY = 35
var hp = 55
var climbing = 210

func ready():
	$Sprite.play("idle")
	loadhearts()

func playerlives():
	$"../HUD/Playerlives".text = " Playerlives: " 

func loadhearts():
	$"../HUD/Playerhearts".rect_size.x = hp % 3

func Healthbar():
	pass

func climb():
	$Sprite.play("climb")

func _physics_process(_delta):
	match state:
		States.AIR:
			if is_on_floor():
				state = States.FLOOR
				$Sprite.play("idle")
			if Input.is_action_pressed("move_right"):
				$Sprite.play("move_right")
				if Input.is_action_pressed("run"):
					velocity.x = RUNSPEED
				if Input.is_action_pressed("shoot_right"):
					if Input.is_action_just_pressed("shoot_right"):
						$Sprite.play("shoot_right")
						shoot_right()
					if Input.is_action_pressed("move_left"):
						$Sprite.play("move_left")
				else:
					velocity.x = SPEED
			elif Input.is_action_pressed("move_left"):
				$Sprite.play("move_left")
				if Input.is_action_just_pressed("shoot_left"):
					shoot_left()
				if Input.is_action_just_pressed("run"):
					velocity.x = -RUNSPEED
				else:
					velocity.x = -SPEED
			if Input.is_action_pressed("shoot_right"):
				shoot_right()
				$Sprite.play("shoot_right")
			if Input.is_action_pressed("move_up"):
				if Input.is_action_just_pressed("shootup"):
					shootup()
				velocity.y = -climbing
			else:
				velocity.x = lerp(velocity.x,0,0.2)
			move_and_fall()
			if Input.is_action_just_pressed("climb"):
				velocity.y = climbing
				$Sprite.play("climb")
			if Input.is_action_pressed("jump"):
				$Sprite.play("jump")
				velocity.y = JUMPFORCE
				$Sprite.flip_h = false
				if Input.is_action_just_pressed("shoot_right"):
					shoot_right()
					$Sprite.play("shoot_right")
			if Input.is_action_just_pressed("shoot_left"):
				$AnimationPlayer.play("shootleft")
				$Sprite.play("shoot_left")
			if Input.is_action_just_pressed("shootup"):
				$AnimationPlayer.play("shootup")
				$Sprite.play("shoot_up")
				shootup()

		States.FLOOR:
			if is_on_floor():
				$Sprite.play("idle")
			if Input.is_action_pressed("move_right"):
				$Sprite.play("move_right")
				if Input.is_action_just_pressed("run"):
					velocity.x = RUNSPEED
				else:
					velocity.x -= SPEED
					$Sprite.play("idle")
			elif Input.is_action_pressed("move_left"):
				$Sprite.play("move_left")
				if Input.is_action_just_pressed("shoot_left"):
					shoot_left()
				if Input.is_action_just_pressed("run"):
					velocity.x = -RUNSPEED
				if Input.is_action_just_pressed("shootdown"):
					$AnimationPlayer.play("shootdown")
					shootdown()
			else:
				velocity.x = lerp(velocity.x,0,0.2)
				state = States.FLOOR
				move_and_fall()
	
				global_position += input_vector * SPEED
		
				move_and_slide(velocity,Vector2.UP)
				shoot_right()

func shoot():
	$Sprite.play("shoot_right")
	$AnimationPlayer.play("shoot_right")

func jump():
	$AnimationPlayer.play("jump")

func take_damage(damage):
	ouch()
	hp -= damage
	hp -= 1
	if hp <= 0:
		$Sprite.play("death")
		emit_signal("died")
		$GameOver.play()

func ouch():
	set_modulate(Color(1,0.3,0.3,0.3))

func died():
	$Sprite.play("death")
	Healthbar()
	loadhearts()
	$Timer.start()

func _on_player_body_entered(body):
	if body.is_in_group("enemies"):
		playerlives()

func is_on_floor():
	velocity = move_and_slide(velocity,Vector2.UP)
	velocity.y = velocity.y + GRAVITY

func move_and_fall():
	velocity = move_and_slide(velocity,Vector2.UP)
	velocity.y = velocity.y + GRAVITY

func _on_player_area_entered(area):
	Healthbar()
	if is_in_group("eyeleft"):
		take_damage(1)
	if is_in_group("Boss"):
		take_damage(1)
	hp -= 1
	if hp <= 0:
		died()
	if area.is_in_group("door"):
		get_tree().change_scene("res://YouWin.tscn")

func run():
	velocity = move_and_slide(velocity,Vector2.UP)
	velocity.x = velocity.x + GRAVITY
	$AanimationPlayer.play("run")

func shoot_Laser():
	$AnimationPlayer.play("shoot_right")
	$Sprite.play("shoot_right")

func shootup():
	if Input.is_action_just_pressed("shootup"):
		$AnimationPlayer.play("shootup")
		$Sprite.play("shoot_up")

func shootdown():
	$AanimationPlayer.play("shootdown")
	$Sprite.play("shoot_left")

func shoot_left():
	$AnimationPlayer.play("shoot_left")
	$Sprite.play("shoot_left")

func shoot_right():
	$AnimationPlayer.play("shoot_right")
	$Sprite.play("shoot_right")

func _on_Timer_timeout():
	get_tree().change_scene("res://GameOver.tscn")
