extends CharacterBody2D
class_name Bosstwo

signal health_changed(health)

enum State { MOVE, PANIC, DEAD }
var state: State = State.MOVE

@export var max_health: int = 250
@export var total_lives: int = 7
@export var move_speed: float = 120.0
@export var gravity: float = 900.0
@export var attack_delay: float = 1.5
@export var panic_speed_multiplier: float = 1.6

var health: int
var current_life: int = 1

var direction := 1
var left_boundary: float
var right_boundary: float

var finishing := false
var panic := false

# SPIKES
const SPIKE_ONE = preload("res://Scenes/Boss/BosstwoSpikeBallone.tscn")
const SPIKE_TWO = preload("res://Scenes/Boss/BosstwoSpikeBalltwo.tscn")

@onready var sprite_node: AnimatedSprite2D = $Sprite
@onready var hit_area: Area2D = $Area2D   # ✅ THIS IS YOUR HIT DETECTOR


# ---------------- READY ----------------
func _ready():
	health = max_health
	add_to_group("Boss")

	left_boundary = position.x - 650
	right_boundary = position.x + 650

	# IMPORTANT: connect Area2D
	hit_area.area_entered.connect(_on_area_entered)

	start_attack_loop()


# ---------------- ATTACK LOOP ----------------
func start_attack_loop():
	while not finishing:

		shoot_one()
		await get_tree().create_timer(attack_delay if not panic else 0.7).timeout

		shoot_two()
		await get_tree().create_timer(attack_delay if not panic else 0.7).timeout


# ---------------- SPIKE 1 ----------------
func shoot_one():
	if finishing:
		return

	var spike = SPIKE_ONE.instantiate()
	spike.global_position = global_position
	get_tree().current_scene.add_child(spike)


# ---------------- SPIKE 2 ----------------
func shoot_two():
	if finishing:
		return

	var spike = SPIKE_TWO.instantiate()
	spike.global_position = global_position
	get_tree().current_scene.add_child(spike)


# ---------------- MOVEMENT ----------------
func _physics_process(delta):
	if state == State.DEAD:
		return

	var speed = move_speed * (panic_speed_multiplier if panic else 1.0)

	if not is_on_floor():
		velocity.y += gravity * delta
	else:
		velocity.y = 0

	velocity.x = direction * speed
	move_and_slide()

	if position.x < left_boundary:
		direction = 1
	elif position.x > right_boundary:
		direction = -1


# ---------------- DAMAGE ----------------
func _on_area_entered(area):
	if finishing:
		return

	if area.is_in_group("Bullet"):
		area.queue_free()
		take_damage(1)


func take_damage(amount: int):
	if finishing:
		return

	health -= amount
	health = max(health, 0)

	health_changed.emit(health)

	# PANIC MODE ON LAST LIFE
	if current_life == total_lives - 1:
		panic = true
		state = State.PANIC

	if health <= 0:
		call_deferred("next_life")


# ---------------- LIFE SYSTEM ----------------
func next_life():
	if finishing:
		return

	if current_life < total_lives:
		current_life += 1
		health = max_health
	else:
		call_deferred("die")


# ---------------- DEATH ----------------
func die():
	if finishing:
		return

	finishing = true
	state = State.DEAD
	panic = false

	await final_flash()

	queue_free()


# ---------------- FINAL FLASH (GUARANTEED) ----------------
func final_flash():
	sprite_node.modulate = Color(1, 0.2, 0.2)

	await get_tree().create_timer(0.25).timeout

	sprite_node.modulate = Color(1, 1, 1)

	await get_tree().create_timer(0.1).timeout
