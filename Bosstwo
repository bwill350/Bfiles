extends CharacterBody2D
class_name Bosstwo

signal health_changed(health)

enum State { MOVE, PHASE, RAGE, DEAD }
var state: State = State.MOVE

@export var max_health: int = 250
@export var total_lives: int = 7

@export var move_speed: float = 120.0
@export var shoot_interval: float = 1.1
@export var gravity: float = 900.0

var health: int
var current_life: int = 1

const BULLET_SCENE = preload("res://BossoneBullet.tscn")
const EXPLOSION_SCENE = preload("res://Explosion.tscn")

@onready var sprite: AnimatedSprite2D = $Sprite
@onready var hit_area: Area2D = $Area2D   # ✅ UPDATED (your new node)
@onready var shoot_timer: Timer = $ShootTimer
@onready var points_label: Label = $"../HUD/Points"
@onready var health_label: Label = $"../HUD/BosstwoHealthLabel"

var direction := 1
var left_boundary: float
var right_boundary: float

var finishing := false
var spiral_angle := 0.0


# ---------------- READY ----------------
func _ready():
	# animation fix
	sprite.animation = "one"
	sprite.frame = 0
	sprite.play()

	health = max_health
	add_to_group("Boss")

	left_boundary = position.x - 650
	right_boundary = position.x + 650

	# ✅ FIXED AREA2D CONNECTIONS
	hit_area.area_entered.connect(_on_area_entered)
	hit_area.body_entered.connect(_on_area_entered)

	shoot_timer.wait_time = shoot_interval
	shoot_timer.timeout.connect(shoot_player)
	shoot_timer.start()

	update_ui()


# ---------------- PHYSICS + GRAVITY ----------------
func _physics_process(delta):
	if state == State.DEAD or finishing:
		return

	if not is_on_floor():
		velocity.y += gravity * delta
	else:
		velocity.y = 0

	velocity.x = direction * move_speed
	move_and_slide()

	if position.x < left_boundary:
		direction = 1
	elif position.x > right_boundary:
		direction = -1


# ---------------- SHOOT ----------------
func shoot_player():
	if finishing:
		return

	var players = get_tree().get_nodes_in_group("player")
	if players.is_empty():
		return

	var player = players[0]
	var predicted_pos = player.global_position

	if "velocity" in player:
		predicted_pos += player.velocity * 0.3

	if player.state == player.State.JUMP:
		predicted_pos.y -= 50

	var bullet = BULLET_SCENE.instantiate()
	bullet.global_position = global_position

	var dir = (predicted_pos - global_position).normalized()
	bullet.direction = dir
	bullet.rotation = dir.angle()

	get_tree().current_scene.add_child(bullet)


# ---------------- DAMAGE ----------------
func _on_area_entered(area):
	if finishing:
		return

	if area.is_in_group("Bullet"):
		area.queue_free()
		take_damage(1)


func _on_body_entered(body):
	if finishing:
		return

	if body.is_in_group("Bullet"):
		body.queue_free()
		take_damage(1)


# ---------------- HEALTH ----------------
func take_damage(amount: int):
	if finishing:
		return

	health -= amount
	health = max(health, 0)

	health_changed.emit(health)
	update_ui()
	flash_red()

	if health <= 0:
		next_life()


# ---------------- LIFE SYSTEM ----------------
func next_life():
	if current_life < total_lives:
		current_life += 1
		move_speed += 15

		health = max_health
		update_ui()
	else:
		die()


# ---------------- UI ----------------
func update_ui():
	if points_label:
		points_label.text = "Points: %d" % Bossone.points

	if health_label:
		health_label.text = "Bosstwo Health: %d" % health


# ---------------- FLASH ----------------
func flash_red():
	sprite.modulate = Color(1, 0.3, 0.3)
	await get_tree().create_timer(0.07).timeout
	sprite.modulate = Color(1, 1, 1)


# ---------------- DEATH ----------------
func die():
	if finishing:
		return

	finishing = true
	state = State.DEAD

	shoot_timer.stop()

	await bosstwo_finisher()
	queue_free()


# =========================================================
# FINISHER
# =========================================================
func bosstwo_finisher():
	set_physics_process(false)

	var t := 0.0
	while t < 3.5:
		fire_spiral_ring()
		await get_tree().create_timer(0.04).timeout
		spiral_angle += 0.5
		t += 0.04

	for i in range(10):
		radial_explosion()
		await get_tree().create_timer(0.1).timeout

	final_apocalypse_burst()
	await get_tree().create_timer(0.3).timeout
	final_apocalypse_burst()

	await get_tree().create_timer(0.8).timeout


# ---------------- SPIRAL ----------------
func fire_spiral_ring():
	var center = global_position

	for i in range(26):
		var angle = spiral_angle + (TAU * i / 26)
		var dir = Vector2(cos(angle), sin(angle))

		var bullet = BULLET_SCENE.instantiate()
		bullet.global_position = center
		bullet.direction = dir
		bullet.rotation = dir.angle()

		get_tree().current_scene.add_child(bullet)


# ---------------- FINAL BURST ----------------
func final_apocalypse_burst():
	var center = global_position

	for i in range(72):
		var angle = TAU * i / 72
		var dir = Vector2(cos(angle), sin(angle))

		var bullet = BULLET_SCENE.instantiate()
		bullet.global_position = center
		bullet.direction = dir
		bullet.rotation = dir.angle()

		get_tree().current_scene.add_child(bullet)

	radial_explosion()
	radial_explosion()
	radial_explosion()


# ---------------- EXPLOSION ----------------
func radial_explosion():
	var center = global_position

	for i in range(28):
		var angle = TAU * i / 28
		var offset = Vector2(cos(angle), sin(angle)) * 170

		var explosion = EXPLOSION_SCENE.instantiate()
		explosion.global_position = center + offset

		get_tree().current_scene.add_child(explosion)
