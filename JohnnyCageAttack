extends Area2D
class_name JohnnyCageAttack

@onready var collision: CollisionShape2D = $CollisionShape2D

@export var active_time := 0.2
@export var lifetime := 0.6

var active := false
var has_hit := false
var damage := 1
var attack_owner: Node = null
var attack_name := ""
var attack_type := ""
var cam: Camera2D = null


func _ready():

	add_to_group("JohnnyCageAttack")

	await get_tree().process_frame

	cam = get_viewport().get_camera_2d()

	area_entered.connect(_on_area_entered)

	enable_hitbox()

	var attack_active_time := active_time

	if attack_name == "fatalkick":
		attack_active_time = 0.6

	await get_tree().create_timer(attack_active_time).timeout

	if not is_inside_tree():
		return

	disable_hitbox()

	await get_tree().create_timer(lifetime).timeout

	if not is_inside_tree():
		return

	queue_free()


func enable_hitbox():

	active = true
	monitoring = true
	collision.disabled = false


func disable_hitbox():

	active = false
	monitoring = false
	collision.disabled = true


func _on_area_entered(area):

	if not active:
		return

	if area == null:
		return

	var target = area.get_parent()

	if attack_owner != null and target == attack_owner:
		return

	if target == null:
		return

	if not target.is_in_group("Fighter"):
		return

	if not target.has_method("take_damage"):
		return

	# =====================================================
	# NORMAL ATTACKS
	# =====================================================

	if attack_name != "fatalkick":

		if has_hit:
			return

		has_hit = true
	if target.has_method("play_anim"):
		target.play_anim("fatalkick")
	# =====================================================
	# CAMERA SHAKE
	# =====================================================

	if cam and cam.has_method("shake"):
		cam.shake(18, 0.20)

	# =====================================================
	# UPPERCUT LAUNCH
	# =====================================================

	if attack_name == "uppercut":

		if "velocity" in target:

			var dir = 1

			if attack_owner != null:
				dir = attack_owner.facing

			target.velocity.x = dir * 1000
			target.velocity.y = -1800

			if "uppercut_launched" in target:
				target.uppercut_launched = true

			if target.has_method("play_anim"):
				target.play_anim("wasuppercut")

	# =====================================================
	# JUMPKICK LAUNCH
	# =====================================================

	elif attack_name == "jumpkick":

		if "velocity" in target:

			var dir = 1

			if attack_owner != null:
				dir = attack_owner.facing

			target.velocity.x = dir * 2800
			target.velocity.y = -200

			if "jumpkick_launched" in target:
				target.jumpkick_launched = true

			if target.has_method("play_anim"):
				target.play_anim("wasjumpkick")

	# =====================================================
	# TELL TARGET WHAT HIT IT
	#
	# THIS MUST HAPPEN BEFORE take_damage()
	# =====================================================

	target.set_meta("last_attack_name", attack_name)

	print(
		"JOHNNY ATTACK HIT: ",
		target.name,
		" | ATTACK: ",
		attack_name
	)

	# =====================================================
	# FATAL KICK
	#
	# DO NOT PLAY ANIMATION ON TARGET
	#
	# Kano's die() reads:
	# last_attack_name == "fatalkick"
	#
	# and shows the $fatalkick Sprite2D.
	# =====================================================

	if attack_name == "fatalkick":

		print("================================")
		print("JOHNNY CAGE FATAL KICK HIT")
		print("TARGET: ", target.name)
		print("SETTING last_attack_name = fatalkick")
		print("================================")

		if "velocity" in target:

			var dir = 1

			if attack_owner != null:
				dir = attack_owner.facing

			target.velocity.x = dir * 10
			target.velocity.y = -66

	# =====================================================
	# DAMAGE
	#
	# Metadata is already set above.
	# take_damage() can now call die().
	# =====================================================

	target.take_damage(damage)

	# =====================================================
	# CAMERA SHAKE BY ATTACK
	# =====================================================

	var cam2 := get_viewport().get_camera_2d()

	if cam2:

		match attack_name:

			"uppercut":
				cam2.shake(16, 0.18)

			"jumpkick":
				cam2.shake(14, 0.15)

			"roundhousekick":
				cam2.shake(12, 0.15)

			"kick", "highkick", "lowkick":
				cam2.shake(8, 0.10)

			"punch", "highpunch", "lowpunch":
				cam2.shake(6, 0.08)

			"fatalkick":
				cam2.shake(18, 0.20)

			_:
				cam2.shake(10, 0.12)
