const REPTILE = preload("res://Scenes/Boss/Reptile.tscn")
const SUBZERO = preload("res://Projectiles/Subzero.tscn")
const RAIDEN = preload("res://Scenes/Boss/Raiden.tscn")
const SONYA = preload("res://Scenes/Boss/Sonya.tscn")
const KANO = preload("res://Scenes/Boss/Kano.tscn")
const JOHNNYCAGE = preload("res://Scenes/Boss/JohnnyCage.tscn")

var p1
var p2

var round_starting := false
var round_active := false


# =========================================================
# READY
# =========================================================

func _ready():

	# ---------------------------------------------------------
	# HIDE ROUND UI
	# ---------------------------------------------------------

	if $HUD/Round1 != null:
		$HUD/Round1.visible = false

	if $HUD/Round2 != null:
		$HUD/Round2.visible = false

	if $HUD/Fight != null:
		$HUD/Fight.visible = false

	if $HUD/Round3 != null:
		$HUD/Round3.visible = false

	# ---------------------------------------------------------
	# ALWAYS START AT ROUND 1
	# ---------------------------------------------------------

	Game.current_round = 1
	Game.p1_round_wins = 0
	Game.p2_round_wins = 0

	# ---------------------------------------------------------
	# START ROUND 1
	# ---------------------------------------------------------

	await start_round(1)


# =========================================================
# START ROUND
# =========================================================

func start_round(round_number: int):

	if round_starting:
		return

	round_starting = true
	round_active = false

	Game.current_round = round_number

	print("================================")
	print("STARTING ROUND: ", Game.current_round)
	print("================================")

	# ---------------------------------------------------------
	# REMOVE OLD FIGHTERS
	# ---------------------------------------------------------

	await remove_current_fighters()

	# ---------------------------------------------------------
	# RESET HEALTH
	# ---------------------------------------------------------

	reset_health_bars()

	# ---------------------------------------------------------
	# HIDE ROUND UI
	# ---------------------------------------------------------

	if $HUD/Round1 != null:
		$HUD/Round1.visible = false

	if $HUD/Round2 != null:
		$HUD/Round2.visible = false

	if $HUD/Round3 != null:
		$HUD/Round3.visible = false

	if $HUD/Fight != null:
		$HUD/Fight.visible = false

	# ---------------------------------------------------------
	# SPAWN NEW FIGHTERS
	# ---------------------------------------------------------

	spawn_players()

	setup()
	assign_targets()

	# ---------------------------------------------------------
	# WAIT FOR FIGHTERS
	# ---------------------------------------------------------

	await get_tree().process_frame

	# ---------------------------------------------------------
	# RESET HEALTH AGAIN
	# ---------------------------------------------------------

	reset_health_bars()

	# ---------------------------------------------------------
	# SPAWN PROTECTION
	# ---------------------------------------------------------

	set_spawn_protection(true)

	# ---------------------------------------------------------
	# SHOW CORRECT ROUND
	# ---------------------------------------------------------

	if round_number == 1:

		print("SHOWING ROUND 1")

		if $HUD/Round1 != null:
			$HUD/Round1.visible = true

	elif round_number == 2:

		print("SHOWING ROUND 2")

		if $HUD/Round2 != null:
			$HUD/Round2.visible = true

	elif round_number == 3:

		print("SHOWING ROUND 3")

		if $HUD/Round3 != null:
			$HUD/Round3.visible = true

	# ---------------------------------------------------------
	# KEEP ROUND IMAGE ON SCREEN
	# ---------------------------------------------------------

	await get_tree().create_timer(2.0).timeout

	# ---------------------------------------------------------
	# HIDE ROUND IMAGE
	# ---------------------------------------------------------

	if $HUD/Round1 != null:
		$HUD/Round1.visible = false

	if $HUD/Round2 != null:
		$HUD/Round2.visible = false

	if $HUD/Round3 != null:
		$HUD/Round3.visible = false

	# ---------------------------------------------------------
	# SHORT DELAY
	# ---------------------------------------------------------

	await get_tree().create_timer(0.3).timeout

	# ---------------------------------------------------------
	# SHOW FIGHT
	# ---------------------------------------------------------

	if $HUD/Fight != null:

		$HUD/Fight.visible = true

		print("FIGHT!")

	await get_tree().create_timer(1.0).timeout

	# ---------------------------------------------------------
	# HIDE FIGHT
	# ---------------------------------------------------------

	if $HUD/Fight != null:
		$HUD/Fight.visible = false

	# ---------------------------------------------------------
	# REMOVE SPAWN PROTECTION
	# ---------------------------------------------------------

	set_spawn_protection(false)

	# ---------------------------------------------------------
	# ROUND ACTIVE
	# ---------------------------------------------------------

	round_active = true
	round_starting = false

	print("ROUND ", Game.current_round, " IS ACTIVE")


# =========================================================
# ROUND DEATH SIGNAL
# =========================================================
# Fighters call:
#
# round_death.emit("player1")
# round_death.emit("cpu")
#
# This is what automatically starts Round 2.
# =========================================================

func _on_round_death(winner: String):

	if round_starting:
		return

	if Game.current_round != 1:
		return

	print("================================")
	print("ROUND 1 HAS ENDED")
	print("WINNER: ", winner)
	print("================================")

	round_active = false

	# ---------------------------------------------------------
	# GIVE ROUND WIN
	# ---------------------------------------------------------

	if winner == "player1":

		Game.p1_round_wins += 1

		print("P1 ROUND WINS: ", Game.p1_round_wins)

	elif winner == "cpu":

		Game.p2_round_wins += 1

		print("P2 ROUND WINS: ", Game.p2_round_wins)

	# ---------------------------------------------------------
	# WAIT BEFORE ROUND 2
	# ---------------------------------------------------------

	await get_tree().create_timer(3.0).timeout

	# ---------------------------------------------------------
	# START ROUND 2
	# ---------------------------------------------------------

	if Game.current_round == 1:

		await start_round(2)


# =========================================================
# START ROUND 2
# =========================================================

func start_round_2():

	if round_starting:
		return

	if Game.current_round != 1:
		return

	print("================================")
	print("START ROUND 2")
	print("================================")

	Game.current_round = 2

	await start_round(2)


# =========================================================
# START ROUND 3
# =========================================================

func start_round_3():

	if round_starting:
		return

	if Game.current_round != 2:
		return

	print("================================")
	print("START ROUND 3")
	print("================================")

	Game.current_round = 3

	await start_round(3)


# =========================================================
# P1 WINS ROUND
# =========================================================

func player1_won_round():

	if round_starting:
		return

	if Game.current_round == 1:

		Game.p1_round_wins += 1

		print("P1 WON ROUND 1")

		Game.current_round = 2

		await start_round(2)

	elif Game.current_round == 2:

		Game.p1_round_wins += 1

		print("P1 HAS WON THE MATCH")

		if $HUD.has_method("show_you_win"):
			$HUD.show_you_win()


# =========================================================
# P2 WINS ROUND
# =========================================================

func player2_won_round():

	if round_starting:
		return

	if Game.current_round == 1:

		Game.p2_round_wins += 1

		print("P2 WON ROUND 1")

		Game.current_round = 2

		await start_round(2)

	elif Game.current_round == 2:

		Game.p2_round_wins += 1

		print("P2 HAS WON THE MATCH")

		if $HUD.has_method("show_you_lose"):
			$HUD.show_you_lose()


# =========================================================
# REMOVE CURRENT FIGHTERS
# =========================================================

func remove_current_fighters():

	round_active = false

	# ---------------------------------------------------------
	# REMOVE P1
	# ---------------------------------------------------------

	if is_instance_valid(p1):

		p1.set_process(false)
		p1.set_physics_process(false)

		p1.queue_free()
		p1 = null

	# ---------------------------------------------------------
	# REMOVE P2
	# ---------------------------------------------------------

	if is_instance_valid(p2):

		p2.set_process(false)
		p2.set_physics_process(false)

		p2.queue_free()
		p2 = null

	# ---------------------------------------------------------
	# WAIT FOR QUEUE FREE
	# ---------------------------------------------------------

	await get_tree().process_frame


