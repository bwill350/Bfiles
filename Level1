extends Node2D


# =========================================================
# SPAWN POSITIONS
# =========================================================

const P1_SPAWN := Vector2(603, 496)
const P2_SPAWN := Vector2(1890, 496)


# =========================================================
# CHARACTER SCENES
# =========================================================

const LIU_KANG = preload("res://Scenes/Boss/LiuKang.tscn")
const REPTILE = preload("res://Scenes/Boss/Reptile.tscn")
const SUBZERO = preload("res://Projectiles/Subzero.tscn")
const RAIDEN = preload("res://Scenes/Boss/Raiden.tscn")
const SONYA = preload("res://Scenes/Boss/Sonya.tscn")
const KANO = preload("res://Scenes/Boss/Kano.tscn")
const JOHNNYCAGE = preload("res://Scenes/Boss/JohnnyCage.tscn")


# =========================================================
# FIGHTERS
# =========================================================

var p1
var p2


# =========================================================
# ROUND STATE
# =========================================================

var round_starting := false
var round_active := false
var round_resolving := false


# =========================================================
# READY
# =========================================================

func _ready():

	Game.current_round = 1
	Game.p1_round_wins = 0
	Game.p2_round_wins = 0
	Game.match_over = false

	round_starting = false
	round_active = false
	round_resolving = false


	# =====================================================
	# HIDE ROUND UI
	# =====================================================

	$HUD/Round1.visible = false
	$HUD/Round2.visible = false
	$HUD/Round3.visible = false
	$HUD/Fight.visible = false
	$HUD/Fatality.visible = false


	# =====================================================
	# RESET ROUND WIN SPRITES
	# =====================================================

	if $HUD.has_method("hide_round_win_sprites"):
		$HUD.hide_round_win_sprites()


	# =====================================================
	# START ROUND 1
	# =====================================================

	await start_round(1)


# =========================================================
# START ROUND
# =========================================================

func start_round(round_number: int):

	if round_starting:
		return

	if Game.match_over:
		return

	round_starting = true
	round_active = false
	round_resolving = false

	Game.current_round = round_number


	print("================================")
	print("STARTING ROUND: ", Game.current_round)
	print("P1 WINS: ", Game.p1_round_wins)
	print("P2 WINS: ", Game.p2_round_wins)
	print("================================")


	# =====================================================
	# REMOVE OLD FIGHTERS
	# =====================================================

	await remove_current_fighters()


	# =====================================================
	# RESET HEALTH
	# =====================================================

	reset_health_bars()


	# =====================================================
	# HIDE ALL ROUND UI
	# =====================================================

	$HUD/Round1.visible = false
	$HUD/Round2.visible = false
	$HUD/Round3.visible = false
	$HUD/Fight.visible = false
	$HUD/Fatality.visible = false


	# =====================================================
	# SPAWN FIGHTERS
	# =====================================================

	spawn_players()

	setup()
	assign_targets()

	await get_tree().process_frame


	# =====================================================
	# RESET HEALTH AFTER SPAWN
	# =====================================================

	reset_health_bars()


	# =====================================================
	# UPDATE ROUND WIN INDICATORS
	# =====================================================

	if $HUD.has_method("update_round_wins"):
		$HUD.update_round_wins()


	# =====================================================
	# SPAWN PROTECTION
	# =====================================================

	set_spawn_protection(true)


	# =====================================================
	# SHOW ROUND 1
	# =====================================================

	if round_number == 1:

		print("SHOWING ROUND 1")

		$HUD/Round1.visible = true

		if has_node("Round1"):
			$Round1.play()


	# =====================================================
	# SHOW ROUND 2
	# =====================================================

	elif round_number == 2:

		print("SHOWING ROUND 2")

		$HUD/Round2.visible = true

		if has_node("Round2"):
			$Round2.play()


	# =====================================================
	# SHOW ROUND 3
	# =====================================================

	elif round_number == 3:

		print("SHOWING ROUND 3")

		$HUD/Round3.visible = true

		if has_node("Round3"):
			$Round3.play()


	# =====================================================
	# KEEP ROUND IMAGE ON SCREEN
	# =====================================================

	await get_tree().create_timer(2.0).timeout


	# =====================================================
	# HIDE ROUND IMAGE
	# =====================================================

	$HUD/Round1.visible = false
	$HUD/Round2.visible = false
	$HUD/Round3.visible = false


	# =====================================================
	# SHORT DELAY BEFORE FIGHT
	# =====================================================

	await get_tree().create_timer(0.3).timeout


	# =====================================================
	# SHOW FIGHT
	# =====================================================

	$HUD/Fight.visible = true

	print("FIGHT!")


	if has_node("Fight"):
		$Fight.play()


	# =====================================================
	# KEEP FIGHT ON SCREEN
	# =====================================================

	await get_tree().create_timer(1.0).timeout


	# =====================================================
	# HIDE FIGHT
	# =====================================================

	$HUD/Fight.visible = false


	# =====================================================
	# REMOVE SPAWN PROTECTION
	# =====================================================

	set_spawn_protection(false)


	# =====================================================
	# ROUND ACTIVE
	# =====================================================

	round_active = true
	round_starting = false

	print("ROUND ", Game.current_round, " IS ACTIVE")


# =========================================================
# FATALITY
# =========================================================

func _on_fatality():

	# =====================================================
	# SHOW FATALITY
	# =====================================================

	$HUD/Fatality.visible = true

	print("FATALITY!")


	# =====================================================
	# PLAY FATALITY SOUND
	# =====================================================

	if has_node("Fatality"):
		$Fatality.play()


	# =====================================================
	# KEEP FATALITY ON SCREEN
	# =====================================================

	await get_tree().create_timer(2.0).timeout


	# =====================================================
	# HIDE FATALITY
	# =====================================================

	$HUD/Fatality.visible = false


# =========================================================
# ROUND DEATH
# =========================================================

func _on_round_death(winner: String):

	if round_resolving:
		return

	if Game.match_over:
		return

	if round_starting:
		return

	round_resolving = true
	round_active = false


	print("================================")
	print("ROUND ", Game.current_round, " HAS ENDED")
	print("WINNER: ", winner)
	print("================================")


	# =====================================================
	# AWARD ONE ROUND WIN
	# =====================================================

	match winner:

		"player1":
			Game.add_p1_round_win()

		"cpu":
			Game.add_p2_round_win()

		_:
			print("ERROR: UNKNOWN ROUND WINNER: ", winner)
			round_resolving = false
			return


	# =====================================================
	# UPDATE ROUND WIN SPRITES
	# =====================================================

	if $HUD.has_method("update_round_wins"):
		$HUD.update_round_wins()


	print("P1 ROUND WINS: ", Game.p1_round_wins)
	print("P2 ROUND WINS: ", Game.p2_round_wins)


	# =====================================================
	# P1 WON MATCH
	# =====================================================

	if Game.has_p1_won_match():

		Game.match_over = true

		print("================================")
		print("PLAYER 1 HAS WON THE MATCH")
		print(
			"FINAL SCORE: ",
			Game.p1_round_wins,
			" - ",
			Game.p2_round_wins
		)
		print("================================")

		if $HUD.has_method("show_you_win"):
			$HUD.show_you_win()

		round_resolving = false
		return


	# =====================================================
	# P2 WON MATCH
	# =====================================================

	if Game.has_p2_won_match():

		Game.match_over = true

		print("================================")
		print("PLAYER 2 / CPU HAS WON THE MATCH")
		print(
			"FINAL SCORE: ",
			Game.p1_round_wins,
			" - ",
			Game.p2_round_wins
		)
		print("================================")

		if $HUD.has_method("show_you_lose"):
			$HUD.show_you_lose()

		round_resolving = false
		return


	# =====================================================
	# WAIT BEFORE NEXT ROUND
	# =====================================================

	await get_tree().create_timer(3.0).timeout


	# =====================================================
	# DETERMINE NEXT ROUND
	# =====================================================

	var total_round_wins := (
		Game.p1_round_wins +
		Game.p2_round_wins
	)


	# =====================================================
	# START ROUND 2
	# =====================================================

	if total_round_wins == 1:

		print("================================")
		print("STARTING ROUND 2")
		print(
			"SCORE: ",
			Game.p1_round_wins,
			" - ",
			Game.p2_round_wins
		)
		print("================================")

		round_resolving = false

		await start_round(2)

		return


	# =====================================================
	# START ROUND 3
	# =====================================================

	if total_round_wins == 2:

		print("================================")
		print("1 - 1 TIE")
		print("STARTING ROUND 3")
		print("================================")

		round_resolving = false

		await start_round(3)

		return


	round_resolving = false


# =========================================================
# BACKUP P1 ROUND FUNCTION
# =========================================================

func player1_won_round():

	_on_round_death("player1")


# =========================================================
# BACKUP P2 ROUND FUNCTION
# =========================================================

func player2_won_round():

	_on_round_death("cpu")


# =========================================================
# REMOVE CURRENT FIGHTERS
# =========================================================

func remove_current_fighters():

	round_active = false

	if is_instance_valid(p1):

		p1.set_process(false)
		p1.set_physics_process(false)

		p1.queue_free()
		p1 = null


	if is_instance_valid(p2):

		p2.set_process(false)
		p2.set_physics_process(false)

		p2.queue_free()
		p2 = null


	await get_tree().process_frame


# =========================================================
# RESET HEALTH BARS
# =========================================================

func reset_health_bars():

	if $HUD/DukeHealthBar != null:
		$HUD/DukeHealthBar.value = $HUD/DukeHealthBar.max_value

	if $HUD/SubzeroHealthBar != null:
		$HUD/SubzeroHealthBar.value = $HUD/SubzeroHealthBar.max_value

	if $HUD/RaidenHealthBar != null:
		$HUD/RaidenHealthBar.value = $HUD/RaidenHealthBar.max_value

	if $HUD/LiuKangHealthBar != null:
		$HUD/LiuKangHealthBar.value = $HUD/LiuKangHealthBar.max_value

	if $HUD/SonyaHealthBar != null:
		$HUD/SonyaHealthBar.value = $HUD/SonyaHealthBar.max_value

	if $HUD/KanoHealthBar != null:
		$HUD/KanoHealthBar.value = $HUD/KanoHealthBar.max_value

	if $HUD/JohnnyCageHealthBar != null:
		$HUD/JohnnyCageHealthBar.value = $HUD/JohnnyCageHealthBar.max_value

	if $HUD/ReptileHealthBar != null:
		$HUD/ReptileHealthBar.value = $HUD/ReptileHealthBar.max_value


	# =====================================================
	# RESET SEGMENTS
	# =====================================================

	$HUD/Seg1.visible = true
	$HUD/Seg2.visible = true
	$HUD/Seg3.visible = true
	$HUD/Seg4.visible = true
	$HUD/Seg5.visible = true
	$HUD/Seg6.visible = true
	$HUD/Seg7.visible = true
	$HUD/Seg8.visible = true


# =========================================================
# SPAWN PLAYERS
# =========================================================

func spawn_players():

	spawn_p1()
	spawn_p2()


# =========================================================
# P1 HEALTH
# =========================================================

func _on_p1_health_changed(health):

	if not is_instance_valid(p1):
		return

	$HUD/DukeLabel.text = "%s: %d" % [
		Game.p1_character,
		health
	]

	$HUD/DukeHealthBar.value = health

	update_p1_segments(
		health,
		$HUD/DukeHealthBar.max_value
	)


# =========================================================
# P2 HEALTH
# =========================================================

func _on_p2_health_changed(health):

	if not is_instance_valid(p2):
		return

	$HUD/ReptileLabel.text = "%s: %d" % [
		Game.p2_character,
		health
	]

	$HUD/ReptileHealthBar.value = health

	update_p2_segments(
		health,
		$HUD/ReptileHealthBar.max_value
	)


# =========================================================
# P1 SEGMENTS
# =========================================================

func update_p1_segments(health, max_hp):

	if max_hp <= 0:
		return

	var percent = float(health) / float(max_hp)

	$HUD/Seg5.visible = percent > 0.00
	$HUD/Seg6.visible = percent > 0.01
	$HUD/Seg7.visible = percent > 0.02
	$HUD/Seg8.visible = percent > 0.03


# =========================================================
# P2 SEGMENTS
# =========================================================

func update_p2_segments(health, max_hp):

	if max_hp <= 0:
		return

	var percent = float(health) / float(max_hp)

	$HUD/Seg1.visible = percent > 0.00
	$HUD/Seg2.visible = percent > 0.01
	$HUD/Seg3.visible = percent > 0.02
	$HUD/Seg4.visible = percent > 0.03


# =========================================================
# SPAWN P1
# =========================================================

func spawn_p1():

	if Game.p1_data != null:

		p1 = Game.p1_data.scene.instantiate()

	else:

		match Game.p1_character:

			"LiuKang":
				p1 = LIU_KANG.instantiate()

			"Reptile":
				p1 = REPTILE.instantiate()

			"Subzero":
				p1 = SUBZERO.instantiate()

			"Raiden":
				p1 = RAIDEN.instantiate()

			"Sonya":
				p1 = SONYA.instantiate()

			"Kano":
				p1 = KANO.instantiate()

			"JohnnyCage":
				p1 = JOHNNYCAGE.instantiate()


	if p1:

		p1.position = P1_SPAWN

		add_child(p1)


		# =====================================================
		# HEALTH
		# =====================================================

		if p1.has_signal("health_changed"):

			if not p1.health_changed.is_connected(
				_on_p1_health_changed
			):

				p1.health_changed.connect(
					_on_p1_health_changed
				)


		# =====================================================
		# ROUND DEATH
		# =====================================================

		if p1.has_signal("round_death"):

			if not p1.round_death.is_connected(
				_on_round_death
			):

				p1.round_death.connect(
					_on_round_death
				)


		# =====================================================
		# FATALITY
		# =====================================================

		if p1.has_signal("fatality"):

			if not p1.fatality.is_connected(
				_on_fatality
			):

				p1.fatality.connect(
					_on_fatality
				)


# =========================================================
# SPAWN P2
# =========================================================

func spawn_p2():

	if Game.p2_data != null:

		p2 = Game.p2_data.scene.instantiate()

	else:

		match Game.p2_character:

			"LiuKang":
				p2 = LIU_KANG.instantiate()

			"Reptile":
				p2 = REPTILE.instantiate()

			"Subzero":
				p2 = SUBZERO.instantiate()

			"Raiden":
				p2 = RAIDEN.instantiate()

			"Sonya":
				p2 = SONYA.instantiate()

			"Kano":
				p2 = KANO.instantiate()

			"JohnnyCage":
				p2 = JOHNNYCAGE.instantiate()


	if p2:

		p2.position = P2_SPAWN

		add_child(p2)


		# =====================================================
		# HEALTH
		# =====================================================

		if p2.has_signal("health_changed"):

			if not p2.health_changed.is_connected(
				_on_p2_health_changed
			):

				p2.health_changed.connect(
					_on_p2_health_changed
				)


		# =====================================================
		# ROUND DEATH
		# =====================================================

		if p2.has_signal("round_death"):

			if not p2.round_death.is_connected(
				_on_round_death
			):

				p2.round_death.connect(
					_on_round_death
				)


		# =====================================================
		# FATALITY
		# =====================================================

		if p2.has_signal("fatality"):

			if not p2.fatality.is_connected(
				_on_fatality
			):

				p2.fatality.connect(
					_on_fatality
				)


# =========================================================
# SETUP
# =========================================================

func setup():

	if p1:
		p1.add_to_group("player1")

	if p2:
		p2.add_to_group("cpu")


# =========================================================
# TARGETS
# =========================================================

func assign_targets():

	if p1 and p2:

		p1.target = p2
		p2.target = p1


	if Game.vs_cpu and p2:

		p2.is_cpu = true


# =========================================================
# SPAWN PROTECTION
# =========================================================

func set_spawn_protection(enabled: bool):

	if is_instance_valid(p1):
		p1.spawn_protection = enabled

	if is_instance_valid(p2):
		p2.spawn_protection = enabled
