extends Node2D

# =========================================================
# LEVEL TREE
# =========================================================
#
# Level1 (Node2D)
# └── HUD (CanvasLayer)
#     ├── DukeLabel (Label)
#     ├── RaidenLabel (Label)
#     ├── ReptileLabel (Label)
#     ├── SubzeroLabel (Label)
#     │
#     ├── DukeHealthBar (Control / TextureProgressBar)
#     ├── RaidenHealthBar (Control / TextureProgressBar)
#     ├── ReptileHealthBar (Control / TextureProgressBar)
#     ├── SubzeroHealthBar (Control / TextureProgressBar)
#     │
#     ├── Points (Label)
#     ├── Health (Label)
#     │
#     ├── Seg1 (TextureRect)
#     ├── Seg2 (TextureRect)
#     ├── Seg3 (TextureRect)
#     ├── Seg4 (TextureRect)
#     ├── Seg5 (TextureRect)
#     ├── Seg6 (TextureRect)
#     ├── Seg7 (TextureRect)
#     ├── Seg8 (TextureRect)
#     ├── Seg9 (TextureRect)
#     ├── Seg10 (TextureRect)
#     ├── Seg11 (TextureRect)
#     ├── Seg12 (TextureRect)
#     ├── Seg13 (TextureRect)
#     ├── Seg14 (TextureRect)
#     ├── Seg15 (TextureRect)
#     └── Seg16 (TextureRect)
#
# =========================================================

const P1_SPAWN := Vector2(603, 496)
const P2_SPAWN := Vector2(840, 496)

const REPTILE = preload("res://Scenes/Boss/Reptile.tscn")
const SUBZERO = preload("res://Scenes/Boss/Subzero.tscn")
const RAIDEN = preload("res://Scenes/Boss/Raiden.tscn")

var p1
var p2

# ---------------- READY ----------------
func _ready():
	spawn_players()
	setup()
	assign_targets()

	# small delay so physics settles (prevents instant overlap hits)
	await get_tree().create_timer(0.1).timeout
	enable_spawn_protection()

# ---------------- SPAWN ----------------
func spawn_players():
	spawn_p1()
	spawn_p2()

func spawn_p1():

	if Game.p1_data != null:
		p1 = Game.p1_data.scene.instantiate()
	else:
		match Game.p1_character:
			"Reptile":
				p1 = REPTILE.instantiate()
			"Subzero":
				p1 = SUBZERO.instantiate()
			"Raiden":
				p1 = RAIDEN.instantiate()

	if p1:
		p1.position = P1_SPAWN
		add_child(p1)

func spawn_p2():

	if Game.p2_data != null:
		p2 = Game.p2_data.scene.instantiate()
	else:
		match Game.p2_character:
			"Reptile":
				p2 = REPTILE.instantiate()
			"Subzero":
				p2 = SUBZERO.instantiate()
			"Raiden":
				p2 = RAIDEN.instantiate()

	if p2:
		p2.position = P2_SPAWN
		add_child(p2)

# ---------------- SETUP ----------------
func setup():
	if p1:
		p1.add_to_group("player")

	if p2:
		p2.add_to_group("player")

# ---------------- TARGETS ----------------
func assign_targets():

	if Game.vs_cpu and p2:
		p2.is_cpu = true
		p2.target = p1

	if p1 and p2:
		p1.target = p2
		p2.target = p1

# ---------------- SPAWN PROTECTION ----------------
func enable_spawn_protection():

	if p1:
		p1.spawn_protection = true

	if p2:
		p2.spawn_protection = true

	await get_tree().create_timer(1.0).timeout

	if p1:
		p1.spawn_protection = false

	if p2:
		p2.spawn_protection = false

