# FSM - Crouching State
extends PlayerState

func enter_state(player_node):
	print("Entered Crouching State")
	super(player_node)
	player.velocity.x = 0
	player.anim.animation = "crouch"
	player.anim.play()

func physics_update(delta):
	# If crouching should cancel movement, freeze X velocity
	player.velocity.x = 0
	player.move_and_slide()

func handle_input(_delta):
	# Exit crouch when "down" is released
	if not Input.is_action_pressed("down"):
		player.change_state("Idle")

	# Optional: crouch attack
	if Input.is_action_just_pressed("slash"):
		player.change_state("CrouchAttack")
