extends Area2D

@onready var collision: CollisionShape2D = $CollisionShape2D

@export var active_time := 0.2
@export var lifetime := 0.6
@export var damage := 1

var active := false
var has_hit := false
var attack_owner: Node = null


func _ready():
	add_to_group("KanoAttack")


func enable_hitbox():
	active = true
	monitoring = true
	collision.disabled = false


func disable_hitbox():
	active = false
	monitoring = false
	collision.disabled = true


func _on_area_entered(area: Area2D) -> void:
	if not active:
		return

	if has_hit:
		return

	if area == null:
		return

	var fighter := area.get_parent()

	if fighter == null:
		return

	if not fighter.is_in_group("Fighter"):
		return

	if fighter == owner:
		return

	if not fighter.has_method("take_damage"):
		return

	has_hit = true
	fighter.take_damage(damage)
