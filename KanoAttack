extends Area2D
class_name KanoAttack

@onready var collision: CollisionShape2D = $CollisionShape2D

@export var active_time := 0.2
@export var lifetime := 0.6

var active := false
var has_hit := false
var damage := 1

var attack_owner: Node = null
var attack_name := ""
var attack_type := ""

var cam: Camera2D = null


func _ready():

	add_to_group("KanoAttack")

	await get_tree().process_frame

	# Get camera
	cam = get_viewport().get_camera_2d()

	# Connect hit detection
	if not area_entered.is_connected(_on_area_entered):
		area_entered.connect(_on_area_entered)

	enable_hitbox()

	await get_tree().create_timer(active_time).timeout

	if not is_inside_tree():
		return

	disable_hitbox()

	await get_tree().create_timer(lifetime).timeout

	if not is_inside_tree():
		return

	queue_free()


# =========================================================
# ENABLE HITBOX
# =========================================================

func enable_hitbox():

	active = true
	monitoring = true
	collision.disabled = false


# =========================================================
# DISABLE HITBOX
# =========================================================

func disable_hitbox():

	active = false
	monitoring = false
	collision.disabled = true


# =========================================================
# HIT DETECTION
# =========================================================

func _on_area_entered(area: Area2D):

	if not active:
		return

	if has_hit:
		return

	if area == null or not is_instance_valid(area):
		return

	# The Area2D that was hit should belong to the Fighter.
	var target = area.get_parent()

	if target == null or not is_instance_valid(target):
		return

	# Never hit the attacker
	if attack_owner != null and target == attack_owner:
		return

	# Only fighters can be damaged
	if not target.is_in_group("Fighter"):
		return

	if not target.has_method("take_damage"):
		return

	has_hit = true


# =========================
	# UPPERCUT LAUNCH
	# =========================
	if attack_name == "uppercut":

		if "velocity" in target:

			var dir = 1

			if attack_owner != null:
				dir = attack_owner.facing

			target.velocity.x = dir * 1000
			target.velocity.y = -1800

			if "uppercut_launched" in target:
				target.uppercut_launched = true

			if target.has_method("play_anim"):
				target.play_anim("wasuppercut")

	# =========================
	# JUMPKICK LAUNCH
	# =========================
	elif attack_name == "jumpkick":

		if "velocity" in target:

			var dir = 1

			if attack_owner != null:
				dir = attack_owner.facing

			target.velocity.x = dir * 2800
			target.velocity.y = -200

			if "jumpkick_launched" in target:
				target.jumpkick_launched = true

			if target.has_method("play_anim"):
				target.play_anim("wasjumpkick")

	# =========================
	# DAMAGE
	# =========================
	target.take_damage(damage)


	# =====================================================
	# CAMERA SHAKE
	# =====================================================

	var cam2 := get_viewport().get_camera_2d()

	if cam2:

		match attack_name:

			"uppercut":
				cam2.shake(16, 0.18)

			"jumpkick":
				cam2.shake(14, 0.15)

			"roundhousekick":
				cam2.shake(12, 0.15)

			"kick", "highkick", "lowkick":
				cam2.shake(8, 0.10)

			"punch", "highpunch", "lowpunch":
				cam2.shake(6, 0.08)

			_:
				cam2.shake(10, 0.12)
