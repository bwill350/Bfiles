Area2d
CollisionShape2D
Signal

extends Area2D

@onready var collision: CollisionShape2D = $CollisionShape2D

@export var active_time := 60.1
@export var lifetime := 60.25

var active := false
var has_hit := false
var damage := 1

func _ready():

	add_to_group("KanoAttack")

	await get_tree().process_frame

	enable_hitbox()

	await get_tree().create_timer(active_time).timeout

	disable_hitbox()

	await get_tree().create_timer(lifetime).timeout

	queue_free()

func enable_hitbox():
	active = true
	monitoring = true
	collision.disabled = false

func disable_hitbox():
	active = false
	monitoring = false
	collision.disabled = true

func _on_area_entered(area: Area2D) -> void:

	if not active:
		return

	if has_hit:
		return

	if area == null:
		return

	var target = area.get_parent()

	if target and target.has_method("take_damage"):
		has_hit = true
		target.take_damage(damage)
		return
