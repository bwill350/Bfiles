extends Area2D

@onready var sprite: AnimatedSprite2D = $Sprite
@onready var sound: AudioStreamPlayer2D = $ElectricDeathSound
@onready var ring: Sprite2D = $ShockwaveRing

@onready var p1: CPUParticles2D = $CPUParticles2D
@onready var p2: CPUParticles2D = $CPUParticles2D2
@onready var p3: CPUParticles2D = $CPUParticles2D3
@onready var p4: CPUParticles2D = $CPUParticles2D4
const ELECTRIC_BULLET = preload("res://Projectiles/ElectricBullet.tscn")
var finished := false
var owner_character = null
var damage_done := false

func _ready():

	add_to_group("ElectricDeath")
	add_to_group("HurtBox")

	self.scale = Vector2.ZERO

	if sprite:
		sprite.play("charge")

	if sound:
		sound.play()

	start_main_animation()
	start_shockwave()
	start_particle_burst()

	await get_tree().create_timer(2.0).timeout

	stop_fatality()

func stop_fatality():

	if finished:
		return

	finished = true

	if sprite:
		sprite.stop()
		sprite.modulate = Color.WHITE

	if sound:
		sound.stop()

	if ring:
		ring.modulate.a = 0.0

	for p in [p1, p2, p3, p4]:
		if p:
			p.emitting = false

	var t = create_tween()
	t.tween_property(self, "scale", Vector2.ZERO, 0.25)

	await t.finished
	queue_free()

func start_main_animation():

	var t = create_tween()

	t.tween_property(self, "scale", Vector2.ONE, 0.1)
	t.tween_property(self, "scale", Vector2(7, 7), 0.1)
	t.tween_property(self, "scale", Vector2.ZERO, 0.2)

func start_shockwave():

	if ring == null:
		return

	ring.scale = Vector2.ZERO
	ring.modulate.a = 1.0

	var t = create_tween()

	t.tween_property(ring, "scale", Vector2(12, 12), 0.25)
	t.parallel().tween_property(ring, "modulate:a", 0.0, 0.25)

func start_particle_burst():

	var parts = [p1, p2, p3, p4]

	for i in range(parts.size()):

		var p = parts[i]

		if p == null:
			continue

		p.emitting = true
		p.scale = Vector2.ZERO
		p.modulate.a = 1.0

		var delay = i * 0.03

		var t_in = create_tween()
		t_in.tween_interval(delay)
		t_in.tween_property(p, "scale", Vector2.ONE, 0.1)

		var t_out = create_tween()
		t_out.tween_interval(0.2 + delay)
		t_out.tween_property(p, "scale", Vector2.ZERO, 0.15)
		t_out.tween_property(p, "modulate:a", 0.0, 0.15)

		t_out.tween_callback(func():
			p.emitting = false
		)


func _on_area_entered(area):
	if damage_done or area == null:
		return

	var enemy = area.get_parent()

	# Ignore the fighter that created this effect
	if owner_character and enemy == owner_character:
		return

	if not area.is_in_group("HurtBox"):
		return

	if enemy and enemy.has_method("take_damage"):
		enemy.take_damage(1)
		damage_done = true
