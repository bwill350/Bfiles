# FSM - CrouchWalk State
extends PlayerState

func enter_state(player_node):
	print("Entered CrouchWalk State")
	super(player_node)
	player.anim.animation = "crouch_walk"
	player.anim.play()

func physics_update(delta):
	# Apply crouch movement (slower than standing walk)
	if Input.is_action_pressed("left"):
		player.velocity.x = -player.CROUCH_SPEED
		player.facing_direction = -1
	elif Input.is_action_pressed("right"):
		player.velocity.x = player.CROUCH_SPEED
		player.facing_direction = 1
	else:
		# No horizontal input -> back to crouch idle
		player.change_state("Crouching")
		return

	# Apply gravity
	player.velocity.y += player.GRAVITY * delta
	player.velocity.y = min(player.velocity.y, player.MAX_FALL_SPEED)

	player.move_and_slide()

	# If no longer on the ground, fall
	if not player.is_on_floor():
		player.change_state("Falling")

func handle_input(_delta):
	# Exit crouch
	if not Input.is_action_pressed("down"):
		player.change_state("Idle")

	# Optional crouch attack
	elif Input.is_action_just_pressed("slash"):
		player.change_state("CrouchAttack")
