extends Area2D
class_name JohnnyCageBullet

@export var speed: float = 900.0
@export var lifetime: float = 1.0
@export var spin_speed: float = 15.0
@export var damage: int = 1

var velocity: Vector2 = Vector2.ZERO
var has_hit := false

@onready var sprite: Sprite2D = $Sprite2D

func _ready():
	add_to_group("JohnnyCageBullet")

	# Flip sprite based on direction
	sprite.flip_h = velocity.x < 0

	area_entered.connect(_on_area_entered)

	await get_tree().create_timer(lifetime).timeout

	if is_instance_valid(self):
		queue_free()

func _physics_process(delta):
	global_position += velocity * delta

func _on_area_entered(area):

	if has_hit:
		return

	# Ignore other Johnny Cage bullets
	if area.is_in_group("JohnnyCageBullet"):
		return

	var fighter = area.get_parent()

	if fighter == null:
		return

	if not fighter.is_in_group("Fighter"):
		return

	# Don't hit Johnny Cage himself
	if fighter.is_in_group("JohnnyCage"):
		return

	has_hit = true

	if fighter.has_method("take_damage"):
		fighter.take_damage(damage)

	queue_free()
