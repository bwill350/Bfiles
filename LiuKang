func do_action(anim_name: String):

	if state == State.DEAD:
		return

	if is_finish_state:
		return

	if is_attacking:
		return

	if action_locked:
		return

	if is_hurting:
		return

	# STOP MOVEMENT
	velocity.x = 0

	action_locked = true
	is_attacking = true

	play_anim(anim_name)

	# ---------------- MELEE ATTACKS ----------------
	if anim_name in [
		"punch",
		"highpunch",
		"lowpunch",
		"kick",
		"highkick",
		"lowkick",
		"uppercut",
		"roundhousekick",
		"jumpkick",
		"fatalitycombo",
		"knee"
	]:
		spawn_attack(anim_name)

	# ---------------- SPECIALS ----------------
	elif anim_name == "flyingkick":
		start_flyingkick()

	elif anim_name == "bicyclekick":
		start_bicyclekick()

	await get_tree().create_timer(0.15).timeout

	if state == State.DEAD:
		return

	if is_hurting:
		return

	is_attacking = false
	action_locked = false
	hurt_cooldown = false

	velocity.x = 0

	# CPU immediately gets another opportunity
	if is_cpu:
		ai_timer = 0.05

