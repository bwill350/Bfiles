	current_anim = anim
	sprite.play(anim)

# ---------------- COMBOS ----------------
func register_input(input: String):

	# only human player can enter combos
	if not is_in_group("player1"):
		return

	combo.append(input)

	combo_timer = 0.0

	check_combos()

func spawn_fx(scene: PackedScene):

	if scene == null:
		return

	var fx = scene.instantiate()

	# IMPORTANT: set owner BEFORE it can collide
	fx.owner_character = self
	fx.damage_done = false

	get_tree().current_scene.call_deferred("add_child", fx)

	# Wait for FX to be added
	await get_tree().process_frame

	# PLAY FATALITY SOUND
	if is_instance_valid(fatality_sound):
		fatality_sound.play()

	# Position FX
	if target and is_instance_valid(target):
		fx.global_position = target.global_position + Vector2(60 * facing, 0)
	else:
		fx.global_position = global_position + Vector2(80 * facing, 0)

func check_combos():

	# ---------------- FIRE ----------------
	if combo == FIRE_COMBO: 

		combo_used.emit("fire")

		special_bullet = FIRE_BULLET
		print("================================")
		print("===========FATALITY=============")
		print("================================")
		combo.clear()
		# PLAY FATALITY SOUND
		if is_instance_valid(fatality_sound):
			fatality_sound.play()
		shoot_fireball()
		return

	# ---------------- ELECTRIC ----------------
	elif combo == ELECTRIC_COMBO:

		combo_used.emit("electric")

		spawn_fx(ELECTRIC_DEATH)

		special_bullet = ELECTRIC_BULLET

		combo.clear()
		return

	elif combo == PUNCH_COMBO:

		combo_used.emit("punch_combo")

		combo.clear()

		start_punch_combo()
		return

	# ---------------- kick ----------------
	elif combo == KICK_COMBO:

		combo_used.emit("kick_combo")

		combo.clear()

		start_kick_combo()
		return

# ---------------- DRAGON ----------------
	elif combo == DRAGON_COMBO:

		print("DRAGON COMBO HIT")

		combo_used.emit("dragon")

		var fx = DRAGON_DEATH.instantiate()
		get_tree().current_scene.add_child(fx)
		# PLAY FATALITY SOUND
		if is_instance_valid(fatality_sound):
			fatality_sound.play()
		fx.global_position = global_position + Vector2(0 * facing, 0)

		play_anim("dragon")
		print("================================")
		print("===========FATALITY=============")
		print("================================")
		combo.clear()

		await get_tree().create_timer(0.4).timeout

		return

	# ---------------- FATALITY_COMBO ----------------
	elif combo == FATALITY_COMBO:

		combo_used.emit("fatality_combo")

		combo.clear()

		do_action("fatalitydragon")
		return

func start_punch_combo():

	if action_locked or is_hurting or state == State.DEAD:
		return

	await combo_attack([
		"punch",
		"lowpunch",
		"punch",
		"uppercut",
		"highpunch",
		"uppercut"
	])

func start_kick_combo():

	if action_locked or is_hurting or state == State.DEAD:
		return

	await combo_attack([
		"kick",
		"knee",
		"highkick",
		"roundhousekick",
		"lowkick",
		"roundhousekick",
		"highkick"
	])

func combo_attack(attacks: Array):

	action_locked = true
	is_attacking = true

	for attack in attacks:

		if is_hurting or state == State.DEAD:
			break

		play_anim(attack)
		spawn_attack(attack)

		# let each move finish naturally
		await get_tree().create_timer(0.25).timeout

		# clear attack before next move
		is_attacking = false

		await get_tree().create_timer(0.05).timeout

		is_attacking = true

	is_attacking = false
	action_locked = false

	if not is_hurting:
		play_anim("idle")

