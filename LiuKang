func start_block():

	if state == State.DEAD:
		return

	is_blocking = true
	state = State.BLOCK

	play_anim("block")

func stop_block():

	if is_blocking:
		is_blocking = false
		state = State.IDLE

# ---------------- HURT BOX ----------------
func _on_liu_kang_hurt_box_area_entered(area: Area2D) -> void:

	if hurt_cooldown:
		return

	if area == null or !is_instance_valid(area):
		return

	if state == State.DEAD:
		return

	if area.is_in_group("HurtBox"):
		return

	if not can_take_damage:
		return

	if area.is_in_group("HitBox") \
		or area.is_in_group("ReptileAcid") \
		or area.is_in_group("ReptileBullet") \
		or area.is_in_group("RaidenElectricBullet") \
		or area.is_in_group("FireBullet") \
		or area.is_in_group("Fireball") \
		or area.is_in_group("SonyaBullet") \
		or area.is_in_group("JohnnyCageBullet") \
		or area.is_in_group("KanoBullet") \
		or area.is_in_group("IceBullet") \
		or area.is_in_group("KanoAttack"):

		hurt_cooldown = true

		knockback_x = -facing * 100

		if area.get("attack_name") and area.attack_name == "uppercut":
			$Sprite.play("wasuppercut")
		else:
			$Sprite.play("hurt")

		if is_instance_valid(hurt_sound):
			hurt_sound.play()

		take_damage(1)

		await get_tree().create_timer(0.10).timeout

		if is_instance_valid(self):
			hurt_cooldown = false
