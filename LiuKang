extends CharacterBody2D
class_name LiuKang

# ---------------- SIGNALS ----------------
signal health_changed(health)
signal combo_used(combo_name: String)
@export var speed := 300.0
# ---------------- STATE ----------------
enum State { IDLE, RUN, JUMP, JUMPKICK, BLOCK, PUNCH, CLIMB, DEAD }

var state: State = State.IDLE
var special_bullet: PackedScene = null

# ---------------- CPU ----------------
var is_cpu := false
var target: Node2D = null
var ai_timer := 0.0

# ---------------- FLAGS ----------------
var is_blocking := false
var is_hurting := false
var is_shooting := false
var is_attacking := false
var action_locked := false
var hurt_locked := false
var can_take_damage := true
var is_finish_state := false
var spawn_protection := false
var is_flying := false
# ---------------- MOVEMENT ----------------
var facing := 1
var current_anim := ""
var health: int

const GRAVITY = 5000

# ---------------- EXPORTS ----------------
@export var SPEED := 300.0
@export var CLIMB_SPEED := 250.0
@export var max_health := 10
@export var jump_velocity := -2200.0
@export var combo_reset_time := 0.6

# ---------------- PRELOADS ----------------
const LIU_KANG_ATTACK = preload("res://LiuKangAttack.tscn")
const FIREBALL = preload("res://Fireball.tscn")

# ---------------- NODES ----------------
@onready var sprite: AnimatedSprite2D = $Sprite
@onready var hit_sound: AudioStreamPlayer2D = $Hit
@onready var hit_box: Area2D = $LiuKangHurtBox
@onready var finish_label: Sprite2D = $HUD/FinishLabel/Sprite2D
@onready var attack_marker: Marker2D = $AttackMarker
@onready var shoot_marker: Marker2D = $LiuKangshoot
# ---------------- PRELOADS ----------------
const FIRE_BULLET = preload("res://Projectiles/FireBullet.tscn")
const ICE_BULLET = preload("res://Projectiles/IceBullet.tscn")
const ELECTRIC_BULLET = preload("res://Projectiles/ElectricBullet.tscn")
const BLOOD_EFFECT = preload("res://GreenBloodEffect.tscn")

# ---------------- DEATH FX ----------------
const BLOOD_DEATH = preload("res://Deaths/BloodDeath.tscn")
const FIRE_DEATH = preload("res://Deaths/FireDeath.tscn")
const ICE_DEATH = preload("res://Deaths/IceDeath.tscn")
const ELECTRIC_DEATH = preload("res://Deaths/ElectricDeath.tscn")
const ACID_COMBO = ["down", "down", "down", "right", "shoot"]
const FIRE_COMBO = ["down", "right", "shoot"]
const ICE_COMBO = ["left", "left", "shoot"]
const ELECTRIC_COMBO = ["up", "down", "shoot"]

# ---------------- COMBOS ----------------
var combo := []
var combo_timer := 0.0

# ---------------- READY ----------------
func _ready():
	add_to_group("LiuKang")

	health = max_health
	health_changed.emit(health)

	play_anim("idle")

	if hit_box:
		if not hit_box.area_entered.is_connected(_on_LiuKang_Hurt_Box_area_entered):
			hit_box.area_entered.connect(_on_LiuKang_Hurt_Box_area_entered)

# ---------------- PHYSICS ----------------
# ---------------- PHYSICS ----------------
func _physics_process(delta):

	velocity.y += GRAVITY * delta

	if is_cpu:
		cpu_logic(delta)
		move_and_slide()
		return

	if state == State.DEAD:
		return

	if action_locked or hurt_locked:
		move_and_slide()
		return

	var input_dir = Input.get_axis("left", "right")

	if input_dir != 0:
		facing = input_dir

	sprite.flip_h = facing < 0

	velocity.x = input_dir * SPEED

# ---------------- WALK ANIMATION ----------------
	if is_on_floor():
		if input_dir != 0:
			if not is_attacking:
				state = State.RUN
				play_anim("walk")
		else:
			if not is_attacking:
				state = State.IDLE
				play_anim("idle")

	# ---------------- JUMP ----------------
	if Input.is_action_just_pressed("jump") and is_on_floor():
		velocity.y = jump_velocity

	if Input.is_action_pressed("shoot"):
		shoot_fireball()

	if Input.is_action_just_pressed("punch"):
		do_action("punch")

	# ---------------- STATES ----------------
	if not is_on_floor():

		state = State.JUMP

		if not is_attacking:
			play_anim("jump")

	elif input_dir != 0:

		state = State.RUN

		if not is_attacking:
			play_anim("walk")

	else:

		state = State.IDLE

		if not is_attacking:
			play_anim("idle")

	move_and_slide()

	# ---------------- ATTACKS ----------------
	if Input.is_action_just_pressed("jumpkick"):
		do_action("jumpkick")

	elif Input.is_action_just_pressed("punch"):
		do_action("punch")

	elif Input.is_action_just_pressed("roundhousekick"):
		do_action("roundhousekick")

	elif Input.is_action_just_pressed("kick"):
		do_action("kick")

	elif Input.is_action_just_pressed("uppercut"):
		do_action("uppercut")

	elif Input.is_action_pressed("shoot"):
		shoot_fireball()

	elif Input.is_action_just_pressed("flyingkick"):
			do_action("flyingkick")

	elif Input.is_action_pressed("block"):
		start_block()
	elif Input.is_action_pressed("bicyclekick"):
		do_action("bicyclekick")

	else:
		stop_block()

# ---------------- BLOCK ----------------
func start_block():

	if state == State.DEAD:
		return

	is_blocking = true
	state = State.BLOCK

	play_anim("block")

func stop_block():

	if is_blocking:
		is_blocking = false
		state = State.IDLE

# ---------------- CPU ----------------
func cpu_logic(delta):

	if target == null:
		return

	# STOP AT LOW HP
	if health <= 1:
		is_attacking = false
		action_locked = true
		velocity.x = 0
		move_and_slide()
		return

	if action_locked:
		return

	ai_timer -= delta

	var dist = target.global_position.x - global_position.x

	var dir = sign(dist)

	# ❗ FIX: prevent 0-direction freeze
	if dir == 0:
		dir = facing

	var abs_dist = abs(dist)

	# ---------------- FACING (REPTILE STYLE FIX) ----------------
	if dir != 0:
		facing = dir

	sprite.flip_h = facing < 0

	# gravity (CPU needs this too)
	velocity.y += GRAVITY * delta

	# ---------------- MOVE ----------------
	if abs_dist > 220:

		velocity.x = facing * SPEED * 0.8

		if state != State.RUN:
			state = State.RUN

		if not is_attacking:
			play_anim("walk")

	else:

		velocity.x = 0

		if state != State.IDLE:
			state = State.IDLE

		if not is_attacking:
			play_anim("idle")

		# ---------------- ATTACK TIMER ----------------
		if ai_timer <= 0:

			ai_timer = randf_range(0.4, 0.8)

			match randi() % 5:
				0: do_action("punch")
				1: do_action("kick")
				2: do_action("uppercut")
				3: do_action("roundhousekick")
				4: shoot_fireball()

	# ---------------- AIR STATE ----------------
	if not is_on_floor():
		state = State.JUMP

func do_action(anim_name: String):

	if action_locked:
		return

	action_locked = true
	is_attacking = true

	play_anim(anim_name)

	# melee attacks
	if anim_name in [
		"punch",
		"kick",
		"uppercut",
		"roundhousekick",
		"jumpkick"
	]:
		var attack = LIU_KANG_ATTACK.instantiate()
		get_tree().current_scene.add_child(attack)
		attack.global_position = attack_marker.global_position

	# ---------------- FLYING KICK ----------------
	if anim_name == "flyingkick":
		air_launch(1800, -900)

	# ---------------- BICYCLE KICK ----------------
	elif anim_name == "bicyclekick":
		air_launch(3000, -300) # faster, screen cross move
		state = State.JUMP

	await sprite.animation_finished

	is_attacking = false
	action_locked = false
	play_anim("idle")

func air_launch(x_speed: float, y_speed: float):
	state = State.JUMP
	is_attacking = true
	action_locked = true

	velocity.x = facing * x_speed
	velocity.y = y_speed

# ---------------- FIREBALL ----------------
func shoot_fireball():

	if is_shooting:
		return

	is_shooting = true
	is_attacking = true
	action_locked = true

	play_anim("shoot")

	var fireball = FIREBALL.instantiate()
	get_tree().current_scene.add_child(fireball)

	fireball.global_position = shoot_marker.global_position
	fireball.velocity = Vector2(facing, 0) * fireball.speed

	await get_tree().create_timer(0.25).timeout

	is_shooting = false
	is_attacking = false
	action_locked = false

	play_anim("idle")

# ---------------- DAMAGE ----------------
func take_damage(amount: int):

	if spawn_protection:
		return

	if not can_take_damage:
		return

	can_take_damage = false

	health -= amount
	health = max(health, 0)

	health_changed.emit(health)

	hit_sound.play()

	await get_tree().create_timer(0.2).timeout

	can_take_damage = true

	if health <= 0:
		die()

# ---------------- ATTACK ----------------
func spawn_attack():

	var attack = LIU_KANG_ATTACK.instantiate()

	get_tree().current_scene.add_child(attack)

	attack.global_position = attack_marker.global_position

# ---------------- DEATH ----------------
func die():
	state = State.DEAD
	velocity = Vector2.ZERO
	queue_free()

# ---------------- ANIMATION ----------------
func play_anim(anim: String):

	if current_anim == anim:
		return

	current_anim = anim
	sprite.play(anim)

# ---------------- COMBOS ----------------
func register_input(input: String):

	combo.append(input)

	combo_timer = 0.0

	check_combos()

func spawn_fx(scene: PackedScene):

	var fx = scene.instantiate()

	get_tree().current_scene.call_deferred("add_child", fx)

	await get_tree().process_frame

	if target and is_instance_valid(target):
		fx.global_position = target.global_position + Vector2(60 * facing, 0)
	else:
		fx.global_position = global_position + Vector2(80 * facing, 0)

func check_combos():

	# ---------------- FIRE ----------------
	if combo == FIRE_COMBO:

		combo_used.emit("fire")

		spawn_fx(FIRE_DEATH)

		special_bullet = FIRE_BULLET

		combo.clear()
		return

	# ---------------- ICE ----------------
	elif combo == ICE_COMBO:

		combo_used.emit("ice")

		spawn_fx(ICE_DEATH)

		special_bullet = ICE_BULLET

		combo.clear()
		return

	# ---------------- ELECTRIC ----------------
	elif combo == ELECTRIC_COMBO:

		combo_used.emit("electric")

		spawn_fx(ELECTRIC_DEATH)

		special_bullet = ELECTRIC_BULLET

		combo.clear()
		return

# ---------------- HURT BOX ----------------
func _on_LiuKang_Hurt_Box_area_entered(area: Area2D):

	if area == null:
		return

	var attacker = area.get_parent()

	# ---------------- REPTILE ----------------
	if area.is_in_group("ReptileAttack"):
		take_damage(1)
		return

	# ---------------- SUBZERO ----------------
	if area.is_in_group("SubzeroAttack"):
		take_damage(1)
		return

	# ---------------- RAIDEN ----------------
	if area.is_in_group("RaidenAttack"):
		take_damage(1)
		return

	if area.is_in_group("RaidenElectricBullet"):
		take_damage(1)
		return

	# ---------------- FALLBACK ----------------
	if attacker != null and attacker != self:
		if attacker.has_method("take_damage"):
			take_damage(1)
			return
