# =====================================================
# DEATH
# =====================================================
func die():

	# =====================================================
	# ALREADY DEAD
	# =====================================================

	if state == State.DEAD:
		return

	# =====================================================
	# LOCK REPTILE AS DEAD
	# =====================================================

	state = State.DEAD

	velocity = Vector2.ZERO

	is_attacking = false
	is_shooting = false
	is_blocking = false
	is_hurting = false

	action_locked = true
	hurt_locked = true

	can_take_damage = false

	stunned = false
	special_move_invincible = false

	uppercut_launched = false

	is_pulled = false
	pull_timer = 0.0
	pull_target = null

	knockback_x = 0.0

	# =====================================================
	# STOP CPU
	# =====================================================

	ai_timer = 999999.0

	# =====================================================
	# HIDE FINISH HIM
	# =====================================================

	if is_instance_valid(finish_label):
		finish_label.visible = false

	# =====================================================
	# DETERMINE ROUND WINNER
	# =====================================================
	#
	# If Reptile is P1:
	#     CPU wins.
	#
	# Otherwise Reptile is CPU:
	#     P1 wins.
	# =====================================================

	var winner := ""

	if is_in_group("player1"):

		winner = "cpu"

	else:

		winner = "player1"

	# =====================================================
	# PRINT DEBUG
	# =====================================================

	print("================================")
	print("LIUKANG DIED")
	print("ROUND: ", Game.current_round)
	print(
		"CURRENT SCORE: ",
		Game.p1_round_wins,
		" - ",
		Game.p2_round_wins
	)
	print("ROUND WINNER: ", winner)
	print("================================")

	# =====================================================
	# DETERMINE IF THIS DEATH ENDS THE MATCH
	# =====================================================
	#
	# IMPORTANT:
	#
	# The score has NOT been incremented here yet.
	# Level1 is responsible for awarding the round.
	#
	# If the winner already has 1 win, this death
	# will give them their second win.
	# =====================================================

	var match_will_end := false

	if winner == "player1":

		if Game.p1_round_wins >= 1:
			match_will_end = true

	else:

		if Game.p2_round_wins >= 1:
			match_will_end = true

	print("MATCH WILL END: ", match_will_end)

	# =====================================================
	# FINAL MATCH DEATH
	# =====================================================

	if match_will_end:

		print("================================")
		print("LIUKANG FINAL DEATH")
		print("FATALITY ALLOWED")
		print("================================")

		# -------------------------------------------------
		# BLOOD DEATH EFFECT
		# -------------------------------------------------

		var blood = BLOOD_DEATH.instantiate()

		get_tree().current_scene.add_child(blood)

		blood.global_position = global_position

		# -------------------------------------------------
		# SHOW DEAD SPRITE
		# -------------------------------------------------

		$Sprite.visible = false
		$Crispy.visible = true

		$Crispy.flip_h = facing > 0

		# -------------------------------------------------
		# HIDE FINISH HIM
		# -------------------------------------------------

		if is_instance_valid(finish_label):
			finish_label.visible = false

		# -------------------------------------------------
		# WAIT FOR FINAL DEATH
		# -------------------------------------------------

		await get_tree().create_timer(3.0).timeout

		# -------------------------------------------------
		# TELL LEVEL1
		# -------------------------------------------------

		round_death.emit(winner)

		return

	# =====================================================
	# NORMAL ROUND DEATH
	# =====================================================
	#
	# This means the match is NOT over.
	#
	# Examples:
	#
	# Score 0-0
	# Reptile dies
	# Winner gets Round 1
	#
	# Score 1-0
	# Reptile dies and CPU wins
	# Score becomes 1-1
	#
	# Level1 handles the score and next round.
	# =====================================================

	print("================================")
	print("LIUKANG ROUND DEATH")
	print("NO FATALITY")
	print("LEVEL1 WILL HANDLE NEXT ROUND")
	print("================================")

	# =====================================================
	# HIDE FINISH HIM
	# =====================================================

	if is_instance_valid(finish_label):
		finish_label.visible = false

	# =====================================================
	# DEAD SPRITE
	# =====================================================

	$Sprite.visible = false
	$Crispy.visible = true

	$Crispy.flip_h = facing > 0

	# =====================================================
	# GIVE LEVEL1 CONTROL
	# =====================================================

	round_death.emit(winner)

	return


