const LIU_KANG_ATTACK = preload("res://LiuKangAttack.tscn")
const FIREBALL = preload("res://Fireball.tscn")

# ---------------- NODES ----------------
@onready var sprite: AnimatedSprite2D = $Sprite
@onready var hit_sound: AudioStreamPlayer2D = $Hit
@onready var hit_box: Area2D = $LiuKangHurtBox
@onready var finish_label: Sprite2D = $HUD/FinishLabel/Sprite2D
@onready var attack_marker: Marker2D = $AttackMarker
@onready var shoot_marker: Marker2D = $LiuKangshoot
# ---------------- PRELOADS ----------------
const FIRE_BULLET = preload("res://Projectiles/FireBullet.tscn")
const ICE_BULLET = preload("res://Projectiles/IceBullet.tscn")
const ELECTRIC_BULLET = preload("res://Projectiles/ElectricBullet.tscn")
const BLOOD_EFFECT = preload("res://GreenBloodEffect.tscn")

# ---------------- DEATH FX ----------------
const BLOOD_DEATH = preload("res://Deaths/BloodDeath.tscn")
const FIRE_DEATH = preload("res://Deaths/FireDeath.tscn")
const ICE_DEATH = preload("res://Deaths/IceDeath.tscn")
const ELECTRIC_DEATH = preload("res://Deaths/ElectricDeath.tscn")
const ACID_COMBO = ["down", "down", "down", "right", "shoot"]
const FIRE_COMBO = ["down", "right", "shoot"]
const ICE_COMBO = ["left", "left", "shoot"]
const ELECTRIC_COMBO = ["up", "down", "shoot"]

# ---------------- COMBOS ----------------
var combo := []
var combo_timer := 0.0

# ---------------- COOLDOWNS ----------------
var shoot_cooldown: float = 0.0


# ---------------- READY ----------------
func _ready():

	spawn_protection = true

	if finish_label:
		finish_label.visible = false

	add_to_group("Fighter")
	add_to_group("LiuKang")

	health = max_health
	health_changed.emit(health)

	play_anim("idle")

	if not hit_box.area_entered.is_connected(_on_liu_kang_hurt_box_area_entered):
		hit_box.area_entered.connect(_on_liu_kang_hurt_box_area_entered)

	await get_tree().create_timer(1.0).timeout

	spawn_protection = false

func _unhandled_input(event):

	if event.is_action_pressed("up"):
		register_input("up")

	elif event.is_action_pressed("down"):
		register_input("down")

	elif event.is_action_pressed("left"):
		register_input("left")

	elif event.is_action_pressed("right"):
		register_input("right")

	elif event.is_action_pressed("shoot"):
		register_input("shoot")

func apply_stun(duration: float):
	if stunned:
		play_anim("freeze")
		return

	stunned = true
	velocity = Vector2.ZERO

	await get_tree().create_timer(duration).timeout

	stunned = false
	

func start_flyingkick():
	flyingkick_active = true
	special_move_invincible = true
	special_move = true
	special_move_timer = 0.6  # NOT 6.25 (that’s way too long)

	# 🔥 stronger upward boost
	velocity.x = facing * 1300
	velocity.y = -900


func start_bicyclekick():
	bicyclekick_active = true
	special_move_invincible = true
	special_move = true
	special_move_timer = 0.55

	velocity.x = facing * 1300
	velocity.y = -600

 
# ---------------- PHYSICS ----------------
func _physics_process(delta):
	shoot_cooldown = max(shoot_cooldown - delta, 0.0)

	combo_timer += delta
	if combo_timer > 0.6:
		combo.clear()

	# ---------------- DEAD ----------------
	if state == State.DEAD:
		return

	# ---------------- FINISH HIM ----------------
	if is_finish_state:

		velocity.x = 0

		if not is_on_floor():
			velocity.y += GRAVITY * delta
		else:
			velocity.y = 0

		state = State.IDLE
		play_anim("idle")

		move_and_slide()
		return

	# ---------------- LOCK TIMER SAFETY ----------------
	if action_locked:
		lock_timer -= delta
		if lock_timer <= 0:
			action_locked = false
			is_attacking = false
			hurt_locked = false

	# ---------------- GRAVITY ----------------
	velocity.y += GRAVITY * delta

	# ---------------- LOCKED ----------------
	if action_locked or hurt_locked:
		velocity.x = move_toward(velocity.x, 0, SPEED * 8 * delta)
		move_and_slide()
		return

	# ---------------- CPU ----------------
	if is_cpu:
		if target == null:
			target = get_tree().get_first_node_in_group("Fighter")

		cpu_logic(delta)
		move_and_slide()
		return

	# ---------------- INPUT ----------------
	var input_dir = Input.get_axis("left", "right")
	var climb_pressed = Input.is_action_pressed("climb")

	# ---------------- FACING (FIXED LIKE REPTILE) ----------------
	if input_dir != 0:
		facing = sign(input_dir)

	sprite.flip_h = -facing < 0

	# ---------------- MOVEMENT ----------------
	velocity.x = input_dir * SPEED

	# ---------------- STATE ----------------
	if climb_pressed and not is_on_floor() and is_on_wall():
		state = State.CLIMB

	elif not is_on_floor():
		state = State.JUMP

	elif input_dir != 0:
		state = State.RUN

	else:
		state = State.IDLE

	move_and_slide()

	# ---------------- STATES (ONLY WHEN FREE) ----------------
	if not is_hurting and not is_attacking:
		if not is_on_floor():
			state = State.JUMP
		elif input_dir != 0:
			state = State.RUN
		else:
			state = State.IDLE

	# ---------------- ANIMS (ONLY ONCE) ----------------
	if is_hurting:
		play_anim("hurt")
	elif is_attacking:
		pass # attack system controls animation
	else:
		match state:
			State.JUMP:
				play_anim("jump")
			State.RUN:
				play_anim("walk")
			State.IDLE:
				play_anim("idle")

	# ---------------- ANIMATION ----------------
	if not is_attacking:
		match state:
			State.CLIMB:
				play_anim("climb")
			State.JUMP:
				play_anim("jump")
			State.RUN:
				play_anim("walk")
			State.IDLE:
				play_anim("idle")
	# ---------------- JUMP ----------------
	if Input.is_action_just_pressed("jump") and is_on_floor():
		velocity.y = jump_velocity

	# ---------------- ATTACKS ----------------
	if Input.is_action_just_pressed("jump"):
		do_action("jump")

	elif Input.is_action_just_pressed("punch"):
		do_action("punch")

	elif Input.is_action_just_pressed("roundhousekick"):
		do_action("roundhousekick")

	elif Input.is_action_just_pressed("kick"):
		do_action("kick")

	elif Input.is_action_just_pressed("uppercut"):
		do_action("uppercut")

	elif Input.is_action_pressed("shoot"):
		shoot_fireball()

	elif Input.is_action_just_pressed("flyingkick"):
		do_action("flyingkick")

	elif Input.is_action_just_pressed("bicyclekick"):
		do_action("bicyclekick")

	elif Input.is_action_pressed("block"):
		start_block()

	else:
		stop_block()

	move_and_slide()

	# ---------------- SPECIAL MOVES ----------------
	if special_move:

		for i in range(get_slide_collision_count()):
			var col = get_slide_collision(i)
			var body = col.get_collider()

			if body and body != self and body.has_method("take_damage"):

				body.take_damage(1)

				special_move = false
				flyingkick_active = false
				bicyclekick_active = false
				special_move_invincible = false
				special_move_timer = 0.0

				velocity = Vector2.ZERO
				return

# ---------------- BLOCK ----------------
func start_block():

	if state == State.DEAD:
		return

	is_blocking = true
	state = State.BLOCK

	play_anim("block")

func stop_block():

	if is_blocking:
		is_blocking = false
		state = State.IDLE

# ---------------- CPU ----------------
func cpu_logic(delta):
	# ---------------- HURT PRIORITY ----------------
	if is_hurting:
		velocity.x = 0
		velocity.y += GRAVITY * delta
		do_action("punch")
		do_action("uppercut")
		do_action("roundhousekick")
		move_and_slide()


	# HARD LOCK (Liu Kang style behavior)
	if action_locked:
		return

# STOP ALL ACTIONS AT 1HP
	if health <= 1:
		is_attacking = false
		action_locked = true
		velocity.x = 0
		move_and_slide()
		return

	if target == null or !is_instance_valid(target):
		velocity.x = 0
		return

	ai_timer -= delta

	var dist = target.global_position.x - global_position.x
	var direction = sign(dist)

	velocity.y += GRAVITY * delta
	facing = direction
	sprite.flip_h = facing > 0

# GRAVITY
	velocity.y += GRAVITY * delta


# ---------------- MOVEMENT ----------------
	if abs(dist) > 220:

		velocity.x = direction * SPEED * 0.8

	if state != State.RUN:
		state = State.RUN

	if not is_attacking:
		play_anim("walk")

	else:

		velocity.x = 0
		velocity.y = 0

	if state != State.IDLE:
		state = State.IDLE

	if not is_attacking:
		play_anim("idle")

	# ---------------- AI ACTIONS ----------------
	if ai_timer <= 0:

		ai_timer = randf_range(0.4, 0.8)

		match randi() % 5:

			0:
				do_action("punch")

			1:
				do_action("kick")

			2:
				do_action("uppercut")

			3:
				do_action("roundhousekick")

			4:
				shoot_fireball()

	# ---------------- AIR/LAND STATE ----------------
	if state == State.JUMP and not special_move:
		velocity.y += GRAVITY * delta

	if state != State.JUMP:
		state = State.JUMP

	else:
		velocity.y = 0

	if not is_attacking:
		play_anim("idle")

	else:

		if abs(dist) > 220:

			state = State.RUN

		if not is_attacking:
			play_anim("walk")

		else:

			state = State.IDLE

		if not is_attacking:
			play_anim("idle")



func do_action(anim_name: String):

	if action_locked:
		return

	action_locked = true
	is_attacking = true

	play_anim(anim_name)

	# melee attacks
	if anim_name in [
		"punch",
		"kick",
		"uppercut",
		"roundhousekick",
		"jumpkick"
	]:
		var attack = LIU_KANG_ATTACK.instantiate()
		get_tree().current_scene.add_child(attack)
		attack.global_position = attack_marker.global_position

# ---------------- BICYCLE KICK ----------------
	if anim_name == "flyingkick":
		start_flyingkick()
		spawn_attack()

	# ---------------- BICYCLE KICK ----------------
	elif anim_name == "bicyclekick":
		start_bicyclekick()
		spawn_attack()

	await sprite.animation_finished

	is_attacking = false
	action_locked = false
	play_anim("idle")

func air_launch(x_speed: float, y_speed: float):
	state = State.JUMP
	is_attacking = true
	action_locked = true

	special_move = true
	special_move_timer = 66.25

	velocity.x = facing * x_speed
	

# ---------------- FIREBALL ----------------
func shoot_fireball():

	if is_shooting:
		return

	is_shooting = true
	is_attacking = true
	action_locked = false

	play_anim("shoot")

	var fireball = FIREBALL.instantiate()
	get_tree().current_scene.add_child(fireball)

	fireball.global_position = shoot_marker.global_position

	# ✅ FIX: always pass direction instead of hard velocity
	fireball.direction = facing

	# optional fallback if your Fireball still uses velocity:
	fireball.velocity = Vector2(fireball.direction, 0) * fireball.speed

	await get_tree().create_timer(0.25).timeout

	is_shooting = false

	if is_hurting or state == State.DEAD:
		return

	is_attacking = false
	action_locked = false

	play_anim("idle")

func take_damage(amount: int):
	if spawn_protection:
		return
	if state == State.DEAD:
		return
	if is_hurting:
		return
	if special_move_invincible:
		return
	if not can_take_damage:
		return

	can_take_damage = false
	is_hurting = true

	health -= amount
	health = max(health, 0)

	health_changed.emit(health)

# ---------------- DELAYED FINISH CHECK ----------------
	if health == 1:
		is_finish_state = true

	# small delay so it doesn't pop instantly during hit frames
	await get_tree().create_timer(0.2).timeout

	# double-check still alive and still at 1 HP
	if health == 1 and state != State.DEAD:
		finish_label.visible = true

		if finish_label.has_method("start_flicker"):
			finish_label.start_flicker(0.4, 0.05)

	if health == 1:
		is_finish_state = true
		finish_label.visible = true
		await get_tree().create_timer(1.0).timeout
		finish_label.visible = false

	hit_sound.play()
	# stop actions immediately
	is_attacking = false
	is_shooting = false
	action_locked = true

	play_anim("hurt")

	# ---------------- DEATH ----------------
	if health == 0:
		die()
		return

	# ---------------- HURT TIME ----------------
	await get_tree().create_timer(0.25).timeout

	is_hurting = false
	action_locked = false

	if state != State.DEAD:
		play_anim("idle")

	# ---------------- FINISH STATE ----------------
	await get_tree().create_timer(0.15).timeout
	can_take_damage = true

# ---------------- ATTACK ----------------
func spawn_attack():

	var attack = LIU_KANG_ATTACK.instantiate()

	get_tree().current_scene.add_child(attack)

	attack.global_position = attack_marker.global_position

# ---------------- DEATH ----------------
func die():
	state = State.DEAD
	velocity = Vector2.ZERO

	var death = BLOOD_DEATH.instantiate()
	get_tree().current_scene.add_child(death)
	death.global_position = global_position
	queue_free()

# ---------------- ANIMATION ----------------
func play_anim(anim: String):

	if current_anim == anim:
		return

	current_anim = anim
	sprite.play(anim)

# ---------------- COMBOS ----------------
func register_input(input: String):

	combo.append(input)

	combo_timer = 0.0

	check_combos()

func spawn_fx(scene: PackedScene):

	var fx = scene.instantiate()

	get_tree().current_scene.call_deferred("add_child", fx)

	await get_tree().process_frame

	if target and is_instance_valid(target):
		fx.global_position = target.global_position + Vector2(60 * facing, 0)
	else:
		fx.global_position = global_position + Vector2(80 * facing, 0)

func check_combos():

	# ---------------- FIRE ----------------
	if combo == FIRE_COMBO:

		combo_used.emit("fire")

		spawn_fx(FIRE_DEATH)

		special_bullet = FIRE_BULLET

		combo.clear()
		return

	# ---------------- ICE ----------------
	elif combo == ICE_COMBO:

		combo_used.emit("ice")

		spawn_fx(ICE_DEATH)

		special_bullet = ICE_BULLET

		combo.clear()
		return

	# ---------------- ELECTRIC ----------------
	elif combo == ELECTRIC_COMBO:

		combo_used.emit("electric")

		spawn_fx(ELECTRIC_DEATH)

		special_bullet = ELECTRIC_BULLET

		combo.clear()
		return

# ---------------- HURT BOX ----------------
func _on_liu_kang_hurt_box_area_entered(area: Area2D):
	if area.get_parent() == self:
		return
	take_damage(1)
	if health > 1 and area.is_in_group("SubzeroBullet"):
		apply_stun(3.0)

