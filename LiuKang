func _ready():
	$Sprite.modulate = Color(1, 1, 1, 1)
	$Crispy.visible = false
	add_to_group("Fighter")
	add_to_group("enemy")
	add_to_group("LiuKang")

	add_to_group("FireDeath")
	add_to_group("IceDeath")
	add_to_group("ElectricDeath")

	spawn_locked = false

	health = max_health
	health_changed.emit(health)

	current_anim = ""
	sprite.play("idle")
	current_anim = "idle"

	ai_timer = randf_range(0.2, 0.6)
	facing = 1
	sprite.flip_h = -facing < 0
	$Crispy.flip_h = -facing < 0


func _unhandled_input(event):

	if event.is_action_pressed("jump"):
		jump_requested = true

	var inputs = ["up", "down", "left", "right", "shoot", "grab"]

	for i in inputs:
		if event.is_action_pressed(i):
			register_input(i)

func apply_stun(_duration := 4.0):

	if state == State.DEAD:
		return

	stunned = true

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	velocity = Vector2.ZERO
	knockback_x = 0

	play_anim("idle")

	await get_tree().create_timer(4.0).timeout

	stunned = false

	is_hurting = false
	hurt_locked = false
	action_locked = false

func start_flyingkick():
	play_anim("flyingkick")
	$Flyingkick.play()
	flyingkick_active = true
	special_move = true
	special_move_invincible = true
	special_move_timer = 10.6

	special_move_y = global_position.y - 100

	velocity.x = facing * 1300
	velocity.y = 0

func start_bicyclekick():

	if state == State.DEAD:
		return

	if action_locked:
		return

	bicyclekick_active = true
	spawn_protection = true
	is_attacking = true
	action_locked = true

	play_anim("bicyclekick")
	$Bicyclekick.play()

	# Stay at the height where the kick started
	bicyclekick_y = global_position.y - 100

	# Fly straight across the screen
	velocity = Vector2(facing * 1300, 0)

	# Stop after 1 second
	get_tree().create_timer(1.0).timeout.connect(func():
		bicyclekick_active = false
	)

	while bicyclekick_active:
		spawn_attack("bicyclekick")
		await get_tree().create_timer(0.08).timeout

	velocity.x = 0
	velocity.y = 0

	state = State.IDLE
	spawn_protection = false
	is_attacking = false
	action_locked = false
	play_anim("idle")


func handle_bicyclekick(delta):
	if not bicyclekick_active:
		return

	# Fly straight in the direction you're facing
	velocity.x = facing * 2200.0
	velocity.y = 0

	# Keep the character moving
	move_and_slide()

func end_bicyclekick():
	bicyclekick_active = false
	spawn_protection = false
	action_locked = false
	is_attacking = false

	if state != State.DEAD:
		play_anim("idle")

func handle_flyingkick(delta):
	# lock height exactly where it started
	global_position.y = special_move_y
	# keep moving forward
	velocity.x = facing * 1300
	velocity.y = 0
	# STOP WHEN INPUT RELEASED
	spawn_attack("flyingkick")
	if not Input.is_action_pressed("flyingkick"):
		flyingkick_active = false
		special_move = false
		special_move_invincible = false
		return



	move_and_slide()

func handle_special_hit():

	if not special_move:
		return

	for i in range(get_slide_collision_count()):
		var col = get_slide_collision(i)
		var body = col.get_collider()

		if body and body != self and body.has_method("take_damage"):
			body.take_damage(1)

			special_move = false
			flyingkick_active = false
			bicyclekick_active = false
			special_move_invincible = false
			velocity = Vector2.ZERO
			return

func update_state(input_dir, running):
	if state == State.DEAD:
		return

	if health <= 1:
		state = State.IDLE
		return

	if not is_on_floor():
		state = State.JUMP
	elif running and input_dir != 0:
		state = State.RUN
	elif input_dir != 0:
		state = State.WALK
	else:
		state = State.IDLE

func update_anim():
	match state:
		State.JUMP:
			play_anim("jump")
		State.RUN:
			play_anim("run")
		State.WALK:
			play_anim("walk")
		State.IDLE:
			play_anim("idle")

 
func handle_double_tap_run(input_dir: float, delta: float) -> bool:
	if input_dir == 0:
		return false

	var now := Time.get_ticks_msec() / 1000.0

	if input_dir == last_tap_dir:
		if now - last_tap_time <= tap_time:
			run_locked = true
			return true

	last_tap_time = now
	last_tap_dir = input_dir

	return false

func run(input_dir: float):
	if input_dir == 0:
		return

	if state == State.DEAD:
		return

	state = State.RUN
	velocity.x = input_dir * SPEED * 4  # fast dash run

	if not is_attacking and not is_hurting:
		play_anim("run")

# ---------------- PHYSICS ----------------
func _physics_process(delta):

	if state == State.DEAD:
		return

	if is_pulled:
		run_pull_logic(delta)
		move_and_slide()
		return

	# ---------------- GLOBAL LOCKS ----------------
	if dragon_active or stunned:
		velocity = Vector2.ZERO
		move_and_slide()
		return


# ---------------- UPPERCUT HIT ANIMATION ----------------
	if was_uppercut:
		velocity.y += GRAVITY * delta
		velocity.x = 0
		move_and_slide()
		return

	if flyingkick_active:
		handle_flyingkick(delta)
		move_and_slide()
		return

	if bicyclekick_active:
		handle_bicyclekick(delta)
		move_and_slide()
		return

	# ---------------- FINISH STATE ----------------
	if is_finish_state:
		state = State.IDLE
		velocity.x = 0
		if not is_hurting:
			play_anim("idle")
		move_and_slide()
		return

	# ---------------- GRAVITY (ONLY ONCE) ----------------
	velocity.y += GRAVITY * delta

	if uppercut_launched:

	# Gravity brings the fighter back down
		velocity.y += GRAVITY * delta

		move_and_slide()

		if is_on_floor():
			uppercut_launched = false

	# Gravity brings the fighter back down
		velocity.y += GRAVITY * delta

		return

	# ---------------- COOLDOWNS ----------------
	shoot_cooldown = max(shoot_cooldown - delta, 0.0)

	combo_timer += delta
	if combo_timer > combo_reset_time:
		combo.clear()

	# ---------------- CPU ----------------
	if is_cpu:
		cpu_logic(delta)
		return

	if action_locked:
		return


	# ---------------- INPUT ----------------
	var input_dir = Input.get_axis("left", "right")

	if input_dir != 0:
		facing = input_dir

	sprite.flip_h = facing > 0
	$Crispy.flip_h = facing > 0
	$AttackMarker.position = Vector2(0 * facing, 0)
	$LiuKangShoot.position = Vector2(63 * facing, -225)

	# =========================================================
	# 🟢 MOVEMENT (RUN ADDED HERE)
	# =========================================================
	if Input.is_action_pressed("run") and input_dir != 0:
		run(input_dir)   # 🔥 CALLS YOUR NEW RUN FUNCTION
	else:
		velocity.x = input_dir * SPEED

		# ---------------- STATE ----------------
		if not is_on_floor():
			state = State.JUMP
		elif input_dir != 0:
			state = State.WALK
		elif input_dir != 0:
			state = State.RUN
		else:
			state = State.IDLE

	# ---------------- ANIMS ----------------
	match state:

		State.JUMP:
			if not is_attacking:
				play_anim("jump")

		State.WALK:
			if not is_attacking:
				play_anim("walk")

		State.RUN:
			if not is_attacking:
				play_anim("run")

		State.IDLE:
			if not is_attacking:
				play_anim("idle")

	if is_hurting and hurt_locked:
		return

	# ---------------- ANIMATIONS ----------------
	match state:
		State.JUMP:
			if is_grabbing:
				state = State.JUMP
			if not is_on_floor():
				play_anim("jump")
			if grabbed_enemy and is_instance_valid(grabbed_enemy):

				var grab_offset := Vector2(80 * facing, 0)

				# put enemy on opposite side of Liu Kang
				grabbed_enemy.global_position = global_position + grab_offset

				# face enemy away from Liu
				grabbed_enemy.facing = -facing
				grabbed_enemy.sprite.flip_h = grabbed_enemy.facing > 0

				# stop enemy movement
				grabbed_enemy.velocity = Vector2.ZERO
			elif not is_attacking:
				play_anim("jump")
	# ---------------- ANIMS ----------------
	match state:

		State.JUMP:
			if not is_attacking:
				play_anim("jump")

		State.WALK:
			if not is_attacking:
				play_anim("walk")

		State.RUN:
			if not is_attacking:
				play_anim("run")

		State.IDLE:
			if not is_attacking:
				play_anim("idle")

	if is_hurting and hurt_locked:
		return

	# ---------------- JUMP ----------------
	if Input.is_action_just_pressed("jump") and is_on_floor():
		velocity.y = jump_velocity


	if Input.is_action_just_pressed("grab") and is_on_floor():
		is_grabbing = true
		is_attacking = true

		velocity.y = jump_velocity

		play_anim("jump")

		start_grab()

		return

	# ---------------- ATTACK INPUT ----------------
	if Input.is_action_just_pressed("punch"):
		do_action("punch")

	elif Input.is_action_just_pressed("highpunch"):
		do_action("highpunch")

	elif Input.is_action_just_pressed("lowpunch"):
		do_action("lowpunch")

	elif Input.is_action_just_pressed("roundhousekick"):
		do_action("roundhousekick")

	elif Input.is_action_just_pressed("kick"):
		do_action("kick")

	elif Input.is_action_just_pressed("highkick"):
		do_action("highkick")

	elif Input.is_action_pressed("fatalitydragon"):
		do_action("fatalitydragon")

	elif Input.is_action_just_pressed("lowkick"):
		do_action("lowkick")

	elif Input.is_action_just_pressed("uppercut"):
		do_action("uppercut")

	elif Input.is_action_pressed("shoot"):
		shoot_fireball()

	elif Input.is_action_pressed("block"):
		start_block()

	elif Input.is_action_just_pressed("flyingkick"):
		start_flyingkick()

	elif Input.is_action_just_pressed("bicyclekick"):
		start_bicyclekick()

	elif Input.is_action_pressed("invisible"):
		invisible()

	elif Input.is_action_pressed("knee"):
		do_action("knee")

	elif Input.is_action_pressed("visible"):
		sprite.visible = true

	elif Input.is_action_pressed("block"):
		start_block()
	elif Input.is_action_pressed("grab"):
		velocity.y = jump_velocity
	else:
		stop_block()

	move_and_slide()

	# ---------------- SPECIAL HIT CHECK ----------------
	handle_special_hit()

	# ---------------- SPECIAL MOVES ----------------
	if special_move:

		for i in range(get_slide_collision_count()):
			var col = get_slide_collision(i)
			var body = col.get_collider()

			if body and body != self and body.has_method("take_damage"):

				body.take_damage(1)

				special_move = false
				flyingkick_active = false
				bicyclekick_active = false
				special_move_invincible = false
				special_move_timer = 0.0

				velocity = Vector2.ZERO
				return

func start_grab():

	if state == State.DEAD:
		return

	var grab = GRAB_ATTACK.instantiate()
	get_tree().current_scene.add_child(grab)

	grab.global_position = $GrabMarker.global_position
