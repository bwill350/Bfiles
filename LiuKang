func check_combos():

	# ---------------- FIRE ----------------
	if combo == FIRE_COMBO: 

		combo_used.emit("fire")

		special_bullet = FIRE_BULLET

		combo.clear()

		shoot_fireball()
		return

	# ---------------- ELECTRIC ----------------
	elif combo == ELECTRIC_COMBO:

		combo_used.emit("electric")

		spawn_fx(ELECTRIC_DEATH)

		special_bullet = ELECTRIC_BULLET

		combo.clear()
		return

	elif combo == PUNCH_COMBO:

		combo_used.emit("punch_combo")

		combo.clear()

		start_punch_combo()
		return

	# ---------------- kick ----------------
	elif combo == KICK_COMBO:

		combo_used.emit("kick_combo")

		combo.clear()

		start_kick_combo()
		return

# ---------------- DRAGON ----------------
	elif combo == DRAGON_COMBO:

		print("DRAGON COMBO HIT")

		combo_used.emit("dragon")

		var fx = DRAGON_DEATH.instantiate()
		get_tree().current_scene.add_child(fx)

		fx.global_position = global_position + Vector2(0 * facing, 0)

		play_anim("dragon")

		combo.clear()

		await get_tree().create_timer(0.4).timeout

		return

	# ---------------- FATALITY_COMBO ----------------
	elif combo == FATALITY_COMBO:

		combo_used.emit("fatality_combo")

		combo.clear()

		do_action("fatalitydragon")
		return

func start_punch_combo():

	if action_locked or is_hurting or state == State.DEAD:
		return

	await combo_attack([
		"punch",
		"lowpunch",
		"punch",
		"uppercut",
		"highpunch",
		"uppercut"
	])

func start_kick_combo():

	if action_locked or is_hurting or state == State.DEAD:
		return

	await combo_attack([
		"kick",
		"knee",
		"highkick",
		"roundhousekick",
		"lowkick",
		"roundhousekick",
		"highkick"
	])

func combo_attack(attacks: Array):

	action_locked = true
	is_attacking = true

	for attack in attacks:

		if is_hurting or state == State.DEAD:
			break

		play_anim(attack)
		spawn_attack(attack)

		# let each move finish naturally
		await get_tree().create_timer(0.25).timeout

		# clear attack before next move
		is_attacking = false

		await get_tree().create_timer(0.05).timeout

		is_attacking = true

	is_attacking = false
	action_locked = false

	if not is_hurting:
		play_anim("idle")

