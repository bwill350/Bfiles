func _unhandled_input(event):

	if event.is_action_pressed("up"):
		register_input("up")

	elif event.is_action_pressed("down"):
		register_input("down")

	elif event.is_action_pressed("left"):
		register_input("left")

	elif event.is_action_pressed("right"):
		register_input("right")

	elif event.is_action_pressed("shoot"):
		register_input("shoot")

func apply_stun(duration: float):
	if stunned:
		return

	stunned = true
	is_attacking = false
	action_locked = true
	velocity = Vector2.ZERO
	play_anim("hurt") # or "idle" if you don't have freeze

	await get_tree().create_timer(duration).timeout

	stunned = false
	action_locked = false


func start_flyingkick():
	play_anim("flyingkick")
	flyingkick_active = true
	special_move_invincible = true
	special_move = true
	special_move_timer = 0.6

	special_move_y = $BloodMarker.global_position.y

	velocity.x = facing * 1300
	velocity.y = 0


func start_bicyclekick():
	play_anim("bicyclekick")
	bicyclekick_active = true
	special_move_invincible = true
	special_move = true
	special_move_timer = 0.55

	special_move_y = $BloodMarker.global_position.y

	velocity.x = facing * 1300
	velocity.y = 0


func update_animation():
	if is_hurting:
		play_anim("hurt")
		return

	if is_attacking:
		return

	if not is_on_floor():
		play_anim("jump")
	elif abs(velocity.x) > 10:
		play_anim("jump")
	else:
		play_anim("jump")
 
# ---------------- PHYSICS ----------------
func _physics_process(delta):

	shoot_cooldown = max(shoot_cooldown - delta, 0.0)
	combo_timer += delta

	if combo_timer > combo_reset_time:
		combo.clear()

	# ---------------- SPECIAL MOVES FIRST ----------------
	if flyingkick_active:
		start_flyingkick()
		return

	if bicyclekick_active:
		start_bicyclekick()
		return

	# ---------------- CPU ----------------
	if is_cpu:
		cpu_logic(delta)
		move_and_slide()
		return

	if state == State.DEAD:
		return

	# gravity ONCE
	velocity.y += GRAVITY * delta

	if action_locked:
		move_and_slide()
		return

	var input_dir = Input.get_axis("left", "right")

	# facing
	if input_dir != 0:
		facing = input_dir

	sprite.flip_h = facing > 0

	$AttackMarker.position = Vector2(63 * facing, -155)
	$LiuKangshoot.position = Vector2(63 * facing, -155)

	velocity.x = input_dir * SPEED

	# states
	if not is_on_floor():
		state = State.JUMP
	elif input_dir != 0:
		state = State.RUN
	else:
		state = State.IDLE

	match state:
		State.RUN:
			if not is_attacking:
				play_anim("walk")
		State.JUMP:
			if not is_attacking:
				play_anim("jump")
		State.IDLE:
			if not is_attacking:
				play_anim("idle")

	# jump
	if Input.is_action_just_pressed("jump") and is_on_floor():
		velocity.y = jump_velocity

	# attacks
	if Input.is_action_just_pressed("punch"):
		do_action("punch")
	elif Input.is_action_just_pressed("kick"):
		do_action("kick")
	elif Input.is_action_just_pressed("uppercut"):
		do_action("uppercut")
	elif Input.is_action_just_pressed("roundhousekick"):
		do_action("roundhousekick")
	elif Input.is_action_just_pressed("jumpkick"):
		do_action("jumpkick")

	elif Input.is_action_pressed("flyingkick"):
		start_flyingkick()

	elif Input.is_action_pressed("bicyclekick"):
		start_bicyclekick()

	elif Input.is_action_just_pressed("shoot"):
		shoot_fireball()

	elif Input.is_action_pressed("block"):
		start_block()
	else:
		stop_block()

	move_and_slide()

	# special collision hit check
	handle_special_hit()

	# ---------------- SPECIAL MOVES ----------------
	if special_move:

		for i in range(get_slide_collision_count()):
			var col = get_slide_collision(i)
			var body = col.get_collider()

			if body and body != self and body.has_method("take_damage"):

				body.take_damage(1)

				special_move = false
				flyingkick_active = false
				bicyclekick_active = false
				special_move_invincible = false
				special_move_timer = 0.0

				velocity = Vector2.ZERO
				return

	# ---------------- SPECIAL MOVES ----------------
	if special_move:

		if flyingkick_active:
			global_position.y = lerp(global_position.y, flyingkick_y, 0.2)
			special_move_timer -= delta
			velocity.x = facing * 1300
			velocity.y +GRAVITY * delta * 0.4
			move_and_slide()
# ---------------- CPU ----------------
func cpu_logic(delta):
	# ---------------- HURT PRIORITY ----------------
	if is_hurting:

		
		velocity.x = knockback_x

	# gradually reduce knockback
		knockback_x = move_toward(knockback_x, 0, 1500 * delta)

		if abs(knockback_x) < 10:
			knockback_x = 0
			is_hurting = false

			velocity.y += GRAVITY * delta
			move_and_slide()
			return


# GRAVITY
	velocity.y += GRAVITY * delta

	var dist = target.global_position.x - global_position.x
	var direction = sign(dist)

	# HARD LOCK (Liu Kang style behavior)
	if action_locked:
		return

# STOP ALL ACTIONS AT 1HP
	if health <= 1:
		is_attacking = false
		action_locked = true
		velocity.x = 0
		move_and_slide()
		return

	if target == null or !is_instance_valid(target):
		velocity.x = 0
		return

	ai_timer -= delta

	velocity.y += GRAVITY * delta
	facing = direction
	sprite.flip_h = facing > 0

# GRAVITY
	velocity.y += GRAVITY * delta


# ---------------- MOVEMENT ----------------
	if abs(dist) > 220:

		velocity.x = direction * SPEED * 0.8

	if state != State.RUN:
		state = State.RUN

	if not is_attacking:
		play_anim("walk")

	if abs(dist) > 220:
		velocity.x = direction * SPEED * 0.8
		state = State.RUN
		play_anim("walk")
	else:
		velocity.x = direction * SPEED * 0.8
		state = State.RUN
		play_anim("walk")

	# ---------------- AI ACTIONS ----------------
	if ai_timer <= 0:

		ai_timer = randf_range(0.4, 0.8)

		match randi() % 5:

			0:
				do_action("punch")

			1:
				do_action("kick")

			2:
				do_action("uppercut")

			3:
				do_action("roundhousekick")

			4:
				shoot_fireball()

func handle_flyingkick(delta):
	play_anim("flyingkick")

	special_move_timer -= delta
	velocity.x = facing * 1900
	velocity.y = 400

	move_and_slide()

	if special_move_timer <= 0:
		flyingkick_active = false
		special_move = false
		special_move_invincible = false
		velocity = Vector2.ZERO

func handle_bicyclekick(delta):
	play_anim("bicyclekick")

	special_move_timer -= delta
	velocity.x = facing * 1900
	velocity.y = 300

	move_and_slide()

	if special_move_timer <= 0:
		bicyclekick_active = false
		special_move = false
		special_move_invincible = false
		velocity = Vector2.ZERO

func handle_special_hit():

	if not special_move:
		return

	for i in range(get_slide_collision_count()):
		var col = get_slide_collision(i)
		var body = col.get_collider()

		if body and body != self and body.has_method("take_damage"):
			body.take_damage(1)

			special_move = false
			flyingkick_active = false
			bicyclekick_active = false
			special_move_invincible = false
			velocity = Vector2.ZERO
			return

func do_action(anim_name: String):

	if action_locked:
		return

	action_locked = true
	is_attacking = true

	play_anim(anim_name)

	# ---------------- MELEE ATTACKS ----------------
	if anim_name in [
		"punch",
		"kick",
		"uppercut",
		"roundhousekick",
		"jumpkick"
	]:
		spawn_attack(anim_name)

	# ---------------- SPECIALS ----------------
	elif anim_name == "flyingkick":
		start_flyingkick()

	elif anim_name == "bicyclekick":
		start_bicyclekick()

	await sprite.animation_finished

	is_attacking = false
	action_locked = false
	play_anim("idle")

func air_launch(x_speed: float, y_speed: float):
	state = State.JUMP
	is_attacking = true
	action_locked = true

	special_move = true
	special_move_timer = 0.6

	velocity.x = facing * x_speed
	

# ---------------- FIREBALL ----------------
func shoot_fireball():

	if is_shooting:
		return

	is_shooting = true
	is_attacking = true
	action_locked = true

	play_anim("shoot")

	var fireball = FIREBALL.instantiate()
	get_tree().current_scene.add_child(fireball)

	fireball.global_position = $LiuKangshoot.global_position

	# Always use facing direction
	fireball.direction = facing

	# Fallback for older fireball scripts
	fireball.velocity = Vector2(fireball.direction, 0) * fireball.speed

	await get_tree().create_timer(0.25).timeout

	is_shooting = false

	if is_hurting or state == State.DEAD:
		return

	is_attacking = false
	action_locked = false

	play_anim("idle")

func take_damage(amount: int):
	if not can_take_damage:
		return

	can_take_damage = false

	if state == State.DEAD:
		can_take_damage = true
		return

	if spawn_protection:
		can_take_damage = true
		return

	# BLOCK REDUCTION
	if is_blocking:
		amount = max(amount - 1, 0)

	if amount <= 0:
		can_take_damage = true
		return

	health -= amount
	health = max(health, 0)

	print("Sonya took damage: ", amount, " HP=", health)

	health_changed.emit(health)
	hit_sound.play()

	# 💀 DEATH FIRST
	if health <= 0:
		die()
		return

	# ⚠️ FINISH STATE (ONLY ONCE)
	if health == 1 and not is_finish_state:
		trigger_finish_state()

	# 💥 HURT FX ALWAYS WORKS EXCEPT DEAD
	is_hurting = true
	hurt_locked = true
	action_locked = true

	state = State.IDLE
	play_anim("hurt")

	var blood = BLOOD_EFFECT.instantiate()
	get_tree().current_scene.add_child(blood)
	blood.global_position = $BloodMarker.global_position

	await sprite.animation_finished

	is_hurting = false
	hurt_locked = false
	action_locked = false

	await get_tree().create_timer(0.4).timeout

	can_take_damage = true

	# ⚠️ FINISH HIM
	if health == 0:
		if not is_finish_state:
			trigger_finish_state()
		finish_label.visible = true
	else:
		finish_label.visible = false

func trigger_finish_state():
	if is_finish_state:
		return

	is_finish_state = true

	is_attacking = false
	is_shooting = false
	is_hurting = false

	action_locked = true
	hurt_locked = true

	state = State.IDLE
	velocity = Vector2.ZERO

	finish_label.visible = true

# ---------------- ATTACK ----------------
func spawn_attack(anim_name: String):

	if anim_name not in [
		"punch",
		"kick",
		"uppercut",
		"roundhousekick",
		"jumpkick"
	]:
		return

	var attack = LIU_KANG_ATTACK.instantiate()
	get_tree().current_scene.add_child(attack)

	attack.global_position = $AttackMarker.global_position
	attack.scale.x = facing  # THIS replaces facing system

	var dmg := 1

	match anim_name:
		"uppercut":
			dmg = 1
		"roundhousekick":
			dmg = 1

	if attack.has_method("set_damage"):
		attack.set_damage(dmg)
	else:
		attack.damage = dmg

	attack.owner = self


# ---------------- DEATH ----------------
func die():
	state = State.DEAD
	velocity = Vector2.ZERO

	var death = BLOOD_DEATH.instantiate()
	get_tree().current_scene.add_child(death)
	death.global_position = global_position
	queue_free()

# ---------------- ANIMATION ----------------
func play_anim(anim: String):

	if current_anim == anim:
		return

	current_anim = anim
	sprite.play(anim)

# ---------------- COMBOS ----------------
func register_input(input: String):

	combo.append(input)

	combo_timer = 0.0

	check_combos()

func spawn_fx(scene: PackedScene):

	var fx = scene.instantiate()

	# IMPORTANT: set owner BEFORE it can collide
	fx.owner_character = self
	fx.damage_done = false

	get_tree().current_scene.call_deferred("add_child", fx)

	await get_tree().process_frame

	if target and is_instance_valid(target):
		fx.global_position = target.global_position + Vector2(60 * facing, 0)
	else:
		fx.global_position = global_position + Vector2(80 * facing, 0)

func check_combos():

	# ---------------- FIRE ----------------
	if combo == FIRE_COMBO:

		combo_used.emit("fire")

		spawn_fx(FIRE_DEATH)

		special_bullet = FIRE_BULLET

		combo.clear()
		return

	# ---------------- ICE ----------------
	elif combo == ICE_COMBO:

		combo_used.emit("ice")

		spawn_fx(ICE_DEATH)

		special_bullet = ICE_BULLET

		combo.clear()
		return

	# ---------------- ELECTRIC ----------------
	elif combo == ELECTRIC_COMBO:

		combo_used.emit("electric")

		spawn_fx(ELECTRIC_DEATH)

		special_bullet = ELECTRIC_BULLET

		combo.clear()
		return

# ---------------- BLOCK ----------------
func start_block():

	if state == State.DEAD:
		return

	is_blocking = true
	state = State.BLOCK

	play_anim("block")

func stop_block():

	if is_blocking:
		is_blocking = false
		state = State.IDLE

# ---------------- HURT BOX ----------------
func _on_liu_kang_hurt_box_area_entered(area: Area2D) -> void:

	if area == null or !is_instance_valid(area):
		return

	# ---------------- SPEAR ----------------
	if area.is_in_group("ReptileSpear"):

		if not can_take_damage:
			return

		take_damage(1)

		is_hurting = true
		action_locked = true
		is_attacking = false

		velocity.x = -11888
		velocity.y = -200

		play_anim("hurt")
		return

	# ---------------- GLOBAL COOLDOWN CHECK ----------------
	if not can_take_damage:
		return

	var damage_sources = [
		"HitBox",
		"ReptileBullet",
		"ReptileAcid",
		"RaidenElectricBullet",
		"ElectricForceField",
		"ElectricBurst",
		"ElectricBullet",
		"KanoBullet",
		"IceBullet",
		"SubzeroBullet",
		"JohnnyCageBullet",
		"SonyaBullet",
		"FireBullet",
		"Fireball"
	]

	for source in damage_sources:
		if area.is_in_group(source):

			if source == "SubzeroBullet":
				apply_stun(3.0)

			take_damage(1)

			is_hurting = true
			action_locked = true
			is_attacking = false

			knockback_x = -facing * 1100
			velocity.y = -200

			play_anim("hurt")
			return
