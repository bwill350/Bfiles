func end_grab():

	if grabbed_enemy and is_instance_valid(grabbed_enemy):

		grabbed_enemy.action_locked = false
		grabbed_enemy.is_hurting = false
		grabbed_enemy.is_attacking = false

		grabbed_enemy.velocity = Vector2(
			facing * 600,
			-800
		)

		await get_tree().create_timer(0.2).timeout

		grabbed_enemy.velocity.x = 0


	grabbed_enemy = null

	is_grabbing = false
	is_attacking = false
	action_locked = false

	play_anim("idle")

func spear_pulled_to_p1():

	if state == State.DEAD:
		return

	# =====================================================
	# LOCK LIU KANG DURING PULL
	# =====================================================

	is_pulled = true
	stunned = true

	action_locked = true
	hurt_locked = true
	is_hurting = false

	is_attacking = false
	is_shooting = false
	is_blocking = false

	flyingkick_active = false
	bicyclekick_active = false
	special_move = false
	uppercut_launched = false
	was_uppercut = false

