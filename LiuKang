# ---------------- FIREBALL ----------------
func shoot_fireball():

	if health <= 1:
		return

	if is_finish_state:
		return

	if is_shooting:
		return

	is_shooting = true
	is_attacking = true
	action_locked = true

	play_anim("shoot")

	# PLAY FIREBALL SOUND
	$Fireball.play()

	var bullet_scene: PackedScene

	# 🔥 Combo override bullet
	if special_bullet != null:
		bullet_scene = special_bullet
		special_bullet = null
	else:
		bullet_scene = FIREBALL

	var bullet = bullet_scene.instantiate()
	get_tree().current_scene.add_child(bullet)

	await get_tree().process_frame

	bullet.global_position = $LiuKangShoot.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	# Flip sprite if needed
	if bullet.has_node("Sprite2D"):
		bullet.get_node("Sprite2D").flip_h = facing > 0

	await get_tree().create_timer(0.25).timeout

	is_shooting = false

	if is_hurting or state == State.DEAD:
		return

	is_attacking = false
	action_locked = false

