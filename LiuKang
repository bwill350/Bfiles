	current_anim = ""
	play_anim("idle")

	pull_timer = 0.35

	# Find Reptile
	pull_target = get_tree().get_first_node_in_group("Reptile")


func run_pull_logic(delta):

	# =====================================================
	# NO TARGET
	# =====================================================

	if pull_target == null or not is_instance_valid(pull_target):

		is_pulled = false
		stunned = false

		action_locked = false
		hurt_locked = false
		is_hurting = false

		is_attacking = false
		is_shooting = false
		is_blocking = false

		velocity = Vector2.ZERO

		state = State.IDLE

		current_anim = ""
		play_anim("idle")

		return


	# =====================================================
	# PULL LIU KANG TOWARD REPTILE
	# =====================================================

	var dir: float = sign(
		pull_target.global_position.x -
		global_position.x
	)

	velocity.x = dir * 900.0
	velocity.y = -120.0

	pull_timer -= delta


	# =====================================================
	# PULL FINISHED
	# =====================================================

	if pull_timer <= 0.0:

		is_pulled = false

		# Snap Liu Kang beside Reptile
		global_position = (
			pull_target.attack_marker.global_position
			+ Vector2(
				40.0 * pull_target.facing,
				0.0
			)
		)

		# =================================================
		# COMPLETELY CANCEL ALL ACTIONS
		# =================================================

		velocity = Vector2.ZERO

		stunned = false

		is_hurting = false
		hurt_locked = false

		is_attacking = false
		is_shooting = false
		is_blocking = false

		action_locked = false

		flyingkick_active = false
		bicyclekick_active = false
		special_move = false
		uppercut_launched = false
		was_uppercut = false

		grabbed_enemy = null
		is_grabbing = false

		combo.clear()
		combo_timer = 0.0

		# =================================================
		# FORCE IDLE
		# =================================================

		state = State.IDLE

		current_anim = ""
		play_anim("idle")

		# =================================================
		# FACE REPTILE
		# =================================================

		if is_instance_valid(pull_target):

			var face_dir: float = sign(
				pull_target.global_position.x -
				global_position.x
			)

			if face_dir != 0.0:
				facing = face_dir

			sprite.flip_h = facing > 0
			$Crispy.flip_h = facing > 0

			$AttackMarker.position = Vector2(0, 0)

			$LiuKangShoot.position = Vector2(
				63 * facing,
				-225
			)

		pull_target = null

		print("LIU KANG PULL FINISHED - IDLE")

func invisible() -> void:
	sprite.visible = false
	await get_tree().create_timer(2.1).timeout
	sprite.visible = true

# ---------------- CPU ----------------
func cpu_logic(delta):

	# =========================================================
	# DEAD
	# =========================================================
	if state == State.DEAD:
		return

	# =========================================================
	# FINISH HIM
	# =========================================================
	if is_finish_state:
		is_attacking = false
		action_locked = true
		velocity.x = 0
		state = State.IDLE

		if not is_hurting:
			play_anim("idle")

		return

	# =========================================================
	# HURT
	# =========================================================
	if is_hurting:

		velocity.x = knockback_x

		knockback_x = move_toward(
			knockback_x,
			0.0,
			1500.0 * delta
		)

		move_and_slide()

		if abs(knockback_x) > 10.0:
			return

		knockback_x = 0.0
		is_hurting = false
		hurt_locked = false
		is_attacking = false
		is_shooting = false
		action_locked = false

		state = State.IDLE
		play_anim("idle")

		ai_timer = 0.1

		return

	# =========================================================
	# ACTION LOCK
	# =========================================================
	if action_locked:
		velocity.x = 0
		return

	# =========================================================
	# FIND PLAYER 1
	# =========================================================
	if target == null or not is_instance_valid(target):

		target = get_tree().get_first_node_in_group("player1")

		# Backup: find human Fighter
		if target == null or not is_instance_valid(target):

			for node in get_tree().get_nodes_in_group("Fighter"):

				if node == self:
					continue

				if not is_instance_valid(node):
					continue

				if node is Node2D and not node.is_cpu:
					target = node
					break

	# =========================================================
	# NO TARGET
	# =========================================================
	if target == null or not is_instance_valid(target):

		velocity.x = 0
		state = State.IDLE
		play_anim("idle")

		return

	# =========================================================
	# DISTANCE TO PLAYER 1
	# =========================================================
	var dist: float = target.global_position.x - global_position.x
	var distance: float = abs(dist)
	var direction: float = sign(dist)

# =========================================================
# FACE PLAYER 1
# =========================================================
	if direction != 0:

		facing = direction

		sprite.flip_h = facing > 0
		$Crispy.flip_h = facing > 0

		$AttackMarker.position = Vector2.ZERO
		$LiuKangShoot.position = Vector2(63 * facing, -211)

	# =========================================================
	# CPU DISTANCES
	# =========================================================
	var attack_range := 110.0
	var stopping_distance := 90.0

	# =========================================================
	# WALK TOWARD PLAYER 1
	# =========================================================
	if distance > stopping_distance:

		velocity.x = direction * SPEED

		state = State.WALK

		if not is_attacking and not is_hurting:
			play_anim("walk")

	# =========================================================
	# AI ATTACK TIMER
	# =========================================================
	ai_timer -= delta

	if ai_timer > 0.0:
		return



	# =========================================================
	# GRAVITY
	# =========================================================
	velocity.y += GRAVITY * delta


	# =========================================================
	# UPPERCUT RECOVERY
	# =========================================================
	if uppercut_launched:

		velocity.x = 0.0
		move_and_slide()

		if is_on_floor():

			uppercut_launched = false
			velocity.y = 0.0

			# FIND PLAYER 1 AGAIN
			target = get_tree().get_first_node_in_group("player1")

			ai_timer = 0.01

		return


	# =========================================================
	# HURT RECOVERY
	# =========================================================
	if is_hurting:

		velocity.x = knockback_x

		knockback_x = move_toward(
			knockback_x,
			0.0,
			1500.0 * delta
		)

		move_and_slide()

		# Still getting knocked backward
		if abs(knockback_x) > 10.0:
			return

		# =====================================================
		# HURT IS FINISHED
		# =====================================================

		knockback_x = 0.0

		is_hurting = false
		hurt_locked = false
		is_attacking = false
		is_shooting = false
		action_locked = false

		state = State.IDLE

		current_anim = ""
		play_anim("idle")

		# =====================================================
		# IMMEDIATELY FIND PLAYER 1
		# =====================================================

		target = get_tree().get_first_node_in_group("player1")

		# Backup search
		if target == null or not is_instance_valid(target):

			for node in get_tree().get_nodes_in_group("Fighter"):

				if node == self:
					continue

				if not is_instance_valid(node):
					continue

				if node is Node2D and not node.is_cpu:
					target = node
					break

		# =====================================================
		# DO NOT WAIT
		# =====================================================

		ai_timer = 0.01

		# Continue AI immediately on next physics frame
		return


	# =========================================================
	# ACTION LOCK
	# =========================================================
	if action_locked:

		velocity.x = 0.0
		move_and_slide()

		return


	# =========================================================
	# TARGET VALIDATION
	# =========================================================
	if target == null or not is_instance_valid(target):

		target = get_tree().get_first_node_in_group("player1")

		if target == null or not is_instance_valid(target):

			velocity.x = 0.0
			state = State.IDLE
			play_anim("idle")

			move_and_slide()

			ai_timer = 0.01
			return

	# =========================================================
	# FACE PLAYER 1
	# =========================================================
	if direction != 0:

		facing = direction

		sprite.flip_h = facing > 0
		$Crispy.flip_h = facing > 0

		$AttackMarker.position = Vector2(0, 0)
		$LiuKangShoot.position = Vector2(63 * facing, -225)

	# =========================================================
	# CHASE PLAYER 1
	# =========================================================
	if distance > stopping_distance:

		velocity.x = direction * SPEED * 1.05

		state = State.RUN

		if not is_attacking and not is_hurting:
			play_anim("walk")


	# =========================================================
	# AI ATTACK TIMER
	# =========================================================
	ai_timer -= delta


	if ai_timer <= 0.0:

		# =====================================================
		# ATTACK PLAYER 1
		# =====================================================
		if (
			distance <= attack_range
			and not is_hurting
			and not is_finish_state
			and not action_locked
			and not is_attacking
		):

			match Game.difficulty:

				# =================================================
				# HARD
				# =================================================
				"Hard":

					ai_timer = randf_range(0.08, 0.18)

					var choice := randi() % 100

					if choice < 15:
						do_action("punch")

					elif choice < 25:
						do_action("highpunch")

					elif choice < 35:
						do_action("lowpunch")

					elif choice < 50:
						do_action("kick")

					elif choice < 60:
						do_action("highkick")

					elif choice < 70:
						do_action("lowkick")

					elif choice < 82:
						do_action("uppercut")

					elif choice < 92:
						do_action("roundhousekick")

					else:
						do_action("knee")


				# =================================================
				# EASY
				# =================================================
				"Easy":

					ai_timer = randf_range(0.35, 0.65)

					var choice := randi() % 100

					if choice < 35:
						do_action("punch")

					elif choice < 45:
						do_action("highpunch")

					elif choice < 55:
						do_action("lowpunch")

					elif choice < 70:
						do_action("kick")

					elif choice < 80:
						do_action("highkick")

					elif choice < 88:
						do_action("lowkick")

					elif choice < 94:
						do_action("uppercut")

					else:
						shoot_fireball()


	# =========================================================
	# FINAL MOVEMENT
	# =========================================================
	move_and_slide()

func do_action(anim_name: String):

	if state == State.DEAD:
		return

	if is_finish_state:
		return

	if is_attacking:
		return

	if action_locked:
		return

	if is_hurting:
		return

	# STOP MOVEMENT
	velocity.x = 0

	action_locked = true
	is_attacking = true

	play_anim(anim_name)

	# ---------------- MELEE ATTACKS ----------------
	if anim_name in [
		"bicyclekick",
		"punch",
		"highpunch",
		"lowpunch",
		"kick",
		"highkick",
		"lowkick",
		"uppercut",
		"roundhousekick",
		"jumpkick",
		"flyingkick",
		"fatalitycombo",
		"knee"
	]:
		spawn_attack(anim_name)

	# ---------------- SPECIALS ----------------
	elif anim_name == "flyingkick":
		start_flyingkick()

	elif anim_name == "bicyclekick":
		start_bicyclekick()

	await get_tree().create_timer(0.15).timeout

	if state == State.DEAD:
		return

	if is_hurting:
		return

	is_attacking = false
	action_locked = false
	hurt_cooldown = false

	velocity.x = 0

	# CPU immediately gets another opportunity
	if is_cpu:
		ai_timer = 0.05

func air_launch(x_speed: float, y_speed: float):
	state = State.JUMP
	is_attacking = true
	action_locked = true

	special_move = true
	special_move_timer = 0.6

