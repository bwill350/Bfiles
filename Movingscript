# FSM - Moving State
extends PlayerState

func enter_state(player_node):
	print("Entered Moving State")
	super(player_node)
	player.anim.animation = "run"
	player.anim.play()

func physics_update(delta):
	# Handle horizontal movement
	if Input.is_action_pressed("left"):
		player.velocity.x = -player.SPEED
		player.facing_direction = -1
	elif Input.is_action_pressed("right"):
		player.velocity.x = player.SPEED
		player.facing_direction = 1
	else:
		# If no movement input, return to idle
		player.change_state("Idle")
		return

	# Apply gravity
	player.velocity.y += player.GRAVITY * delta
	player.velocity.y = min(player.velocity.y, player.MAX_FALL_SPEED)

	player.move_and_slide()

	# Transition to Falling if in air
	if not player.is_on_floor():
		player.change_state("Falling")

func handle_input(_delta):
	# Jumping
	if Input.is_action_just_pressed("jump"):
		player.change_state("Jumping")

	# Crouching
	elif Input.is_action_just_pressed("down"):
		player.change_state("Crouching")

	# Optional: Attack while moving
	elif Input.is_action_just_pressed("slash"):
		player.change_state("RunningAttack")
