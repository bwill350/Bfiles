extends Area2D
class_name FireDeath

@onready var sprite: AnimatedSprite2D = $Sprite
@onready var sound: AudioStreamPlayer2D = $FireSound
@onready var ring: Sprite2D = $ShockwaveRing

@onready var p1: CPUParticles2D = $CPUParticles2D
@onready var p2: CPUParticles2D = $CPUParticles2D2
@onready var p3: CPUParticles2D = $CPUParticles2D3
var owner_character = null

# 🔥 FIRE CONTROL (from Kano combo)
var fire_bullet_scene: PackedScene = null
var fire_spawn_position: Vector2 = Vector2.ZERO
var fire_direction: float = 1
var fire_triggered := false
var flicker_on := true
var finished := false
var damage_done := false

# ---------------- READY ----------------
func _ready():
	$CleanupTimer.start()

	add_to_group("FireDeath")
	add_to_group("HurtBox")

	self.scale = Vector2.ZERO

	if sound:
		sound.play()

	# 🔥 EVERYTHING STARTS HERE
	start_flicker()
	start_main_animation()
	start_shockwave()
	start_particle_burst()

	await get_tree().create_timer(2.5).timeout
	await sprite.animation_finished

	stop_fatality()

# ---------------- STOP EVERYTHING ----------------
func stop_fatality():
	if finished:
		return

	finished = true

	sprite.stop()
	sprite.modulate = Color.WHITE

	if sound:
		sound.stop()

	if ring:
		ring.modulate.a = 0.0

	for p in [p1, p2, p3]:
		if p:
			p.emitting = false

	var t = create_tween()
	t.tween_property(self, "scale", Vector2.ZERO, 0.5)

	await t.finished

	queue_free()

# ---------------- FLICKER ----------------
func start_flicker():
	var flicker = create_tween()
	flicker.set_loops(8)

	flicker.tween_callback(func():
		if finished:
			return

		flicker_on = !flicker_on
		sprite.modulate = Color(1,1,1) if flicker_on else Color(0.4,0.8,1.5)
	).set_delay(0.05)

# ---------------- MAIN ANIMATION ----------------
func start_main_animation():
	var t = create_tween()

	t.tween_property(self, "scale", Vector2.ONE, 0.15)
	t.tween_property(self, "scale", Vector2(6, 6), 0.12)
	t.tween_property(self, "scale", Vector2.ONE, 0.18)
	t.tween_property(self, "scale", Vector2.ZERO, 0.2)

# ---------------- SHOCKWAVE ----------------
func start_shockwave():
	if ring == null:
		return

	ring.scale = Vector2.ZERO
	ring.modulate.a = 1.0

	var t = create_tween()

	t.tween_property(ring, "scale", Vector2(10, 10), 0.35)
	t.parallel().tween_property(ring, "modulate:a", 0.0, 0.35)

# ---------------- PARTICLES ----------------
func start_particle_burst():
	var parts = [p1, p2, p3]

	for i in range(parts.size()):
		var p = parts[i]
		if p == null:
			continue

		p.emitting = false
		p.scale = Vector2.ZERO
		p.modulate.a = 0.0

		var delay = i * 0.06

		var t_in = create_tween()
		t_in.tween_interval(delay)

		t_in.tween_callback(func():
			if finished:
				return
			p.emitting = true
		)

		t_in.tween_property(p, "scale", Vector2.ONE, 0.15)
		t_in.tween_property(p, "modulate:a", 1.0, 0.1)

# ---------------- OPTIONAL: FIRE BULLET FROM DEATH ----------------
func spawn_fire_bullet():
	var bullet = preload("res://Projectiles/FireBullet.tscn").instantiate()

	get_tree().current_scene.add_child(bullet)

	bullet.global_position = global_position
	bullet.velocity = Vector2(1, 0) * bullet.speed
