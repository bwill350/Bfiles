extends Area2D

@onready var sprite: AnimatedSprite2D = $Sprite
@onready var sound: AudioStreamPlayer2D = $FireSound
@onready var ring: Sprite2D = $ShockwaveRing

@onready var p1: CPUParticles2D = $CPUParticles2D
@onready var p2: CPUParticles2D = $CPUParticles2D2
@onready var p3: CPUParticles2D = $CPUParticles2D3

const FIRE_BULLET = preload("res://Projectiles/FireBullet.tscn")

var flicker_on := true
var finished := false
var owner_character = null


# ---------------- READY ----------------
func _ready():

	$Sprite.play("fade")

	add_to_group("FireDeath")

	self.scale = Vector2.ZERO

	if sprite:
		sprite.play("charge")

	if sound:
		sound.play()

	start_flicker()
	start_main_animation()
	start_shockwave()
	start_particle_burst()

	# SINGLE LIFETIME
	await get_tree().create_timer(2.5).timeout

	await $Sprite.animation_finished

	stop_fatality()

	await get_tree().process_frame

	for fighter in get_tree().get_nodes_in_group("Reptile"):
		fighter.remove_meta("firedeath_hit")
	for fighter in get_tree().get_nodes_in_group("Subzero"):
		fighter.remove_meta("firedeath_hit")
	for fighter in get_tree().get_nodes_in_group("Raiden"):
		fighter.remove_meta("firedeath_hit")
	for fighter in get_tree().get_nodes_in_group("LiuKang"):
		fighter.remove_meta("firedeath_hit")
	for fighter in get_tree().get_nodes_in_group("JohnnyCage"):
		fighter.remove_meta("firedeath_hit")
	for fighter in get_tree().get_nodes_in_group("Kano"):
		fighter.remove_meta("firedeath_hit")
	for fighter in get_tree().get_nodes_in_group("Sonya"):
		fighter.remove_meta("firedeath_hit")

		queue_free()

# ---------------- STOP EVERYTHING ----------------
func stop_fatality():

	if finished:
		return

	finished = true

	# stop animation
	if sprite:
		sprite.stop()
		sprite.modulate = Color.WHITE

	# stop sound
	if sound:
		sound.stop()

	# fade ring instantly
	if ring:
		ring.modulate.a = 0.0

	# stop particles
	for p in [p1, p2, p3]:

		if p:
			p.emitting = false

	# shrink out
	var t = create_tween()

	t.tween_property(
		self,
		"scale",
		Vector2.ZERO,
		5.35
	).set_trans(Tween.TRANS_QUAD)\
	 .set_ease(Tween.EASE_IN)

	await t.finished

	$CleanupTimer.start()

	queue_free()

# ---------------- FLICKER ----------------
func start_flicker():

	var flicker = create_tween()

	flicker.set_loops(8)

	flicker.tween_callback(func():

		if finished:
			return

		flicker_on = !flicker_on

		if flicker_on:
			sprite.modulate = Color(1, 1, 1)
		else:
			sprite.modulate = Color(0.4, 0.8, 1.5)

	).set_delay(0.05)

# ---------------- MAIN ANIMATION ----------------
func start_main_animation():

	var t = create_tween()

	t.tween_property(
		self,
		"scale",
		Vector2.ONE,
		0.15
	).set_trans(Tween.TRANS_BACK)\
	 .set_ease(Tween.EASE_OUT)

	t.tween_property(
		self,
		"scale",
		Vector2(6, 6),
		0.12
	).set_trans(Tween.TRANS_EXPO)\
	 .set_ease(Tween.EASE_OUT)

	t.tween_property(
		self,
		"scale",
		Vector2.ONE,
		0.18
	).set_trans(Tween.TRANS_SINE)\
	 .set_ease(Tween.EASE_IN_OUT)

	t.tween_property(
		self,
		"scale",
		Vector2.ZERO,
		0.2
	).set_trans(Tween.TRANS_QUAD)\
	 .set_ease(Tween.EASE_IN)

# ---------------- SHOCKWAVE ----------------
func start_shockwave():

	if ring == null:
		return

	ring.scale = Vector2.ZERO
	ring.modulate.a = 1.0

	var t = create_tween()

	t.tween_property(
		ring,
		"scale",
		Vector2(10, 10),
		0.35
	).set_trans(Tween.TRANS_EXPO)\
	 .set_ease(Tween.EASE_OUT)

	t.parallel().tween_property(
		ring,
		"modulate:a",
		0.0,
		0.35
	)

# ---------------- PARTICLES ----------------
func start_particle_burst():

	var parts = [p1, p2, p3]

	for i in range(parts.size()):

		var p = parts[i]

		if p == null:
			continue

		p.emitting = false
		p.scale = Vector2.ZERO
		p.modulate.a = 0.0

		var delay = i * 0.06

		var t_in = create_tween()

		t_in.tween_interval(delay)

		t_in.tween_callback(func():

			if finished:
				return

			p.emitting = true
		)

		t_in.tween_property(
			p,
			"scale",
			Vector2.ONE,
			0.15
		)

		t_in.tween_property(
			p,
			"modulate:a",
			1.0,
			0.1
		)

		var t_out = create_tween()

		t_out.tween_interval(0.25 + delay)

		t_out.tween_property(
			p,
			"scale",
			Vector2.ZERO,
			0.2
		)

		t_out.tween_property(
			p,
			"modulate:a",
			0.0,
			0.2
		)

		t_out.tween_callback(func():
			p.emitting = false
		)

func _on_cleanup_timer_timeout():

	get_tree().change_scene_to_file("res://CharacterSelect.tscn")
