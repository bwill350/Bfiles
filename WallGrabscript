# FSM - jumping state
extends PlayerState

func enter_state(player_node):
	print("Entered WallGrab State")
	super(player_node)
	player.state_label.text = "WallGrab"
	player.anim.animation = "ledge"
	if player.anim.frame_changed:
		player.anim.get_frame(1)
		player.nanim.pause()

func handle_input(_delta):
	#Handle Class
	if Input.is_action_just_pressed("jump"):
		var current_frame = player.anim.get_frame()
		var current_progress = player.anim.get_frame_progress()
		player.anim.get_frame_and_progress(current_frame, current_progress)
		player.anim.play()
		player.velocity.y = player.JUMP_VELOCITY
		
		player.chagne_state("Idle")
