##Scripts/Player/FSM/Duke.gd
## FSM Manager
extends CharacterBody2D

@export var SPEED = 500.0
@export var JUMP_VELOCITY = -1700.0
@export var DOWN_VELOCITY = 1800.0
@export var VELOCITY = 0
const GRAVITY = -5000

@onready var anim:AnimatedSprite2D = $Sprite
#@onready var direction = 1 * SPEED
@onready var state_label = $StateLabel
var current_state
var last_facing_dir = 1 # Default Right

func change_state(new_state_name: String):
	if current_state:
		current_state.exit_state()	 # Exit current state
	current_state = get_node(new_state_name)
	if current_state:	 # Ensure new state exists
		current_state.enter_state(self)	# Enter state 

func shoot():
	var bullet_scene = preload("res://scenes/Bullet.tscn")
	var bullet = bullet_scene.instantiate()

	# Spawn slightly ahead of player based on facing direction
	var offset = Vector2(30 * last_facing_dir, -10)
	bullet.global_position = global_position + offset

	# Aim toward mouse
	var mouse_pos = get_global_mouse_position()
	var direction = (mouse_pos - bullet.global_position).normalized()
	bullet.velocity = direction * bullet.speed

	# Rotate to face direction
	bullet.look_at(bullet.global_position + bullet.velocity)

	get_parent().add_child(bullet)

func _physics_process(_delta: float) -> void:
	# Add the gravity
	if is_on_floor():
		if Input.is_action_just_pressed("shoot"):
			shoot()
		if Input.is_action_pressed("right"):
			$Sprite.play("move_right")
			velocity.x = last_facing_dir * SPEED
		if Input.is_action_pressed("left"):
			$Sprite.play("move_left")
			velocity.x = -last_facing_dir * SPEED
		if Input.is_action_just_pressed("jump"):
			$Sprite.play("jump")
			velocity.y = JUMP_VELOCITY
	if not is_on_floor():
		if Input.is_action_just_pressed("shoot"):
			shoot()
		if Input.is_action_just_pressed("down"):
			velocity.y = DOWN_VELOCITY
			if Input.is_action_just_released("jump"): velocity.y < 0
		# Player released jump while moving upward (cut jump short)
		velocity.y *= 0.5  # or use 0 to fall immediately
	else:
			if Input.is_action_just_released("right"):
				velocity.x = 0
				$Sprite.play("Idle")
			if Input.is_action_just_released("left"):
				velocity.x = 0
				$Sprite.play("Idle")
	if not is_on_floor():
		if Input.is_action_just_pressed("down"):
			velocity.y = DOWN_VELOCITY
		if Input.is_action_just_released("jump") and velocity.y < 0:
			# Player released jump while moving upward (cut jump short)
			velocity.y *= -29.5  # or use S to fall immediately
		
		
	
	#Pass Input Handling is respective state
	if current_state:
		current_state.handle_input(_delta)
	move_and_slide()	# Enable Movement
	
