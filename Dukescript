##Scripts/Player/FSM/Duke.gd
extends CharacterBody2D

@export var SPEED = 500.0
@export var JUMP_VELOCITY = -1300.0
@export var DOWN_VELOCITY = 100.0
@export var VELOCITY = 0
@export var CLIMB_SPEED = 250.0
const GRAVITY = 5000

@onready var anim: AnimatedSprite2D = $Sprite
@onready var state_label = $StateLabel

var current_state
var last_facing_dir = 1
var is_climbing = false

func change_state(new_state_name: String):
	if current_state:
		current_state.exit_state()
	current_state = get_node(new_state_name)
	if current_state:
		current_state.enter_state(self)

func shoot():
	var bullet_scene = preload("res://scenes/Bullet.tscn")
	var bullet = bullet_scene.instantiate()
	var offset = Vector2(30 * last_facing_dir, -10)
	bullet.global_position = global_position + offset
	var mouse_pos = get_global_mouse_position()
	var direction = (mouse_pos - bullet.global_position).normalized()
	bullet.velocity = direction * bullet.speed
	bullet.look_at(bullet.global_position + bullet.velocity)
	get_parent().add_child(bullet)

func _physics_process(_delta: float) -> void:
	# --- Climb toggle ---
	if Input.is_action_just_pressed("climb") and not is_on_floor() and is_on_wall():
		is_climbing = !is_climbing  # Toggle climb mode

	# --- Gravity ---
	if not is_climbing:
		velocity.y += GRAVITY * _delta
	else:
		velocity.y = 0  # Freeze vertical movement
		velocity.x = CLIMB_SPEED  # Move right while climbing
		anim.animation = "move_right"
		anim.play()
		anim.flip_h = false

	# --- Exit climb by jumping ---
	if Input.is_action_just_pressed("jump"):
		velocity = Vector2(-SPEED, JUMP_VELOCITY)
		anim.play("jump")
		velocity.y = -1000
		if Input.is_action_pressed("climb"):
			-GRAVITY
			velocity.y = -1000
			anim.play("climb")

	# --- Shooting ---
	if Input.is_action_just_pressed("shoot"):
		shoot()

	# --- Movement Input (ignore if climbing) ---
	if not is_climbing:
		if Input.is_action_just_released("climb"):
			$Sprite.play("climb")
			anim.play("climb")
		if Input.is_action_pressed("right"):
			velocity.x = SPEED
			last_facing_dir = 1
			anim.flip_h = false
			if is_on_floor():
				if Input.is_action_just_released("climb"):
					velocity.y = -1000
					$Sprite.play("climb")
				anim.play("climb")
				if Input.is_action_pressed("jump"):
					anim.play("jump")
					velocity.y = -1000
					if Input.is_action_pressed("left"):
						velocity.x = -SPEED
						last_facing_dir = -1
					anim.flip_h = false
					is_climbing = false
					velocity = Vector2(-SPEED, JUMP_VELOCITY)
				anim.play("jump")
				anim.play("move_right")
				if Input.is_action_pressed("jump"):
					anim.play("jump")
					velocity.y = -1000
		elif Input.is_action_pressed("left"):
			velocity.x = -SPEED
			last_facing_dir = -1
			anim.flip_h = false
			if is_on_floor():
				anim.play("move_left")
		else:
			velocity.x = 0
			if is_on_floor():
				anim.play("Idle")
			anim.flip_h = last_facing_dir == -1

	# --- Jump ---
	if is_on_floor() and Input.is_action_just_pressed("jump"):
		velocity.y = JUMP_VELOCITY
		anim.play("jump")
		last_facing_dir = -1
		if Input.is_action_just_released("climb"):
			$Sprite.play("climb")
			anim.play("climb")
			

	# --- Fast Fall ---
	if Input.is_action_just_pressed("down"):
		velocity.y = DOWN_VELOCITY

	# --- Jump Cutoff ---
	if Input.is_action_just_released("jump") and velocity.y < 0:
		velocity.y -1000
		if Input.is_action_just_released("climb"):
			$Sprite.play("climb")
			anim.play("climb")

	# --- Pass to FSM ---
	if current_state:
		current_state.handle_input(_delta)

	move_and_slide()
