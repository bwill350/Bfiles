extends CharacterBody2D
class_name Duke

@export var SPEED = 500.0
@export var JUMP_VELOCITY = -1800.0
@export var DOWN_VELOCITY = 100.0
@export var CLIMB_SPEED = 250.0
const GRAVITY = 5000


@export var health: int = 15
@export var last_facing_dir = 1
@export var is_climbing = false

enum State { IDLE, MOVE, JUMP, CLIMB, SHOOT, FALL }
@export var current_state: State = State.IDLE

@onready var anim: AnimatedSprite2D = $Sprite
@onready var marker: Marker2D = $Marker2D
@onready var hitbox: Area2D = $HitBox
@onready var hit_sound = $HitSound

signal Die
signal health_changed(health)

func _ready():
	add_to_group("player")
	hitbox.area_entered.connect(_on_hitbox_area_entered)

func _process(_delta: float) -> void:
	marker.look_at(get_global_mouse_position())

func _physics_process(delta: float) -> void:
	match current_state:
		State.IDLE:
			handle_idle_state()
		State.MOVE:
			handle_move_state()
		State.JUMP:
			handle_jump_state()
		State.CLIMB:
			handle_climb_state()
		State.SHOOT:
			handle_shoot_state()
		State.FALL:
			handle_fall_state()

	handle_common_inputs()
	move_and_slide()

func handle_idle_state():
	velocity.x = 0
	anim.play("Idle")
	anim.flip_h = last_facing_dir == -1

	if Input.is_action_pressed("left") or Input.is_action_pressed("right"):
		current_state = State.MOVE
	elif Input.is_action_just_pressed("jump") and is_on_floor():
		current_state = State.JUMP
	elif is_on_wall() and Input.is_action_pressed("climb") and not is_on_floor():
		current_state = State.CLIMB
	elif not is_on_floor():
		current_state = State.FALL

func handle_move_state():
	if Input.is_action_pressed("right"):
		velocity.x = SPEED
		last_facing_dir = 1
		anim.play("move_right")
		anim.flip_h = false  # ← Facing right
	elif Input.is_action_pressed("left"):
		velocity.x = -SPEED
		last_facing_dir = -1
		anim.play("move_left")
		
	else:
		current_state = State.IDLE
		return

	if Input.is_action_just_pressed("jump") and is_on_floor():
		current_state = State.JUMP
	elif is_on_wall() and Input.is_action_pressed("climb") and not is_on_floor():
		current_state = State.CLIMB
	elif not is_on_floor():
		current_state = State.FALL

	velocity.y += GRAVITY * get_physics_process_delta_time()

func handle_jump_state():
	velocity.y = JUMP_VELOCITY
	anim.play("jump")
	if Input.is_action_pressed("left"):
		velocity.x = -SPEED
		last_facing_dir = -1
		anim.flip_h = true
	elif Input.is_action_pressed("right"):
		velocity.x = SPEED
		last_facing_dir = 1
		anim.flip_h = false
	else:
		velocity.x = 0
	current_state = State.FALL

func handle_fall_state():
	velocity.y += GRAVITY * get_physics_process_delta_time()

	if is_on_floor():
		current_state = State.IDLE
	elif is_on_wall() and Input.is_action_pressed("climb"):
		current_state = State.CLIMB

	if Input.is_action_pressed("left"):
		velocity.x = -SPEED
		last_facing_dir = -1
		anim.flip_h = true
	elif Input.is_action_pressed("right"):
		velocity.x = SPEED
		last_facing_dir = 1
		anim.flip_h = false
	else:
		velocity.x = 0

func handle_climb_state():
	anim.play("climb")
	velocity.y = -CLIMB_SPEED

	if Input.is_action_pressed("right"):
		velocity.x = SPEED
		last_facing_dir = 1
		anim.flip_h = false
	elif Input.is_action_pressed("left"):
		velocity.x = -SPEED
		last_facing_dir = -1
		anim.flip_h = true
	else:
		velocity.x = 0
		anim.flip_h = last_facing_dir == -1

	if Input.is_action_just_pressed("jump"):
		velocity.y = 1000
		current_state = State.FALL
	elif not is_on_wall() or not Input.is_action_pressed("climb"):
		current_state = State.FALL

func handle_shoot_state():
	shoot()
	current_state = State.IDLE

func handle_common_inputs():
	if Input.is_action_just_pressed("shoot"):
		anim.play("shoot_up")
		shoot()

	if Input.is_action_just_pressed("shoot_up") and is_on_floor():
		anim.play("shoot_up")

	if Input.is_action_just_pressed("down"):
		velocity.y = DOWN_VELOCITY

# ----------------------------------
# Shooting
# ----------------------------------

func shoot():
	var bullet_scene = preload("res://scenes/Bullet.tscn")
	var bullet = bullet_scene.instantiate()
	bullet.global_position = marker.global_position

	var mouse_pos = get_global_mouse_position()
	var direction = (mouse_pos - bullet.global_position).normalized()
	bullet.velocity = direction * bullet.speed
	bullet.look_at(bullet.global_position + bullet.velocity)

	get_tree().current_scene.add_child(bullet)

# ----------------------------------
# Damage Handling
# ----------------------------------

func _on_hitbox_area_entered(area: Area2D) -> void:
	if area.name == "Bat" or area.name == "DeadlyFlower" or area.name == "DeadlyFlowerBullet" or area.is_in_group("enemies"):
		take_damage(5)

func take_damage(amount: int):
	health -= amount
	emit_signal("health_changed", health)
	print("Duke took damage! Health now: ", health)
	if hit_sound:
		hit_sound.play()
	flash_red()
	if health <= 0:
		emit_signal("Die")
		die()

func flash_red():
	$Sprite.modulate = Color(1, 0.2, 0.2)
	await get_tree().create_timer(0.1).timeout
	$Sprite.modulate = Color(1, 1, 1)

func die():
	print("Duke has died.")
	queue_free()
