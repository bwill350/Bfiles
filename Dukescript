extends CharacterBody2D
class_name Duke

@export var SPEED = 500.0
@export var JUMP_VELOCITY = -1800.0
@export var DOWN_VELOCITY = 100.0
@export var CLIMB_SPEED = 250.0
const GRAVITY = 5000

var health: int = 15
var current_state
var last_facing_dir = 1
var is_climbing = false
var invincible = false
var invincible_time = 1.0

@onready var anim: AnimatedSprite2D = $Sprite
@onready var state_label = $StateLabel
@onready var marker: Marker2D = $Marker2D
@onready var hitbox: Area2D = $HitBox
@onready var hit_sound = $HitSound

signal Die
signal health_changed(health)

func _ready():
	add_to_group("player")
	hitbox.area_entered.connect(_on_hitbox_area_entered)

func change_state(new_state_name: String):
	if current_state:
		current_state.exit_state()
	current_state = get_node(new_state_name)
	if current_state:
		current_state.enter_state(self)

func shoot():
	var bullet_scene = preload("res://scenes/Bullet.tscn")
	var bullet = bullet_scene.instantiate()
	bullet.global_position = marker.global_position

	var mouse_pos = get_global_mouse_position()
	var direction = (mouse_pos - bullet.global_position).normalized()
	bullet.velocity = direction * bullet.speed
	bullet.look_at(bullet.global_position + bullet.velocity)

	get_tree().current_scene.add_child(bullet)

func shoot_up():
	if is_on_wall():
		if Input.is_action_just_pressed("shoot_up"):
			anim.play("shoot_up")
			velocity.y = 0
		anim.flip_h = last_facing_dir == -1

func _process(_delta: float) -> void:
	marker.look_at(get_global_mouse_position())

func _physics_process(delta: float) -> void:
	var on_wall = is_on_wall()
	var climb_pressed = Input.is_action_pressed("climb")

	if climb_pressed and not is_on_floor() and on_wall:
		is_climbing = true
	else:
		if not climb_pressed:
			is_climbing = false

	if is_climbing:
		velocity.y = -CLIMB_SPEED
		if Input.is_action_pressed("right"):
			velocity.x = SPEED
			last_facing_dir = 1
			anim.play("climb")
			anim.flip_h = false
		elif Input.is_action_pressed("left"):
			velocity.x = -SPEED
			last_facing_dir = -1
			anim.play("climb")
			anim.flip_h = true
		else:
			velocity.x = 0
			anim.play("climb")
			anim.flip_h = last_facing_dir == -1
	else:
		velocity.y += GRAVITY * delta

		if Input.is_action_pressed("right"):
			velocity.x = SPEED
			last_facing_dir = 1
			if is_on_floor():
				anim.play("move_right")
			anim.flip_h = false
		elif Input.is_action_pressed("left"):
			velocity.x = -SPEED
			last_facing_dir = -1
			if is_on_floor():
				anim.play("move_left")
			anim.flip_h = false
		else:
			shoot_up()
			velocity.x = 0
			if is_on_floor():
				$Sprite.play("shoot_up")
				anim.play("Idle")
				anim.flip_h = last_facing_dir == -1

	if Input.is_action_pressed("shoot_up") and is_on_floor():
		if Input.is_action_just_pressed("shoot_up"):
			$Sprite.play("shoot_up")

	if Input.is_action_just_pressed("jump") and is_on_floor():
		shoot_up()
		velocity.y = JUMP_VELOCITY
		anim.play("jump")
		if Input.is_action_just_pressed("shoot_up"):
			$Sprite.play("shoot_up")
		
	if is_climbing and Input.is_action_just_pressed("jump"):
		velocity.y = 1000
		is_climbing = false
		anim.play("jump")
		$Sprite.play("jump")

	if Input.is_action_just_pressed("shoot"):
		shoot()

	if Input.is_action_just_pressed("down"):
		velocity.y = DOWN_VELOCITY

	if current_state:
		current_state.handle_input(delta)
		$Sprite.play("shoot_up")

	move_and_slide()

# ----------------------------------
# Damage Handling
# ----------------------------------

func _on_hitbox_area_entered(area: Area2D) -> void:
	if area.name == "Bat" or area.name == "DeadlyFlower" or area.name == "DeadlyFlowerBullet" or area.is_in_group("enemies"):
		take_damage(5)

func take_damage(amount: int):
	if invincible:
		return
	health -= amount
	emit_signal("health_changed", health)
	print("Duke took damage! Health now: ", health)

	if hit_sound:
		hit_sound.play()

	flash_red()
	invincible = true
	await get_tree().create_timer(invincible_time).timeout
	invincible = false

	if health <= 0:
		emit_signal("Die")
		die()

func flash_red():
	$Sprite.modulate = Color(1, 0.2, 0.2)
	await get_tree().create_timer(0.1).timeout
	$Sprite.modulate = Color(1, 1, 1)

func die():
	print("Duke has died.")
	queue_free()
