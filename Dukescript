extends CharacterBody2D

@export var SPEED = 500.0
@export var JUMP_VELOCITY = -1300.0
@export var DOWN_VELOCITY = 100.0
@export var CLIMB_SPEED = 250.0
const GRAVITY = 5000

@onready var anim: AnimatedSprite2D = $Sprite
@onready var state_label = $StateLabel
@onready var marker: Marker2D = $Marker2D  # Bullet spawn point & aimer

var current_state
var last_facing_dir = 1
var is_climbing = false

func change_state(new_state_name: String):
	if current_state:
		current_state.exit_state()
	current_state = get_node(new_state_name)
	if current_state:
		current_state.enter_state(self)

func shoot():
	var bullet_scene = preload("res://scenes/Bullet.tscn")
	var bullet = bullet_scene.instantiate()
	
	bullet.global_position = marker.global_position
	
	var mouse_pos = get_global_mouse_position()
	var direction = (mouse_pos - bullet.global_position).normalized()
	bullet.velocity = direction * bullet.speed
	bullet.look_at(bullet.global_position + bullet.velocity)
	
	get_tree().current_scene.add_child(bullet)

func _process(delta: float) -> void:
	# Make marker aim at mouse
	marker.look_at(get_global_mouse_position())

func _physics_process(delta: float) -> void:
	# --- Climbing toggle ---
	var on_wall = is_on_wall()
	var climb_pressed = Input.is_action_pressed("climb")
	if climb_pressed and not is_on_floor() and on_wall:
		is_climbing = true
	else:
		if not climb_pressed:
			is_climbing = false

	# --- Gravity ---
	if not is_climbing:
		velocity.y += GRAVITY * delta
	else:
		velocity.y = -CLIMB_SPEED  # Climb upward while holding climb

		# Allow left/right input while climbing
		if Input.is_action_pressed("right"):
			velocity.x = SPEED
			last_facing_dir = 1
			anim.play("climb")
			anim.flip_h = false
		elif Input.is_action_pressed("left"):
			velocity.x = -SPEED
			last_facing_dir = -1
			anim.play("climb")
			anim.flip_h = true
		else:
			velocity.x = 0
			anim.play("climb")
			anim.flip_h = last_facing_dir == -1

	# --- Movement Input (only if not climbing) ---
	if not is_climbing:
		if Input.is_action_just_pressed("jump") and not is_on_floor():
			velocity.y = JUMP_VELOCITY
			velocity.x = SPEED * last_facing_dir  # Jump in facing direction
			anim.play("jump")
		if Input.is_action_pressed("right"):
			velocity.x = SPEED
			last_facing_dir = 1
			anim.play("move_right")
			anim.flip_h = false
		elif Input.is_action_pressed("left"):
			velocity.x = -SPEED
			last_facing_dir = -1
			anim.play("move_left")
			anim.flip_h = false
		else:
			velocity.x = 0
			if is_on_floor():
				anim.play("Idle")
				anim.flip_h = last_facing_dir == -1  # Keep facing last direction

	# --- Jumping ---
	if Input.is_action_just_pressed("jump") and is_on_floor():
		velocity.y = JUMP_VELOCITY
		velocity.x = SPEED * last_facing_dir  # Jump in facing direction
		anim.play("jump")

	# --- Exit climbing with jump ---
	if is_climbing and Input.is_action_just_pressed("jump"):
		velocity.y = 1000  # Fall quickly to ground
		is_climbing = false
		anim.play("jump")
		$Sprite.play("jump")

	# --- Shooting ---
	if Input.is_action_just_pressed("shoot"):
		shoot()

	# --- Fast fall ---
	if Input.is_action_just_pressed("down"):
		velocity.y = DOWN_VELOCITY

	# --- Short hop ---
	if Input.is_action_just_released("jump") and velocity.y < 0:
		velocity.y *= 0.5  # Cut upward velocity

	# FSM state logic
	if current_state:
		current_state.handle_input(delta)

	move_and_slide()
