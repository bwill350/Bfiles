extends Area2D
class_name GrabAttack

var owner_character: CharacterBody2D
var grabbed := false

@export var damage := 3


func _ready():

	area_entered.connect(_on_area_entered)

	await get_tree().create_timer(0.5).timeout
	queue_free()



func _on_area_entered(area):

	if grabbed:
		return

	if not area.is_in_group("HurtBox"):
		return

	if owner_character == null:
		return


	var enemy = area.get_parent()


	if enemy == owner_character:
		return

	if not enemy.is_in_group("Fighter"):
		return

	if not enemy.has_method("take_damage"):
		return


	grabbed = true


	# save enemy
	owner_character.grabbed_enemy = enemy
	owner_character.is_grabbing = true


	# freeze enemy
	enemy.action_locked = true
	enemy.is_attacking = false
	enemy.is_hurting = true
	enemy.velocity = Vector2.ZERO


	queue_free()
