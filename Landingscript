# FSM - Landing State
extends PlayerState

var landing_timer := 0.2  # Duration of landing pause
var elapsed_time := 0.0

func enter_state(player_node):
	print("Entered Landing State")
	super(player_node)
	player.velocity.x = 0  # Stop horizontal motion
	player.anim.animation = "land"
	player.anim.play()
	elapsed_time = 0.0

func physics_update(delta):
	elapsed_time += delta

	# Wait for the landing animation or pause duration to finish
	if elapsed_time >= landing_timer:
		# Automatically transition based on input
		if Input.is_action_pressed("left") or Input.is_action_pressed("right"):
			player.change_state("Moving")
		else:
			player.change_state("Idle")

func handle_input(_delta):
	# Optional: You can ignore inputs during landing if desired
	pass
