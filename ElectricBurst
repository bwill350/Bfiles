extends Area2D

var damage_done := false
var owner_character = null
@export var damage := 1

func _ready():
	add_to_group("ElectricForceHurtBox")

	# optional but useful if you are filtering by attacker type elsewhere
	add_to_group("RaidenAttack")
	add_to_group("ElectricAttack")

	area_entered.connect(_on_area_entered)

func _on_area_entered(area):
	print("Area:", area.name)
	print("Parent:", area.get_parent().name)

	var enemy = area.get_parent()

	print("Enemy:", enemy)
	print("Owner:", owner_character)

	if enemy == owner_character:
		print("IGNORED OWNER")
		return

	if enemy and enemy.has_method("take_damage"):
		print("DAMAGING:", enemy.name)
		enemy.take_damage(1)
		damage_done = true
