extends Area2D

@export var damage := 1

func _ready():
	add_to_group("ElectricForceHurtBox")

	# optional but useful if you are filtering by attacker type elsewhere
	add_to_group("RaidenAttack")
	add_to_group("ElectricAttack")

	area_entered.connect(_on_area_entered)

func _on_area_entered(area):

	if area == null:
		return

	var parent = area.get_parent()
	if parent == null:
		return

	# ---------------- SPECIFIC GROUP CHECKS ----------------

	if area.is_in_group("HurtBox"):
		parent.take_damage(damage)
		return

	# ---------------- ATTACKS (optional safety layer) ----------------
	if area.is_in_group("ReptileAttack"):
		parent.take_damage(damage)
		return

	if area.is_in_group("SubzeroAttack"):
		parent.take_damage(damage)
		return

	if area.is_in_group("RaidenAttack"):
		return

	# ---------------- FALLBACK ----------------
	if parent.has_method("take_damage"):
		parent.take_damage(damage)
