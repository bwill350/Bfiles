extends Area2D
class_name SonyaBullet

@export var speed: float = 900.0
@export var lifetime: float = 3.0
@export var damage: int = 1
@export var stun_time: float = 0.5

var velocity: Vector2 = Vector2.ZERO
var has_hit := false

@onready var sprite: AnimatedSprite2D = $Sprite


func _ready():
	add_to_group("SonyaBullet")

	# WAIT 1 FRAME so velocity is valid
	await get_tree().process_frame

	_update_flip()

	area_entered.connect(_on_area_entered)

	await get_tree().create_timer(lifetime).timeout
	if is_instance_valid(self):
		queue_free()


func _physics_process(delta):
	global_position += velocity * delta


func _update_flip():
	# LEFT = flip, RIGHT = normal
	sprite.flip_h = velocity.x < 0


func _on_area_entered(area):

	if has_hit:
		return

	if area.is_in_group("SonyaBullet"):
		return

	var fighter = area.get_parent()

	if fighter == null:
		return

	if not fighter.is_in_group("Fighter"):
		return

	if fighter.is_in_group("Sonya"):
		return

	has_hit = true

	if fighter.has_method("take_damage"):
		fighter.take_damage(damage)

	if fighter.has_method("apply_stun"):
		fighter.apply_stun(stun_time)

	queue_free()
