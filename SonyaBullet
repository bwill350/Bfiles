extends Area2D
class_name SonyaBullet

@export var speed: float = 900.0
@export var damage: int = 1
@export var lifetime: float = 3.0

var velocity: Vector2 = Vector2.ZERO
var has_hit := false

@onready var sprite: AnimatedSprite2D = $Sprite


func _ready():

	if sprite:
		sprite.play("SonyaBullet")

	add_to_group("SonyaBullet")

	area_entered.connect(_on_area_entered)

	# safety: always move forward even if spawn forgot velocity
	if velocity == Vector2.ZERO:
		velocity = Vector2.RIGHT * speed

	await get_tree().create_timer(lifetime).timeout
	queue_free()


func _physics_process(delta):
	global_position += velocity * delta


func _on_area_entered(area: Area2D) -> void:

	if has_hit:
		return

	# ignore self bullets
	if area.is_in_group("SonyaBullet"):
		return

	# OPTIONAL: ignore other bullets
	if area.is_in_group("SubzeroBullet") or area.is_in_group("ReptileBullet"):
		return

	# apply hit once then remove
	has_hit = true
	queue_free()
