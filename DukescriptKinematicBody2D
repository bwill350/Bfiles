extends KinematicBody2D
class_name Player

signal died

const RUNSPEED = 400
const SPEED = 1200
const JUMPFORCE = -1000
const GRAVITY = 200
const BULLET = preload("res://Bullet.tscn")
const WALL_JUMP_FORCE = Vector2(1000, -1000)

var hud
var hp = 5
var coins = 0
var velocity = Vector2.ZERO
var facing_right = true
var facing_left = true

func _ready():
	loadhearts()

func _physics_process(delta):
	handle_input()
	apply_gravity(delta)
	velocity = move_and_slide(velocity, Vector2.UP)
	update_animation()

func handle_input():
	var direction = Input.get_axis("move_left", "move_right")
	if direction != 0:
		facing_right = direction > 0
		facing_left = direction > 0
		velocity.x = direction * SPEED
	else:
		velocity.x = 0

	if Input.is_action_just_pressed("jump") and is_on_floor():
		jump()

	if Input.is_action_pressed("climb"):
		climb()

	if Input.is_action_just_pressed("shoot_up"):
		shoot_up()
	elif Input.is_action_just_pressed("shoot_left"):
		facing_right = false
		shoot_left()
	elif Input.is_action_just_pressed("shoot_right"):
		facing_right = true
		shoot_right()
	elif Input.is_action_just_pressed("shoot"):
		facing_right = true
		shoot()

func apply_gravity(delta):
	if Input.is_action_pressed("climb"):
		velocity.y = -GRAVITY
	elif not is_on_floor():
		if not Input.is_action_pressed("jump"):
			velocity.y = GRAVITY
		else:
			velocity.y = -GRAVITY
	else:
		velocity.y = 0

func update_animation():
	if Input.is_action_pressed("climb") and not is_on_floor():
		$Sprite.play("climb")
	elif not is_on_floor():
		$Sprite.play("jump")
	elif abs(velocity.x) > 10:
		if facing_right:
			$Sprite.play("move_right")
		else:
			$Sprite.play("move_left")
	elif Input.is_action_pressed("shoot_up"):
		$Sprite.play("shoot_up")
	elif Input.is_action_pressed("shoot_left"):
		$Sprite.play("shoot_left")
	elif Input.is_action_pressed("shoot_right"):
		$Sprite.play("shoot_right")
	else:
		if facing_right:
			$Sprite.play("idle")
		else:
			$Sprite.play("idle_left")

func jump():
	velocity.y = JUMPFORCE

func wall_jump():
	for i in range(get_slide_count()):
		var collision = get_slide_collision(i)
		if collision.normal.x != 0:
			var wall_dir = collision.normal.x
			velocity.x = wall_dir * WALL_JUMP_FORCE.x
			velocity.y = WALL_JUMP_FORCE.y
			facing_right = wall_dir < 0
			break

func climb():
	$Sprite.play("climb")
	var direction = Input.get_axis("move_left", "move_right")
	if direction != 0:
		velocity.x = direction * SPEED
	velocity.y = -GRAVITY

func shoot():
	var bullet = BULLET.instance()
	bullet.global_position = $FirePoint.global_position
	bullet.velocity = Vector2.RIGHT * bullet.speed
	bullet.rotation = bullet.velocity.angle()
	get_tree().current_scene.add_child(bullet)
	$Sprite.play("shoot_right")

func shoot_up():
	var bullet = BULLET.instance()
	bullet.global_position = $FirePoint.global_position
	bullet.velocity = Vector2.UP * bullet.speed
	bullet.rotation = bullet.velocity.angle()
	get_tree().current_scene.add_child(bullet)
	$Sprite.play("shoot_up")

func shoot_down():
	var bullet = BULLET.instance()
	bullet.global_position = $FirePoint.global_position
	bullet.velocity = Vector2.DOWN * bullet.speed
	bullet.rotation = bullet.velocity.angle()
	get_tree().current_scene.add_child(bullet)
	$Sprite.play("shoot_down")

func shoot_left():
	var bullet = BULLET.instance()
	bullet.global_position = $FirePoint.global_position
	bullet.velocity = Vector2.LEFT * bullet.speed
	bullet.rotation = bullet.velocity.angle()
	get_tree().current_scene.add_child(bullet)
	$Sprite.play("shoot_left")

func shoot_right():
	var bullet = BULLET.instance()
	bullet.global_position = $FirePoint.global_position
	bullet.velocity = Vector2.RIGHT * bullet.speed
	bullet.rotation = bullet.velocity.angle()
	get_tree().current_scene.add_child(bullet)
	$Sprite.play("shoot_right")

func take_damage(damage):
	if hp <= 0:
		return
	hp -= damage
	ouch()
	loadhearts()
	if hp <= 0:
		died()

func ouch():
	set_modulate(Color(1, 0.3, 0.3, 0.3))

func died():
	$Sprite.play("death")
	$AnimationPlayer.play("death")
	emit_signal("died")
	$GameOver.play()
	$Timer.start()

func loadhearts():
	$"../HUD/Playerhearts".rect_size.x = hp % 3

func _on_player_body_entered(body):
	if body.is_in_group("enemies"):
		take_damage(1)

func _on_player_area_entered(area):
	if area.is_in_group("eyeleft") or area.is_in_group("Boss"):
		take_damage(1)
	elif area.is_in_group("door"):
		get_tree().change_scene("res://YouWin.tscn")

func _on_Timer_timeout():
	get_tree().change_scene("res://GameOver.tscn")
