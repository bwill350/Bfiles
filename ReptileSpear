extends Area2D
class_name ReptileSpear

@export var lifetime: float = 3.0
@export var speed := 2000.0

var velocity := Vector2.ZERO
var owner_character = null
var hit := false
var hit_lock := false


func _ready():
	add_to_group("ReptileSpear")
	area_entered.connect(_on_area_entered)

	# auto delete after lifetime
	await get_tree().create_timer(lifetime).timeout
	if is_instance_valid(self):
		queue_free()


func _physics_process(delta):
	position += velocity * delta


func _on_area_entered(area: Area2D) -> void:

	if hit or hit_lock:
		return

	if area == null:
		return

	# safer than get_parent()
	var enemy = area.owner if area.owner != null else area.get_parent()

	if enemy == null:
		return

	if enemy == owner_character:
		return

	if not enemy.is_in_group("Fighter"):
		return

	hit = true
	hit_lock = true

	# stop spear immediately
	velocity = Vector2.ZERO

	# apply pull logic
	if enemy.has_method("spear_pulled_to_p1"):
		enemy.spear_pulled_to_p1()

	# optional extra callback
	if enemy.has_method("take_damage"):
		enemy.take_damage(1)

	queue_free()
