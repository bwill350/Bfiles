extends Control

@onready var difficulty_btn = $DifficultyButton
@onready var difficulty_label = $DifficultyLabel

@onready var coolstuff_btn = $CoolStuffButton
@onready var coolstuff_label = $CoolStuffLabel

var difficulty_clicks := 0


func _ready():

	difficulty_btn.pressed.connect(_on_difficulty_pressed)
	coolstuff_btn.pressed.connect(_on_cool_pressed)

	_update_difficulty()
	_update_coolstuff()


# ---------------- DIFFICULTY (1 click = Easy, 2 clicks = Hard) ----------------
func _on_difficulty_pressed():

	difficulty_clicks += 1

	if difficulty_clicks == 1:
		Game.difficulty = "Easy"
	elif difficulty_clicks == 2:
		Game.difficulty = "Hard"
	else:
		difficulty_clicks = 0
		Game.difficulty = "Easy"

	_update_difficulty()


func _update_difficulty():

	difficulty_label.text = "Difficulty: " + Game.difficulty
	difficulty_btn.text = "Click 2x for Hard" if Game.difficulty == "Easy" else "Click 1x for Easy"


# ---------------- COOL STUFF ----------------
func _on_cool_pressed():

	Game.cool_stuff = !Game.cool_stuff
	_update_coolstuff()


func _update_coolstuff():

	coolstuff_label.text = "Cool Stuff: " + ("ON" if Game.cool_stuff else "OFF")
	coolstuff_btn.text = "Disable" if Game.cool_stuff else "Enable"
