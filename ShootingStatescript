# FSM - Shoot State
extends PlayerState

var shoot_finished := false

func enter_state(player_node):
	print("Entered Shoot State")
	super(player_node)
	player.velocity.x = 0
	player.anim.animation = "shoot"
	player.anim.play()
	shoot_finished = false

	# Connect animation finished signal
	if not player.anim.is_connected("animation_finished", self, "_on_animation_finished"):
		player.anim.connect("animation_finished", self, "_on_animation_finished")

	# Spawn bullet
	_spawn_bullet()

func physics_update(delta):
	# Gravity for fall support
	player.velocity.y += player.GRAVITY * delta
	player.velocity.y = min(player.velocity.y, player.MAX_FALL_SPEED)
	player.move_and_slide()

	if not player.is_on_floor():
		player.change_state("Falling")

func handle_input(_delta):
	pass  # Ignore inputs during shooting unless you want cancels

func _on_animation_finished(anim_name):
	if anim_name == "shoot":
		shoot_finished = true
		if player.is_on_floor():
			player.change_state("Idle")
		else:
			player.change_state("Falling")

func _spawn_bullet():
	var bullet_scene = preload("res://Scenes/Bullet.tscn")
	var bullet = bullet_scene.instantiate()

	# Adjust spawn offset relative to player
	var spawn_offset = Vector2(16 * player.facing_direction, -5)
	bullet.global_position = player.global_position + spawn_offset

	# Set bullet direction (you must define this in Bullet.gd)
	bullet.direction = player.facing_direction

	player.get_parent().add_child(bullet)
