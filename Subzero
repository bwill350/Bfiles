func combo_attack(attacks: Array):

	action_locked = true
	is_attacking = true

	for attack in attacks:

		# STOP COMBO IF HIT
		if is_hurting or state == State.DEAD:
			break

		play_anim(attack)
		spawn_attack(attack)

		await sprite.animation_finished

	is_attacking = false
	action_locked = false

	if not is_hurting:
		play_anim("idle")

# ---------------- ATTACK ----------------
func spawn_attack(anim_name: String):

	if anim_name not in [
		"punch",
		"highpunch",
		"lowpunch",
		"kick",
		"highkick",
		"lowkick",
		"uppercut",
		"roundhousekick",
		"knee"
	]:
		return

	var attack = SUBZERO_ATTACK.instantiate()
	get_tree().current_scene.add_child(attack)

	attack.add_to_group("HitBox")
	attack.global_position = attack_marker.global_position
	attack.scale.x = facing

	var dmg := 1

	match anim_name:
		"punch":
			dmg = 1
		"highpunch":
			dmg = 1
		"lowpunch":
			dmg = 1
		"kick":
			dmg = 1
		"highkick":
			dmg = 1
		"lowkick":
			dmg = 1
		"uppercut":
			dmg = 1
		"roundhousekick":
			dmg = 1
		"knee":
			dmg = 1

	attack.damage = dmg

	# IMPORTANT
	attack.attack_owner = self
	attack.attack_name = anim_name
	attack.attack_type = anim_name

# ---------------- SHOOT ----------------
func shoot_player():
	if is_shooting:
		return
	is_shooting = true
	is_attacking = true
	action_locked = true

	play_anim("shoot")

	var bullet_scene: PackedScene = BULLET_SCENE

	if special_bullet != null:
		bullet_scene = special_bullet
		special_bullet = null   # use the special bullet once

	var bullet = bullet_scene.instantiate()
	get_tree().current_scene.add_child(bullet)

	bullet.global_position = $Subzeroshoot.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	await get_tree().create_timer(0.25).timeout

	is_shooting = false
	is_attacking = false
	action_locked = false

# ---------------- DAMAGE ----------------
func take_damage(amount: int):

	# ALREADY DEAD / INVINCIBLE
	if state == State.DEAD:
		return

	if is_hurting:
		return

	if not can_take_damage:
		return

	if spawn_protection:
		return

	can_take_damage = false

	# hit cooldown
	await get_tree().create_timer(0.25).timeout

	can_take_damage = true


	# BLOCK REDUCTION
	if is_blocking:
		amount = max(amount - 1, 0)

	if amount <= 0:
		return


	health -= amount
	health = max(health, 0)

	print("Reptile HP:", health)

	health_changed.emit(health)
	hit_sound.play()


	# ==========================
	# FINISH HIM STATE
	# ==========================
	if health == 1 and Game.current_round == 2 and not is_finish_state:
		trigger_finish_state()
		return

	# ==========================
	# DEAD
	# ==========================
	if health <= 0:
		is_attacking = false
		die()
		return

	# ==========================
	# NORMAL HIT
	# ==========================
	is_hurting = true
	hurt_locked = true
	action_locked = true

	combo.clear()

	is_attacking = false
	is_shooting = false
	is_blocking = false

	state = State.IDLE

	play_anim("hurt")

	if has_node("BloodMarker"):
		var blood = BLOOD_EFFECT.instantiate()
		get_tree().current_scene.add_child(blood)
		blood.global_position = $BloodMarker.global_position

	await get_tree().create_timer(0.25).timeout

	is_hurting = false
	hurt_locked = false
	action_locked = false

func trigger_finish_state():

	if is_finish_state:
		return

	is_finish_state = true

	state = State.IDLE

	# force them to fall back down
	velocity.x = 0
	velocity.y = 0

	action_locked = true
	hurt_locked = false
	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

	# cancel any uppercut/fly state
	set_meta("uppercut_launched", false)

	play_anim("idle")

	finish_label.visible = true

	if finish_label.has_method("start_flicker"):
		finish_label.start_flicker(2.0, 0.05)

	# let gravity work
	await get_tree().create_timer(0.1).timeout

	while not is_on_floor():
		velocity.y += 5000.0 * get_physics_process_delta_time()
		move_and_slide()
		await get_tree().physics_frame

	velocity = Vector2.ZERO

	await get_tree().create_timer(2.0).timeout

	if is_instance_valid(finish_label):
		finish_label.visible = false

func die():

	if state == State.DEAD:
		return

	# =====================================================
	# LOCK SUBZERO AS DEAD
	# =====================================================

	state = State.DEAD

	velocity = Vector2.ZERO
	is_attacking = false
	is_shooting = false
	action_locked = true
	hurt_locked = true
	is_hurting = false
	is_blocking = false
	can_take_damage = false

	stunned = false
	is_pulled = false
	is_spear_pulled = false
	pull_target = null
	pull_timer = 0.0
	knockback_x = 0.0
	uppercut_launched = false
	hurt_cooldown = false

	# IMPORTANT:
	# Finish Him is NOT handled here.
	# It only happens in take_damage() when:
	# health == 1 AND Game.current_round == 2.


	# =====================================================
	# HIDE NORMAL SPRITE
	# =====================================================

	$Sprite.visible = false
	$Crispy.visible = true


	# =====================================================
	# ROUND 1 DEATH
	# START ROUND 2
	# =====================================================

	if Game.current_round == 1:

		# -------------------------------------------------
		# TELL LEVEL1 WHO WON ROUND 1
		# -------------------------------------------------

		if is_in_group("player1"):
			round_death.emit("cpu")
		else:
			round_death.emit("player1")


		# -------------------------------------------------
		# WAIT BEFORE ROUND 2
		# -------------------------------------------------

		await get_tree().create_timer(3.0).timeout


		# -------------------------------------------------
		# CHANGE TO ROUND 2
		# -------------------------------------------------

		Game.current_round = 2


		# =================================================
		# FIND PLAYER 1
		# =================================================

		var p1 = get_tree().get_first_node_in_group("player1")


		# =================================================
		# FIND PLAYER 2 / CPU
		# =================================================

		var p2 = get_tree().get_first_node_in_group("enemy")


		# =================================================
		# RESET PLAYER 1
		# =================================================

		if p1 != null and is_instance_valid(p1):

			p1.global_position = Vector2(603, 496)

			p1.health = 10

			p1.velocity = Vector2.ZERO

			p1.state = p1.State.IDLE

			p1.is_hurting = false
			p1.is_attacking = false
			p1.is_shooting = false
			p1.action_locked = false
			p1.hurt_locked = false
			p1.can_take_damage = true
			p1.is_blocking = false

			if "is_finish_state" in p1:
				p1.is_finish_state = false

			if p1.has_node("Sprite"):
				p1.get_node("Sprite").visible = true

			if p1.has_node("Crispy"):
				p1.get_node("Crispy").visible = false

			if p1.has_signal("health_changed"):
				p1.health_changed.emit(10)

			if p1.has_method("play_anim"):
				p1.play_anim("idle")


		# =================================================
		# RESET PLAYER 2
		# =================================================

		if p2 != null and is_instance_valid(p2):

			p2.global_position = Vector2(1890, 496)

			p2.health = 10

			p2.velocity = Vector2.ZERO

			p2.state = p2.State.IDLE

			p2.is_hurting = false
			p2.is_attacking = false
			p2.is_shooting = false
			p2.action_locked = false
			p2.hurt_locked = false
			p2.can_take_damage = true
			p2.is_blocking = false

			if "is_finish_state" in p2:
				p2.is_finish_state = false

			if p2.has_node("Sprite"):
				p2.get_node("Sprite").visible = true

			if p2.has_node("Crispy"):
				p2.get_node("Crispy").visible = false

			if p2.has_signal("health_changed"):
				p2.health_changed.emit(10)

			if p2.has_method("play_anim"):
				p2.play_anim("idle")


		# =================================================
		# RESET THIS SUBZERO
		# =================================================

		health = 10
		max_health = 10

		global_position = Vector2(1890, 496)

		velocity = Vector2.ZERO

		state = State.IDLE

		is_hurting = false
		is_attacking = false
		is_shooting = false
		action_locked = false
		hurt_locked = false
		can_take_damage = true
		is_blocking = false

		stunned = false
		is_pulled = false
		is_spear_pulled = false
		pull_target = null
		pull_timer = 0.0

		knockback_x = 0.0
		uppercut_launched = false
		hurt_cooldown = false
		run_locked = false

		is_finish_state = false
		spawn_protection = false

		combo.clear()
		combo_timer = 0.0
		ai_timer = randf_range(0.2, 0.6)

		# Make sure Finish Him is hidden
		if is_instance_valid(finish_label):
			finish_label.visible = false


		# Show normal Sub-Zero

		$Sprite.visible = true
		$Crispy.visible = false

		health_changed.emit(10)

		play_anim("idle")


		# =================================================
		# RESET HUD
		# =================================================

		var hud = get_tree().get_first_node_in_group("HUD")

		if hud != null and is_instance_valid(hud):

			if hud.has_method("_find_fighters"):
				hud._find_fighters()

			if hud.has_method("reset_all_health_bars"):
				hud.reset_all_health_bars()

			if hud.has_node("SubzeroHealthBar"):
				hud.get_node("SubzeroHealthBar").value = 10

			if hud.has_node("DukeHealthBar"):
				hud.get_node("DukeHealthBar").value = 10

			if hud.has_node("ReptileHealthBar"):
				hud.get_node("ReptileHealthBar").value = 10

			if hud.has_method("show_round"):
				hud.show_round(2)


		# =================================================
		# ROUND 2 STARTED
		# =================================================

		return


	# =====================================================
	# ROUND 2 DEATH
	# FINAL DEATH / MATCH OVER
	# =====================================================

	if Game.current_round == 2:

		# IMPORTANT:
		# At this point health is 0.
		# Finish Him has already happened earlier
		# when health reached exactly 1.
		# DO NOT SHOW FINISH HIM HERE.


		# -------------------------------------------------
		# BLOOD EFFECT
		# -------------------------------------------------

		var blood = BLOOD_DEATH.instantiate()

		get_tree().current_scene.add_child(blood)

		blood.global_position = global_position


		# -------------------------------------------------
		# FINAL DEATH SPRITE
		# -------------------------------------------------

		$Sprite.visible = false
		$Crispy.visible = true


		# -------------------------------------------------
		# MAKE SURE FINISH LABEL IS NOT RE-TRIGGERED
		# -------------------------------------------------

		if is_instance_valid(finish_label):
			finish_label.visible = false


		# -------------------------------------------------
		# WAIT FOR FATALITY
		# -------------------------------------------------

		await get_tree().create_timer(3.0).timeout


		# =================================================
		# FINAL MATCH RESULT
		# =================================================

		if is_in_group("player1"):
			round_death.emit("cpu")
		else:
			round_death.emit("player1")

		return

func spawn_fx(scene: PackedScene):

	var fx = scene.instantiate()

	# IMPORTANT: set owner BEFORE it can collide
	fx.owner_character = self
	fx.damage_done = false

	get_tree().current_scene.call_deferred("add_child", fx)

	await get_tree().process_frame

	if target and is_instance_valid(target):
		fx.global_position = target.global_position + Vector2(60 * facing, 0)
	else:
		fx.global_position = global_position + Vector2(80 * facing, 0)

# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):

	if current_anim == anim_name and sprite.is_playing():
		return

	current_anim = anim_name
	sprite.play(anim_name)

func _on_subzero_hurt_box_area_entered(area: Area2D) -> void:
	print("Subzero hit by:", area.name)
	print(area.get_groups())
	if hurt_cooldown:
		return

	if area == null or !is_instance_valid(area):
		return

	if not can_take_damage:
		return

	if area.get("attack_name") and area.attack_name == "uppercut":
		$Sprite.play("wasuppercut")
	else:
		$Sprite.play("hurt")

	$Hurt.play()


	if area.is_in_group("HitBox") \
		or area.is_in_group("ReptileAcid") \
		or area.is_in_group("RaidenElectricBullet") \
		or area.is_in_group("FireBullet") \
		or area.is_in_group("Fireball") \
		or area.is_in_group("SonyaBullet") \
		or area.is_in_group("JohnnyCageBullet") \
		or area.is_in_group("KanoBullet") \
		or area.is_in_group("IceBullet") \
		or area.is_in_group("KanoAttack"):

		hurt_cooldown = true

		knockback_x = -facing * 100
		take_damage(1)

		await get_tree().create_timer(0.2).timeout
		hurt_cooldown = false
