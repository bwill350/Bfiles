	call_deferred("emit_health")

	play_anim("idle")

	ai_timer = randf_range(0.2, 0.6)

	facing = 1
	sprite.flip_h = facing > 0
	$Crispy.flip_h = facing > 0

func emit_health():

	health_changed.emit(health)

func run(input_dir: float):
	if input_dir == 0:
		return

	state = State.RUN
	velocity.x = input_dir * SPEED * 4  # faster than walk

	if not is_attacking:
		play_anim("run")

func handle_double_tap_run(input_dir: float, delta: float) -> bool:

	if input_dir == 0:
		return false

	var now := Time.get_ticks_msec() / 1000.0

	if input_dir == last_tap_dir:
		if now - last_tap_time <= tap_time:
			run_locked = true
			return true

	last_tap_time = now
	last_tap_dir = input_dir

	return false

func apply_stun(_duration := 4.0):

	if state == State.DEAD:
		return

	stunned = true

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	velocity = Vector2.ZERO
	knockback_x = 0

	play_anim("idle")

	await get_tree().create_timer(4.0).timeout

	stunned = false

	is_hurting = false
	hurt_locked = false
	action_locked = false

# ---------------- PHYSICS ----------------
func _physics_process(delta):

	if state == State.DEAD:
		return

	# =========================================================
	# SPEAR PULL
	# =========================================================

	if is_pulled:
		run_pull_logic(delta)
		move_and_slide()
		return

	# =========================================================
	# STUN
	# =========================================================

	if stunned:
		velocity = Vector2.ZERO
		return

	# =========================================================
	# GRAVITY
	# =========================================================

	velocity.y += GRAVITY * delta

	# =========================================================
	# UPPERCUT LAUNCH
	# =========================================================

	if was_uppercut:

		move_and_slide()

		if is_on_floor():

			velocity.y = 0
			was_uppercut = false

			if state != State.DEAD:

				is_hurting = false
				hurt_locked = false
				action_locked = false
				is_attacking = false

				state = State.IDLE
				play_anim("idle")

		return

	# =========================================================
	# NORMAL GROUND GRAVITY
	# =========================================================

	if is_on_floor():

		velocity.y = 0

	# =========================================================
	# DEATH / FINISH
	# =========================================================

	if state == State.DEAD:
		return

	if is_finish_state:

		state = State.IDLE
		velocity.x = 0

		if not is_hurting:
			play_anim("idle")

		move_and_slide()
		return

	# =========================================================
	# COOLDOWNS
	# =========================================================

	shoot_cooldown = max(
		shoot_cooldown - delta,
		0.0
	)

	combo_timer += delta

	if combo_timer > combo_reset_time:
		combo.clear()

	# =========================================================
	# CPU
	# =========================================================

	if is_cpu:

		cpu_logic(delta)

		move_and_slide()

		return

	# =========================================================
	# PLAYER CONTROL
	# =========================================================

	if action_locked:
		return

	var input_dir := Input.get_axis(
		"left",
		"right"
	)

	var climb_pressed := Input.is_action_pressed("climb")

	# =========================================================
	# FACING
	# =========================================================
	#
	# IMPORTANT:
	# Only change facing when LEFT or RIGHT is actually pressed.
	#
	# This works while airborne too.
	# =========================================================

	if input_dir != 0:

		facing = input_dir

		sprite.flip_h = facing > 0
		$Crispy.flip_h = facing > 0

		$AttackMarker.position = Vector2(
			0,
			0
		)

		$Subzeroshoot.position = Vector2(
			63 * facing,
			-235
		)

	# =========================================================
	# PLAYER JUMP
	# =========================================================
	#
	# Check jump BEFORE movement state so pressing
	# LEFT/RIGHT in the air does not cancel jump.
	# =========================================================

	if (
		Input.is_action_just_pressed("jump")
		and is_on_floor()
	):

		velocity.y = jump_velocity
		state = State.JUMP
		$Jump.play()

	# =========================================================
	# AIRBORNE
	# =========================================================
	#
	# Once Sub-Zero is in the air, ALWAYS keep JUMP state.
	# Left/right can change facing and horizontal movement,
	# but cannot change the animation to walk/run/idle.
	# =========================================================

	if not is_on_floor():

		velocity.x = input_dir * SPEED

		state = State.JUMP

	# =========================================================
	# GROUND MOVEMENT
	# =========================================================

	else:

		if Input.is_action_pressed("run") and input_dir != 0:

			run(input_dir)

		else:

			velocity.x = input_dir * SPEED

			if input_dir != 0:

				state = State.WALK

			else:

				state = State.IDLE

	# =========================================================
	# ANIMATIONS
	# =========================================================

	match state:

		State.JUMP:

			if not is_attacking:
				play_anim("jump")

		State.WALK:

			if not is_attacking:
				play_anim("walk")

		State.RUN:

			if not is_attacking:
				play_anim("run")

		State.IDLE:

			if not is_attacking:
				play_anim("idle")

	# =========================================================
	# HURT LOCK
	# =========================================================

	if is_hurting and hurt_locked:
		return

	# =========================================================
	# ATTACKS
	# =========================================================

	if Input.is_action_just_pressed("punch"):
		do_action("punch")

	if Input.is_action_just_pressed("highpunch"):
		do_action("highpunch")

	if Input.is_action_just_pressed("lowpunch"):
		do_action("lowpunch")

	elif Input.is_action_just_pressed("roundhousekick"):
		do_action("roundhousekick")

	elif Input.is_action_just_pressed("slidekick"):
		do_action("slidekick")

	elif Input.is_action_pressed("highkick"):
		do_action("highkick")

	elif Input.is_action_just_pressed("lowkick"):
		do_action("lowkick")

	elif Input.is_action_just_pressed("uppercut"):
		do_action("uppercut")

	elif Input.is_action_just_pressed("knee"):
		do_action("knee")

	elif Input.is_action_just_pressed("splat"):
		do_action("splat")

	elif Input.is_action_just_pressed("shoot"):
		shoot_player()

	elif Input.is_action_pressed("block"):
		start_block()

	else:
		stop_block()

	# =========================================================
	# MOVE
	# =========================================================

	move_and_slide() 

func spear_pulled_to_p1():

	is_pulled = true
	stunned = true
	action_locked = true
	is_hurting = true

	pull_timer = 0.35

	pull_target = get_tree().get_first_node_in_group("Reptile")

func run_pull_logic(delta):
	if pull_target == null or !is_instance_valid(pull_target):
		is_pulled = false
		stunned = false
		action_locked = false
		return

	var dir = sign(pull_target.global_position.x - global_position.x)

	velocity.x = dir * 900
	velocity.y = -120

	pull_timer -= delta

	if pull_timer <= 0.0:

		is_pulled = false

		# SNAP to Reptile AttackMarker (THIS IS MK MOMENT)
		global_position = pull_target.attack_marker.global_position + Vector2(40 * pull_target.facing, 0)

		stunned = false
		is_hurting = false
		action_locked = false
		is_attacking = true

		pull_target = null

# ---------------- BLOCK ----------------
func start_block():

	if state == State.DEAD:
		return

	is_blocking = true
	state = State.BLOCK

	play_anim("block")

func stop_block():

	if is_blocking:
		is_blocking = false
		state = State.IDLE

# ---------------- CPU LOGIC ----------------
func cpu_logic(delta):

	# =========================================================
	# DEAD
	# =========================================================
	if state == State.DEAD:
		return

	# =========================================================
	# FINISH HIM
	# =========================================================
	if is_finish_state:
		is_attacking = false
		action_locked = true
		velocity.x = 0
		state = State.IDLE

		if not is_hurting:
			play_anim("idle")

		return

	# =========================================================
	# HURT
	# =========================================================
	if is_hurting:

		velocity.x = knockback_x

		knockback_x = move_toward(
			knockback_x,
			0.0,
			1500.0 * delta
		)

		move_and_slide()

		if abs(knockback_x) > 10.0:
			return

		knockback_x = 0.0
		is_hurting = false
		hurt_locked = false
		is_attacking = false
		is_shooting = false
		action_locked = false

		state = State.IDLE
		play_anim("idle")

		ai_timer = 0.1

		return

	# =========================================================
	# ACTION LOCK
	# =========================================================
	if action_locked:
		velocity.x = 0
		return

	# =========================================================
	# FIND PLAYER 1
	# =========================================================
	if target == null or not is_instance_valid(target):

		target = get_tree().get_first_node_in_group("player1")

		# Backup: find human Fighter
		if target == null or not is_instance_valid(target):

			for node in get_tree().get_nodes_in_group("Fighter"):

				if node == self:
					continue

				if not is_instance_valid(node):
					continue

				if node is Node2D and not node.is_cpu:
					target = node
					break

	# =========================================================
	# NO TARGET
	# =========================================================
	if target == null or not is_instance_valid(target):

		velocity.x = 0
		state = State.IDLE
		play_anim("idle")

		return

# =========================================================
# DISTANCE TO PLAYER 1
# =========================================================
	var dist: float = target.global_position.x - global_position.x
	var distance: float = abs(dist)
	var direction: float = sign(dist)

# =========================================================
# FACE OPPOSITE PLAYER 1
# =========================================================
	if direction != 0:

		# CPU faces opposite the direction of Player 1
		facing = direction

		# Same flip convention used by Sub-Zero's player controls
		sprite.flip_h = facing > 0
		$Crispy.flip_h = facing > 0

		$AttackMarker.position = Vector2(0, 0)
		$Subzeroshoot.position = Vector2(63 * -facing, -211)

	# =========================================================
	# CPU DISTANCES
	# =========================================================
	var attack_range := 110.0
	var stopping_distance := 90.0

	# =========================================================
	# WALK TOWARD PLAYER 1
	# =========================================================
	if distance > stopping_distance:

		velocity.x = direction * SPEED

		state = State.WALK

		if not is_attacking and not is_hurting:
			play_anim("walk")

	else:

		velocity.x = 0

		if not is_attacking and not is_hurting:
			state = State.IDLE
			play_anim("idle")

	# =========================================================
	# AI ATTACK TIMER
	# =========================================================
	ai_timer -= delta

	if ai_timer > 0.0:
		return

	# =========================================================
	# ATTACK ONLY WHEN CLOSE
	# =========================================================
	if (
		distance <= attack_range
		and not is_hurting
		and not is_finish_state
		and not action_locked
		and not is_attacking
	):

		match Game.difficulty:

			# =================================================
			# HARD
			# =================================================
			"Hard":

				ai_timer = randf_range(0.05, 0.15)

				var choice: int = randi() % 100

				if choice < 20:

					do_action("punch")

				elif choice < 35:

					do_action("highpunch")

				elif choice < 45:

					do_action("lowpunch")

				elif choice < 60:

					do_action("slidekick")

				elif choice < 70:

					do_action("highkick")

				elif choice < 80:

					do_action("lowkick")

				elif choice < 88:

					do_action("uppercut")

				elif choice < 94:

					do_action("roundhousekick")

				else:
					shoot_player()

			# =================================================
			# EASY
			# =================================================
			"Easy":

				ai_timer = randf_range(0.5, 0.9)

				var choice: int = randi() % 100

				if choice < 40:

					do_action("punch")

				elif choice < 55:

					do_action("slidekick")

				elif choice < 65:

					do_action("highkick")

				elif choice < 75:

					do_action("lowkick")

				elif choice < 85:

					do_action("uppercut")

				else:
					shoot_player()

# ---------------- ACTION ----------------
func do_action(anim_name: String):

	if is_finish_state:
		return

	if state == State.DEAD:
		return

	if action_locked:
		return

	action_locked = true
	is_attacking = true
	lock_timer = 0.6

	play_anim(anim_name)

	# ---------------- NORMAL ATTACKS ----------------
	if anim_name in [
		"punch",
		"highpunch",
		"lowpunch",
		"kick",
		"highkick",
		"lowkick",
		"slidekick",
		"uppercut",
		"roundhousekick",
		"knee"
	]:
		spawn_attack(anim_name)

	# ---------------- SUBZERO SPECIAL (NO NEW NAME) ----------------
	if has_node("AttackMarker"):
		$AttackMarker.call_deferred("emit_signal", "trigger_attack")

	await sprite.animation_finished

	is_attacking = false
	action_locked = false
	hurt_locked = false

# ---------------- COMBOS ----------------
func register_input(input: String):

	# Add direction to combo buffer
	combo.append(input)

	combo_timer = 0.0

	# Keep only enough inputs for the longest combo
	if combo.size() > ICE_DEATH_TWO_COMBO.size():
		combo.pop_front()

	check_combos()

# ---------------- ICE COMBO ----------------
func ice_combo():

	combo_used.emit("ice")

	special_bullet = BULLET_SCENE
	print("================================")
	print("===========FATALITY=============")
	print("================================")
	combo.clear()
	combo_timer = 0.0

	shoot_player()

func opponent_is_ready_for_fatality() -> bool:

	var opponent: Node = null

	# -------------------------------------------------
	# SUB-ZERO IS PLAYER 1
	# Find the CPU opponent
	# -------------------------------------------------

	if is_in_group("player1"):

		for node in get_tree().get_nodes_in_group("Fighter"):

			if node == self:
				continue

			if not is_instance_valid(node):
				continue

			if node.is_cpu:
				opponent = node
				break

	# -------------------------------------------------
	# SUB-ZERO IS CPU
	# Find Player 1
	# -------------------------------------------------

	else:

		opponent = get_tree().get_first_node_in_group("player1")

	# -------------------------------------------------
	# NO OPPONENT
	# -------------------------------------------------

	if opponent == null or not is_instance_valid(opponent):

		print("FATALITY CHECK: OPPONENT NOT FOUND")
		return false

	# -------------------------------------------------
	# CHECK OPPONENT HEALTH
	# -------------------------------------------------

	if "health" in opponent:

		print("FATALITY CHECK: ", opponent.name)
		print("OPPONENT HEALTH: ", opponent.health)

		return opponent.health <= 1

	return false

# ---------------- CHECK COMBOS ----------------
func check_combos():

# =====================================================
# ICE DEATH TWO
# DOWN -> UP -> DOWN -> UP -> RIGHT
# =====================================================

	if combo == ICE_DEATH_TWO_COMBO:

		print("================================")
		print("ICE DEATH TWO COMBO HIT")
		print("================================")

		# Opponent must be at 1 HP
		if not opponent_is_ready_for_fatality():

			print("================================")
			print("ICE DEATH TWO BLOCKED")
			print("OPPONENT IS NOT AT 1 HP")
			print("================================")

			combo.clear()
			combo_timer = 0.0
			return

		# -------------------------------------------------
		# FATALITY
		# -------------------------------------------------
# Spawn the fatality on the OPPOSITE side
		combo_used.emit("ice_death_two")

		var fx = ICE_DEATHTWO.instantiate()

		get_tree().current_scene.add_child(fx)

		fx.global_position = global_position + Vector2(320 * facing, 0)

		if is_instance_valid(fatality_sound):
			fatality_sound.play()

		print("================================")
		print("======= ICE DEATH TWO ==========")
		print("======== FATALITY ==============")
		print("================================")

		combo.clear()
		combo_timer = 0.0

		return




	# =====================================================
	# PUNCH COMBO
	# =====================================================

	if combo == PUNCH_COMBO:

		combo_used.emit("punch_combo")

		combo.clear()
		combo_timer = 0.0

		start_punch_combo()

		return


	# =====================================================
	# KICK COMBO
	# =====================================================

	if combo == KICK_COMBO:

		combo_used.emit("kick_combo")

		combo.clear()
		combo_timer = 0.0

		start_kick_combo()

		return



func start_punch_combo():

	await combo_attack([
		"punch",
		"lowpunch",
		"punch",
		"uppercut",
		"highpunch",
		"uppercut"
	])

func start_kick_combo():

	if kick_combo_active:
		return

	if action_locked or is_hurting or state == State.DEAD:
		return

	if health <= 1:
		return

	kick_combo_active = true
	can_take_damage = false

	await combo_attack([
		"slidekick",
		"knee",
		"highkick",
		"roundhousekick",
		"lowkick",
		"roundhousekick",
		"highkick"
	])

	# Combo is completely finished
	kick_combo_active = false

	if state != State.DEAD:
		can_take_damage = true

# =========================================================
# COMBO ATTACK
# =========================================================

func combo_attack(attacks: Array):

	action_locked = true
	is_attacking = true

	for attack in attacks:

		# STOP COMBO IF HIT
		if is_hurting or state == State.DEAD:
			break

		play_anim(attack)
		spawn_attack(attack)

		await sprite.animation_finished

	is_attacking = false
	action_locked = false

	if not is_hurting:
		play_anim("idle")

# ---------------- ATTACK ----------------
func spawn_attack(anim_name: String):

	if anim_name not in [
		"punch",
		"highpunch",
		"lowpunch",
		"kick",
		"highkick",
		"lowkick",
		"slidekick",
		"uppercut",
		"roundhousekick",
		"knee"
	]:
