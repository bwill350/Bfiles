extends CharacterBody2D
class_name Subzero

signal health_changed(health)
signal combo_used(combo_name: String)

# ---------------- STATE ----------------
enum State { IDLE, SRUN, SJUMP, SJUMPKICK, SBLOCK, SPUNCH, SCLIMB, DEAD }

var state: State = State.IDLE
var is_finish_state := false

# ---------------- CPU ----------------
var is_cpu := false
var target: Node2D = null
var ai_timer := 0.0

var hit_from_reptileacid := false

@onready var finish_label: Label = get_tree().current_scene.get_node("CanvasLayer/FinishLabel")

# ---------------- COMBAT ----------------
var is_hurting := false
var is_shooting := false
var is_attacking := false
var action_locked := false
var hurt_locked := false

var facing := 1
var current_anim := ""
var lock_timer := 0.0
var health: int
var can_take_damage := true

const BLOOD_EFFECT = preload("res://Bloodeffect.tscn")
const SMOKE_EFFECT = preload("res://SmokeEffect.tscn")
const GRAVITY = 5000

# ---------------- EXPORTS ----------------
@export var SPEED = 900.0
@export var SCLIMB_SPEED = 250.0
@export var max_health: int = 10
@export var sjump_velocity = -1800.0

# ---------------- PRELOADS ----------------
const BULLET_SCENE = preload("res://Projectiles/Subzerobullet.tscn")
const SUBZERO_ATTACK = preload("res://Projectiles/SubzeroAttack.tscn")
const ICE_DEATH = preload("res://Deaths/IceDeath.tscn")
const BLOOD_DEATH = preload("res://Deaths/BloodDeath.tscn")
const SMOKE_DEATH = preload("res://SmokeEffect.tscn")

# ---------------- NODES ----------------
@onready var sprite: AnimatedSprite2D = $Sprite
@onready var hit_sound: AudioStreamPlayer2D = $Hit
@onready var hit_box: Area2D = $SubzeroHurtBox
@onready var shoot_marker: Marker2D = $Subzeroshoot
@onready var attack_marker: Marker2D = $AttackMarker
@onready var blood_marker: Marker2D = $BloodMarker
@onready var smoke_marker: Marker2D = $SmokeMarker

# ---------------- READY ----------------
func _ready():

	action_locked = false
	hurt_locked = false
	is_attacking = false
	is_shooting = false
	is_hurting = false
	hit_from_reptileacid = false
	can_take_damage = true

	lock_timer = 0.0

	state = State.IDLE
	velocity = Vector2.ZERO

	add_to_group("Subzero")
	add_to_group("ElectricDeath")
	add_to_group("IceDeath")
	add_to_group("FireDeath")

	health = max_health
	health_changed.emit(health)

	play_anim("sidle")

	ai_timer = randf_range(0.2, 0.6)
	health_changed.connect(_on_health_changed)

func _on_health_changed(h):

	if h == 1 and not is_finish_state:

		is_finish_state = true

		# HARD RESET COMBAT STATE HERE TOO
		is_attacking = false
		is_shooting = false
		action_locked = true
		hurt_locked = true
		state = State.IDLE
		velocity = Vector2.ZERO

		$HUD/FinishLabel.text = "FINISH HIM"
		$HUD/FinishLabel.visible = true

		await get_tree().create_timer(2.0).timeout

		$HUD/FinishLabel.visible = false
		$HUD/FinishLabel.text = "FINISH HIM"
		$HUD/FinishLabel.visible = true
		$HUD/FinishLabel.start_flicker(2.0, 0.05)


# ---------------- PHYSICS ----------------
func _physics_process(delta):

	if is_finish_state:

		# FULL PHYSICS LOCK (prevents floating / lifting)
		velocity = Vector2.ZERO

		if state != State.DEAD:
			state = State.IDLE
			play_anim("sidle")
		move_and_slide()
		return

	# stop attacking input logic
	if Input.is_action_just_pressed("spunch") \
	or Input.is_action_just_pressed("skick") \
	or Input.is_action_just_pressed("suppercut") \
	or Input.is_action_just_pressed("sshoot"):

		pass
	move_and_slide()

	# ---------------- LOCK TIMER SAFETY ----------------
	if action_locked:
		lock_timer -= delta
		if lock_timer <= 0:
			action_locked = false
			is_attacking = false
			hurt_locked = false

	if state != State.DEAD:
		velocity.y += GRAVITY * delta

	# ---------------- CPU ----------------
	if is_cpu:
		if target == null:
			target = get_tree().get_first_node_in_group("Reptile")

		cpu_logic(delta)
		return

	# ---------------- BLOCK INPUT WHEN LOCKED ----------------
	if action_locked or hurt_locked:
		velocity.x = move_toward(velocity.x, 0, SPEED * 8 * delta)
		move_and_slide()
		return

	# ---------------- INPUT ----------------
	var input_dir = Input.get_axis("sleft", "sright")
	var climb_pressed = Input.is_action_pressed("sclimb")

	if input_dir != 0:
		velocity.x = input_dir * SPEED
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED * 10 * delta)

	if input_dir > 0:
		facing = 1
	elif input_dir < 0:
		facing = -1

	sprite.flip_h = facing > 0

	# ---------------- STATE ----------------
	if climb_pressed and not is_on_floor() and is_on_wall():
		state = State.SCLIMB
	elif not is_on_floor():
		state = State.SJUMP
	elif input_dir != 0:
		state = State.SRUN
	else:
		state = State.IDLE

	# ---------------- ANIMATION ----------------
	if not action_locked:
		match state:
			State.SCLIMB:
				play_anim("sclimb")
			State.SJUMP:
				play_anim("sjump")
			State.SRUN:
				play_anim("swalk")
			State.IDLE:
				play_anim("sidle")


	# ---------------- INPUT ACTIONS ----------------
	if Input.is_action_just_pressed("sjump") and is_on_floor():
		velocity.y = sjump_velocity

	elif Input.is_action_just_pressed("sjumpkick"):
		do_action("sjumpkick")

	elif Input.is_action_pressed("sblock"):
		do_action("sblock")

	elif Input.is_action_just_pressed("spunch"):
		do_action("spunch")

	elif Input.is_action_just_pressed("sroundhousekick"):
		do_action("sroundhousekick")

	elif Input.is_action_pressed("skick"):
		do_action("skick")

	elif Input.is_action_pressed("suppercut"):
		do_action("suppercut")

	elif Input.is_action_just_pressed("sshoot"):
		shoot_player()

	move_and_slide()


# ---------------- CPU LOGIC ----------------
func cpu_logic(delta):

	if target == null:
		return


	ai_timer -= delta

	var dist = target.global_position.x - global_position.x
	var dir = sign(dist)
	var abs_dist = abs(dist)

	facing = dir
	sprite.flip_h = facing > 0


	if abs_dist > 220:
		velocity.x = dir * SPEED * 0.8

		if state != State.SRUN:
			state = State.SRUN
			play_anim("swalk")

	else:
		velocity.x = move_toward(velocity.x, 0, SPEED * 6 * delta)

		if state != State.IDLE:
			state = State.IDLE
			play_anim("sidle")

		if ai_timer <= 0:
			ai_timer = randf_range(0.4, 0.8)

			match randi() % 5:
				0: do_action("spunch")
				1: do_action("skick")
				2: do_action("suppercut")
				3: do_action("sroundhousekick")
				4:
					if randf() < 0.3:
						shoot_player()


# ---------------- ACTION ----------------
func do_action(anim_name: String):
	if is_finish_state:
		return
	if state == State.DEAD:
		return

	if action_locked:
		return

	action_locked = true
	is_attacking = true
	lock_timer = 0.6

	play_anim(anim_name)

	if anim_name in ["spunch", "skick", "sroundhousekick", "suppercut"]:
		spawn_attack(anim_name)

	await sprite.animation_finished

	is_attacking = false
	action_locked = false
	hurt_locked = false

	play_anim("sidle")


# ---------------- ATTACK ----------------
func spawn_attack(anim_name: String):

	var attack = SUBZERO_ATTACK.instantiate()
	get_tree().current_scene.add_child(attack)

	attack.global_position = attack_marker.global_position

	var dmg := 1

	match anim_name:
		"sroundhousekick":
			dmg = 5
		"suppercut":
			dmg = 3
		"skick":
			dmg = 2
		"spunch":
			dmg = 1

	if attack.has_method("set_damage"):
		attack.set_damage(dmg)
	else:
		attack.set("damage", dmg)

	attack.set("owner", self)
	attack.set("facing", facing)

# ---------------- SHOOT ----------------
func shoot_player():

	if is_shooting:
		return

	is_shooting = true
	is_attacking = true

	play_anim("sshoot")

	var bullet = BULLET_SCENE.instantiate()
	get_tree().current_scene.add_child(bullet)

	bullet.global_position = shoot_marker.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	await sprite.animation_finished

	is_shooting = false
	is_attacking = false

	play_anim("sidle")

# ---------------- DAMAGE ----------------
func take_damage(amount: int):

	if state == State.DEAD:
		return

	if not can_take_damage:
		return

	can_take_damage = false

	is_hurting = true
	hurt_locked = true

	health -= amount
	health = max(health, 0)

	health_changed.emit(health)


	hit_sound.play()
	play_anim("shurt")

	await get_tree().create_timer(0.15).timeout

	is_hurting = false
	hurt_locked = false
	can_take_damage = true

	var blood = BLOOD_EFFECT.instantiate()
	get_tree().current_scene.add_child(blood)
	blood.global_position = blood_marker.global_position

	if health <= 0:
		die()
	if health == 1:
		is_finish_state = true
	elif health > 1:
		is_finish_state = false
	else:
		play_anim("sidle")



# ---------------- DEATH ----------------
func die():

	if state == State.DEAD:
		return

	state = State.DEAD
	velocity = Vector2.ZERO

	is_attacking = false
	is_shooting = false
	action_locked = true
	hurt_locked = true

	var death = BLOOD_DEATH.instantiate()
	get_tree().current_scene.add_child(death)

	death.global_position = global_position

	if death.has_method("set"):
		death.set("facing", facing)

	queue_free()

# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):

	if current_anim == anim_name:
		return

	current_anim = anim_name
	sprite.play(anim_name)

# ---------------- HIT DETECTION ----------------
func _on_subzero_hurt_box_area_entered(area: Area2D) -> void:
	if area == null:
		return

	if area.is_in_group("ReptileBullet"):
		take_damage(1)
		return

	if area.is_in_group("ReptileAcid"): # <-- IMPORTANT
		hit_from_reptileacid = true
		take_damage(1)
		return

	if area.is_in_group("ReptileAttack"):
		take_damage(1)
		return

	if area.is_in_group("FireDeath"):
		take_damage(1)
		return

	if area.is_in_group("IceDeath"):
		take_damage(1)
		return

	if area.is_in_group("ElectricDeath"):
		take_damage(1)
		return

	if area.is_in_group("FireBullet"):
		take_damage(1)
		return

func _separate_from_opponent():
	pass
