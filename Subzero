func _unhandled_input(event):

	# =====================================================
	# CPU MUST NOT RECEIVE PLAYER INPUT
	# =====================================================

	if is_cpu:
		return

	# =====================================================
	# PLAYER 1 JUMP
	# =====================================================

	if event.is_action_pressed("jump"):
		if is_on_floor():
			velocity.y = jump_velocity

	# =====================================================
	# COMBO INPUT
	# =====================================================

	var inputs = [
		"up",
		"down",
		"left",
		"right",
		"shoot"
	]

	for i in inputs:
		if event.is_action_pressed(i):
			register_input(i)


