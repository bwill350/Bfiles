extends CharacterBody2D
class_name Subzero

signal health_changed(health)
signal combo_used(combo_name: String)

# ---------------- STATE ----------------
enum State { SIDLE, SRUN, SJUMP, SCLIMB, SPUNCH, SBLOCK, SDEAD }
var state: State = State.SIDLE

# ---------------- CPU ----------------
var is_cpu := false
var target: Node2D = null
var ai_timer := 0.0

# ---------------- COMBAT ----------------
var is_hurting := false
var is_shooting := false
var is_attacking := false
var action_locked := false
var hurt_locked := false

var facing := -1
var current_anim := ""

var health: int

# ✅ NEW: replaces cooldown system
var hitstun_time := 0.0

var frozen := false

const GRAVITY = 5000.0

# ---------------- EXPORTS ----------------
@export var SPEED = 850.0
@export var CLIMB_SPEED = 220.0
@export var max_health: int = 100
@export var jump_velocity = -1700.0
@export var shoot_cooldown := 0.25

# ---------------- PRELOADS ----------------
const BULLET_SCENE = preload("res://Projectiles/Subzerobullet.tscn")
const ICE_ATTACK = preload("res://Projectiles/ReptileAttack.tscn")
const ICE_DEATH = preload("res://Deaths/IceDeath.tscn")

# ---------------- NODES ----------------
@onready var sprite: AnimatedSprite2D = $Sprite
@onready var hit_sound: AudioStreamPlayer2D = $Hit
@onready var shoot_marker: Marker2D = $Subzeroshoot
@onready var attack_marker: Marker2D = $AttackMarker

# ---------------- READY ----------------
func _ready():
	add_to_group("enemy")
	add_to_group("Subzero")

	health = max_health
	health_changed.emit(health)

	play_anim("sidle")

# ---------------- PHYSICS ----------------
func _physics_process(delta):

	if state == State.SDEAD:
		return

	# ✅ HITSTUN TIMER (replaces cooldown bugs)
	if hitstun_time > 0:
		hitstun_time -= delta

	if is_cpu:
		cpu_logic(delta)
		move_and_slide()
		return

	if frozen or action_locked or hurt_locked:
		move_and_slide()
		return

	var input_dir = Input.get_axis("sleft", "sright")
	var climb_pressed = Input.is_action_pressed("sclimb")

	if input_dir != 0:
		facing = input_dir

	velocity.y += GRAVITY * delta
	velocity.x = input_dir * SPEED

	sprite.flip_h = facing > 0

	if climb_pressed and not is_on_floor() and is_on_wall():
		state = State.SCLIMB
	elif not is_on_floor():
		state = State.SJUMP
	elif input_dir != 0:
		state = State.SRUN
	else:
		state = State.SIDLE

	match state:
		State.SCLIMB:
			velocity.y = -CLIMB_SPEED
			play_anim("sclimb")
		State.SJUMP:
			play_anim("sjump")
		State.SRUN:
			play_anim("srun")
		State.SIDLE:
			play_anim("sidle")

	if Input.is_action_just_pressed("sjump") and is_on_floor():
		velocity.y = jump_velocity

	if Input.is_action_just_pressed("sshoot"):
		ice_shoot()

	if Input.is_action_just_pressed("spunch"):
		do_action("spunch")

	move_and_slide()

# ---------------- CPU ----------------
func cpu_logic(delta):

	if target == null:
		return

	ai_timer -= delta

	var dist = target.global_position.x - global_position.x
	var abs_dist = abs(dist)
	var dir = sign(dist)

	facing = dir
	sprite.flip_h = facing > 0

	velocity.y += GRAVITY * delta

	if abs_dist > 200:
		velocity.x = dir * SPEED * 0.8
		play_anim("srun")
	else:
		velocity.x = 0

	if target.has_method("is_attacking") and target.is_attacking and abs_dist < 170:
		if not action_locked:
			do_action("sblock")

	if ai_timer > 0:
		if velocity.x == 0 and not is_attacking:
			play_anim("sidle")
		return

	ai_timer = randf_range(0.4, 0.8)

	if action_locked or is_attacking:
		return

	match randi() % 4:
		0: do_action("spunch")
		1: do_action("spunch")
		2: do_action("spunch")
		3: ice_shoot()

# ---------------- SHOOT ----------------
func ice_shoot():

	if is_shooting or state == State.SDEAD:
		return

	is_shooting = true
	is_attacking = true

	play_anim("sshoot")

	var bullet = BULLET_SCENE.instantiate()
	get_tree().current_scene.add_child(bullet)

	bullet.global_position = shoot_marker.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	await sprite.animation_finished

	is_shooting = false
	is_attacking = false
	play_anim("sidle")

# ---------------- ATTACK ----------------
func do_action(anim_name: String):

	if state == State.SDEAD:
		return

	if action_locked:
		return

	action_locked = true
	is_attacking = true

	play_anim(anim_name)

	var attack = ICE_ATTACK.instantiate()
	attack.global_position = attack_marker.global_position
	get_tree().current_scene.add_child(attack)

	await sprite.animation_finished

	is_attacking = false
	action_locked = false
	play_anim("sidle")

# ---------------- DAMAGE (FIXED SYSTEM) ----------------
func take_damage(amount: int):

	if state == State.SDEAD:
		return

	# optional hitstun gate (prevents spam only, NOT immunity)
	if hitstun_time > 0.1:
		pass

	health -= amount
	health = max(health, 0)
	health_changed.emit(health)

	if hit_sound:
		hit_sound.play()

	# HITSTUN instead of cooldown
	hitstun_time = 0.25

	is_attacking = false
	action_locked = false

	play_anim("shurt")

	if health <= 0:
		die()

# ---------------- HIT ----------------
func _on_hit_box_area_entered(area):

	if state == State.SDEAD:
		return

	if area.is_in_group("ReptileBullet"):
		take_damage(1)

	elif area.is_in_group("Bullet"):
		take_damage(10)

	elif area.is_in_group("ReptileAttack"):
		take_damage(1)

# ---------------- DEATH ----------------
func die():

	state = State.SDEAD

	action_locked = true
	hurt_locked = true
	is_attacking = false
	is_shooting = false
	frozen = true

	velocity = Vector2.ZERO
	set_physics_process(false)

	sprite.modulate = Color(0.7, 0.7, 0.7)

	var death_instance = ICE_DEATH.instantiate()
	death_instance.global_position = global_position
	get_tree().current_scene.add_child(death_instance)

	await get_tree().create_timer(1.5).timeout
	queue_free()

# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):

	if state == State.SDEAD:
		return

	if current_anim == anim_name:
		return

	current_anim = anim_name
	sprite.play(anim_name)
