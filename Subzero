var spawn_protection := false
signal health_changed(health)
signal combo_used(combo_name: String)
var combo := []
var combo_timer := 0.0
# ---------------- STATE ----------------
enum State { IDLE, RUN, JUMP, JUMPKICK, BLOCK, PUNCH, CLIMB, DEAD }

var state: State = State.IDLE
var is_finish_state := false

# ---------------- CPU ----------------
var is_cpu := false
var target: Node2D = null
var ai_timer := 0.0

var hit_from_reptileacid := false

@onready var finish_label: Sprite2D = $HUD/FinishLabel/Sprite2D

func _unhandled_input(event):

	if event.is_action_pressed("left"):
		register_input("left")

	elif event.is_action_pressed("right"):
		register_input("right")

	elif event.is_action_pressed("down"):
		register_input("down")

	elif event.is_action_pressed("shoot"):
		register_input("shoot")

# ---------------- COMBAT ----------------
var is_hurting := false
var is_shooting := false
var is_attacking := false
var action_locked := false
var hurt_locked := false
var special_bullet: PackedScene = null
var facing := -1
var current_anim := ""
var lock_timer := 0.0
var health: int
var can_take_damage := true
const ICE_COMBO = ["right", "down", "shoot"]
const BLOOD_EFFECT = preload("res://Bloodeffect.tscn")
const SMOKE_EFFECT = preload("res://SmokeEffect.tscn")
const GRAVITY = 5000

# ---------------- EXPORTS ----------------
@export var SPEED = 300.0
@export var SCLIMB_SPEED = 250.0
@export var max_health: int = 10
@export var sjump_velocity = -1800.0
@export var damage := 1

# ---------------- PRELOADS ----------------
const BULLET_SCENE = preload("res://Projectiles/Subzerobullet.tscn")
const SUBZERO_ATTACK = preload("res://Projectiles/SubzeroAttack.tscn")
const ICE_DEATH = preload("res://Deaths/IceDeath.tscn")
const BLOOD_DEATH = preload("res://Deaths/BloodDeath.tscn")
const SMOKE_DEATH = preload("res://SmokeEffect.tscn")
const ICE_BULLET = preload("res://Projectiles/IceBullet.tscn")
# ---------------- NODES ----------------
@onready var sprite: AnimatedSprite2D = $Sprite
@onready var hit_sound: AudioStreamPlayer2D = $Hit
@onready var hit_box: Area2D = $SubzeroHurtBox
@onready var shoot_marker: Marker2D = $Subzeroshoot
@onready var attack_marker: Marker2D = $AttackMarker
@onready var blood_marker: Marker2D = $BloodMarker
@onready var smoke_marker: Marker2D = $SmokeMarker
func update_facing_offsets():
	$AttackMarker.position = Vector2(34 * facing, -124)
	$SubzeroHurtBox/CollisionShape2D.position = Vector2(34 * facing, -81)

# ---------------- READY ----------------
func _ready():
	spawn_protection = true
	await get_tree().create_timer(1.0).timeout
	action_locked = false
	hurt_locked = false
	is_attacking = false
	is_shooting = false
	is_hurting = false
	hit_from_reptileacid = false
	can_take_damage = true

	lock_timer = 0.0

	state = State.IDLE
	velocity = Vector2.ZERO

	add_to_group("Subzero")
	add_to_group("ElectricDeath")
	add_to_group("IceDeath")
	add_to_group("FireDeath")

	health = max_health
	health_changed.emit(health)

	play_anim("sidle")

	ai_timer = randf_range(0.2, 0.6)
	health_changed.connect(_on_health_changed)

func _on_health_changed(h):

	if h == 1 and not is_finish_state:

		is_finish_state = true

		is_attacking = false
		is_shooting = false
		is_hurting = false

		action_locked = false
		hurt_locked = false

		state = State.IDLE
		velocity = Vector2.ZERO

		finish_label.visible = true

		if finish_label.has_method("start_flicker"):
			finish_label.start_flicker(2.0, 0.05)

		await get_tree().create_timer(2.0).timeout

		if is_instance_valid(finish_label):
			finish_label.visible = false

# ---------------- PHYSICS ----------------
func _physics_process(delta):

	combo_timer += delta

	if combo_timer > 0.6:
		combo.clear()

	# ---------------- FINISH HIM ----------------
	if is_finish_state:

		velocity.x = 0

		if not is_on_floor():
			velocity.y += GRAVITY * delta
		else:
			velocity.y = 0

		if state != State.DEAD:
			state = State.IDLE
			play_anim("idle")

		move_and_slide()
		return

	# ---------------- LOCK TIMER SAFETY ----------------
	if action_locked:
		lock_timer -= delta

		if lock_timer <= 0:
			action_locked = false
			is_attacking = false
			hurt_locked = false

	# ---------------- GRAVITY ----------------
	if state != State.DEAD:
		velocity.y += GRAVITY * delta

	# ---------------- LOCKED ----------------
	if action_locked or hurt_locked:
		velocity.x = move_toward(velocity.x, 0, SPEED * 8 * delta)
		move_and_slide()
		return

	# ---------------- CPU ----------------
	if is_cpu:
		if target == null:
			target = get_tree().get_first_node_in_group("Reptile")

		cpu_logic(delta)
		move_and_slide()
		return

	# ---------------- BLOCK INPUT WHEN LOCKED ----------------
	if action_locked or hurt_locked:
		velocity.x = move_toward(velocity.x, 0, SPEED * 8 * delta)
		move_and_slide()
		return

	# ---------------- INPUT ----------------
	var input_dir = Input.get_axis("left", "right")
	var climb_pressed = Input.is_action_pressed("climb")

	if input_dir != 0:
		facing = -sign(input_dir)
		update_facing_offsets()
		velocity.x = input_dir * SPEED
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED * 10 * delta)

	sprite.flip_h = facing < 0

	# ---------------- STATE ----------------
	if climb_pressed and not is_on_floor() and is_on_wall():
		state = State.CLIMB
	elif not is_on_floor():
		state = State.JUMP
	elif input_dir != 0:
		state = State.RUN
	else:
		state = State.IDLE

	move_and_slide()

# ---------------- ANIMATION ----------------
	if not action_locked:
		match state:
			State.CLIMB:
				play_anim("climb")
			State.JUMP:
				play_anim("jump")
			State.RUN:
				play_anim("walk")
			State.IDLE:
				play_anim("idle")


	# ---------------- INPUT ACTIONS ----------------
	if Input.is_action_just_pressed("jump") and is_on_floor():
		velocity.y = sjump_velocity

	elif Input.is_action_just_pressed("jumpkick"):
		do_action("jumpkick")

	elif Input.is_action_pressed("block"):
		do_action("block")

	elif Input.is_action_just_pressed("punch"):
		do_action("punch")

	elif Input.is_action_just_pressed("roundhousekick"):
		do_action("roundhousekick")

	elif Input.is_action_pressed("kick"):
		do_action("kick")

	elif Input.is_action_pressed("uppercut"):
		do_action("uppercut")

	elif Input.is_action_just_pressed("shoot"):
		shoot_player()

	move_and_slide()


# ---------------- CPU LOGIC ----------------
func cpu_logic(delta):

	if target == null:
		return
	#STOP ALL ACTIONS AT 1HP
	if health <= 1:
		is_attacking = false
		action_locked = true
		move_and_slide()


	ai_timer -= delta

	var dist = target.global_position.x - global_position.x
	var dir = sign(dist)
	var abs_dist = abs(dist)

	facing = dir
	sprite.flip_h = facing > 0


	if abs_dist > 220:
		velocity.x = dir * SPEED * 0.8

		if state != State.RUN:
			state = State.RUN
			play_anim("walk")

	else:
		velocity.x = move_toward(velocity.x, 0, SPEED * 6 * delta)

		if state != State.IDLE:
			state = State.IDLE
			play_anim("idle")

		if ai_timer <= 0:
			ai_timer = randf_range(0.4, 0.8)

			match randi() % 5:
				0: do_action("punch")
				1: do_action("kick")
				2: do_action("uppercut")
				3: do_action("roundhousekick")
				4:
					if randf() < 0.3:
						shoot_player()


# ---------------- ACTION ----------------
func do_action(anim_name: String):
	if is_finish_state:
		return
	if state == State.DEAD:
		return

	if action_locked:
		return

	action_locked = true
	is_attacking = true
	lock_timer = 0.6

	play_anim(anim_name)

	if anim_name in ["punch", "kick", "roundhousekick", "uppercut"]:
		spawn_attack(anim_name)

	await sprite.animation_finished

	is_attacking = false
	action_locked = false
	hurt_locked = false

	play_anim("idle")

# ---------------- COMBOS ----------------
func register_input(input: String):

	combo.append(input)

	combo_timer = 0.0

	check_combos()

# ---------------- ICE COMBO ----------------
func ice_combo():
	combo_used.emit("ice")

	special_bullet = ICE_BULLET

	spawn_fx(ICE_DEATH)

	combo.clear()


func check_combos():

	if combo == ICE_COMBO:
		ice_combo()
		return

# ---------------- ATTACK ----------------
func spawn_attack(anim_name: String):

	var attack = SUBZERO_ATTACK.instantiate()
	get_tree().current_scene.add_child(attack)

	attack.global_position = attack_marker.global_position

	var dmg := 1

	match anim_name:
		"roundhousekick":
			dmg = 1
		"uppercut":
			dmg = 1
		"kick":
			dmg = 1
		"punch":
			dmg = 1

	if attack.has_method("set_damage"):
		attack.set_damage(dmg)
	else:
		attack.set("damage", dmg)

	attack.set("owner", self)
	attack.set("facing", facing)

# ---------------- SHOOT ----------------
func shoot_player():

	if is_shooting:
		return

	is_shooting = true
	is_attacking = true

	play_anim("shoot")

	var bullet = BULLET_SCENE.instantiate()
	get_tree().current_scene.add_child(bullet)

	bullet.global_position = shoot_marker.global_position
	bullet.velocity = Vector2(-facing, 0) * bullet.speed

	await sprite.animation_finished

	is_shooting = false
	is_attacking = false

	play_anim("idle")

# ---------------- DAMAGE ----------------
func take_damage(amount: int):
	if health <= 1:
		action_locked = true
		velocity.x = 0
	if spawn_protection:
		return
	if state == State.DEAD:
		return

	if not can_take_damage:
		return

	can_take_damage = false

	is_hurting = true
	hurt_locked = true

	health -= amount
	health = max(health, 0)

	health_changed.emit(health)


	hit_sound.play()
	play_anim("hurt")

	await get_tree().create_timer(0.15).timeout

	is_hurting = false
	hurt_locked = false
	can_take_damage = true

	var blood = BLOOD_EFFECT.instantiate()
	get_tree().current_scene.add_child(blood)
	blood.global_position = blood_marker.global_position

	if health <= 0:
		die()
	if health == 1:
		is_finish_state = true
	elif health > 1:
		is_finish_state = false



# ---------------- DEATH ----------------
func die():

	if state == State.DEAD:
		return

	state = State.DEAD
	velocity = Vector2.ZERO

	is_attacking = false
	is_shooting = false
	action_locked = true
	hurt_locked = true

	var death = BLOOD_DEATH.instantiate()
	get_tree().current_scene.add_child(death)

	death.global_position = global_position

	if death.has_method("set"):
		death.set("facing", facing)

	queue_free()



func spawn_fx(scene: PackedScene):

	var fx = scene.instantiate()

	get_tree().current_scene.add_child(fx)

	if target:
		fx.global_position = target.global_position

	else:
		fx.global_position = global_position + Vector2(80, 0)

	get_tree().create_timer(1.0).timeout.connect(func():
		if is_instance_valid(fx):
			fx.queue_free()
	)

# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):

	if current_anim == anim_name:
		return

	current_anim = anim_name
	sprite.play(anim_name)

func _on_subzero_hurt_box_area_entered(area: Area2D) -> void:

	if area == null:
		return

	var attacker = area.get_parent()

	if attacker == null:
		return

	# ---------------- REPTILE ----------------
	if area.is_in_group("ReptileBullet"):
		take_damage(1)
		return

	if area.is_in_group("ReptileAcid"):
		hit_from_reptileacid = true
		take_damage(1)
		return

	if area.is_in_group("ReptileAttack"):
		take_damage(1)
		return

	# ---------------- RAIDEN ----------------
	if area.is_in_group("RaidenAttack"):
		take_damage(1)
		return

	if area.is_in_group("RaidenElectricBullet"):
		take_damage(1)
		return

	if area.is_in_group("ElectricForceHurtBox"):
		take_damage(1)
		return

	if area.is_in_group("ElectricBurst"):
		take_damage(1)
		return

	# ---------------- ELEMENTAL ----------------
	if area.is_in_group("FireDeath"):
		take_damage(1)
		return

	if area.is_in_group("IceDeath"):
		take_damage(1)
		return

	if area.is_in_group("ElectricDeath"):
		take_damage(1)
		return

	if area.is_in_group("FireBullet"):
		take_damage(1)
		return
