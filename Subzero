func _unhandled_input(event):

	if event.is_action_pressed("jump"):
		velocity.y = jump_velocity

	var inputs = ["up", "down", "left", "right", "shoot"]

	for i in inputs:
		if event.is_action_pressed(i):
			register_input(i)


func update_facing_offsets():
	$AttackMarker.position = Vector2(63 * facing, -211)



# ---------------- READY ----------------
func _ready():

	print("SUBZERO READY:", self)

	$Crispy.visible = false

	add_to_group("Fighter")
	add_to_group("enemy")
	add_to_group("Subzero")

	spawn_locked = false

	health = max_health

	# Wait until Level1 connects health_changed
	call_deferred("emit_health")

	play_anim("idle")

	ai_timer = randf_range(0.2, 0.6)

	facing = 1
	sprite.flip_h = -facing < 0


func emit_health():

	health_changed.emit(health)

func run(input_dir: float):
	if input_dir == 0:
		return

	state = State.RUN
	velocity.x = input_dir * SPEED * 4  # faster than walk

	if not is_attacking:
		play_anim("run")

func handle_double_tap_run(input_dir: float, delta: float) -> bool:

	if input_dir == 0:
		return false

	var now := Time.get_ticks_msec() / 1000.0

	if input_dir == last_tap_dir:
		if now - last_tap_time <= tap_time:
			run_locked = true
			return true

	last_tap_time = now
	last_tap_dir = input_dir

	return false

func apply_stun(_duration := 4.0):

	if state == State.DEAD:
		return

	stunned = true

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	velocity = Vector2.ZERO
	knockback_x = 0

	play_anim("idle")

	await get_tree().create_timer(4.0).timeout

	stunned = false

	is_hurting = false
	hurt_locked = false
	action_locked = false

# ---------------- PHYSICS ----------------
func _physics_process(delta):

	if state == State.DEAD:
		return

	if is_pulled:
		run_pull_logic(delta)
		move_and_slide()
		return

	# ---------------- STUN ----------------
	if stunned:
		velocity = Vector2.ZERO
		return

	# ---------------- DEATH / FINISH ----------------
	if state == State.DEAD:
		return

	if is_finish_state:
		state = State.IDLE
		velocity.x = 0
		if not is_hurting:
			play_anim("idle")
		move_and_slide()
		return

	# ---------------- GRAVITY (ONLY ONCE) ----------------
	velocity.y += GRAVITY * delta

	if uppercut_launched:

		move_and_slide()

		if is_on_floor():
			uppercut_launched = false

		return

	# ---------------- COOLDOWNS ----------------
	shoot_cooldown = max(shoot_cooldown - delta, 0.0)

	combo_timer += delta
	if combo_timer > combo_reset_time:
		combo.clear()

	# ---------------- CPU ----------------
	if is_cpu:
		cpu_logic(delta)
		move_and_slide()
		return

	if state == State.DEAD:
		return

	if is_finish_state:
		state = State.IDLE
		velocity.x = 0

		if not is_hurting:
			play_anim("idle")

		move_and_slide()
		return


	if action_locked:
		return

	var input_dir = Input.get_axis("left", "right")
	var climb_pressed = Input.is_action_pressed("climb")

	# ---------------- FACING ----------------
	if input_dir != 0:
		facing = input_dir

	sprite.flip_h = facing > 0

	$AttackMarker.position = Vector2(63 * facing, -211)
	$Subzeroshoot.position = Vector2(63 * facing, -211)

	# =========================================================
	# 🟢 MOVEMENT (RUN ADDED HERE)
	# =========================================================
	if Input.is_action_pressed("run") and input_dir != 0:
		run(input_dir)   # 🔥 CALLS YOUR NEW RUN FUNCTION
	else:
		velocity.x = input_dir * SPEED

		# ---------------- STATE ----------------
		if not is_on_floor():
			state = State.JUMP
		elif input_dir != 0:
			state = State.WALK
		elif input_dir != 0:
			state = State.RUN
		else:
			state = State.IDLE

	# ---------------- ANIMS ----------------
	match state:

		State.CLIMB:
			velocity.y = -CLIMB_SPEED
			if not is_attacking:
				play_anim("idle")

		State.JUMP:
			if not is_attacking:
				play_anim("jump")

		State.WALK:
			if not is_attacking:
				play_anim("walk")

		State.RUN:
			if not is_attacking:
				play_anim("run")

		State.IDLE:
			if not is_attacking:
				play_anim("idle")

	if is_hurting and hurt_locked:
		return

	# ---------------- JUMP ----------------
	if Input.is_action_just_pressed("jump") and is_on_floor():
		velocity.y = jump_velocity

	# ---------------- ATTACKS ----------------
	if Input.is_action_just_pressed("punch"):
		do_action("punch")

	if Input.is_action_just_pressed("highpunch"):
		do_action("highpunch")

	if Input.is_action_just_pressed("lowpunch"):
		do_action("lowpunch")

	elif Input.is_action_just_pressed("roundhousekick"):
		do_action("roundhousekick")

	elif Input.is_action_just_pressed("kick"):
		do_action("kick")

	elif Input.is_action_just_pressed("kick"):
		do_action("kick")

	elif Input.is_action_just_pressed("highkick"):
		do_action("highkick")

	elif Input.is_action_just_pressed("lowkick"):
		do_action("lowkick")

	elif Input.is_action_just_pressed("uppercut"):
		do_action("uppercut")

	elif Input.is_action_pressed("knee"):
		do_action("knee")

	elif Input.is_action_just_pressed("shoot"):
		shoot_player()

	elif Input.is_action_pressed("block"):
		start_block()

	else:
		stop_block()


	move_and_slide()

func spear_pulled_to_p1():
	print("START PULL")

	is_pulled = true
	stunned = true
	action_locked = true
	is_hurting = true

	pull_timer = 0.35

	pull_target = get_tree().get_first_node_in_group("Reptile")

func run_pull_logic(delta):
	print("Running pull logic")
	if pull_target == null or !is_instance_valid(pull_target):
		is_pulled = false
		stunned = false
		action_locked = false
		return

	var dir = sign(pull_target.global_position.x - global_position.x)

	velocity.x = dir * 900
	velocity.y = -120

	pull_timer -= delta

	if pull_timer <= 0.0:

		is_pulled = false

		# SNAP to Reptile AttackMarker (THIS IS MK MOMENT)
		global_position = pull_target.attack_marker.global_position + Vector2(40 * pull_target.facing, 0)

		stunned = false
		is_hurting = false
		action_locked = false
		is_attacking = true

		pull_target = null

# ---------------- BLOCK ----------------
func start_block():

	if state == State.DEAD:
		return

	is_blocking = true
	state = State.BLOCK

	play_anim("block")

func stop_block():

	if is_blocking:
		is_blocking = false
		state = State.IDLE

# ---------------- CPU LOGIC ----------------
func cpu_logic(delta):
# ---------------- HURT PRIORITY ----------------
	if is_hurting:

		if is_spear_pulled:
			# opposite of normal knockback
			velocity.x = -facing * -600
		else:
			# normal knockback
			velocity.x = -facing * 100

		knockback_x = move_toward(knockback_x, 0, 1500 * delta)

		if abs(knockback_x) < 10:
			knockback_x = 0
			is_hurting = false
			is_spear_pulled = false

		return

	if target == null or !is_instance_valid(target):
		velocity.x = 0
		return

	var dist = target.global_position.x - global_position.x
	var direction = sign(dist)

	# HARD LOCK (Liu Kang style behavior)
	if action_locked:
		return

# STOP ALL ACTIONS AT 1HP
	if health <= 1:
		is_attacking = false
		action_locked = true
		velocity.x = 0
		move_and_slide()
		return

	ai_timer -= delta
	facing = direction
	sprite.flip_h = facing > 0

# ---------------- MOVEMENT ----------------
	if not is_attacking:
		play_anim("walk")

	if abs(dist) > 220:
		velocity.x = direction * SPEED * 0.8
		state = State.RUN
		play_anim("run")
	else:
		velocity.x = direction * SPEED * 0.8
		state = State.WALK
		play_anim("walk")


# ---------------- AI ACTIONS ----------------
	if ai_timer <= 0:

		match Game.difficulty:

			"Hard":

				# Very fast reactions
				ai_timer = randf_range(0.05, 0.15)

				var choice = randi() % 100

				if choice < 20:
					do_action("punch")
				elif choice < 20:
					do_action("highpunch")
				elif choice < 20:
					do_action("lowpunch")
				elif choice < 20:
					do_action("kick")
				elif choice < 20:
					do_action("highkick")
				elif choice < 20:
					do_action("lowkick")
				elif choice < 65:
					do_action("uppercut")
				elif choice < 80:
					do_action("roundhousekick")
				else:
					shoot_player()
					do_action("uppercut")

			"Easy":

				ai_timer = randf_range(0.5, 0.9)

				var choice = randi() % 100

				if choice < 40:
					do_action("punch")
				elif choice < 40:
					do_action("highpunch")
				elif choice < 40:
					do_action("lowpunch")
				elif choice < 70:
					do_action("kick")
				elif choice < 70:
					do_action("highkick")
				elif choice < 70:
					do_action("lowkick")
				elif choice < 85:
					do_action("uppercut")
				else:
					shoot_player()

# ---------------- ACTION ----------------
func do_action(anim_name: String):

	if is_finish_state:
		return

	if state == State.DEAD:
		return

	if action_locked:
		return

	action_locked = true
	is_attacking = true
	lock_timer = 0.6

	play_anim(anim_name)

	# ---------------- NORMAL ATTACKS ----------------
	if anim_name in [
		"punch",
		"highpunch",
		"lowpunch",
		"kick",
		"highkick",
		"lowkick",
		"uppercut",
		"roundhousekick",
		"knee"
	]:
		spawn_attack(anim_name)

	# ---------------- SUBZERO SPECIAL (NO NEW NAME) ----------------
	if has_node("AttackMarker"):
		$AttackMarker.call_deferred("emit_signal", "trigger_attack")

	await sprite.animation_finished

	is_attacking = false
	action_locked = false
	hurt_locked = false

# ---------------- COMBOS ----------------
func register_input(input: String):

	combo.append(input)

	combo_timer = 0.0

	check_combos()

# ---------------- ICE COMBO ----------------
func ice_combo():
	combo_used.emit("ice")

	special_bullet = BULLET_SCENE

	combo.clear()

	shoot_player()


func check_combos():

	if combo == ICE_DEATH_TWO_COMBO:
		combo_used.emit("ice_death_two")
		action_locked = true
		is_attacking = true
		spawn_fx(ICE_DEATHTWO)
		$Sprite.play("uppercut")
		await $Sprite.animation_finished

		action_locked = false
		play_anim("idle")
		combo.clear()
		return

	if combo == SPLAT_COMBO:

		combo_used.emit("splat")

		action_locked = true
		is_attacking = true

		# Subzero character animation
		$Sprite.play("splat")

		# Spawn ice puddle
		spawn_fx(SPLAT)

		await $Sprite.animation_finished

		is_attacking = false
		action_locked = false

		play_anim("idle")

		combo.clear()
		return

	elif combo == ICE_COMBO:
		ice_combo()
		return

	elif combo == PUNCH_COMBO:

		combo_used.emit("punch_combo")

		combo.clear()

		start_punch_combo()
		return


	# ---------------- kick ----------------
	if combo == KICK_COMBO:

		combo_used.emit("kick_combo")

		combo.clear()

		start_kick_combo()
		return

func start_splat_combo():

	await combo_attack([
		"punch",
		"punch"
	])

func start_punch_combo():

	await combo_attack([
		"punch",
		"lowpunch",
		"punch",
		"uppercut",
		"highpunch",
		"uppercut"
	])

func start_kick_combo():

	await combo_attack([
		"kick",
		"knee",
		"highkick",
		"roundhousekick",
		"lowkick",
		"roundhousekick",
		"highkick"
	])

func combo_attack(attacks: Array):

	action_locked = true
	is_attacking = true

	for attack in attacks:

		# STOP COMBO IF HIT
		if is_hurting or state == State.DEAD:
			break

		play_anim(attack)
		spawn_attack(attack)

		await sprite.animation_finished

	is_attacking = false
	action_locked = false

	if not is_hurting:
		play_anim("idle")

# ---------------- ATTACK ----------------
func spawn_attack(anim_name: String):

	if anim_name not in [
		"punch",
		"highpunch",
		"lowpunch",
		"kick",
		"highkick",
		"lowkick",
		"uppercut",
		"roundhousekick",
		"knee"
	]:
		return

	var attack = SUBZERO_ATTACK.instantiate()
	get_tree().current_scene.add_child(attack)

	attack.add_to_group("HitBox")
	attack.global_position = attack_marker.global_position
	attack.scale.x = facing

	var dmg := 1

	match anim_name:
		"punch":
			dmg = 1
		"highpunch":
			dmg = 1
		"lowpunch":
			dmg = 1
		"kick":
			dmg = 1
		"highkick":
			dmg = 1
		"lowkick":
			dmg = 1
		"uppercut":
			dmg = 1
		"roundhousekick":
			dmg = 1
		"knee":
			dmg = 1

	attack.damage = dmg

	# IMPORTANT
	attack.attack_owner = self
	attack.attack_name = anim_name
	attack.attack_type = anim_name

# ---------------- SHOOT ----------------
func shoot_player():
	if is_shooting:
		return
	is_shooting = true
	is_attacking = true
	action_locked = true

	play_anim("shoot")

	var bullet_scene: PackedScene = BULLET_SCENE

	if special_bullet != null:
		bullet_scene = special_bullet
		special_bullet = null   # use the special bullet once

	var bullet = bullet_scene.instantiate()
	get_tree().current_scene.add_child(bullet)

	bullet.global_position = $Subzeroshoot.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	await get_tree().create_timer(0.25).timeout

	is_shooting = false
	is_attacking = false
	action_locked = false

# ---------------- DAMAGE ----------------
func take_damage(amount: int):

	if state == State.DEAD:
		return

	if not can_take_damage:
		return

	can_take_damage = false

	await get_tree().create_timer(0.2).timeout

	can_take_damage = true

	if state == State.DEAD:
		return

	if spawn_protection:
		return

	# BLOCK REDUCTION
	if is_blocking:
		amount = max(amount - 1, 0)

	if amount <= 0:
		return

	health -= amount
	health = max(health, 0)

	print("Subzero took damage: ", amount, " HP=", health)

	health_changed.emit(health)
	hit_sound.play()

	# ---------------- FINISH HIM ----------------
	if health == 1 and not is_finish_state:
		trigger_finish_state()
		return

	# ---------------- FINAL HIT ----------------
	if health <= 0:
		var death = ICE_DEATHTWO.instantiate()
		state = State.DEAD

		finish_label.visible = false

		get_tree().current_scene.add_child(death)
		death.global_position = global_position

		await get_tree().create_timer(0.2).timeout

		die()
		return

	# ---------------- NORMAL HURT ----------------
	is_hurting = true
	hurt_locked = true
	action_locked = true

	combo.clear()

	state = State.IDLE

	play_anim("hurt")

	var blood = BLOOD_EFFECT.instantiate()
	get_tree().current_scene.add_child(blood)
	blood.global_position = blood_marker.global_position

	await get_tree().create_timer(0.2).timeout

	is_hurting = false
	hurt_locked = false
	action_locked = false

func trigger_finish_state():

	if is_finish_state:
		return

	is_finish_state = true

	state = State.IDLE

	# force them to fall back down
	velocity.x = 0
	velocity.y = 0

	action_locked = true
	hurt_locked = false
	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

	# cancel any uppercut/fly state
	set_meta("uppercut_launched", false)

	play_anim("idle")

	finish_label.visible = true

	if finish_label.has_method("start_flicker"):
		finish_label.start_flicker(2.0, 0.05)

	# let gravity work
	await get_tree().create_timer(0.1).timeout

	while not is_on_floor():
		velocity.y += 5000.0 * get_physics_process_delta_time()
		move_and_slide()
		await get_tree().physics_frame

	velocity = Vector2.ZERO

	await get_tree().create_timer(2.0).timeout

	if is_instance_valid(finish_label):
		finish_label.visible = false

# ---------------- DEATH ----------------
func die():

	if state == State.DEAD:
		return

	state = State.DEAD

	var death = BLOOD_DEATH.instantiate()
	get_tree().current_scene.add_child(death)
	death.global_position = global_position

	# stop everything
	velocity = Vector2.ZERO
	is_attacking = false
	is_shooting = false
	action_locked = true
	hurt_locked = true
	is_hurting = false

	# 🔥 HARD SWAP SPRITES
	$Sprite.visible = false          # AnimatedSprite2D OFF
	$Crispy.visible = true         # static image ON

	# optional delay before menu
	await get_tree().create_timer(4.5).timeout

	get_tree().change_scene_to_file("res://Scenes/MainMenu.tscn")

func spawn_fx(scene: PackedScene):

	var fx = scene.instantiate()

	# IMPORTANT: set owner BEFORE it can collide
	fx.owner_character = self
	fx.damage_done = false

	get_tree().current_scene.call_deferred("add_child", fx)

	await get_tree().process_frame

	if target and is_instance_valid(target):
		fx.global_position = target.global_position + Vector2(60 * facing, 0)
	else:
		fx.global_position = global_position + Vector2(80 * facing, 0)

# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):

	if current_anim == anim_name and sprite.is_playing():
		return

	current_anim = anim_name
	sprite.play(anim_name)

func _on_subzero_hurt_box_area_entered(area: Area2D) -> void:
	print("Subzero hit by:", area.name)
	print(area.get_groups())
	if hurt_cooldown:
		return

	if area == null or !is_instance_valid(area):
		return

	if not can_take_damage:
		return

	if area.get("attack_name") and area.attack_name == "uppercut":
		$Sprite.play("wasuppercut")
	else:
		$Sprite.play("hurt")

	$Hurt.play()


	if area.is_in_group("HitBox") \
		or area.is_in_group("ReptileAcid") \
		or area.is_in_group("RaidenElectricBullet") \
