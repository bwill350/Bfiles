var combo := []
var combo_timer := 0.0
var spawn_locked := true
var spawn_protection := false
var is_spear_pulled := false
var last_hit_frame := -1
# ---------------- STATE ----------------
enum State { IDLE, RUN, JUMP, JUMPKICK, BLOCK, PUNCH, CLIMB, DEAD }
var state: State = State.IDLE
var is_finish_state := false
var hurt_cooldown := false
# ---------------- CPU ----------------
var is_cpu := false
var target: Node2D = null
var ai_timer := 0.0
var knockback_x := 0.0
var hit_from_reptileacid := false
@onready var character = get_parent()
@onready var finish_label: Sprite2D = $HUD/FinishLabel/Sprite2D

# ---------------- COMBAT ----------------
var is_hurting := false
var is_shooting := false
var is_attacking := false
var action_locked := false
var hurt_locked := false
var special_bullet: PackedScene = null
var facing := 1
var current_anim := ""
var lock_timer := 0.0
var health: int
var can_take_damage := true
var is_blocking := false
const ICE_COMBO = ["right", "down", "shoot"]
const BLOOD_EFFECT = preload("res://Bloodeffect.tscn")
const SMOKE_EFFECT = preload("res://SmokeEffect.tscn")
const GRAVITY = 5000

# ---------------- EXPORTS ----------------
@export var SPEED = 300.0
@export var CLIMB_SPEED = 250.0
@export var max_health: int = 10
@export var jump_velocity = -2200.0
@export var damage := 1
@export var shoot_cooldown_time: float = 0.25
@export var combo_reset_time := 1.0
var shoot_cooldown := 0.0
# ---------------- PRELOADS ----------------
const BULLET_SCENE = preload("res://Projectiles/Subzerobullet.tscn")
const SUBZERO_ATTACK = preload("res://Projectiles/SubzeroAttack.tscn")
const ICE_DEATH = preload("res://Deaths/IceDeath.tscn")
const BLOOD_DEATH = preload("res://Deaths/BloodDeath.tscn")
const SMOKE_DEATH = preload("res://SmokeEffect.tscn")
const ICE_BULLET = preload("res://Projectiles/IceBullet.tscn")
# ---------------- NODES ----------------
@onready var sprite: AnimatedSprite2D = $Sprite
@onready var hit_sound: AudioStreamPlayer2D = $Hit
@onready var hit_box: Area2D = $SubzeroHurtBox
@onready var shoot_marker: Marker2D = $Subzeroshoot
@onready var attack_marker: Marker2D = $AttackMarker
@onready var blood_marker: Marker2D = $BloodMarker
@onready var smoke_marker: Marker2D = $SmokeMarker


func _unhandled_input(event):
	if is_cpu:
		return

	if event.is_action_pressed("left"):
		register_input("left")

	elif event.is_action_pressed("right"):
		register_input("right")

	elif event.is_action_pressed("down"):
		register_input("down")

	elif event.is_action_pressed("shoot"):
		register_input("shoot")


func update_facing_offsets():
	$AttackMarker.position = Vector2(34 * facing, -124)
	$SubzeroHurtBox/CollisionShape2D.position = Vector2(34 * facing, -81)

# ---------------- READY ----------------
func _ready():
	$Crispy.visible = false
	add_to_group("Fighter")
	add_to_group("enemy")
	add_to_group("Subzero")

	spawn_locked = false

	health = max_health
	health_changed.emit(health)

	play_anim("idle")

	ai_timer = randf_range(0.2, 0.6)

# ---------------- PHYSICS ----------------
func _physics_process(delta):

	shoot_cooldown = max(shoot_cooldown - delta, 0.0)

	combo_timer += delta

	if combo_timer > combo_reset_time:
		combo.clear()
		combo_timer = 0.0

	if is_cpu:
		cpu_logic(delta)
		move_and_slide()
		return

	if state == State.DEAD:
		return

	# ---------------- FINISH HIM STATE ----------------
	if health == 1:
		if not is_finish_state:
			is_finish_state = true
			finish_label.visible = true
			if finish_label.has_method("start_flicker"):
				finish_label.start_flicker(2.0, 0.05)
	else:
		if is_finish_state:
			is_finish_state = false
			finish_label.visible = false

	if health <= 1:

		is_finish_state = true

		is_hurting = false
		is_attacking = false
		is_shooting = false
		is_blocking = false

		state = State.IDLE

		velocity = Vector2.ZERO

		play_anim("idle")

		move_and_slide()
		return

	velocity.y += GRAVITY * delta

	if action_locked:
		return

	var input_dir = Input.get_axis("left", "right")
	var climb_pressed = Input.is_action_pressed("climb")

	# ---------------- FACING ----------------
	if input_dir != 0:
		facing = input_dir

	sprite.flip_h = facing > 0

	$AttackMarker.position = Vector2(63 * facing, -155)
	$Subzeroshoot.position = Vector2(63 * facing, -155)
	# ---------------- MOVEMENT ----------------
	velocity.x = input_dir * SPEED

	# ---------------- CLIMB ----------------
	if climb_pressed and not is_on_floor() and is_on_wall():
		state = State.CLIMB

	elif not is_on_floor():
		state = State.JUMP

	elif input_dir != 0:
		state = State.RUN

	else:
		state = State.IDLE

	# ---------------- ANIMS ----------------
	match state:

		State.CLIMB:
			velocity.y = -CLIMB_SPEED

			if not is_attacking:
				play_anim("climb")

		State.JUMP:
			if not is_attacking:
				play_anim("jump")

		State.RUN:
			if not is_attacking:
				play_anim("walk")

		State.IDLE:
			if not is_attacking:
				play_anim("idle")

	# ---------------- JUMP ----------------
	if Input.is_action_just_pressed("jump") and is_on_floor():
		velocity.y = jump_velocity

	# ---------------- ATTACKS ----------------
	if Input.is_action_just_pressed("jumpkick"):
		do_action("jumpkick")

	elif Input.is_action_just_pressed("punch"):
		do_action("punch")

	elif Input.is_action_just_pressed("roundhousekick"):
		do_action("roundhousekick")

	elif Input.is_action_just_pressed("kick"):
		do_action("kick")

	elif Input.is_action_just_pressed("uppercut"):
		do_action("uppercut")

	elif Input.is_action_pressed("shoot"):
		shoot_player()

	elif Input.is_action_just_pressed("shoot"):
		if shoot_cooldown <= 0:
			shoot_player()

	elif Input.is_action_pressed("block"):
		start_block()

	else:
		stop_block()

	move_and_slide()
# ---------------- BLOCK ----------------
func start_block():

	if state == State.DEAD:
		return

	is_blocking = true
	state = State.BLOCK

	play_anim("block")

func stop_block():

	if is_blocking:
		is_blocking = false
		state = State.IDLE

# ---------------- CPU LOGIC ----------------
func cpu_logic(delta):
	# ---------------- HURT PRIORITY ----------------
	if is_hurting:

		if is_spear_pulled:
			# opposite of normal knockback
			velocity.x = -facing * -600
		else:
			# normal knockback
			velocity.x = -facing * 600

		knockback_x = move_toward(knockback_x, 0, 10 * delta)

		if abs(knockback_x) < 10:
			knockback_x = 0
			is_hurting = false
			is_spear_pulled = false

		return

	if target == null or !is_instance_valid(target):
		velocity.x = 0
		return

# GRAVITY
	velocity.y += GRAVITY * delta

	var dist = target.global_position.x - global_position.x
	var direction = sign(dist)

	# HARD LOCK (Liu Kang style behavior)
	if action_locked:
		return

# STOP ALL ACTIONS AT 1HP
	if health <= 1:
		is_attacking = false
		action_locked = true
		velocity.x = 0
		move_and_slide()
		return

	ai_timer -= delta

	velocity.y += GRAVITY * delta
	facing = direction
	sprite.flip_h = facing > 0

# GRAVITY
	velocity.y += GRAVITY * delta


# ---------------- MOVEMENT ----------------
	if not is_attacking:
		play_anim("walk")

	if abs(dist) > 220:
		velocity.x = direction * SPEED * 0.8
		state = State.RUN
		play_anim("walk")
	else:
		velocity.x = direction * SPEED * 0.8
		state = State.RUN
		play_anim("walk")



	# ---------------- AI ACTIONS ----------------
	if ai_timer <= 0:

		ai_timer = randf_range(0.4, 0.8)

		match randi() % 5:

			0:
				do_action("punch")

			1:
				do_action("kick")

			2:
				do_action("uppercut")

			3:
				do_action("roundhousekick")

			4:
				shoot_player()

# ---------------- ACTION ----------------
func do_action(anim_name: String):

	if is_finish_state:
		return

	if state == State.DEAD:
		return

	if action_locked:
		return

	action_locked = true
	is_attacking = true
	lock_timer = 0.6

	play_anim(anim_name)

	# ---------------- NORMAL ATTACKS ----------------
	if anim_name in [
		"punch",
		"kick",
		"uppercut",
		"roundhousekick",
		"jumpkick"
	]:
		spawn_attack(anim_name)

	# ---------------- SUBZERO SPECIAL (NO NEW NAME) ----------------
	if has_node("AttackMarker"):
		$AttackMarker.call_deferred("emit_signal", "trigger_attack")

	await get_tree().create_timer(0.25).timeout

	is_attacking = false
	action_locked = false
	hurt_locked = false

# ---------------- COMBOS ----------------
func register_input(input: String):

	combo.append(input)

	combo_timer = 0.0

	check_combos()

# ---------------- ICE COMBO ----------------
func ice_combo():
	combo_used.emit("ice")

	special_bullet = ICE_BULLET

	spawn_fx(ICE_DEATH)

	combo.clear()


func check_combos():

	if combo == ICE_COMBO:
		ice_combo()
		return

# ---------------- ATTACK ----------------
func spawn_attack(anim_name: String):

	if anim_name not in [
		"punch",
		"kick",
		"uppercut",
		"roundhousekick",
		"jumpkick"
	]:
		return
	var attack = SUBZERO_ATTACK.instantiate()
	get_tree().current_scene.add_child(attack)

	attack.global_position = attack_marker.global_position
	attack.scale.x = facing  # THIS replaces facing system

	var dmg := 1

	match anim_name:
		"uppercut":
			dmg = 1
		"roundhousekick":
			dmg = 1

	if attack.has_method("set_damage"):
		attack.set_damage(dmg)
	else:
		attack.damage = dmg

	attack.owner = self

# ---------------- SHOOT ----------------
func shoot_player():

	if is_shooting:
		return

	is_shooting = true
	is_attacking = true
	action_locked = true

	play_anim("shoot")

	var bullet = BULLET_SCENE.instantiate()
	get_tree().current_scene.add_child(bullet)

	bullet.global_position = shoot_marker.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	await get_tree().create_timer(0.25).timeout

	is_shooting = false

	if is_hurting or state == State.DEAD:
		return

	is_attacking = false
	action_locked = false

# ---------------- DAMAGE ----------------
func take_damage(amount: int):

	if state == State.DEAD:
		return

	if spawn_protection:
		return

	if not can_take_damage:
		return

	# 🔥 FRAME LOCK (prevents multi-hit stacking)
	var frame := Engine.get_physics_frames()
	if has_meta("last_damage_frame") and get_meta("last_damage_frame") == frame:
		return
	set_meta("last_damage_frame", frame)

	# BLOCK REDUCTION
	if is_blocking:
		amount = max(amount - 1, 0)

	if amount <= 0:
		return

	# APPLY DAMAGE
	health -= amount
	health = max(health, 0)

	print("ouch")
	print("Subzero took damage: ", amount, " HP=", health)

	health_changed.emit(health)
	hit_sound.play()

# ---------------- FINISH HIM ----------------
	if health == 1 and not is_finish_state:

		trigger_finish_state()
		return

	# ---------------- DEATH ----------------
		# ---------------- FINAL HIT ----------------
	if health <= 0:

		die()
		await get_tree().create_timer(0.5).timeout

		get_tree().change_scene_to_file("res://CharacterSelect.tscn")
		return

	# ---------------- NORMAL HURT ----------------
	is_hurting = true
	hurt_locked = true
	action_locked = true

	state = State.IDLE
	play_anim("hurt")

	# knockback should be handled outside, NOT here

	await get_tree().create_timer(0.25).timeout

	is_hurting = false
	hurt_locked = false
	action_locked = false

func trigger_finish_state():

	if is_finish_state:
		return

	is_finish_state = true

	state = State.IDLE
	velocity = Vector2.ZERO

	action_locked = true
	hurt_locked = false
	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

	play_anim("idle")

	finish_label.visible = true

	if finish_label.has_method("start_flicker"):
		finish_label.start_flicker(2.0, 0.05)
		die()
	await get_tree().create_timer(2.0).timeout

	if is_instance_valid(finish_label):
		finish_label.visible = false

	state = State.IDLE
	velocity = Vector2.ZERO

	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

# ---------------- DEATH ----------------
func die():

	if state == State.DEAD:
		return

	state = State.DEAD

	var death = BLOOD_DEATH.instantiate()
	get_tree().current_scene.add_child(death)
	death.global_position = global_position

	# stop everything
	velocity = Vector2.ZERO
	is_attacking = false
	is_shooting = false
	action_locked = true
	hurt_locked = true
	is_hurting = false

	# 🔥 HARD SWAP SPRITES
	$Sprite.visible = false          # AnimatedSprite2D OFF
	$Crispy.visible = true         # static image ON


	# optional delay before menu
	await get_tree().create_timer(1.5).timeout

	get_tree().change_scene_to_file("res://CharacterSelect.tscn")



func spawn_fx(scene: PackedScene):

	var fx = scene.instantiate()

	# IMPORTANT: set owner BEFORE it can collide
	fx.owner_character = self
	fx.damage_done = false

	get_tree().current_scene.call_deferred("add_child", fx)

	await get_tree().process_frame

	if target and is_instance_valid(target):
		fx.global_position = target.global_position + Vector2(60 * facing, 0)
	else:
		fx.global_position = global_position + Vector2(80 * facing, 0)

# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):

	if current_anim == anim_name:
		return

	current_anim = anim_name
	sprite.play(anim_name)

func _on_subzero_hurt_box_area_entered(area: Area2D) -> void:

	if area == null or !is_instance_valid(area):
		return

	var parent = area.get_parent()
	if parent == null or !is_instance_valid(parent):
		return

	# debug AFTER validation
	print("AREA:", area.name)
	print("PARENT:", parent.name)
	print("GROUPS:", area.get_groups())

	# ---------------- GLOBAL SAFETY BLOCKS ----------------
	if state == State.DEAD:
		return

	if health <= 1:
		return

	if hurt_cooldown:
		return

	if not can_take_damage:
		return

	if spawn_protection:
		return

	# ❌ never treat hurtboxes as damage
	if area.is_in_group("HurtBox"):
		return


	# 🔥 FRAME LOCK (IMPORTANT FIX FOR SPAM)
	var frame := Engine.get_physics_frames()
	if has_meta("last_hit_frame") and get_meta("last_hit_frame") == frame:
		return


	var hit := false
	var knock := 0


	# ---------------- SPEAR PRIORITY ----------------
	if area.is_in_group("ReptileSpear"):
		set_meta("last_hit_frame", frame)

		hurt_cooldown = true
		is_spear_pulled = true
		is_hurting = true
		action_locked = true

		take_damage(1)

		await get_tree().create_timer(0.8).timeout

		is_spear_pulled = false
		is_hurting = false
		action_locked = false
		hurt_cooldown = false
		return


	# ---------------- IGNORE STUN SOURCES ----------------
	if area.is_in_group("SubzeroBullet"):
		return


	# ---------------- HIT TYPES ----------------
	if area.is_in_group("HitBox"):
		knock = -facing * 700
		hit = true

	elif area.is_in_group("ReptileAcid") \
	or area.is_in_group("RaidenElectricBullet") \
	or area.is_in_group("ElectricBullet") \
	or area.is_in_group("KanoBullet") \
	or area.is_in_group("JohnnyCageBullet") \
	or area.is_in_group("SonyaBullet") \
	or area.is_in_group("FireBullet") \
	or area.is_in_group("KanoBullet"):
		knock = -facing * 600
		hit = true

	elif area.is_in_group("ElectricForceField") \
	or area.is_in_group("ElectricBurst"):
		knock = 0
		hit = true


	# ---------------- APPLY DAMAGE ----------------
	if hit and not hurt_cooldown:

		set_meta("last_hit_frame", frame)

		hurt_cooldown = true
		knockback_x = knock

		hit_box.monitoring = false

		take_damage(1)

		await get_tree().create_timer(0.15).timeout

		hit_box.monitoring = true
		hurt_cooldown = false
