func shoot_player():
	if is_shooting:
		return

	is_shooting = true
	is_attacking = true
	action_locked = true

	play_anim("shoot")

	# PLAY ICE SOUND
	$Ice.play()

	var bullet_scene: PackedScene = BULLET_SCENE

	if special_bullet != null:
		bullet_scene = special_bullet
		special_bullet = null   # use the special bullet once

	var bullet = bullet_scene.instantiate()
	get_tree().current_scene.add_child(bullet)

	bullet.global_position = $Subzeroshoot.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	await get_tree().create_timer(0.25).timeout

	is_shooting = false
	is_attacking = false
	action_locked = false

# ---------------- DAMAGE ----------------
# =========================================================
# TAKE DAMAGE

func take_damage(amount: int):

	# =====================================================
	# BASIC DAMAGE LOCKS
	# =====================================================

	if not can_take_damage:
		return

	if state == State.DEAD:
		return

	if spawn_protection:
		return


	# =====================================================
	# PREVENT MULTIPLE DAMAGE ON SAME PHYSICS FRAME
	# =====================================================

	var frame := Engine.get_physics_frames()

	if has_meta("last_damage_frame"):

		if get_meta("last_damage_frame") == frame:
			return

	set_meta("last_damage_frame", frame)


	# =====================================================
	# TEMPORARY DAMAGE COOLDOWN
	# =====================================================

	can_take_damage = false

	get_tree().create_timer(0.25).timeout.connect(
		func():

			if is_instance_valid(self) and state != State.DEAD:
				can_take_damage = true
	)


	# =====================================================
	# BLOCK REDUCTION
	# =====================================================

	if is_blocking:

		amount = max(
			amount - 1,
			0
		)

	if amount <= 0:
		return


	# =====================================================
	# APPLY DAMAGE
	# =====================================================

	health -= amount
	health = max(
		health,
		0
	)

	print("================================")
	print("SUB-ZERO TOOK DAMAGE: ", amount)
	print("SUB-ZERO HP: ", health)
	print("ROUND: ", Game.current_round)
	print("================================")

	health_changed.emit(health)


	# =====================================================
	# HIT SOUND
	# =====================================================

	if is_instance_valid(hit_sound):
		hit_sound.play()


	# =====================================================
	# FINAL HIT
	# =====================================================

	if health <= 0:

		is_attacking = false
		is_shooting = false
		is_hurting = false
		is_blocking = false

		if is_instance_valid(finish_label):
			finish_label.visible = false

		die()

		return


	# =====================================================
	# FINISH HIM
	# =====================================================
	#
	# ONLY trigger FINISH HIM when the opponent already
	# has 1 round win.
	#
	# This means killing Sub-Zero will give the opponent
	# their SECOND round win.
	#
	# Game.current_round is NOT used here.
	# =====================================================

	if health == 1 and not is_finish_state:

		var opponent_will_win_match := false


		# =================================================
		# SUB-ZERO IS PLAYER 1
		# =================================================

		if is_in_group("player1"):

			# CPU already has 1 round win.
			if Game.p2_round_wins >= 1:
				opponent_will_win_match = true


		# =================================================
		# SUB-ZERO IS CPU
		# =================================================

		else:

			# Player 1 already has 1 round win.
			if Game.p1_round_wins >= 1:
				opponent_will_win_match = true


		# =================================================
		# TRIGGER FINISH HIM
		# =================================================

		if opponent_will_win_match:

			is_hurting = false
			hurt_locked = false
			action_locked = false

			trigger_finish_state()

			return


	# =====================================================
	# NORMAL HURT
	# =====================================================

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	state = State.IDLE

	combo.clear()

	play_anim("hurt")


	# =====================================================
	# HURT SOUND
	# =====================================================

	if is_instance_valid(hurt_sound):
		hurt_sound.play()


	# =====================================================
	# BLOOD EFFECT
	# =====================================================

	if has_node("BloodMarker"):

		var blood = BLOOD_EFFECT.instantiate()

		get_tree().current_scene.add_child(blood)

		blood.global_position = $BloodMarker.global_position


	# =====================================================
	# HURT DURATION
	# =====================================================

	await get_tree().create_timer(0.25).timeout

	if state == State.DEAD:
		return

	is_hurting = false
	hurt_locked = false
	action_locked = false


	# =====================================================
	# RETURN TO IDLE
	# =====================================================

	if state != State.DEAD and not is_finish_state:

		play_anim("idle")

func trigger_finish_state():

	if is_finish_state:
		return

	is_finish_state = true

	state = State.IDLE

	# force them to fall back down
	velocity.x = 0
	velocity.y = 0

	action_locked = true
	hurt_locked = false
	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

	# cancel any uppercut/fly state
	set_meta("uppercut_launched", false)

	play_anim("idle")

	finish_label.visible = true

	if finish_label.has_method("start_flicker"):
		finish_label.start_flicker(2.0, 0.05)

	# let gravity work
	await get_tree().create_timer(0.1).timeout

	while not is_on_floor():
		velocity.y += 5000.0 * get_physics_process_delta_time()
		move_and_slide()
		await get_tree().physics_frame

	velocity = Vector2.ZERO

	await get_tree().create_timer(2.0).timeout

	if is_instance_valid(finish_label):
		finish_label.visible = false

# =========================================================
# DEATH
# =========================================================

func die():

	# =====================================================
	# ALREADY DEAD
	# =====================================================

	if state == State.DEAD:
		return

	# =====================================================
	# LOCK SUB-ZERO AS DEAD
	# =====================================================

	state = State.DEAD

	velocity = Vector2.ZERO

	is_attacking = false
	is_shooting = false
	is_blocking = false
	is_hurting = false

	action_locked = true
	hurt_locked = true

	can_take_damage = false

	stunned = false
	is_pulled = false
	is_spear_pulled = false

	pull_target = null
	pull_timer = 0.0

	knockback_x = 0.0
	uppercut_launched = false
	was_uppercut = false
	hurt_cooldown = false

	run_locked = false

	# =====================================================
	# STOP CPU ACTIONS
	# =====================================================

	ai_timer = 999999.0

	# =====================================================
	# HIDE FINISH HIM
	# =====================================================

	if is_instance_valid(finish_label):
		finish_label.visible = false

	# =====================================================
	# DETERMINE ROUND WINNER
	# =====================================================

	var winner := ""

	if is_in_group("player1"):

		# Sub-Zero is Player 1
		winner = "cpu"

	else:

		# Sub-Zero is CPU
		winner = "player1"

	# =====================================================
	# DEBUG
	# =====================================================

	print("================================")
	print("SUB-ZERO DIED")
	print("ROUND: ", Game.current_round)
	print(
		"CURRENT SCORE: ",
		Game.p1_round_wins,
		" - ",
		Game.p2_round_wins
	)
	print("ROUND WINNER: ", winner)
	print("================================")

	# =====================================================
	# DETERMINE IF THIS DEATH ENDS THE MATCH
	# =====================================================

	var match_will_end := false

	if winner == "player1":

		if Game.p1_round_wins >= 1:
			match_will_end = true

	else:

		if Game.p2_round_wins >= 1:
			match_will_end = true

	print("MATCH WILL END: ", match_will_end)

	# =====================================================
	# HIDE NORMAL SPRITE
	# SHOW CRISPY
	# =====================================================

	$Sprite.visible = false
	$Crispy.visible = true

	# IMPORTANT:
	# Crispy uses the OPPOSITE flip convention
	# from the normal Sprite.
	$Crispy.flip_h = facing > 0

	# =====================================================
	# FINAL MATCH DEATH
	# =====================================================

	if match_will_end:

		print("================================")
		print("SUB-ZERO FINAL DEATH")
		print("FATALITY ALLOWED")
		print("================================")

		# -------------------------------------------------
		# BLOOD DEATH EFFECT
		# -------------------------------------------------

		var blood = BLOOD_DEATH.instantiate()

		get_tree().current_scene.add_child(blood)

		blood.global_position = global_position

		# -------------------------------------------------
		# MAKE SURE CRISPY IS SHOWN
		# -------------------------------------------------

		$Sprite.visible = false
		$Crispy.visible = true

		# Crispy uses opposite flip direction
		$Crispy.flip_h = facing > 0

		# -------------------------------------------------
		# HIDE FINISH HIM
		# -------------------------------------------------

		if is_instance_valid(finish_label):
			finish_label.visible = false

		# -------------------------------------------------
		# WAIT FOR FINAL DEATH / FATALITY
		# -------------------------------------------------

		await get_tree().create_timer(3.0).timeout

		# -------------------------------------------------
		# TELL LEVEL1 WHO WON
		# -------------------------------------------------

		round_death.emit(winner)

		return

	# =====================================================
	# NORMAL ROUND DEATH
	# =====================================================

	print("================================")
	print("SUB-ZERO ROUND DEATH")
	print("NO FATALITY")
	print("LEVEL1 WILL HANDLE NEXT ROUND")
	print("================================")

	# =====================================================
	# HIDE FINISH HIM
	# =====================================================

	if is_instance_valid(finish_label):
		finish_label.visible = false

	# =====================================================
	# KEEP CRISPY FACING CORRECTLY
	# =====================================================

	$Sprite.visible = false
	$Crispy.visible = true

	# Crispy uses opposite flip convention
	$Crispy.flip_h = facing > 0

	# =====================================================
	# GIVE LEVEL1 CONTROL
	# =====================================================

	round_death.emit(winner)

func play_anim(anim_name: String):

	if current_anim == anim_name:
		return

	current_anim = anim_name

	sprite.play(anim_name)

func spawn_fx(scene: PackedScene):

	if scene == null:
		print("SUB-ZERO FX ERROR: scene is null")
		return

	var fx = scene.instantiate()

	# Set properties BEFORE adding to scene
	if "owner_character" in fx:
		fx.owner_character = self

	if "damage_done" in fx:
		fx.damage_done = false

	get_tree().current_scene.add_child(fx)

	# Find Player 1 for fatality positioning
	var p1 = get_tree().get_first_node_in_group("player1")

	if p1 != null and is_instance_valid(p1):
		fx.global_position = p1.global_position + Vector2(60 * facing, 0)
	else:
		fx.global_position = global_position + Vector2(80 * facing, 0)

	print("SUB-ZERO SPAWNED FX: ", scene.resource_path)
	print("FX POSITION: ", fx.global_position)

func _on_subzero_hurt_box_area_entered(area: Area2D) -> void:

	print("Subzero hit by:", area.name)
	print(area.get_groups())

	if area == null or not is_instance_valid(area):
		return

	if state == State.DEAD:
		return

	if not can_take_damage:
		return

	if hurt_cooldown:
		return

	# =====================================================
	# ONLY ACCEPT REAL ATTACKS
	# =====================================================

	if not (
		area.is_in_group("HitBox")
		or area.is_in_group("ReptileAcid")
		or area.is_in_group("RaidenElectricBullet")
		or area.is_in_group("FireBullet")
		or area.is_in_group("Fireball")
		or area.is_in_group("SonyaBullet")
		or area.is_in_group("JohnnyCageBullet")
		or area.is_in_group("KanoBullet")
		or area.is_in_group("IceBullet")
		or area.is_in_group("KanoAttack")
	):
		return

	hurt_cooldown = true

	# =====================================================
	# DETECT UPPERCUT
	# =====================================================

	var got_uppercut := false

	if area.get("attack_name") != null:
		if area.attack_name == "uppercut":
			got_uppercut = true

	# =====================================================
	# APPLY KNOCKBACK
	# =====================================================

	knockback_x = -facing * 100

	# =====================================================
	# UPPERCUT REACTION
	# =====================================================

	if got_uppercut:

		was_uppercut = true

		# Stop normal actions
		is_attacking = false
		is_shooting = false
		is_blocking = false
		action_locked = true
		hurt_locked = true
		is_hurting = true

		state = State.JUMP

		# Launch Sub-Zero upward
		velocity.y = jump_velocity

		# Make sure normal animation system cannot immediately
		# replace wasuppercut
		current_anim = "wasuppercut"
		sprite.play("wasuppercut")

		if is_instance_valid(hurt_sound):
			hurt_sound.play()

		take_damage(1)

		await sprite.animation_finished

		# Wait until Sub-Zero comes back down
		while not is_on_floor() and state != State.DEAD:
			await get_tree().physics_frame

		if state != State.DEAD:

			was_uppercut = false
			is_hurting = false
			hurt_locked = false
			action_locked = false
			is_attacking = false

			state = State.IDLE

			play_anim("idle")

		await get_tree().create_timer(0.2).timeout
		hurt_cooldown = false

		return

	# =====================================================
	# NORMAL HIT
	# =====================================================

	current_anim = "hurt"
	sprite.play("hurt")

	if is_instance_valid(hurt_sound):
		hurt_sound.play()

	take_damage(1)

	await get_tree().create_timer(0.2).timeout

	hurt_cooldown = false
