extends CharacterBody2D
class_name Subzero

signal health_changed(health)
signal combo_used(combo_name: String)

# ---------------- STATE ----------------
enum State { IDLE, SRUN, SJUMP, SJUMPKICK, SBLOCK, SPUNCH, SCLIMB, DEAD }

var state: State = State.IDLE

# ---------------- CPU ----------------
var is_cpu := false
var target: Node2D = null
var ai_timer := 0.0

# ---------------- COMBAT FLAGS ----------------
var is_hurting := false
var is_shooting := false
var is_attacking := false
var action_locked := false
var hurt_locked := false

var facing := 1
var current_anim := ""

var health: int
var can_take_damage := true
var already_hit := false
var can_shoot := false

const GRAVITY = 5000

# ---------------- EXPORTS ----------------
@export var SPEED = 900.0
@export var SCLIMB_SPEED = 250.0
@export var max_health: int = 10
@export var sjump_velocity = -1800.0
@export var combo_reset_time := 0.6

# ---------------- PRELOADS ----------------
const BULLET_SCENE = preload("res://Projectiles/Subzerobullet.tscn")
const SUBZERO_ATTACK = preload("res://Projectiles/SubzeroAttack.tscn")
const ICE_DEATH = preload("res://Deaths/IceDeath.tscn")

# ---------------- NODES ----------------
@onready var sprite: AnimatedSprite2D = $Sprite
@onready var hit_sound: AudioStreamPlayer2D = $Hit
@onready var hit_box: Area2D = $HitBox
@onready var shoot_marker: Marker2D = $Subzeroshoot
@onready var attack_marker: Marker2D = $AttackMarker

# ---------------- COMBOS ----------------
var combo := []
var combo_timer := 0.0

const FIRE_COMBO = ["sdown", "sright", "sshoot"]
const ICE_COMBO = ["sleft", "sleft", "sshoot"]
const ELECTRIC_COMBO = ["sup", "sdown", "sshoot"]

# ---------------- READY ----------------
func _ready():
	add_to_group("enemy")
	add_to_group("Subzero")

	health = max_health
	call_deferred("emit_health")

	play_anim("sidle")


func emit_health():
	health_changed.emit(health)


# ---------------- INPUT ----------------
func _unhandled_input(event):
	if is_cpu:
		return

	if event.is_action_pressed("sup"):
		register_input("sup")
	elif event.is_action_pressed("sdown"):
		register_input("sdown")
	elif event.is_action_pressed("sleft"):
		register_input("sleft")
	elif event.is_action_pressed("sright"):
		register_input("sright")
	elif event.is_action_pressed("sshoot"):
		register_input("sshoot")


# ---------------- PHYSICS ----------------
func _physics_process(delta):

	if is_cpu:
		cpu_logic(delta)
		move_and_slide()
		return

	if state == State.DEAD:
		return

	if action_locked or hurt_locked:
		move_and_slide()
		return

	var input_dir = Input.get_axis("sleft", "sright")
	var climb_pressed = Input.is_action_pressed("sclimb")

	velocity.y += GRAVITY * delta

	if input_dir != 0:
		facing = input_dir

	velocity.x = input_dir * SPEED
	sprite.flip_h = facing > 0

	if climb_pressed and not is_on_floor() and is_on_wall():
		state = State.SCLIMB
	elif not is_on_floor():
		state = State.SJUMP
	elif input_dir != 0:
		state = State.SRUN
	else:
		state = State.IDLE

	match state:
		State.SCLIMB:
			velocity.y = -SCLIMB_SPEED
			play_anim("sclimb")
		State.SJUMP:
			play_anim("sjump")
		State.SRUN:
			play_anim("srun")
		State.IDLE:
			play_anim("sidle")

	if Input.is_action_just_pressed("sjump") and is_on_floor():
		velocity.y = sjump_velocity

	if Input.is_action_just_pressed("sjumpkick"):
		do_action("sjumpkick")
	elif Input.is_action_pressed("sblock"):
		do_action("sblock")
	elif Input.is_action_just_pressed("spunch"):
		do_action("spunch")
	elif Input.is_action_pressed("sroundhousekick"):
		do_action("sroundhousekick")
	elif Input.is_action_pressed("skick"):
		do_action("skick")
	elif Input.is_action_pressed("suppercut"):
		do_action("suppercut")
	elif Input.is_action_just_pressed("sshoot"):
		shoot_player()

	move_and_slide()


# ---------------- CPU AI (UNCHANGED) ----------------
func cpu_logic(delta):

	if target == null:
		return

	ai_timer -= delta

	var dist = target.global_position.x - global_position.x
	var dir = sign(dist)
	var abs_dist = abs(dist)

	facing = dir
	sprite.flip_h = facing > 0

	velocity.y += GRAVITY * delta

	if abs_dist > 220:
		velocity.x = dir * SPEED * 0.8
	else:
		velocity.x = 0

	if target.has_method("is_attacking") and target.is_attacking and abs_dist < 180:
		do_action("sblock")
		return

	if ai_timer > 0:
		return

	ai_timer = randf_range(0.4, 0.8)

	var r = randi() % 5

	match r:
		0: do_action("spunch")
		1: do_action("skick")
		2: do_action("suppercut")
		3: do_action("sroundhousekick")
		4:
			if randf() < 0.3:
				shoot_player()


# ---------------- ACTION ----------------
func do_action(anim_name: String):

	if state == State.DEAD:
		return

	if action_locked:
		return

	action_locked = true
	is_attacking = true

	play_anim(anim_name)

	if anim_name in ["spunch", "skick", "sroundhousekick", "suppercut"]:
		spawn_attack()

	await sprite.animation_finished

	is_attacking = false
	action_locked = false
	play_anim("sidle")


# ---------------- ATTACK ----------------
func spawn_attack():
	var attack = SUBZERO_ATTACK.instantiate()
	attack.global_position = attack_marker.global_position
	get_tree().current_scene.add_child(attack)


# ---------------- SHOOT ----------------
func shoot_player():

	if is_shooting:
		return

	is_shooting = true
	is_attacking = true

	play_anim("sshoot")

	var bullet = BULLET_SCENE.instantiate()
	get_tree().current_scene.add_child(bullet)

	bullet.global_position = shoot_marker.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	await sprite.animation_finished

	is_shooting = false
	is_attacking = false
	play_anim("sidle")


# ---------------- DAMAGE ----------------
func take_damage(amount: int):

	if state == State.DEAD or not can_take_damage:
		return

	can_take_damage = false
	is_hurting = true
	hurt_locked = true

	health -= amount
	health = max(health, 0)

	health_changed.emit(health)

	hit_sound.play()
	play_anim("shurt")

	await sprite.animation_finished

	is_hurting = false
	hurt_locked = false
	can_take_damage = true
	already_hit = false

	if health <= 0:
		die()
	else:
		play_anim("sidle")


# ---------------- HIT ----------------
func _on_hit_box_area_entered(area):

	if already_hit:
		return

	if area.is_in_group("ReptileBullet"):
		already_hit = true
		take_damage(1)

	if area.is_in_group("Reptile"):
		already_hit = true
		take_damage(1)

	if area.is_in_group("ReptileAttack"):
		already_hit = true
		take_damage(1)


# ---------------- DEATH ----------------
func die():
	state = State.DEAD
	velocity = Vector2.ZERO

	var death = ICE_DEATH.instantiate()
	death.global_position = global_position
	get_tree().current_scene.add_child(death)

	queue_free()


# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):
	if current_anim == anim_name:
		return
	current_anim = anim_name
	sprite.play(anim_name)


# ---------------- COMBOS ----------------
func register_input(input: String):
	combo.append(input)
	combo_timer = 0.0
	check_combos()


func check_combos():
	if combo == FIRE_COMBO:
		combo_used.emit("fire")
		combo.clear()
	elif combo == ICE_COMBO:
		combo_used.emit("ice")
		combo.clear()
	elif combo == ELECTRIC_COMBO:
		combo_used.emit("electric")
		combo.clear()
