extends CharacterBody2D
class_name Subzero

signal health_changed(health)
signal combo_used(combo_name: String)

# ---------------- STATE ----------------
enum State { SIDLE, SRUN, SJUMP, SJUMPKICK, SBLOCK, SPUNCH, SCLIMB, SDEAD }
var state: State = State.SIDLE

var is_hurting := false
var is_shooting := false
var is_attacking := false
var action_locked := false
var hurt_locked := false

var facing := -1
var current_anim := ""

var health: int
var can_take_damage := true
var already_hit := false
var can_shoot := false

var frozen := false
var flashing := false

var original_color := Color.WHITE

const GRAVITY = 5000

# ---------------- EXPORTS ----------------
@export var SPEED = 850.0
@export var CLIMB_SPEED = 220.0
@export var max_health: int = 20
@export var jump_velocity = -1700.0

# ---------------- PRELOADS ----------------
const BULLET_SCENE = preload("res://Projectiles/Subzerobullet.tscn")
const ICE_ATTACK = preload("res://Projectiles/ReptileAttack.tscn")
const ICE_DEATH = preload("res://Deaths/IceDeath.tscn")

# ---------------- NODES ----------------
@onready var sprite: AnimatedSprite2D = $Sprite
@onready var hit_sound: AudioStreamPlayer2D = $Hit
@onready var hit_box: Area2D = $HitBox
@onready var shoot_marker: Marker2D = $Reptileshoot
@onready var attack_marker: Marker2D = $AttackMarker

# ---------------- READY ----------------
func _ready():

	add_to_group("enemy")
	add_to_group("Subzero")

	health = max_health
	health_changed.emit(health)

	original_color = sprite.modulate
	play_anim("sidle")

# ---------------- PHYSICS ----------------
func _physics_process(delta):

	if state == State.SDEAD:
		return

	if frozen or action_locked or hurt_locked:
		move_and_slide()
		return

	var input_dir = Input.get_axis("sleft", "sright")
	var climb_pressed = Input.is_action_pressed("sclimb")
	var on_wall = is_on_wall()

	velocity.y += GRAVITY * delta

	if input_dir != 0:
		facing = input_dir

	velocity.x = input_dir * SPEED
	sprite.flip_h = facing > 0

	if climb_pressed and not is_on_floor() and on_wall:
		state = State.SCLIMB
	elif not is_on_floor():
		state = State.SJUMP
	elif input_dir != 0:
		state = State.SRUN
	else:
		state = State.SIDLE

	match state:
		State.SCLIMB:
			velocity.y = -CLIMB_SPEED
			play_anim("sclimb")
		State.SJUMP:
			play_anim("sjump")
		State.SRUN:
			play_anim("srun")
		State.SIDLE:
			play_anim("sidle")

	if Input.is_action_just_pressed("sjump") and is_on_floor():
		velocity.y = jump_velocity

	if Input.is_action_just_pressed("sshoot"):
		ice_shoot()

	if Input.is_action_just_pressed("spunch"):
		do_action("spunch")

	move_and_slide()

# ---------------- SHOOT ----------------
func ice_shoot():

	if is_shooting or state == State.SDEAD:
		return

	is_shooting = true
	is_attacking = true

	play_anim("sshoot")

	var bullet = BULLET_SCENE.instantiate()
	get_tree().current_scene.add_child(bullet)

	bullet.global_position = shoot_marker.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	await sprite.animation_finished

	is_shooting = false
	is_attacking = false
	play_anim("sidle")

# ---------------- ATTACK ----------------
func do_action(anim_name: String):

	if state == State.SDEAD:
		return

	action_locked = true
	is_attacking = true

	play_anim(anim_name)

	var attack = ICE_ATTACK.instantiate()
	attack.global_position = attack_marker.global_position
	get_tree().current_scene.add_child(attack)

	await sprite.animation_finished

	is_attacking = false
	action_locked = false
	play_anim("sidle")

# ---------------- DAMAGE ----------------
func take_damage(amount: int):

	if state == State.SDEAD or not can_take_damage:
		return

	can_take_damage = false
	is_hurting = true
	hurt_locked = true

	health -= amount
	health = max(health, 0)
	health_changed.emit(health)

	if hit_sound:
		hit_sound.play()

	play_anim("shurt")
	sprite.modulate = Color(1, 0, 0)

	await sprite.animation_finished

	is_hurting = false
	hurt_locked = false
	can_take_damage = true
	already_hit = false

	# 🔥 FIX: stop color reset if dead
	if health <= 0:
		die()
		return

	sprite.modulate = original_color
	play_anim("sidle")

# ---------------- HIT ----------------
func _on_hit_box_area_entered(area):

	if state == State.SDEAD:
		return

	if already_hit:
		return

	if area.is_in_group("ReptileBullet"):
		already_hit = true
		take_damage(1)

	if area.is_in_group("Bullet"):
		already_hit = true
		area.queue_free()
		take_damage(10)

	elif area.is_in_group("ReptileAttack"):
		take_damage(1)

# ---------------- HIT BODY ----------------
func _on_hit_box_body_entered(body):
	if body.is_in_group("player"):
		can_shoot = true

func _on_hit_box_body_exited(body):
	if body.is_in_group("player"):
		can_shoot = false

# ---------------- FREEZE ----------------
func apply_freeze(time := 0.25):

	if frozen or state == State.SDEAD:
		return

	frozen = true
	sprite.modulate = Color(0.4, 0.8, 1.2)

	await get_tree().create_timer(time).timeout

	if state != State.SDEAD:
		sprite.modulate = original_color

	frozen = false

# ---------------- FLASH ----------------
func flash_red():

	if flashing or state == State.SDEAD:
		return

	flashing = true
	sprite.modulate = Color(1, 0, 0)

	await get_tree().create_timer(0.08).timeout

	if state != State.SDEAD:
		sprite.modulate = original_color

	flashing = false

# ---------------- DEATH ----------------
func die():

	if state == State.SDEAD:
		return

	state = State.SDEAD

	can_take_damage = false
	action_locked = true
	hurt_locked = true
	is_attacking = false
	is_shooting = false
	frozen = true

	velocity = Vector2.ZERO
	set_physics_process(false)

	# 🔥 keep death color locked (NO green reset)
	sprite.modulate = Color(0.7, 0.7, 0.7)

	var death_instance = ICE_DEATH.instantiate()
	death_instance.global_position = global_position
	get_tree().current_scene.add_child(death_instance)

	await get_tree().create_timer(1.5).timeout

	queue_free()

# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):

	if state == State.SDEAD:
		return

	if current_anim == anim_name:
		return

	current_anim = anim_name
	sprite.play(anim_name)
