	attack.global_position = attack_marker.global_position
	attack.scale.x = facing

	var dmg := 1

	match anim_name:
		"punch":
			dmg = 1
		"highpunch":
			dmg = 1
		"lowpunch":
			dmg = 1
		"kick":
			dmg = 1
		"highkick":
			dmg = 1
		"lowkick":
			dmg = 1
		"slidekick":
			dmg = 1
		"uppercut":
			dmg = 1
		"roundhousekick":
			dmg = 1
		"knee":
			dmg = 1

