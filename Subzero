func _unhandled_input(event):

	if event.is_action_pressed("jump"):
		velocity.y = jump_velocity

	var inputs = ["up", "down", "left", "right", "shoot", "splat"]

	for i in inputs:
		if event.is_action_pressed(i):
			register_input(i)


func update_facing_offsets():
	$AttackMarker.position = Vector2(0 * facing, 0)



# ---------------- READY ----------------
func _ready():

	print("SUBZERO READY:", self)

	$Crispy.visible = false

	add_to_group("Fighter")
	add_to_group("enemy")
	add_to_group("Subzero")

	spawn_locked = false

	health = max_health

	# Wait until Level1 connects health_changed
	call_deferred("emit_health")

	play_anim("idle")

	ai_timer = randf_range(0.2, 0.6)

	facing = 1
	sprite.flip_h = -facing < 0
	$Crispy.flip_h = -facing < 0


func emit_health():

	health_changed.emit(health)

func run(input_dir: float):
	if input_dir == 0:
		return

	state = State.RUN
	velocity.x = input_dir * SPEED * 4  # faster than walk

	if not is_attacking:
		play_anim("run")

func handle_double_tap_run(input_dir: float, delta: float) -> bool:

	if input_dir == 0:
		return false

	var now := Time.get_ticks_msec() / 1000.0

	if input_dir == last_tap_dir:
		if now - last_tap_time <= tap_time:
			run_locked = true
			return true

	last_tap_time = now
	last_tap_dir = input_dir

	return false

func apply_stun(_duration := 4.0):

	if state == State.DEAD:
		return

	stunned = true

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	velocity = Vector2.ZERO
	knockback_x = 0

	play_anim("idle")

	await get_tree().create_timer(4.0).timeout

	stunned = false

	is_hurting = false
	hurt_locked = false
	action_locked = false

# ---------------- PHYSICS ----------------
func _physics_process(delta):

	if state == State.DEAD:
		return

	if is_pulled:
		run_pull_logic(delta)
		move_and_slide()
		return

	# ---------------- STUN ----------------
	if stunned:
		velocity = Vector2.ZERO
		return

	# ---------------- DEATH / FINISH ----------------
	if state == State.DEAD:
		return

	if is_finish_state:
		state = State.IDLE
		velocity.x = 0
		if not is_hurting:
			play_anim("idle")
		move_and_slide()
		return

	# ---------------- GRAVITY (ONLY ONCE) ----------------
	velocity.y += GRAVITY * delta

	if uppercut_launched:

		move_and_slide()

		if is_on_floor():
			uppercut_launched = false

		return

	# ---------------- COOLDOWNS ----------------
	shoot_cooldown = max(shoot_cooldown - delta, 0.0)

	combo_timer += delta
	if combo_timer > combo_reset_time:
		combo.clear()

	# ---------------- CPU ----------------
	if is_cpu:
		cpu_logic(delta)
		move_and_slide()
		return

	if state == State.DEAD:
		return

	if is_finish_state:
		state = State.IDLE
		velocity.x = 0

		if not is_hurting:
			play_anim("idle")

		move_and_slide()
		return


	if action_locked:
		return

	var input_dir = Input.get_axis("left", "right")
	var climb_pressed = Input.is_action_pressed("climb")

	# ---------------- FACING ----------------
	if input_dir != 0:
		facing = input_dir

	sprite.flip_h = facing > 0
	$Crispy.flip_h = facing > 0

	$AttackMarker.position = Vector2(0 * facing, 0)
	$Subzeroshoot.position = Vector2(63 * facing, -211)

	# =========================================================
	# 🟢 MOVEMENT (RUN ADDED HERE)
	# =========================================================
	if Input.is_action_pressed("run") and input_dir != 0:
		run(input_dir)   # 🔥 CALLS YOUR NEW RUN FUNCTION
	else:
		velocity.x = input_dir * SPEED

		# ---------------- STATE ----------------
		if not is_on_floor():
			state = State.JUMP
		elif input_dir != 0:
			state = State.WALK
		elif input_dir != 0:
			state = State.RUN
		else:
			state = State.IDLE

	# ---------------- ANIMS ----------------
	match state:

		State.JUMP:
			if not is_attacking:
				play_anim("jump")

		State.WALK:
			if not is_attacking:
				play_anim("walk")

		State.RUN:
			if not is_attacking:
				play_anim("run")

		State.IDLE:
			if not is_attacking:
				play_anim("idle")

	if is_hurting and hurt_locked:
		return

	# ---------------- JUMP ----------------
	if Input.is_action_just_pressed("jump") and is_on_floor():
		velocity.y = jump_velocity

	# ---------------- ATTACKS ----------------
	if Input.is_action_just_pressed("punch"):
		do_action("punch")

	if Input.is_action_just_pressed("highpunch"):
		do_action("highpunch")

	if Input.is_action_just_pressed("lowpunch"):
		do_action("lowpunch")

	elif Input.is_action_just_pressed("roundhousekick"):
		do_action("roundhousekick")

	elif Input.is_action_just_pressed("kick"):
		do_action("kick")

	elif Input.is_action_just_pressed("kick"):
		do_action("kick")

	elif Input.is_action_just_pressed("highkick"):
		do_action("highkick")

	elif Input.is_action_just_pressed("lowkick"):
		do_action("lowkick")

	elif Input.is_action_just_pressed("uppercut"):
		do_action("uppercut")

	elif Input.is_action_pressed("knee"):
		do_action("knee")

	elif Input.is_action_pressed("splat"):
		do_action("splat")

	elif Input.is_action_just_pressed("shoot"):
		shoot_player()



	elif Input.is_action_pressed("block"):
		start_block()

	else:
		stop_block()


	move_and_slide()

func spear_pulled_to_p1():
	print("START PULL")

	is_pulled = true
	stunned = true
	action_locked = true
	is_hurting = true

	pull_timer = 0.35

	pull_target = get_tree().get_first_node_in_group("Reptile")

func run_pull_logic(delta):
	print("Running pull logic")
	if pull_target == null or !is_instance_valid(pull_target):
		is_pulled = false
		stunned = false
		action_locked = false
		return

	var dir = sign(pull_target.global_position.x - global_position.x)

	velocity.x = dir * 900
	velocity.y = -120

	pull_timer -= delta

	if pull_timer <= 0.0:

		is_pulled = false

		# SNAP to Reptile AttackMarker (THIS IS MK MOMENT)
		global_position = pull_target.attack_marker.global_position + Vector2(40 * pull_target.facing, 0)

		stunned = false
		is_hurting = false
		action_locked = false
		is_attacking = true

		pull_target = null

# ---------------- BLOCK ----------------
func start_block():

	if state == State.DEAD:
		return

	is_blocking = true
	state = State.BLOCK

	play_anim("block")

func stop_block():

	if is_blocking:
		is_blocking = false
		state = State.IDLE

# ---------------- CPU LOGIC ----------------
func cpu_logic(delta):

	# =========================================================
	# HURT PRIORITY
	# =========================================================
	if is_hurting:

		if is_spear_pulled:
			# Opposite of normal knockback
			velocity.x = -facing * -600
		else:
			# Normal knockback
			velocity.x = -facing * 100

		knockback_x = move_toward(knockback_x, 0, 1500 * delta)

		# Hurt is finished
		if abs(knockback_x) < 10:

			knockback_x = 0
			is_hurting = false
			is_spear_pulled = false

			# IMPORTANT:
			# Let CPU immediately return to finding the player
			action_locked = false
			hurt_locked = false
			is_attacking = false
			state = State.IDLE

		return


	# =========================================================
	# TARGET CHECK
	# =========================================================
	if target == null or !is_instance_valid(target):

		velocity.x = 0
		state = State.IDLE

		if not is_attacking:
			play_anim("idle")

		return


	# =========================================================
	# FINISH HIM
	# =========================================================
	if is_finish_state:

		is_attacking = false
		action_locked = true
		velocity.x = 0
		state = State.IDLE

		if not is_hurting:
			play_anim("idle")

		return


	# =========================================================
	# STOP ALL ACTIONS AT 1 HP
	# =========================================================
	if health <= 1:

		is_attacking = false
		action_locked = true
		velocity.x = 0
		state = State.IDLE

		play_anim("idle")

		return


	# =========================================================
	# HARD ACTION LOCK
	# =========================================================
	if action_locked:

		velocity.x = 0

		return


	# =========================================================
	# TARGET DISTANCE
	# =========================================================
	var dist: float = target.global_position.x - global_position.x
	var distance: float = abs(dist)
	var direction: float = sign(dist)


	# =========================================================
	# FACING
	# =========================================================
	if direction != 0:
		facing = direction

	sprite.flip_h = facing > 0

	if $Crispy:
		$Crispy.flip_h = facing > 0


	# =========================================================
	# MOVEMENT
	# =========================================================

	# Do not move while attacking
	if is_attacking:

		velocity.x = 0
		state = State.IDLE

		return


	# ---------------------------------------------------------
	# WALK TOWARD PLAYER
	# ---------------------------------------------------------
	# Sub-Zero will WALK when starting.
	# He will NOT automatically switch to RUN.
	if distance > 90:

		velocity.x = direction * SPEED
		state = State.WALK

		play_anim("walk")


	# ---------------------------------------------------------
	# PLAYER IS CLOSE
	# ---------------------------------------------------------
	else:

		velocity.x = 0
		state = State.IDLE

		play_anim("idle")


	# =========================================================
	# AI TIMER
	# =========================================================
	ai_timer -= delta


	# =========================================================
	# ATTACK RANGE
	# =========================================================
	if distance <= 90 and ai_timer <= 0:

		match Game.difficulty:


			# =================================================
			# HARD
			# =================================================
			"Hard":

				ai_timer = randf_range(0.05, 0.15)

				var choice: int = randi() % 100

				if choice < 15:
					do_action("punch")

				elif choice < 30:
					do_action("highpunch")

				elif choice < 45:
					do_action("lowpunch")

				elif choice < 60:
					do_action("kick")

				elif choice < 70:
					do_action("highkick")

				elif choice < 80:
					do_action("lowkick")

				elif choice < 90:
					do_action("uppercut")

				elif choice < 97:
					do_action("roundhousekick")

				else:
					shoot_player()


			# =================================================
			# EASY
			# =================================================
			"Easy":

				ai_timer = randf_range(0.5, 0.9)

				var choice: int = randi() % 100

				if choice < 20:
					do_action("punch")

				elif choice < 35:
					do_action("highpunch")

				elif choice < 50:
					do_action("lowpunch")

				elif choice < 65:
					do_action("kick")

				elif choice < 75:
					do_action("highkick")

				elif choice < 85:
					do_action("lowkick")

				elif choice < 95:
					do_action("uppercut")

				else:
					shoot_player()

# ---------------- ACTION ----------------
func do_action(anim_name: String):

	if is_finish_state:
		return

	if state == State.DEAD:
		return

	if action_locked:
		return

	action_locked = true
	is_attacking = true
	lock_timer = 0.6

	play_anim(anim_name)

	# ---------------- NORMAL ATTACKS ----------------
	if anim_name in [
		"punch",
		"highpunch",
		"lowpunch",
		"kick",
		"highkick",
		"lowkick",
		"uppercut",
		"roundhousekick",
		"knee"
	]:
		spawn_attack(anim_name)

	# ---------------- SUBZERO SPECIAL (NO NEW NAME) ----------------
	if has_node("AttackMarker"):
		$AttackMarker.call_deferred("emit_signal", "trigger_attack")

	await sprite.animation_finished

	is_attacking = false
	action_locked = false
	hurt_locked = false

# ---------------- COMBOS ----------------
func register_input(input: String):

	combo.append(input)

	combo_timer = 0.0

	check_combos()

# ---------------- ICE COMBO ----------------
func ice_combo():
	combo_used.emit("ice")

	special_bullet = BULLET_SCENE

	combo.clear()

	shoot_player()


func check_combos():

	if combo == ICE_DEATH_TWO_COMBO:
		combo_used.emit("ice_death_two")
		action_locked = true
		is_attacking = true
		spawn_fx(ICE_DEATHTWO)
		$Sprite.play("uppercut")
		await $Sprite.animation_finished

		action_locked = false
		play_anim("idle")
		combo.clear()
		return

	if combo == SPLAT_COMBO:

		combo_used.emit("splat")

		action_locked = true
		is_attacking = true

		# Subzero character animation
		$Sprite.play("splat")

		# Spawn ice puddle
		spawn_fx(SPLAT)

		await $Sprite.animation_finished

		is_attacking = false
		action_locked = false

		play_anim("idle")

		combo.clear()
		return

	elif combo == ICE_COMBO:
		ice_combo()
		return

	elif combo == PUNCH_COMBO:

		combo_used.emit("punch_combo")

		combo.clear()

		start_punch_combo()
		return


	# ---------------- kick ----------------
	if combo == KICK_COMBO:

		combo_used.emit("kick_combo")

		combo.clear()

		start_kick_combo()
		return

