extends Area2D
class_name SubzeroAttack

@export var damage := 1
@export var lifetime := 0.05

var has_hit := false

func _ready():

	add_to_group("SubzeroAttack")

	area_entered.connect(_on_area_entered)

	await get_tree().create_timer(lifetime).timeout

	queue_free()

func _on_area_entered(area: Area2D) -> void:

	if has_hit:
		return

	if area == null:
		return

	# HIT BOTH REPTILE + RAIDEN HURTBOXES
	if not (
		area.is_in_group("ReptilesHurtBox") or
		area.is_in_group("RaidenHurtBox")
	):
		return

	var target = area.get_parent()

	if target == null:
		return

	# DON'T HIT SELF
	if target == owner:
		return

	has_hit = true

	# DAMAGE
	if target.has_method("take_damage"):
		target.take_damage(damage)
