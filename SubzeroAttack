extends Area2D
class_name SubzeroAttack

@onready var collision: CollisionShape2D = $CollisionShape2D

@export var active_time := 0.2
@export var lifetime := 0.6

var active := false
var has_hit := false
var damage := 1

var hit_targets := {}

func _ready():
	print("wheniamused")
	add_to_group("SubzeroAttack")

	await get_tree().process_frame

	body_entered.connect(_on_body_entered)

	enable_hitbox()

	await get_tree().create_timer(active_time).timeout
	disable_hitbox()

	await get_tree().create_timer(lifetime).timeout
	queue_free()

func enable_hitbox():
	active = true
	monitoring = true
	if collision:
		collision.disabled = false


func disable_hitbox():
	active = false
	monitoring = false
	if collision:
		collision.disabled = true


func _on_body_entered(body: Node) -> void:

	if not active:
		return

	if body == null:
		return

	if not body.is_in_group("Fighter"):
		return

	if hit_targets.has(body):
		return

	if not body.has_method("take_damage"):
		return

	hit_targets[body] = true
	body.take_damage(damage)
	print("wheniamatttacking")
