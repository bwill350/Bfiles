	)

	await get_tree().process_frame

	if target and is_instance_valid(target):

		fx.fire_spawn_position = (
			$KanoShoot.global_position
			+ Vector2(240 * facing, 0)
		)

	else:

		fx.fire_spawn_position = (
			$KanoShoot.global_position
			+ Vector2(240 * facing, 0)
		)


func check_combos():

	if combo == ACID_COMBO:

		combo_used.emit("acid")

		special_bullet = ACID_BULLET

		combo.clear()

		return

	if combo == FIRE_COMBO:

		combo_used.emit("fire")

		special_bullet = FIRE_BULLET

		combo.clear()

		shoot_player()

		return

	elif combo == KICK_COMBO:

		combo_used.emit("kick_combo")

		combo.clear()

		start_kick_combo()

		return

	elif combo == PUNCH_COMBO:

		combo_used.emit("punch_combo")

		combo.clear()

		start_punch_combo()

		return


func start_punch_combo():

	if action_locked or is_hurting or state == State.DEAD:
		return

	await combo_attack([
		"punch",
		"lowpunch",
		"punch",
		"uppercut",
		"highpunch",
		"uppercut",
		"punch"
	])


func start_kick_combo():

	if kick_combo_active:
		return

	if action_locked or is_hurting or state == State.DEAD:
		return

	if health <= 1:
		return

	kick_combo_active = true
	can_take_damage = false

	await combo_attack([
		"kick",
		"knee",
		"highkick",
		"roundhousekick",
		"lowkick",
		"roundhousekick",
		"highkick"
	])

	kick_combo_active = false

	if state != State.DEAD:
		can_take_damage = true


func combo_attack(attacks: Array):

	action_locked = true
	is_attacking = true

	for attack in attacks:

		if is_hurting or state == State.DEAD:
			break

		play_anim(attack)
		spawn_attack(attack)

		await sprite.animation_finished

	is_attacking = false
	action_locked = false

	if not is_hurting:
		play_anim("idle")


# ---------------- DEATH ----------------
func die():

	if state == State.DEAD:
		return

	state = State.DEAD

	velocity = Vector2.ZERO

	is_attacking = false
	is_shooting = false
	is_blocking = false
	is_hurting = false

	action_locked = true
	hurt_locked = true
	can_take_damage = false

	stunned = false
	uppercut_launched = false
	jumpkick_launched = false

	is_pulled = false
	pull_timer = 0.0
	pull_target = null

	knockback_x = 0.0
	ai_timer = 999999.0


	# =====================================================
	# WINNER
	# =====================================================

	var winner := ""

	if is_in_group("player1"):
		winner = "cpu"
	else:
		winner = "player1"


	# =====================================================
	# GET ATTACK THAT KILLED KANO
	# =====================================================

	var incoming_attack := ""

	if has_meta("last_attack_name"):

		incoming_attack = str(
			get_meta("last_attack_name")
		).strip_edges().to_lower()

		remove_meta("last_attack_name")


	print("================================")
	print("KANO DEATH")
	print("LAST ATTACK = [", incoming_attack, "]")
	print("FINISH STATE = ", is_finish_state)
	print("================================")


	# =====================================================
	# NORMAL ROUND DEATH
	# =====================================================

	if not is_finish_state:

		$Sprite.visible = false
		$Crispy.visible = false

		if has_node("healthzero"):

			$healthzero.visible = true
			$healthzero.flip_h = facing > 0

		if has_node("fatalkick"):

			$fatalkick.visible = false

		current_anim = ""

		if is_instance_valid(finish_label):
			finish_label.visible = false

		round_death.emit(winner)

		return


	# =====================================================
	# FINISH HIM DEATH
	# =====================================================

	$Sprite.visible = false
	$Crispy.visible = false
	$healthzero.visible = false

	if has_node("fatalkick"):

		$fatalkick.visible = false

	current_anim = ""


	# =====================================================
	# JOHNNY CAGE FATAL KICK
	# =====================================================

	if incoming_attack == "fatalkick":

		print("================================")
		print("JOHNNY CAGE FATAL KICK")
		print("KANO FATALKICK SPRITE")
		print("================================")


		# ---------------------------------------------
		# HIDE NORMAL KANO SPRITES
		# ---------------------------------------------

		$Sprite.visible = false
		$Crispy.visible = false
		$healthzero.visible = false


		# ---------------------------------------------
		# SHOW STATIC FATALKICK IMAGE
		# ---------------------------------------------

		if has_node("fatalkick"):

			$fatalkick.visible = true
			$fatalkick.flip_h = facing > 0

		print(
			"KANO FATALKICK VISIBLE = ",
			$fatalkick.visible
		)


		# ---------------------------------------------
		# HOLD IMAGE
		# ---------------------------------------------

		await get_tree().create_timer(3.0).timeout


	# =====================================================
	# ANY OTHER FINISH HIM MOVE
	# =====================================================

	else:

		print("================================")
		print("KANO CRISPY DEATH")
		print("ATTACK = [", incoming_attack, "]")
		print("================================")


		$Sprite.visible = false
		$Crispy.visible = true
		$Crispy.flip_h = facing > 0
		$healthzero.visible = false


		await get_tree().create_timer(0.5).timeout


	# =====================================================
	# BLOOD DEATH EFFECT
	# =====================================================

	var blood = BLOOD_DEATH.instantiate()

	get_tree().current_scene.add_child(blood)

	blood.global_position = global_position


	# =====================================================
	# HIDE FINISH HIM
	# =====================================================

	if is_instance_valid(finish_label):
		finish_label.visible = false


	# =====================================================
	# NORMAL FINISH HIM DEATH HOLD
	# =====================================================

	if incoming_attack != "fatalkick":

		await get_tree().create_timer(3.0).timeout


	# =====================================================
	# CLEANUP
	# =====================================================

	if has_node("fatalkick"):

		$fatalkick.visible = false

	if has_node("Crispy"):

		$Crispy.visible = false


	# =====================================================
	# ROUND DEATH
	# =====================================================

	round_death.emit(winner)

	return

# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):

	if current_anim == anim_name and sprite.is_playing():
		return

	current_anim = anim_name
	sprite.play(anim_name)


# ---------------- HURT BOX ----------------
func _on_kano_hurt_box_area_entered(area: Area2D) -> void:

	if hurt_cooldown:
		return

	if area == null or !is_instance_valid(area):
		return

	if state == State.DEAD:
		return

	if not can_take_damage:
		return

	if spawn_protection:
		return

	if area.is_in_group("HurtBox"):
		return

	var valid_attack := (
		area.is_in_group("HitBox")
		or area.is_in_group("ReptileAcid")
		or area.is_in_group("ReptileBullet")
		or area.is_in_group("SubzeroBullet")
		or area.is_in_group("RaidenElectricBullet")
		or area.is_in_group("FireBullet")
		or area.is_in_group("Fireball")
		or area.is_in_group("SonyaBullet")
		or area.is_in_group("JohnnyCageBullet")
		or area.is_in_group("KanoBullet")
		or area.is_in_group("IceBullet")
		or area.is_in_group("KanoAttack")
	)

	if not valid_attack:
		return

	hurt_cooldown = true

	# =====================================================
	# GET ATTACK NAME
	# =====================================================

	var incoming_attack := ""

	if area.get("attack_name") != null:

		incoming_attack = str(
			area.attack_name
		).strip_edges().to_lower()

	if incoming_attack != "":

		set_meta(
			"last_attack_name",
			incoming_attack
		)

	# =====================================================
	# UPPERCUT
	# =====================================================

	var was_uppercut := false

	if area.get("attack_name") != null:

		if str(area.attack_name).strip_edges().to_lower() == "uppercut":

			was_uppercut = true

	# =====================================================
	# JUMPKICK
	# =====================================================

	var was_jumpkick := false

	if area.get("attack_name") != null:

		if str(area.attack_name).strip_edges().to_lower() == "jumpkick":

			was_jumpkick = true

	# =====================================================
	# KNOCKBACK
	# =====================================================

	knockback_x = -facing * 100

	# =====================================================
	# STOP CURRENT ACTION
	# =====================================================

	is_attacking = false
	is_shooting = false
	is_blocking = false

	# =====================================================
	# HIT ANIMATION
	# =====================================================

	current_anim = ""

	if was_uppercut:

		sprite.play("wasuppercut")

	elif was_jumpkick:

		sprite.play("wasjumpkick")

	else:

		sprite.play("hurt")

	# =====================================================
	# HURT SOUND
	# =====================================================

	if is_instance_valid(hurt_sound):

		hurt_sound.play()

	# =====================================================
	# DAMAGE
	# =====================================================

	take_damage(1)

	# =====================================================
	# DEATH
	# =====================================================

	if state == State.DEAD:

		hurt_cooldown = false
		return

	# =====================================================
	# FINISH HIM
	# =====================================================

	if is_finish_state:

		is_hurting = false
		hurt_locked = false
		action_locked = true

		is_attacking = false
		is_shooting = false
		is_blocking = false

		stunned = false

		velocity = Vector2.ZERO
		knockback_x = 0.0

		state = State.IDLE

		current_anim = ""

		if is_instance_valid(sprite):

			sprite.visible = true
			sprite.play("idle")

		if has_node("Crispy"):

			$Crispy.visible = false

		if has_node("healthzero"):

			$healthzero.visible = false

		if has_node("fatalkick"):

			$fatalkick.visible = false

		hurt_cooldown = false

		return

	# =====================================================
	# UPPERCUT / JUMPKICK
	# =====================================================

	if health > 1:

		is_hurting = true
		hurt_locked = true
		action_locked = true

		is_attacking = false
		is_shooting = false
		is_blocking = false

		stunned = false

		if was_uppercut:

			current_anim = ""
			sprite.play("wasuppercut")

			await sprite.animation_finished

		elif was_jumpkick:

			current_anim = ""
			sprite.play("wasjumpkick")

			await sprite.animation_finished

		else:

			await get_tree().create_timer(0.2).timeout

	# =====================================================
	# DEATH CHECK
	# =====================================================

	if state == State.DEAD or health <= 0:

		hurt_cooldown = false
		return

	# =====================================================
	# FINISH HIM CHECK
	# =====================================================

	if is_finish_state:

		hurt_cooldown = false
		return

	# =====================================================
	# 1 HP NORMAL STATE
	# =====================================================

	if health <= 1:

		is_hurting = false
		hurt_locked = false
		action_locked = false

		is_attacking = false
		is_shooting = false
		is_blocking = false

		stunned = false

		velocity = Vector2.ZERO
		knockback_x = 0.0

		state = State.IDLE

		current_anim = ""

		if is_instance_valid(sprite):

			sprite.visible = true
			sprite.play("idle")

		if has_node("Crispy"):

			$Crispy.visible = false

		if has_node("healthzero"):

			$healthzero.visible = false

		if has_node("fatalkick"):

			$fatalkick.visible = false

		hurt_cooldown = false

		return

	# =====================================================
	# NORMAL HURT RECOVERY
	# =====================================================

	is_hurting = false
	hurt_locked = false
	action_locked = false

	is_attacking = false
	is_shooting = false
	is_blocking = false

	stunned = false

	state = State.IDLE

	velocity.x = 0
	knockback_x = 0

	current_anim = ""

	if is_instance_valid(sprite):

		sprite.visible = true
		sprite.play("idle")

	await get_tree().create_timer(0.2).timeout

	if not is_instance_valid(self):

		return

	if state == State.DEAD:

		return

	if is_finish_state:

		hurt_cooldown = false
		return

	hurt_cooldown = false
