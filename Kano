	$Crispy.flip_h = facing > 0

	if is_cpu:

		if Game.difficulty == "Easy":

			state = State.IDLE
			velocity.x = 0.0
			play_anim("idle")
			ai_timer = randf_range(1.0, 1.8)

	else:

		state = State.IDLE
		velocity.x = 0.0
		play_anim("idle")


func apply_stun(_duration := 4.0):

	if state == State.DEAD:
		return

	stunned = true

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	velocity = Vector2.ZERO
	knockback_x = 0

	play_anim("idle")

	await get_tree().create_timer(4.0).timeout

	stunned = false

	is_hurting = false
	hurt_locked = false
	action_locked = false


func run(input_dir: float):

	if input_dir == 0:
		return

	# NEVER change to RUN while airborne
	if not is_on_floor():

		state = State.JUMP
		velocity.x = input_dir * SPEED * 3

		if not is_attacking:
			play_anim("jump")

		return

	state = State.RUN
	velocity.x = input_dir * SPEED * 3

	if not is_attacking:
		play_anim("run")


func handle_double_tap_run(input_dir: float, delta: float) -> bool:

	if input_dir == 0:
		return false

	var now := Time.get_ticks_msec() / 1000.0

	if input_dir == last_tap_dir:

		if now - last_tap_time <= tap_time:

			run_locked = true
			return true

	last_tap_time = now
	last_tap_dir = input_dir

	return false


func fatalknife():

	if state == State.DEAD:
		return

	if action_locked:
		return

	facing = sign(facing)
	sprite.flip_h = facing > 0

	fatalknife_active = true
	spawn_protection = true
	is_attacking = true
	action_locked = true

	current_anim = ""

	sprite.scale = Vector2(0.13, 0.13)

	sprite.play("fatalknife")

	$Knife.play()

	velocity = Vector2(facing * 2200, 0)

	get_tree().create_timer(1.0).timeout.connect(func():
		fatalknife_active = false
	)

	while fatalknife_active:

		velocity.y = 0
		velocity.x = facing * 2200

		if sprite.animation != "fatalknife":
			sprite.play("fatalknife")
		elif not sprite.is_playing():
			sprite.play("fatalknife")

		spawn_attack("fatalknife")

		$Kanoyell.play()

		await get_tree().create_timer(0.08).timeout

	velocity = Vector2.ZERO

	state = State.IDLE
	spawn_protection = false
	is_attacking = false
	action_locked = false

	sprite.scale = Vector2(0.18, 0.18)

	play_anim("idle")


# ---------------- PHYSICS ----------------
func _physics_process(delta):

	if state == State.DEAD:
		return

	if is_pulled:

		run_pull_logic(delta)
		move_and_slide()

		return

	# ---------------- STUN ----------------

	if stunned:

		velocity = Vector2.ZERO
		move_and_slide()

		return

	# ---------------- CANNONBALL LOCK ----------------

	if cannonball_active:

		velocity.y = 0
		velocity.x = facing * 2200

		move_and_slide()

		return

	# ---------------- FATAL KNIFE LOCK ----------------

	if fatalknife_active:

		velocity.y = 0
		velocity.x = facing * 2200

		move_and_slide()

		return

	# ---------------- FINISH HIM ----------------

	if is_finish_state:

		state = State.IDLE
		velocity.x = 0

		if not is_hurting:
			play_anim("idle")

		move_and_slide()

		return

	# ---------------- GRAVITY ----------------

	if not is_on_floor():

		velocity.y += GRAVITY * delta

	elif velocity.y > 0:

		velocity.y = 0


	# =====================================================
	# UPPERCUT LAUNCH
	# =====================================================

	if uppercut_launched:

		if sprite.animation != "wasuppercut":

			current_anim = ""
			sprite.play("wasuppercut")

		velocity.x = move_toward(
			velocity.x,
			0.0,
			1500.0 * delta
		)

		move_and_slide()

		if is_on_floor():

			velocity.x = 0
			velocity.y = 0

			uppercut_launched = false
			was_uppercut = false

			is_hurting = false
			hurt_locked = false
			action_locked = false

			is_attacking = false
			is_shooting = false
			is_blocking = false

			state = State.IDLE

			current_anim = ""
			play_anim("idle")

		return


	# =====================================================
	# JUMPKICK LAUNCH
	# =====================================================

	if jumpkick_launched:

		if sprite.animation != "wasjumpkick":

			current_anim = ""
			sprite.play("wasjumpkick")

		velocity.x = move_toward(
			velocity.x,
			0.0,
			900.0 * delta
		)

		move_and_slide()

		if is_on_floor():

			velocity.x = 0
			velocity.y = 0

			jumpkick_launched = false
			was_jumpkick = false

			is_hurting = false
			hurt_locked = false
			action_locked = false

			is_attacking = false
			is_shooting = false
			is_blocking = false

			state = State.IDLE

			current_anim = ""
			play_anim("idle")

		return


	# ---------------- COOLDOWNS ----------------

	shoot_cooldown = max(
		shoot_cooldown - delta,
		0.0
	)

	combo_timer += delta

	if combo_timer > combo_reset_time:
		combo.clear()

	$AttackMarker.visible = is_attacking


	# ---------------- CPU ----------------

	if is_cpu:

		cpu_logic(delta)
		move_and_slide()

		return


	# ---------------- ACTION LOCK ----------------

	if action_locked:

		move_and_slide()

		return


	var input_dir = Input.get_axis("left", "right")
	var climb_pressed = Input.is_action_pressed("climb")


	# ---------------- FACING ----------------

	if input_dir != 0:

		facing = sign(input_dir)

	sprite.flip_h = facing > 0
	$Crispy.flip_h = facing > 0

	$AttackMarker.position = Vector2(
		0 * facing,
		0
	)

	$KanoShoot.position = Vector2(
		63 * facing,
		-225
	)


	# =========================================================
	# MOVEMENT
	# =========================================================

	if Input.is_action_pressed("run") and input_dir != 0:

		run(input_dir)

	else:

		velocity.x = input_dir * SPEED

		if not is_on_floor():

			state = State.JUMP

		elif input_dir != 0:

			state = State.WALK

		else:

			state = State.IDLE


	# ---------------- ANIMATIONS ----------------

	match state:

		State.JUMP:

			if not is_attacking:
				play_anim("jump")

		State.WALK:

			if not is_attacking:
				play_anim("walk")

		State.RUN:

			if not is_attacking:
				play_anim("run")

		State.IDLE:

			if not is_attacking:
				play_anim("idle")


	# ---------------- HURT LOCK ----------------

	if is_hurting and hurt_locked:

		move_and_slide()

		return


	# ---------------- JUMP ----------------

	if Input.is_action_just_pressed("jump") and is_on_floor():

		velocity.y = jump_velocity
		$Jump.play()


	# ---------------- ATTACKS ----------------

	if Input.is_action_just_pressed("punch"):

		do_action("punch")

	if Input.is_action_just_pressed("highpunch"):

		do_action("highpunch")

	if Input.is_action_just_pressed("lowpunch"):

		do_action("lowpunch")

	elif Input.is_action_just_pressed("knee"):

		do_action("knee")

	elif Input.is_action_just_pressed("highkick"):

		do_action("highkick")

	elif Input.is_action_just_pressed("lowkick"):

		do_action("lowkick")

	elif Input.is_action_just_pressed("jumpkick"):

		do_action("jumpkick")

	elif Input.is_action_just_pressed("roundhousekick"):

		do_action("roundhousekick")

	elif Input.is_action_just_pressed("uppercut"):

		do_action("uppercut")

	elif Input.is_action_pressed("shoot"):

		shoot_player()

	elif Input.is_action_just_pressed("cannonball"):

		do_action("cannonball")

	elif Input.is_action_just_pressed("fatalknife"):

		fatalknife()

	elif Input.is_action_pressed("fatality"):

		do_action("fatality")

		if is_instance_valid(fatality_sound):

			fatality_sound.play()

			await get_tree().process_frame

			print("================================")
			print("===========FATALITY=============")
			print("================================")

	elif Input.is_action_pressed("block"):

		start_block()

	else:

		stop_block()

	move_and_slide()


func spear_pulled_to_p1():

	is_pulled = true
	stunned = true
	action_locked = true
	is_hurting = true

	pull_timer = 0.35

	pull_target = get_tree().get_first_node_in_group("Reptile")


func run_pull_logic(delta):

	if pull_target == null or !is_instance_valid(pull_target):

		is_pulled = false
		stunned = false
		action_locked = false

		return

	var dir = sign(
		pull_target.global_position.x -
		global_position.x
	)

	velocity.x = dir * 900
	velocity.y = -120

	pull_timer -= delta

	if pull_timer <= 0.0:

		is_pulled = false

		global_position = (
			pull_target.attack_marker.global_position
			+ Vector2(40 * pull_target.facing, 0)
		)

		stunned = false
		is_hurting = false
		action_locked = false
		is_attacking = true

		pull_target = null


# ---------------- BLOCK ----------------
func start_block():

	if state == State.DEAD:
		return

	is_blocking = true
	state = State.BLOCK

	play_anim("block")


func stop_block():

	if is_blocking:

		is_blocking = false
		state = State.IDLE


# ---------------- CPU ----------------
func cpu_logic(delta):

	if state == State.DEAD:

		velocity.x = 0.0
		is_attacking = false
		is_shooting = false
		is_blocking = false
		action_locked = true

		return


	if is_finish_state:

		is_attacking = false
		is_shooting = false
		is_blocking = false
		action_locked = true
		velocity.x = 0.0
		state = State.IDLE

		if not is_hurting:
			play_anim("idle")

		return


	if is_hurting:

		velocity.x = knockback_x

		knockback_x = move_toward(
			knockback_x,
			0.0,
			1500.0 * delta
		)

		move_and_slide()

		if abs(knockback_x) > 10.0:
			return

		knockback_x = 0.0
		is_hurting = false
		hurt_locked = false
		is_attacking = false
		is_shooting = false
		action_locked = false

		state = State.IDLE
		current_anim = ""
		play_anim("idle")

		target = null

		for node in get_tree().get_nodes_in_group("Fighter"):

			if node == self:
				continue

			if not is_instance_valid(node):
				continue

			if node is Node2D and not node.is_cpu:

				target = node
				break

		ai_timer = 0.1

		return


	if action_locked:

		velocity.x = 0.0

		return


	if target == null or not is_instance_valid(target):

		target = get_tree().get_first_node_in_group("player1")

		if target == null or not is_instance_valid(target):

			for node in get_tree().get_nodes_in_group("Fighter"):

				if node == self:
					continue

				if not is_instance_valid(node):
					continue

				if node is Node2D and not node.is_cpu:

					target = node
					break


	if target == null or not is_instance_valid(target):

		velocity.x = 0.0
		state = State.IDLE

		if not is_attacking:
			play_anim("idle")

		return


	if target.get("health") != null and target.health <= 0:

		velocity.x = 0.0
		is_attacking = false
		is_shooting = false
		is_blocking = false
		action_locked = true

		state = State.IDLE
		play_anim("idle")

		return


	var dist: float = target.global_position.x - global_position.x
	var distance: float = abs(dist)
	var direction: float = sign(dist)


	if direction != 0:

		facing = direction

		sprite.flip_h = facing > 0

		if has_node("Crispy"):
			$Crispy.flip_h = facing > 0

		$AttackMarker.position = Vector2(0, 0)

		$KanoShoot.position = Vector2(
			63 * facing,
			-225
		)


	var attack_range := 110.0
	var stopping_distance := 70.0


	if distance > stopping_distance:

		velocity.x = direction * SPEED

		state = State.WALK

		if not is_attacking and not is_hurting:
			play_anim("walk")

	else:

		velocity.x = 0.0

		if not is_attacking and not is_hurting:
			state = State.IDLE
			play_anim("idle")


	ai_timer -= delta

	if ai_timer > 0.0:
		return


	if target == null or not is_instance_valid(target):
		return

	if target.get("health") != null and target.health <= 0:

		velocity.x = 0.0
		is_attacking = false
		is_shooting = false
		action_locked = true
		state = State.IDLE
		play_anim("idle")

		return


	if (
		distance <= attack_range
		and not is_hurting
		and not is_finish_state
		and not action_locked
		and not is_attacking
	):

		match Game.difficulty:

			"Hard":

				ai_timer = randf_range(0.05, 0.15)

				var choice: int = randi() % 100

				if choice < 18:

					do_action("punch")

				elif choice < 33:

					do_action("knee")

				elif choice < 45:

					do_action("highpunch")

				elif choice < 56:

					do_action("lowpunch")

				elif choice < 68:

					do_action("highkick")

				elif choice < 78:

					do_action("lowkick")

				elif choice < 84:

					do_action("jumpkick")

				elif choice < 91:

					do_action("uppercut")

				elif choice < 96:

					do_action("roundhousekick")

				elif choice < 99:

					do_action("cannonball")

				else:

					if shoot_cooldown <= 0.0:
						shoot_player()


			"Easy":

				ai_timer = randf_range(0.5, 0.9)

				var choice: int = randi() % 100

				if choice < 30:

					do_action("punch")

				elif choice < 45:

					do_action("knee")

				elif choice < 58:

					do_action("highpunch")

				elif choice < 68:

					do_action("lowpunch")

				elif choice < 78:

					do_action("highkick")

				elif choice < 86:

					do_action("lowkick")

				elif choice < 91:

					do_action("jumpkick")

				elif choice < 96:

					do_action("uppercut")

				elif choice < 99:

					do_action("roundhousekick")

				else:

					if shoot_cooldown <= 0.0:
						shoot_player()


# ---------------- ACID SHOOT ----------------
func shoot_acid():

	if shoot_cooldown > 0:
		return

	shoot_cooldown = shoot_cooldown_time

	is_attacking = true
	action_locked = true

	play_anim("shoot")

	$KanoShoot.position = Vector2(
		-3.9 * facing,
		-14.6
	)

	var bullet = REPTILES_ACID.instantiate()

	get_tree().current_scene.add_child(bullet)

	bullet.global_position = $KanoShoot.global_position

	bullet.velocity = Vector2(facing, 0) * bullet.speed

	var sprite = bullet.get_node_or_null("Sprite2D")

	if sprite:
		sprite.modulate = Color(1, 0.2, 0.2)

	var anim = bullet.get_node_or_null("AnimatedSprite2D")

	if anim:
		anim.modulate = Color(1, 0.2, 0.2)

	await get_tree().create_timer(0.25).timeout

	is_attacking = false
	action_locked = false

	play_anim("idle")


# ---------------- ACTION ----------------
func do_action(anim_name: String):

	$Kanoyell.play()

	if is_finish_state:
		return

	if state == State.DEAD:
		return

	if action_locked:
		return

	$AttackMarker.visible = true

	action_locked = true
	is_attacking = true
	lock_timer = 0.6

	play_anim(anim_name)

	if anim_name in [
		"punch",
		"kick",
		"highpunch",
		"lowpunch",
		"highkick",
		"lowkick",
		"jumpkick",
		"knee",
		"uppercut",
		"roundhousekick",
		"cannonball"
	]:

		spawn_attack(anim_name)

	if has_node("AttackMarker"):

		$AttackMarker.call_deferred(
			"emit_signal",
			"trigger_attack"
		)

	if anim_name == "cannonball":

		start_cannonball(facing)

		return

	await sprite.animation_finished

	$AttackMarker.visible = false

	is_attacking = false
	action_locked = false
	hurt_locked = false


# ---------------- ATTACK ----------------
func spawn_attack(anim_name: String):

	if anim_name not in [
		"punch",
		"highpunch",
		"lowpunch",
		"kick",
		"highkick",
		"lowkick",
		"jumpkick",
		"knee",
		"uppercut",
		"roundhousekick",
		"cannonball",
		"fatalknife"
	]:

		return

	var attack = KANO_ATTACK.instantiate()

	get_tree().current_scene.add_child(attack)

	attack.global_position = $AttackMarker.global_position

	attack.scale.x = facing

	var sprite := attack.get_node_or_null("Sprite")

	if sprite:
		sprite.flip_h = facing < 0

	var sprite2 := attack.get_node_or_null("AnimatedSprite2D")

	if sprite2:
		sprite2.flip_h = facing < 0

	var col := attack.get_node_or_null("CollisionShape2D")

	if col:
		col.position.x = abs(col.position.x) * facing

	var dmg := 1

	match anim_name:

		"punch":
			dmg = 1

		"highpunch":
			dmg = 1

		"lowpunch":
			dmg = 1

		"kick":
			dmg = 1

		"highkick":
			dmg = 1

		"lowkick":
			dmg = 1

		"jumpkick":
			dmg = 1

		"uppercut":
			dmg = 1

		"roundhousekick":
			dmg = 1

		"cannonball":
			dmg = 1

		"fatalknife":
			dmg = 1

	if attack.has_method("set_damage"):

		attack.set_damage(dmg)

	else:

		attack.damage = dmg

	attack.owner = self
	attack.attack_owner = self
	attack.attack_name = anim_name
	attack.attack_type = anim_name


