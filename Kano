const FIRE_COMBO = ["down", "right", "shoot"]
const ICE_COMBO = ["left", "left", "shoot"]
const ELECTRIC_COMBO = ["up", "down", "shoot"]

func apply_stun(duration: float):
	if stunned:
		play_anim("freeze")
		return

	stunned = true
	velocity = Vector2.ZERO

	await get_tree().create_timer(duration).timeout

	stunned = false

# ---------------- READY ----------------
func _ready():

	add_to_group("Fighter")
	add_to_group("enemy")
	add_to_group("Kano")

	add_to_group("FireDeath")
	add_to_group("IceDeath")
	add_to_group("ElectricDeath")

	spawn_locked = false

	health = max_health
	health_changed.emit(health)

	play_anim("idle")

	ai_timer = randf_range(0.2, 0.6)

# ---------------- INPUT ----------------
func _unhandled_input(event):
	if is_cpu:
		return

	if event.is_action_pressed("up"):
		register_input("up")

	elif event.is_action_pressed("down"):
		register_input("down")

	elif event.is_action_pressed("left"):
		if Input.is_action_just_pressed("cannonball"):
			start_cannonball()
		register_input("left")

	elif event.is_action_pressed("right"):
		if Input.is_action_just_pressed("cannonball"):
			start_cannonball()
		register_input("right")

	elif event.is_action_pressed("shoot"):
		register_input("shoot")

# ---------------- PHYSICS ----------------
func _physics_process(delta):

	# ---------------- STUN ----------------
	if stunned:
		velocity = Vector2.ZERO
		move_and_slide()
		return

	# ---------------- SPECIAL MOVE (CANNONBALL) ----------------

	if special_move:

		special_move_timer -= delta

		if special_move_timer <= 0:
			special_move = false
			cannonball_active = false
			cannonball_hit_lock = false
			spawn_protection = false
			velocity = Vector2.ZERO
		return

		if cannonball_active:
			var cannon_input = Input.get_axis("left", "right")
			velocity.x += cannon_input * 40
			velocity.y = 0

		move_and_slide()

	# COLLISION CHECK
		for i in range(get_slide_collision_count()):
			var col = get_slide_collision(i)
			var body = col.get_collider()

			if body and body != self and body.has_method("take_damage"):

				if "cannonball_hit_lock" in body and body.cannonball_hit_lock:
					continue

				body.take_damage(1)

				special_move = false
				cannonball_active = false
				cannonball_hit_lock = false
				spawn_protection = false
				special_move_timer = 0.35
				velocity = Vector2.ZERO

				return

		return

	# ---------------- INPUT ----------------
	if Input.is_action_just_pressed("cannonball"):
		start_cannonball()

	# ---------------- COOLDOWNS ----------------
	shoot_cooldown = max(shoot_cooldown - delta, 0.0)

	combo_timer += delta

	if combo_timer > combo_reset_time:
		combo.clear()

	# ---------------- CPU ----------------
	if is_cpu:
		cpu_logic(delta)
		move_and_slide()
		return

	# ---------------- DEAD ----------------
	if state == State.DEAD:
		return

	# ---------------- LOCKS ----------------
	if action_locked or hurt_locked:
		move_and_slide()
		return

	# ---------------- INPUT ----------------
	var input_dir = Input.get_axis("left", "right")
	var climb_pressed = Input.is_action_pressed("climb")

	if input_dir != 0:
		facing = input_dir

	sprite.flip_h = facing > 0

	# ---------------- FACING ----------------
	if input_dir != 0:
		facing = input_dir

	sprite.flip_h = facing > 0

	$AttackMarker.position = Vector2(-3.9 * facing, -14.6)
	$KanoShoot.position = Vector2(-3.9 * facing, -14.6)

	# ---------------- JUMP ----------------
	if Input.is_action_just_pressed("jump") and is_on_floor():
		velocity.y = jump_velocity
		state = State.JUMP

	# ---------------- MOVEMENT ----------------
	velocity.x = input_dir * SPEED
	velocity.y += GRAVITY * delta

	# ---------------- STATES ----------------

	if climb_pressed and not is_on_floor() and is_on_wall():
		state = State.CLIMB

	elif not is_on_floor():
		state = State.JUMP

	elif input_dir != 0:
		state = State.RUN

	else:
		state = State.IDLE

	# ---------------- ANIMS ----------------
	match state:

		State.CLIMB:
			velocity.y = -CLIMB_SPEED
			if not is_attacking:
				play_anim("climb")

		State.JUMP:
			if not is_attacking:
				if velocity.y < 0:
					play_anim("jump")
				else:
					play_anim("jump")

		State.RUN:
			if not is_attacking:
				play_anim("walk")

		State.IDLE:
			if not is_attacking:
				play_anim("idle")

	# ---------------- ATTACKS ----------------
	if Input.is_action_just_pressed("punch"):
		do_action("punch")

	elif Input.is_action_just_pressed("roundhousekick"):
		do_action("roundhousekick")

	elif Input.is_action_just_pressed("kick"):
		do_action("kick")

	elif Input.is_action_just_pressed("uppercut"):
		do_action("uppercut")

	elif Input.is_action_pressed("shoot"):
		shoot_player()

	elif Input.is_action_just_pressed("fatality"):
		do_action("fatality")

	elif Input.is_action_just_pressed("Reptilesacid"):
		if shoot_cooldown <= 0:
			shoot_acid()

	elif Input.is_action_pressed("block"):
		start_block()

	else:
		stop_block()

	move_and_slide()
# ---------------- BLOCK ----------------
func start_block():

	if state == State.DEAD:
		return

	is_blocking = true
	state = State.BLOCK

	play_anim("block")

func stop_block():

	if is_blocking:
		is_blocking = false
		state = State.IDLE

# ---------------- ACID SHOOT ----------------
func shoot_acid():

	if shoot_cooldown > 0:
		return

	shoot_cooldown = shoot_cooldown_time

	is_attacking = true
	action_locked = true

	play_anim("shoot")

	# 🔥 SET SHOOT POSITION FIRST
	$KanoShoot.position = Vector2(-3.9 * facing, -14.6)

	# 🟢 SPAWN BULLET
	var bullet = REPTILES_ACID.instantiate()
	get_tree().current_scene.add_child(bullet)

	# IMPORTANT: spawn at marker GLOBAL position
	bullet.global_position = $KanoShoot.global_position

	# 🔫 direction
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	# 🔴 RED ONLY FOR KANO BULLET
	var sprite = bullet.get_node_or_null("Sprite2D")
	if sprite:
		sprite.modulate = Color(1, 0.2, 0.2)

	var anim = bullet.get_node_or_null("AnimatedSprite2D")
	if anim:
		anim.modulate = Color(1, 0.2, 0.2)

	await get_tree().create_timer(0.25).timeout

	is_attacking = false
	action_locked = false

	play_anim("idle")

# ---------------- CPU ----------------
func cpu_logic(delta):
	# ---------------- HURT PRIORITY ----------------
	if is_hurting:

		if is_spear_pulled:
			# opposite of normal knockback
			velocity.x = -facing * -600
		else:
			# normal knockback
			velocity.x = -facing * 600

		knockback_x = move_toward(knockback_x, 0, 1500 * delta)

		if abs(knockback_x) < 10:
			knockback_x = 0
			is_hurting = false
			is_spear_pulled = false

		return

	if target == null or !is_instance_valid(target):
		velocity.x = 0
		return

# GRAVITY
	velocity.y += GRAVITY * delta

	var dist = target.global_position.x - global_position.x
	var direction = sign(dist)

	# HARD LOCK (Liu Kang style behavior)
	if action_locked:
		return

# STOP ALL ACTIONS AT 1HP
	if health <= 1:
		is_attacking = false
		action_locked = true
		velocity.x = 0
		move_and_slide()
		return

	ai_timer -= delta

	velocity.y += GRAVITY * delta
	facing = direction
	sprite.flip_h = facing > 0

# GRAVITY
	velocity.y += GRAVITY * delta


# ---------------- MOVEMENT ----------------
	if not is_attacking:
		play_anim("walk")

	if abs(dist) > 220:
		velocity.x = direction * SPEED * 0.8
		state = State.RUN
		play_anim("walk")
	else:
		velocity.x = direction * SPEED * 0.8
		state = State.RUN
		play_anim("walk")

	# ---------------- AI ACTIONS ----------------
	if ai_timer <= 0:

		ai_timer = randf_range(0.4, 0.8)

		match randi() % 5:

			0:
				do_action("punch")

			1:
				do_action("kick")

			2:
				do_action("uppercut")

			3:
				do_action("roundhousekick")

			4:
				shoot_player()

# ---------------- ACTION ----------------
func do_action(anim_name: String):
	if state == State.DEAD:
		return

	if action_locked:
		return

	is_attacking = true
	action_locked = true

	play_anim(anim_name)

	# spawn attack immediately OR sync via frame event (better below)
	if anim_name in [
		"punch",
		"kick",
		"roundhousekick",
		"uppercut",
		"jumpkick",
		"fatality"
	]:
		spawn_attack(anim_name)

	# safer animation wait
	await sprite.animation_finished

	is_attacking = false
	action_locked = false

	if not is_hurting and state != State.DEAD:
		play_anim("idle")


# ---------------- ATTACK ----------------
func spawn_attack(anim_name: String):
	if anim_name not in [
		"punch",
		"kick",
		"uppercut",
		"roundhousekick",
		"jumpkick"
	]:
		return

	var attack = KANO_ATTACK.instantiate()
	get_tree().current_scene.add_child(attack)

	# ---------------- FIX: proper facing placement ----------------
	var pos = $AttackMarker.global_position

	if facing == -1:
		pos.x = global_position.x - abs($AttackMarker.position.x)
	else:
		pos.x = global_position.x + abs($AttackMarker.position.x)

	attack.global_position = pos

	# direction
	if "direction" in attack:
		attack.direction = facing

	# ---------------- DAMAGE ----------------
	var dmg := 1

	match anim_name:
		"uppercut":
			dmg = 1
		"roundhousekick":
			dmg = 1
		"jumpkick":
			dmg = 1
		_:
			dmg = 1

	if "damage" in attack:
		attack.damage = dmg
	elif attack.has_method("set_damage"):
		attack.set_damage(dmg)

func start_cannonball():
	if state == State.DEAD:
		return
	if action_locked:
		return

	cannonball_hit_lock = true
	spawn_protection = true

	cannonball_active = true
	special_move = true
	special_move_timer = 0.6

	sprite.play("cannonball")

	velocity.x = facing * 1300
	velocity.y = 0

# ---------------- SHOOT ----------------
func shoot_player():
	if is_finish_state:
		return
	if is_shooting:
		return

	is_shooting = true
	is_attacking = true
	action_locked = true

	play_anim("shoot")

	var bullet_scene: PackedScene

	# ---------------- SPECIAL BULLET ----------------
	if special_bullet != null:

		bullet_scene = special_bullet

		# reset after one shot
		special_bullet = null

	else:

		bullet_scene = BULLET_SCENE

	var bullet = bullet_scene.instantiate()

	get_tree().current_scene.add_child(bullet)

	$KanoShoot.position = Vector2(-3.9 * facing, -14.6)

	bullet.global_position = $KanoShoot.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	await get_tree().create_timer(0.25).timeout

	is_shooting = false

	if is_hurting or state == State.DEAD:
		return

	is_attacking = false
	action_locked = false

	play_anim("idle")

# ---------------- DAMAGE ----------------
func take_damage(amount: int):

	if not can_take_damage:
		return

	can_take_damage = false

	await get_tree().create_timer(0.25).timeout

	can_take_damage = true

	if state == State.DEAD:
		return

	if spawn_protection:
		return

	# BLOCK REDUCTION
	if is_blocking:
		amount = max(amount - 1, 0)

	if amount <= 0:
		return

	health -= amount
	health = max(health, 0)

	print("Kano took damage: ", amount, " HP=", health)

	health_changed.emit(health)
	hit_sound.play()

	# ---------------- FINISH HIM ----------------
	if health == 1 and not is_finish_state:

		is_finish_state = true

		finish_label.visible = true

		if finish_label.has_method("start_flicker"):
			finish_label.start_flicker(2.0, 0.05)

		return

	# ---------------- FINAL HIT ----------------
	if health <= 0:

		finish_label.visible = false

		await get_tree().create_timer(0.5).timeout

		get_tree().change_scene_to_file("res://CharacterSelect.tscn")
		return

	# ---------------- NORMAL HURT ----------------
	is_hurting = true
	hurt_locked = true
	action_locked = true

	state = State.IDLE

	play_anim("hurt")

	var blood = BLOOD_EFFECT.instantiate()
	get_tree().current_scene.add_child(blood)
	blood.global_position = blood_marker.global_position

	await get_tree().create_timer(0.25).timeout

	is_hurting = false
	hurt_locked = false
	action_locked = false

func trigger_finish_state():
	if is_finish_state:
		return

	is_finish_state = true

	state = State.IDLE
	velocity = Vector2.ZERO

	action_locked = true
	hurt_locked = false
	is_attacking = false
	is_shooting = false
	is_hurting = false

	finish_label.visible = true

	if finish_label.has_method("start_flicker"):
		finish_label.start_flicker(2.0, 0.05)

	# ⏱ WAIT THEN REMOVE LABEL
	await get_tree().create_timer(2.0).timeout

	if is_instance_valid(finish_label):
		finish_label.visible = false

	is_finish_state = false



# ---------------- COMBOS ----------------
func register_input(input: String):
	combo.append(input)

	combo_timer = 0.0

	check_combos()

func spawn_fx(scene: PackedScene):
	var fx = scene.instantiate()

	# IMPORTANT: set owner BEFORE it can collide
	fx.owner_character = self
	fx.damage_done = false

	get_tree().current_scene.call_deferred("add_child", fx)

	await get_tree().process_frame

	if target and is_instance_valid(target):
		fx.global_position = target.global_position + Vector2(60 * facing, 0)
	else:
		fx.global_position = global_position + Vector2(80 * facing, 0)

func check_combos():
	# ---------------- ACID ----------------
	if combo == ACID_COMBO:

		combo_used.emit("acid")

		special_bullet = ACID_BULLET

		combo.clear()
		return

	# ---------------- FIRE ----------------
	elif combo == FIRE_COMBO:

		combo_used.emit("fire")

		spawn_fx(FIRE_DEATH)

		special_bullet = FIRE_BULLET

		combo.clear()
		return

	# ---------------- ICE ----------------
	elif combo == ICE_COMBO:

		combo_used.emit("ice")

		spawn_fx(ICE_DEATH)

		special_bullet = ICE_BULLET

		combo.clear()
		return

	# ---------------- ELECTRIC ----------------
	elif combo == ELECTRIC_COMBO:

		combo_used.emit("electric")

		spawn_fx(ELECTRIC_DEATH)

		special_bullet = ELECTRIC_BULLET

		combo.clear()
		return

# ---------------- DEATH ----------------
func die():
	state = State.DEAD
	velocity = Vector2.ZERO

	var death = BLOOD_DEATH.instantiate()
	get_tree().current_scene.add_child(death)
	death.global_position = global_position

	await get_tree().create_timer(1.0).timeout

	get_tree().change_scene_to_file("res://Scenes/CharacterSelect.tscn")

	queue_free()

# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):
	if current_anim == anim_name:
		return

	current_anim = anim_name

	sprite.play(anim_name)

# ---------------- HURT BOX ----------------
func _on_kano_hurt_box_area_entered(area: Area2D) -> void:

	if hurt_cooldown:
		return

	if area == null or !is_instance_valid(area):
		return

	if area.is_in_group("HurtBox"):
		return

	if area.is_in_group("ReptileSpear"):
		hurt_cooldown = true

		health -= 1
		health_changed.emit(health)

		is_hurting = true
		action_locked = true

		play_anim("hurt")

		await get_tree().create_timer(0.8).timeout

		is_hurting = false
		action_locked = false
		hurt_cooldown = false
		return

	if not can_take_damage:
		return

	if area.is_in_group("HitBox") \
	or area.is_in_group("ReptileAcid") \
	or area.is_in_group("RaidenElectricBullet") \
	or area.is_in_group("FireBullet") \
	or area.is_in_group("Fireball") \
	or area.is_in_group("JohnnyCageBullet") \
	or area.is_in_group("SonyaBullet") \
	or area.is_in_group("IceBullet"):

		hurt_cooldown = true

		knockback_x = -facing * 600
		take_damage(1)

		is_hurting = true
		action_locked = true
		is_attacking = false

		play_anim("hurt")

		await get_tree().create_timer(0.15).timeout
		hurt_cooldown = false
