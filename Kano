# ---------------- READY ----------------
func _ready():
	$AttackMarker.visible = false
	$Crispy.visible = false
	$AttackMarker.position = Vector2(0 * facing, 0)

	add_to_group("Fighter")
	add_to_group("enemy")
	add_to_group("Kano")

	spawn_locked = false

	health = max_health
	health_changed.emit(health)

	facing = 1
	sprite.flip_h = facing > 0
	$Crispy.flip_h = facing > 0

	# =========================================================
	# START CPU WALKING IMMEDIATELY
	# =========================================================
	if is_cpu:

		if Game.difficulty == "Easy":
			state = State.IDLE
			velocity.x = 0.0
			play_anim("idle")
			ai_timer = randf_range(1.0, 1.8)

	else:
		state = State.IDLE
		velocity.x = 0.0
		play_anim("idle")

func apply_stun(_duration := 4.0):

	if state == State.DEAD:
		return

	stunned = true

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	velocity = Vector2.ZERO
	knockback_x = 0

	play_anim("idle")

	await get_tree().create_timer(4.0).timeout

	stunned = false

	is_hurting = false
	hurt_locked = false
	action_locked = false

func run(input_dir: float):
	if input_dir == 0:
		return

	state = State.RUN
	velocity.x = input_dir * SPEED * 3 # faster than walk

	if not is_attacking:
		play_anim("run")

func handle_double_tap_run(input_dir: float, delta: float) -> bool:

	if input_dir == 0:
		return false

	var now := Time.get_ticks_msec() / 1000.0

	if input_dir == last_tap_dir:
		if now - last_tap_time <= tap_time:
			run_locked = true
			return true

	last_tap_time = now
	last_tap_dir = input_dir

	return false

# ---------------- PHYSICS ----------------
func _physics_process(delta):
	# ---------------- GRAVITY ----------------
	velocity.y += GRAVITY * delta

	if state == State.DEAD:
		return

	if is_pulled:
		run_pull_logic(delta)
		move_and_slide()
		return

	# ---------------- STUN ----------------
	if stunned:
		velocity = Vector2.ZERO
		move_and_slide()
		return

	# ---------------- CANNONBALL LOCK ----------------
	if cannonball_active:
		velocity.y = 0
		velocity.x = facing * 2200
		move_and_slide()
		return

	# ---------------- FINISH HIM ----------------
	if is_finish_state:
		state = State.IDLE
		velocity.x = 0
		if not is_hurting:
			play_anim("idle")
		move_and_slide()
		return

	# ---------------- GRAVITY ----------------
	velocity.y += GRAVITY * delta

	if uppercut_launched:

		move_and_slide()

		if is_on_floor():
			uppercut_launched = false

		return

	# ---------------- COOLDOWNS ----------------
	shoot_cooldown = max(shoot_cooldown - delta, 0.0)

	combo_timer += delta
	if combo_timer > combo_reset_time:
		combo.clear()

	$AttackMarker.visible = is_attacking

	# ---------------- CPU ----------------
	if is_cpu:
		cpu_logic(delta)
		move_and_slide()
		return

	if state == State.DEAD:
		return

	if is_finish_state:
		state = State.IDLE
		velocity.x = 0

		if not is_hurting:
			play_anim("idle")

		move_and_slide()
		return
	# ---------------- CANNONBALL LOCK ----------------
	if cannonball_active:
		velocity.y = 0
		velocity.x = facing * 2200
		move_and_slide()
		return


	if action_locked:
		return

	var input_dir = Input.get_axis("left", "right")
	var climb_pressed = Input.is_action_pressed("climb")

	# ---------------- FACING ----------------
	if input_dir != 0:
		facing = sign(input_dir)

	sprite.flip_h = facing > 0
	$Crispy.flip_h = facing > 0

	$AttackMarker.position = Vector2(0 * facing, 0)
	$KanoShoot.position = Vector2(63 * facing, -225)

	# =========================================================
	# 🟢 MOVEMENT (RUN ADDED HERE)
	# =========================================================
	if Input.is_action_pressed("run") and input_dir != 0:
		run(input_dir)   # 🔥 CALLS YOUR NEW RUN FUNCTION
	else:
		velocity.x = input_dir * SPEED

		# ---------------- STATE ----------------
		if not is_on_floor():
			state = State.JUMP
		elif input_dir != 0:
			state = State.WALK
		elif input_dir != 0:
			state = State.RUN
		else:
			state = State.IDLE

	# ---------------- ANIMATIONS ----------------
	match state:

		State.JUMP:
			if not is_attacking:
				play_anim("jump")

		State.WALK:
			if not is_attacking:
				play_anim("walk")

		State.RUN:
			if not is_attacking:
				play_anim("run")

		State.IDLE:
			if not is_attacking:
				play_anim("idle")

	if is_hurting and hurt_locked:
		return

	# ---------------- JUMP ----------------
	if Input.is_action_just_pressed("jump") and is_on_floor():
		velocity.y = jump_velocity

	# ---------------- ATTACKS ----------------
	if Input.is_action_just_pressed("punch"):
		do_action("punch")

	if Input.is_action_just_pressed("highpunch"):
		do_action("highpunch")

	if Input.is_action_just_pressed("lowpunch"):
		do_action("lowpunch")

	elif Input.is_action_just_pressed("kick"):
		do_action("kick")

	elif Input.is_action_just_pressed("highkick"):
		do_action("highkick")

	elif Input.is_action_just_pressed("lowkick"):
		do_action("lowkick")

	elif Input.is_action_just_pressed("roundhousekick"):
		do_action("roundhousekick")


	elif Input.is_action_just_pressed("uppercut"):
		do_action("uppercut")

	elif Input.is_action_pressed("shoot"):
		shoot_player()

	elif Input.is_action_just_pressed("cannonball"):
		do_action("cannonball")


	elif Input.is_action_pressed("fatality"):
		do_action("fatality")


	elif Input.is_action_pressed("block"):
		start_block()

	else:
		stop_block()

	move_and_slide()

func spear_pulled_to_p1():
	print("START PULL")

	is_pulled = true
	stunned = true
	action_locked = true
	is_hurting = true

	pull_timer = 0.35

	pull_target = get_tree().get_first_node_in_group("Reptile")

func run_pull_logic(delta):
	print("Running pull logic")
	if pull_target == null or !is_instance_valid(pull_target):
		is_pulled = false
		stunned = false
		action_locked = false
		return

	var dir = sign(pull_target.global_position.x - global_position.x)

	velocity.x = dir * 900
	velocity.y = -120

	pull_timer -= delta

	if pull_timer <= 0.0:

		is_pulled = false

		# SNAP to Reptile AttackMarker (THIS IS MK MOMENT)
		global_position = pull_target.attack_marker.global_position + Vector2(40 * pull_target.facing, 0)

		stunned = false
		is_hurting = false
		action_locked = false
		is_attacking = true

		pull_target = null

# ---------------- BLOCK ----------------
func start_block():

	if state == State.DEAD:
		return

	is_blocking = true
	state = State.BLOCK

	play_anim("block")

func stop_block():

	if is_blocking:
		is_blocking = false
		state = State.IDLE


# ---------------- CPU ----------------
func cpu_logic(delta):

	# =========================================================
	# DEAD
	# =========================================================

	if state == State.DEAD:
		return


	# =========================================================
	# HURT RECOVERY
	# =========================================================

	if is_hurting:

		velocity.x = knockback_x

		knockback_x = move_toward(
			knockback_x,
			0.0,
			1500.0 * delta
		)

		if abs(knockback_x) > 10.0:
			return

		knockback_x = 0.0

		is_hurting = false
		hurt_locked = false
		is_attacking = false
		is_shooting = false
		action_locked = false

		state = State.IDLE
		current_anim = ""
		play_anim("idle")

		# Find human player again
		target = null

		for node in get_tree().get_nodes_in_group("Fighter"):

			if node == self:
				continue

			if not is_instance_valid(node):
				continue

			if node is Node2D and not node.is_cpu:
				target = node
				break

		if Game.difficulty == "Easy":
			ai_timer = randf_range(0.6, 1.2)
		else:
			ai_timer = randf_range(0.15, 0.35)

		return


	# =========================================================
	# FINISH HIM
	# =========================================================

	if is_finish_state:

		is_attacking = false
		action_locked = true
		velocity.x = 0.0
		state = State.IDLE

		if not is_hurting:
			play_anim("idle")

		return


	# =========================================================
	# FIND PLAYER 1
	# =========================================================

	if target == null or not is_instance_valid(target):

		target = null

		for node in get_tree().get_nodes_in_group("Fighter"):

			if node == self:
				continue

			if not is_instance_valid(node):
				continue

			if node is Node2D and not node.is_cpu:
				target = node
				break


	# =========================================================
	# NO TARGET
	# =========================================================

	if target == null or not is_instance_valid(target):

		velocity.x = 0.0
		state = State.IDLE

		if not is_attacking:
			play_anim("idle")

		return


	# =========================================================
	# ACTION LOCK
	# =========================================================

	if action_locked:

		velocity.x = 0.0

		if not is_attacking and not is_hurting:
			state = State.IDLE
			play_anim("idle")

		return


	# =========================================================
	# DISTANCE TO PLAYER
	# =========================================================

	var dist: float = target.global_position.x - global_position.x
	var distance: float = abs(dist)
	var direction: float = sign(dist)


	# =========================================================
	# FACE PLAYER
	# =========================================================

	if direction != 0:

		facing = direction

		sprite.flip_h = facing > 0

		if has_node("Crispy"):
			$Crispy.flip_h = facing > 0

		$AttackMarker.position = Vector2(0 * facing, 0)
		$KanoShoot.position = Vector2(63 * facing, -225)


	# =========================================================
	# EASY AI
	# =========================================================

	if Game.difficulty == "Easy":

		var easy_stopping_distance := 105.0
		var easy_attack_range := 125.0


		# -----------------------------------------------------
		# MOVE TOWARD PLAYER
		# -----------------------------------------------------

		if distance > easy_stopping_distance:

			velocity.x = direction * SPEED * 1.05

			state = State.WALK

			if not is_attacking:
				play_anim("walk")

		else:

			velocity.x = 0.0

			if not is_attacking:
				state = State.IDLE
				play_anim("idle")


		# -----------------------------------------------------
		# EASY ATTACK TIMER
		# -----------------------------------------------------

		ai_timer -= delta

		if ai_timer <= 0.0:

			if (
				distance <= easy_attack_range
				and not is_hurting
				and not is_finish_state
				and not action_locked
				and not is_attacking
			):

				# Give Easy CPU a reasonable delay.
				ai_timer = randf_range(0.8, 1.5)

				# 65% chance to attack.
				var attack_roll := randi() % 100

				if attack_roll < 65:

					var choice := randi() % 100

					if choice < 30:
						do_action("punch")

					elif choice < 50:
						do_action("kick")

					elif choice < 62:
						do_action("highpunch")

					elif choice < 72:
						do_action("lowpunch")

					elif choice < 82:
						do_action("highkick")

					elif choice < 90:
						do_action("lowkick")

					elif choice < 96:
						do_action("uppercut")

					else:
						do_action("roundhousekick")

				else:

					state = State.IDLE
					velocity.x = 0.0
					play_anim("idle")

			else:

				ai_timer = randf_range(0.3, 0.7)

		return


	# =========================================================
	# HARD AI
	# =========================================================

	# Keep Kano close enough to actually attack.
	var stopping_distance := 100.0
	var attack_range := 145.0


	# =========================================================
	# CHASE PLAYER
	# =========================================================

	if distance > stopping_distance:

		velocity.x = direction * SPEED

		state = State.WALK

		if not is_attacking:
			play_anim("walk")

	else:

		velocity.x = 0.0

		if not is_attacking:
			state = State.IDLE
			play_anim("idle")


	# =========================================================
	# HARD ATTACK TIMER
	# =========================================================

	ai_timer -= delta

	if ai_timer > 0.0:
		return


	# =========================================================
	# ATTACK WHEN CLOSE
	# =========================================================

	if (
		distance <= attack_range
		and not is_hurting
		and not is_finish_state
		and not action_locked
		and not is_attacking
	):

		# IMPORTANT:
		# Do not use 0.01 here.
		# Give Kano a short attack decision delay.
		ai_timer = randf_range(0.25, 0.55)

		var choice := randi() % 100


		# -----------------------------------------------------
		# PUNCH
		# -----------------------------------------------------

		if choice < 18:
			do_action("punch")


		# -----------------------------------------------------
		# KICK
		# -----------------------------------------------------

		elif choice < 34:
			do_action("kick")


		# -----------------------------------------------------
		# HIGH PUNCH
		# -----------------------------------------------------

		elif choice < 47:
			do_action("highpunch")


		# -----------------------------------------------------
		# LOW PUNCH
		# -----------------------------------------------------

		elif choice < 58:
			do_action("lowpunch")


		# -----------------------------------------------------
		# HIGH KICK
		# -----------------------------------------------------

		elif choice < 69:
			do_action("highkick")


		# -----------------------------------------------------
		# LOW KICK
		# -----------------------------------------------------

		elif choice < 79:
			do_action("lowkick")


		# -----------------------------------------------------
		# UPPERCUT
		# -----------------------------------------------------

		elif choice < 87:
			do_action("uppercut")


		# -----------------------------------------------------
		# ROUNDHOUSE
		# -----------------------------------------------------

		elif choice < 94:
			do_action("roundhousekick")


		# -----------------------------------------------------
		# CANNONBALL
		# -----------------------------------------------------

		elif choice < 98:
			do_action("cannonball")


		# -----------------------------------------------------
		# SHOOT
		# -----------------------------------------------------

		else:

			if shoot_cooldown <= 0.0:
				shoot_player()


	# =========================================================
	# PLAYER IS TOO FAR
	# =========================================================

	else:

		# Recheck fairly quickly while chasing.
		ai_timer = randf_range(0.08, 0.18)

# ---------------- ACID SHOOT ----------------
func shoot_acid():

	if shoot_cooldown > 0:
		return

	shoot_cooldown = shoot_cooldown_time

	is_attacking = true
	action_locked = true

	play_anim("shoot")

	# 🔥 SET SHOOT POSITION FIRST
	$KanoShoot.position = Vector2(-3.9 * facing, -14.6)

	# 🟢 SPAWN BULLET
	var bullet = REPTILES_ACID.instantiate()
	get_tree().current_scene.add_child(bullet)

	# IMPORTANT: spawn at marker GLOBAL position
	bullet.global_position = $KanoShoot.global_position

	# 🔫 direction
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	# 🔴 RED ONLY FOR KANO BULLET
	var sprite = bullet.get_node_or_null("Sprite2D")
	if sprite:
		sprite.modulate = Color(1, 0.2, 0.2)

	var anim = bullet.get_node_or_null("AnimatedSprite2D")
	if anim:
		anim.modulate = Color(1, 0.2, 0.2)

	await get_tree().create_timer(0.25).timeout

	is_attacking = false
	action_locked = false

	play_anim("idle")

# ---------------- ACTION ----------------
func do_action(anim_name: String):
	$Kanoyell.play()
	if is_finish_state:
		return

	if state == State.DEAD:
		return

	if action_locked:
		return

	$AttackMarker.visible = true

	action_locked = true
	is_attacking = true
	lock_timer = 0.6

	play_anim(anim_name)

	# ---------------- NORMAL ATTACKS ----------------
	if anim_name in [
		"punch",
		"kick",
		"highpunch",
		"lowpunch",
		"highkick",
		"lowkick",
		"uppercut",
		"roundhousekick",
		"cannonball"
	]:
		spawn_attack(anim_name)

	# ---------------- SUBZERO SPECIAL (NO NEW NAME) ----------------
	if has_node("AttackMarker"):
		$AttackMarker.call_deferred("emit_signal", "trigger_attack")

# ---------------- CANNONBALL ----------------
	if anim_name == "cannonball":
		start_cannonball(facing)
		return

	await sprite.animation_finished

	$AttackMarker.visible = false

	is_attacking = false
	action_locked = false
	hurt_locked = false

# ---------------- ATTACK ----------------
func spawn_attack(anim_name: String):

	if anim_name not in [
		"punch",
		"highpunch",
		"lowpunch",
		"kick",
		"highkick",
		"lowkick",
		"uppercut",
		"roundhousekick",
		"cannonball"
	]:
		return

	var attack = KANO_ATTACK.instantiate()
	get_tree().current_scene.add_child(attack)

	# Spawn at AttackMarker
	attack.global_position = $AttackMarker.global_position

	# Flip attack to face the correct direction
	attack.scale.x = facing

	# Flip sprite if it exists
	var sprite := attack.get_node_or_null("Sprite")
	if sprite:
		sprite.flip_h = facing < 0

	var sprite2 := attack.get_node_or_null("AnimatedSprite2D")
	if sprite2:
		sprite2.flip_h = facing < 0

	# Flip collision shape position
	var col := attack.get_node_or_null("CollisionShape2D")
	if col:
		col.position.x = abs(col.position.x) * facing

	var dmg := 1

	match anim_name:
		"punch":
			dmg = 1
		"highpunch":
			dmg = 1
		"lowpunch":
			dmg = 1
		"kick":
			dmg = 1
		"highkick":
			dmg = 1
		"lowkick":
			dmg = 1
		"uppercut":
			dmg = 1
		"roundhousekick":
			dmg = 1
		"cannonball":
			dmg = 1

	if attack.has_method("set_damage"):
		attack.set_damage(dmg)
	else:
		attack.damage = dmg

	attack.owner = self
	attack.attack_owner = self
	attack.attack_name = anim_name
	attack.attack_type = anim_name

func start_cannonball(dir: float):

	if state == State.DEAD:
		return

	facing = dir
	sprite.flip_h = facing > 0

	cannonball_active = true
	spawn_protection = true
	is_attacking = true
	action_locked = true

	play_anim("cannonball")

	velocity = Vector2(facing * 2200, 0)

	# Stop after 1 second
	get_tree().create_timer(1.0).timeout.connect(func():
		cannonball_active = false
	)

	while cannonball_active:
		spawn_attack("cannonball")
		$Kanoyell.play()
		await get_tree().create_timer(0.08).timeout

	velocity.x = 0
	state = State.IDLE
	spawn_protection = false
	is_attacking = false
	action_locked = false
	play_anim("idle")

# ---------------- SHOOT ----------------
func shoot_player():
	if is_finish_state:
		return
	if is_shooting:
		return

	is_shooting = true
	is_attacking = true
	action_locked = true

	play_anim("shoot")
	$Kanoyell.play()
	var bullet_scene: PackedScene

	# ---------------- SPECIAL BULLET ----------------
	if special_bullet != null:

		bullet_scene = special_bullet

		# reset after one shot
		special_bullet = null

	else:

		bullet_scene = BULLET_SCENE

	var bullet = bullet_scene.instantiate()

	get_tree().current_scene.add_child(bullet)

	$KanoShoot.position = Vector2(-3.9 * facing, -20.6)

	bullet.global_position = $KanoShoot.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	await get_tree().create_timer(0.25).timeout

	is_shooting = false

	if is_hurting or state == State.DEAD:
		return

	is_attacking = false
	action_locked = false
	play_anim("idle")

# ---------------- DAMAGE ----------------

func take_damage(amount: int):

	# =================================================
	# ALREADY DEAD / INVINCIBLE
	# =================================================

	if state == State.DEAD:
		return

	if not can_take_damage:
		return

	if spawn_protection:
		return


	# =================================================
	# PREVENT MULTIPLE DAMAGE ON SAME PHYSICS FRAME
	# =================================================

	var frame := Engine.get_physics_frames()

	if has_meta("last_damage_frame"):
		if get_meta("last_damage_frame") == frame:
			return

	set_meta("last_damage_frame", frame)


	# =================================================
	# DAMAGE COOLDOWN
	# =================================================

	can_take_damage = false

	get_tree().create_timer(0.25).timeout.connect(func():
		if is_instance_valid(self) and state != State.DEAD:
			can_take_damage = true
	)


	# =================================================
	# BLOCK REDUCTION
	# =================================================

	if is_blocking:
		amount = max(amount - 1, 0)

	if amount <= 0:
		return


	# =================================================
	# APPLY DAMAGE
	# =================================================

	health -= amount
	health = max(health, 0)

	print("JohnnyCage took damage: ", amount, " HP=", health)

	health_changed.emit(health)

	if is_instance_valid(hit_sound):
		hit_sound.play()


	# =================================================
	# FINAL HIT
	# =================================================

	if health <= 0:

		is_attacking = false
		is_shooting = false
		is_hurting = false
		is_blocking = false

		if is_instance_valid(finish_label):
			finish_label.visible = false

		die()

		return

	# =================================================
	# FINISH HIM
	# =================================================
	#
	# Only show FINISH HIM when the opponent already
	# has 1 round win.
	#
	# That means killing this fighter will give the
	# opponent their SECOND round win.
	#
	# We do NOT use Game.current_round here.
	# =================================================

	if health == 1 and not is_finish_state:

		var opponent_will_win_match := false


		# =================================================
		# JOHNNY IS PLAYER 1
		# =================================================

		if is_in_group("player1"):

			# CPU already has 1 round win.
			# This death would give CPU its 2nd win.
			if Game.p2_round_wins >= 1:
				opponent_will_win_match = true


		# =================================================
		# JOHNNY IS CPU
		# =================================================

		else:

			# Player 1 already has 1 round win.
			# This death would give P1 its 2nd win.
			if Game.p1_round_wins >= 1:
				opponent_will_win_match = true


		# =================================================
		# SHOW FINISH HIM ONLY FOR MATCH-ENDING ROUND
		# =================================================

		if opponent_will_win_match:

			is_hurting = false
			hurt_locked = false
			action_locked = false

			trigger_finish_state()

			return


	# =================================================
	# NORMAL HURT
	# =================================================

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	state = State.IDLE

	combo.clear()

	play_anim("hurt")

	if is_instance_valid(hurt_sound):
		hurt_sound.play()


	# =================================================
	# BLOOD EFFECT
	# =================================================

	if has_node("BloodMarker"):

		var blood = BLOOD_EFFECT.instantiate()

		get_tree().current_scene.add_child(blood)

		blood.global_position = $BloodMarker.global_position


	# =================================================
	# HURT DURATION
	# =================================================

	await get_tree().create_timer(0.25).timeout

	if state == State.DEAD:
		return

	is_hurting = false
	hurt_locked = false
	action_locked = false

	if state != State.DEAD and not is_finish_state:
		play_anim("idle")

func trigger_finish_state():

	if is_finish_state:
		return

	is_finish_state = true

	state = State.IDLE

	# force them to fall back down
	velocity.x = 0
	velocity.y = 0

	action_locked = true
	hurt_locked = false
	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

	# cancel any uppercut/fly state
	set_meta("uppercut_launched", false)

	play_anim("idle")

	finish_label.visible = true

	if finish_label.has_method("start_flicker"):
		finish_label.start_flicker(2.0, 0.05)

	# let gravity work
	await get_tree().create_timer(0.1).timeout

	while not is_on_floor():
		velocity.y += 5000.0 * get_physics_process_delta_time()
		move_and_slide()
		await get_tree().physics_frame

	velocity = Vector2.ZERO

	await get_tree().create_timer(2.0).timeout

	if is_instance_valid(finish_label):
		finish_label.visible = false

# ---------------- COMBOS ----------------
func register_input(input: String):

	# only human player can enter combos
	if not is_in_group("player1"):
		return

	combo.append(input)

	combo_timer = 0.0

	check_combos()

func spawn_fx(scene: PackedScene):
	var fx = scene.instantiate()

	# IMPORTANT: set owner BEFORE it can collide
	fx.owner_character = self
	fx.damage_done = false

	get_tree().current_scene.call_deferred("add_child", fx)

	await get_tree().process_frame

	if target and is_instance_valid(target):
		fx.fire_spawn_position = $KanoShoot.global_position + Vector2(240 * facing, 0)
	else:
		fx.fire_spawn_position = $KanoShoot.global_position + Vector2(240 * facing, 0)

func check_combos():
	# ---------------- ACID ----------------
	if combo == ACID_COMBO:

		combo_used.emit("acid")

		special_bullet = ACID_BULLET

		combo.clear()
		return

	# ---------------- FIRE ----------------
	if combo == FIRE_COMBO:

		combo_used.emit("fire")

		special_bullet = FIRE_BULLET

		combo.clear()

		shoot_player()
		return

	# ---------------- kick ----------------
	elif combo == KICK_COMBO:

		combo_used.emit("kick_combo")

		combo.clear()

		start_kick_combo()
		return

	elif combo == PUNCH_COMBO:

		combo_used.emit("punch_combo")

		combo.clear()

		start_punch_combo()
		return

func start_punch_combo():

	if action_locked or is_hurting or state == State.DEAD:
		return

	await combo_attack([
		"punch",
		"lowpunch",
		"punch",
		"uppercut",
		"highpunch",
		"uppercut",
		"punch"
	])

func start_kick_combo():

	if kick_combo_active:
		return

	if action_locked or is_hurting or state == State.DEAD:
		return

	if health <= 1:
		return

	kick_combo_active = true
	can_take_damage = false

	await combo_attack([
		"kick",
		"knee",
		"highkick",
		"roundhousekick",
		"lowkick",
		"roundhousekick",
		"highkick"
	])

	# Combo is completely finished
	kick_combo_active = false

	if state != State.DEAD:
		can_take_damage = true

func combo_attack(attacks: Array):

	action_locked = true
	is_attacking = true

	for attack in attacks:

		# STOP COMBO IF HIT
		if is_hurting or state == State.DEAD:
			break

		play_anim(attack)
		spawn_attack(attack)

		await sprite.animation_finished

	is_attacking = false
	action_locked = false

	if not is_hurting:
		play_anim("idle")


# ---------------- DEATH ----------------
func die():

	# =====================================================
	# ALREADY DEAD
	# =====================================================

	if state == State.DEAD:
		return

	# =====================================================
	# LOCK KANO AS DEAD
	# =====================================================

	state = State.DEAD

	velocity = Vector2.ZERO

	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

	action_locked = true
	hurt_locked = true
	can_take_damage = false

	# =====================================================
	# STOP ALL KANO ACTIONS
	# =====================================================

	stunned = false

	is_pulled = false
	is_spear_pulled = false
	pull_target = null
	pull_timer = 0.0

	knockback_x = 0.0
	uppercut_launched = false
	hurt_cooldown = false

	cannonball_active = false
	cannonball_timer = 0.0
	cannonball_ready = false
	cannonball_hit_lock = false

	run_locked = false
	bullet_spawned = false

	special_move = false
	special_move_timer = 0.0

	# =====================================================
	# HIDE NORMAL SPRITE
	# SHOW DEAD / CRISPY SPRITE
	# =====================================================

	if has_node("Sprite"):
		$Sprite.visible = false

	if has_node("Crispy"):
		$Crispy.visible = true

	# =====================================================
	# DETERMINE ROUND WINNER
	# =====================================================

	var winner := ""

	if is_in_group("player1"):
		winner = "cpu"
	else:
		winner = "player1"

	# =====================================================
	# DETERMINE IF THIS DEATH ENDS THE MATCH
	# =====================================================
	#
	# Level1 has not awarded this round yet.
	#
	# If winner already has 1 round win,
	# this death will be their SECOND win.
	# =====================================================

	var match_will_end := false

	if winner == "player1":

		if Game.p1_round_wins >= 1:
			match_will_end = true

	else:

		if Game.p2_round_wins >= 1:
			match_will_end = true

	# =====================================================
	# FINAL MATCH DEATH
	# =====================================================

	if match_will_end:

		# =================================================
		# BLOOD EFFECT
		# =================================================

		var blood = BLOOD_DEATH.instantiate()

		get_tree().current_scene.add_child(blood)

		blood.global_position = global_position

		# =================================================
		# FINAL DEATH SPRITE
		# =================================================

		$Sprite.visible = false
		$Crispy.visible = true

		# =================================================
		# STOP ALL KANO ACTIONS
		# =================================================

		velocity = Vector2.ZERO

		is_attacking = false
		is_shooting = false
		is_hurting = false
		is_blocking = false

		action_locked = true
		hurt_locked = true
		can_take_damage = false

		stunned = false

		is_pulled = false
		is_spear_pulled = false
		pull_target = null
		pull_timer = 0.0

		cannonball_active = false
		cannonball_timer = 0.0
		cannonball_ready = false
		cannonball_hit_lock = false

		run_locked = true
		bullet_spawned = false

		uppercut_launched = false
		hurt_cooldown = false

		knockback_x = 0.0

		# =================================================
		# MAKE SURE FINISH HIM IS HIDDEN
		# =================================================

		if is_instance_valid(finish_label):
			finish_label.visible = false

		# =================================================
		# WAIT FOR FATALITY / FINAL DEATH
		# =================================================

		await get_tree().create_timer(3.0).timeout

		# =================================================
		# TELL LEVEL1 WHO WON
		# =================================================

		round_death.emit(winner)

		# =================================================
		# SMALL DELAY
		# =================================================

		await get_tree().create_timer(0.2).timeout

		# =================================================
		# FINAL MATCH OVER
		# GO TO MAIN MENU
		# =================================================

		get_tree().change_scene_to_file("res://Scenes/MainMenu.tscn")

		return

	# =====================================================
	# NORMAL ROUND DEATH
	# =====================================================
	#
	# Match is NOT over.
	#
	# Level1 receives round_death and handles:
	#
	# - round winner
	# - score
	# - next round
	#
	# =====================================================

	# =====================================================
	# HIDE FINISH HIM
	# =====================================================

	if is_instance_valid(finish_label):
		finish_label.visible = false

	# =====================================================
	# DEAD SPRITE
	# =====================================================

	$Sprite.visible = false
	$Crispy.visible = true

	# =====================================================
	# TELL LEVEL1
	# =====================================================

	round_death.emit(winner)

	return

# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):

	if current_anim == anim_name and sprite.is_playing():
		return

	current_anim = anim_name
	sprite.play(anim_name)

# ---------------- HURT BOX ----------------
func _on_kano_hurt_box_area_entered(area: Area2D) -> void:

	# =====================================================
	# BASIC CHECKS
	# =====================================================

	if hurt_cooldown:
		return

	if area == null or not is_instance_valid(area):
		return

	if state == State.DEAD:
		return

	if not can_take_damage:
		return

	if spawn_protection:
		return

	# =====================================================
	# IGNORE HURT BOXES
	# =====================================================

	if area.is_in_group("HurtBox"):
		return

	# =====================================================
	# VALID ATTACK / PROJECTILE
	# =====================================================

	var valid_attack := (
		area.is_in_group("HitBox")
		or area.is_in_group("ReptileAcid")
		or area.is_in_group("ReptileBullet")
		or area.is_in_group("RaidenElectricBullet")
		or area.is_in_group("FireBullet")
		or area.is_in_group("Fireball")
		or area.is_in_group("SonyaBullet")
		or area.is_in_group("JohnnyCageBullet")
		or area.is_in_group("KanoBullet")
		or area.is_in_group("IceBullet")
		or area.is_in_group("KanoAttack")
	)

	if not valid_attack:
		return

	# =====================================================
	# LOCK THIS HIT
	# =====================================================

	hurt_cooldown = true

	# =====================================================
	# UPPERCUT CHECK
	# =====================================================

	var was_uppercut := false

	if area.get("attack_name") != null:
		if area.attack_name == "uppercut":
			was_uppercut = true

	# =====================================================
	# KNOCKBACK
	# =====================================================

	knockback_x = -facing * 100

	# =====================================================
	# PLAY HIT ANIMATION
	# =====================================================

	if was_uppercut:

		current_anim = ""
		sprite.play("wasuppercut")

	else:

		current_anim = ""
		sprite.play("hurt")

	# =====================================================
	# HURT SOUND
	# =====================================================

	if is_instance_valid(hurt_sound):
		hurt_sound.play()

	# =====================================================
	# APPLY DAMAGE
	# =====================================================

	take_damage(1)

	# =====================================================
	# WAIT FOR HIT ANIMATION
	# =====================================================

	if state != State.DEAD and health > 1 and not is_finish_state:

		if was_uppercut:

			await sprite.animation_finished

		else:

			await get_tree().create_timer(0.2).timeout

	# =====================================================
	# DEAD CHECK
	# =====================================================

	if state == State.DEAD:
		hurt_cooldown = false
		return

	# =====================================================
	# FINISH HIM CHECK
	# =====================================================

	if is_finish_state:
		hurt_cooldown = false
		return

	# =====================================================
	# 1 HP — FORCE KANO TO IDLE
	# =====================================================

	if health <= 1:

		is_hurting = false
		hurt_locked = false
		action_locked = false

		is_attacking = false
		is_shooting = false
		is_blocking = false

		stunned = false

		velocity = Vector2.ZERO
		knockback_x = 0.0

		state = State.IDLE

		current_anim = ""

		if is_instance_valid(sprite):
			sprite.visible = true
			sprite.play("idle")

		if has_node("Crispy"):
			$Crispy.visible = false

		hurt_cooldown = false
		return

	# =====================================================
	# RETURN TO IDLE
	# =====================================================

	is_hurting = false
	hurt_locked = false
	action_locked = false

	is_attacking = false
	is_shooting = false

	state = State.IDLE

	velocity.x = 0
	knockback_x = 0

	current_anim = ""

	if is_instance_valid(sprite):
		sprite.visible = true
		sprite.play("idle")

	# =====================================================
	# RELEASE DAMAGE COOLDOWN
	# =====================================================

	await get_tree().create_timer(0.2).timeout

	hurt_cooldown = false
