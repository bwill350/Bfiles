# ---------------- DAMAGE ----------------

func take_damage(amount: int):

	if state == State.DEAD:
		return

	if not can_take_damage:
		return

	if spawn_protection:
		return


	# =====================================================
	# DAMAGE FRAME PROTECTION
	# =====================================================

	var frame := Engine.get_physics_frames()

	if has_meta("last_damage_frame"):

		if get_meta("last_damage_frame") == frame:
			return

	set_meta(
		"last_damage_frame",
		frame
	)


	# =====================================================
	# GET ATTACK NAME BEFORE ANYTHING ELSE
	# =====================================================

	var incoming_attack := ""

	if has_meta("last_attack_name"):

		incoming_attack = str(
			get_meta("last_attack_name")
		).strip_edges().to_lower()


	print("================================")
	print("KANO TAKE DAMAGE")
	print("ATTACK = [", incoming_attack, "]")
	print("HEALTH BEFORE = ", health)
	print("FINISH STATE = ", is_finish_state)
	print("================================")


	# =====================================================
	# DAMAGE LOCK
	# =====================================================

	can_take_damage = false

	get_tree().create_timer(0.25).timeout.connect(
		func():

			if is_instance_valid(self) and state != State.DEAD:

				can_take_damage = true
	)


	# =====================================================
	# BLOCK
	# =====================================================

	if is_blocking:

		amount = max(
			amount - 1,
			0
		)


	if amount <= 0:
		return


	# =====================================================
	# APPLY DAMAGE
	# =====================================================

	health -= amount

	health = max(
		health,
		0
	)


	print(
		"Kano took damage: ",
		amount,
		" HP=",
		health
	)

	health_changed.emit(health)


	# =====================================================
	# HIT SOUND
	# =====================================================

	if is_instance_valid(hit_sound):

		hit_sound.play()


	# =====================================================
	# DEATH
	# =====================================================

	if health <= 0:

		print("================================")
		print("KANO HEALTH REACHED ZERO")
		print("INCOMING ATTACK = [", incoming_attack, "]")
		print("CALLING DIE")
		print("================================")


		is_attacking = false
		is_shooting = false
		is_hurting = false
		is_blocking = false


		if is_instance_valid(finish_label):

			finish_label.visible = false


		# IMPORTANT:
		# Keep the attack name available for die()
		if incoming_attack != "":

			set_meta(
				"last_attack_name",
				incoming_attack
			)


		die()

		return


	# =====================================================
	# FINISH HIM AT 1 HP
	# =====================================================

	if health == 1 and not is_finish_state:

		var opponent_will_win_match := false


		if is_in_group("player1"):

			if Game.p2_round_wins >= 1:

				opponent_will_win_match = true

		else:

			if Game.p1_round_wins >= 1:

				opponent_will_win_match = true


		if opponent_will_win_match:

			is_hurting = false
			hurt_locked = false
			action_locked = false

			trigger_finish_state()

			return


	# =====================================================
	# NORMAL HURT
	# =====================================================

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	state = State.IDLE

	combo.clear()

	play_anim("hurt")


	if is_instance_valid(hurt_sound):

		hurt_sound.play()


	# =====================================================
	# BLOOD EFFECT
	# =====================================================

	if has_node("BloodMarker"):

		var blood = BLOOD_EFFECT.instantiate()

		get_tree().current_scene.add_child(blood)

		blood.global_position = $BloodMarker.global_position


	# =====================================================
	# HURT RECOVERY
	# =====================================================

	await get_tree().create_timer(0.25).timeout


	if state == State.DEAD:

		return


	is_hurting = false
	hurt_locked = false
	action_locked = false


	if state != State.DEAD and not is_finish_state:

		play_anim("idle")


func trigger_finish_state():

	if is_finish_state:
		return

	is_finish_state = true

	state = State.IDLE

	velocity.x = 0
	velocity.y = 0

	action_locked = true
	hurt_locked = false
	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

	set_meta(
		"uppercut_launched",
		false
	)

	play_anim("idle")

	finish_label.visible = true

	if finish_label.has_method("start_flicker"):

		finish_label.start_flicker(
			2.0,
			0.05
		)

	await get_tree().create_timer(0.1).timeout

	while not is_on_floor():

		velocity.y += (
			5000.0 *
			get_physics_process_delta_time()
		)

		move_and_slide()

		await get_tree().physics_frame

	velocity = Vector2.ZERO

	await get_tree().create_timer(2.0).timeout

	if is_instance_valid(finish_label):
		finish_label.visible = false


