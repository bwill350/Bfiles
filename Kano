const PUNCH_COMBO = ["right", "down", "right"]

# ---------------- INPUT ----------------
func _unhandled_input(event):

	var inputs = ["up", "down", "left", "right", "shoot"]

	for i in inputs:
		if event.is_action_pressed(i):
			register_input(i)

func update_attack_marker():
	$AttackMarker.position = Vector2(63 * facing, -155)

# ---------------- READY ----------------
func _ready():
	$AttackMarker.visible = false
	$Crispy.visible = false
	$AttackMarker.position = Vector2(63 * facing, -155)
	add_to_group("Fighter")
	add_to_group("enemy")
	add_to_group("Kano")

	spawn_locked = false

	health = max_health
	health_changed.emit(health)

	play_anim("idle")

	ai_timer = randf_range(0.2, 0.6)
	facing = 1
	sprite.flip_h = -facing < 0

func apply_stun(_duration := 4.0):

	if state == State.DEAD:
		return

	stunned = true

	is_hurting = true
	hurt_locked = true
	action_locked = true

	is_attacking = false
	is_shooting = false
	is_blocking = false

	velocity = Vector2.ZERO
	knockback_x = 0

	play_anim("idle")

	await get_tree().create_timer(4.0).timeout

	stunned = false

	is_hurting = false
	hurt_locked = false
	action_locked = false

func run(input_dir: float):
	if input_dir == 0:
		return

	state = State.RUN
	velocity.x = input_dir * SPEED * 3 # faster than walk

	if not is_attacking:
		play_anim("run")

func handle_double_tap_run(input_dir: float, delta: float) -> bool:

	if input_dir == 0:
		return false

	var now := Time.get_ticks_msec() / 1000.0

	if input_dir == last_tap_dir:
		if now - last_tap_time <= tap_time:
			run_locked = true
			return true

	last_tap_time = now
	last_tap_dir = input_dir

	return false

# ---------------- PHYSICS ----------------
func _physics_process(delta):
	# ---------------- GRAVITY ----------------
	velocity.y += GRAVITY * delta

	if state == State.DEAD:
		return

	# ---------------- STUN ----------------
	if stunned:
		velocity = Vector2.ZERO
		move_and_slide()
		return

	# ---------------- CANNONBALL LOCK ----------------
	if cannonball_active:
		velocity.y = 0
		velocity.x = facing * 2200
		move_and_slide()
		return

	# ---------------- FINISH HIM ----------------
	if is_finish_state:
		state = State.IDLE
		velocity.x = 0
		if not is_hurting:
			play_anim("idle")
		move_and_slide()
		return

	# ---------------- GRAVITY ----------------
	velocity.y += GRAVITY * delta

	# ---------------- COOLDOWNS ----------------
	shoot_cooldown = max(shoot_cooldown - delta, 0.0)

	combo_timer += delta
	if combo_timer > combo_reset_time:
		combo.clear()

	$AttackMarker.visible = is_attacking

	# ---------------- CPU ----------------
	if is_cpu:
		cpu_logic(delta)
		move_and_slide()
		return

	if state == State.DEAD:
		return

	if is_finish_state:
		state = State.IDLE
		velocity.x = 0

		if not is_hurting:
			play_anim("idle")

		move_and_slide()
		return
	# ---------------- CANNONBALL LOCK ----------------
	if cannonball_active:
		velocity.y = 0
		velocity.x = facing * 2200
		move_and_slide()
		return


	if action_locked:
		return

	var input_dir = Input.get_axis("left", "right")
	var climb_pressed = Input.is_action_pressed("climb")

	# ---------------- FACING ----------------
	if input_dir != 0:
		facing = input_dir
		sprite.flip_h = facing > 0
		update_attack_marker()

	$AttackMarker.position = Vector2(63 * facing, -155)
	$KanoShoot.position = Vector2(63 * facing, -155)

	# =========================================================
	# 🟢 MOVEMENT (RUN ADDED HERE)
	# =========================================================
	if Input.is_action_pressed("run") and input_dir != 0:
		run(input_dir)   # 🔥 CALLS YOUR NEW RUN FUNCTION
	else:
		velocity.x = input_dir * SPEED

		# ---------------- STATE ----------------
		if not is_on_floor():
			state = State.JUMP
		elif input_dir != 0:
			state = State.WALK
		elif input_dir != 0:
			state = State.RUN
		else:
			state = State.IDLE

	# ---------------- ANIMATIONS ----------------
	match state:

		State.CLIMB:
			velocity.y = -CLIMB_SPEED
			if not is_attacking:
				play_anim("idle")

		State.JUMP:
			if not is_attacking:
				play_anim("jump")

		State.WALK:
			if not is_attacking:
				play_anim("walk")

		State.RUN:
			if not is_attacking:
				play_anim("run")

		State.IDLE:
			if not is_attacking:
				play_anim("idle")

	if is_hurting and hurt_locked:
		return

	# ---------------- JUMP ----------------
	if Input.is_action_just_pressed("jump") and is_on_floor():
		velocity.y = jump_velocity

	# ---------------- ATTACKS ----------------
	if Input.is_action_just_pressed("punch"):
		do_action("punch")


	elif Input.is_action_just_pressed("kick"):
		do_action("kick")


	elif Input.is_action_just_pressed("roundhousekick"):
		do_action("roundhousekick")


	elif Input.is_action_just_pressed("uppercut"):
		do_action("uppercut")

	elif Input.is_action_pressed("shoot"):
		shoot_player()

	elif Input.is_action_just_pressed("cannonball"):
		do_action("cannonball")


	elif Input.is_action_pressed("fatality"):
		do_action("fatality")
		

	elif Input.is_action_pressed("block"):
		start_block()

	else:
		stop_block()

	move_and_slide()

# ---------------- BLOCK ----------------
func start_block():

	if state == State.DEAD:
		return

	is_blocking = true
	state = State.BLOCK

	play_anim("block")

func stop_block():

	if is_blocking:
		is_blocking = false
		state = State.IDLE

# ---------------- CPU ----------------
func cpu_logic(delta):

	# ---------------- HURT PRIORITY ----------------
	if is_hurting:

		if is_spear_pulled:
			velocity.x = -facing * -400
		else:
			velocity.x = -facing * 600

		# gradually reduce knockback
		knockback_x = move_toward(knockback_x, 0, 1500 * delta)

		if abs(knockback_x) < 10:
			knockback_x = 0
			is_hurting = false

		move_and_slide()
		return

	# ---------------- VALID TARGET CHECK ----------------
	if target == null or !is_instance_valid(target):
		velocity.x = 0
		return

	var dist = target.global_position.x - global_position.x
	var direction = sign(dist)

	# ---------------- HARD LOCK ----------------
	if action_locked:
		return

	# ---------------- FINISH STATE ----------------
	if is_finish_state:
		is_attacking = false
		action_locked = true
		velocity.x = 0
		move_and_slide()
		return

	ai_timer -= delta

	facing = direction
	sprite.flip_h = facing > 0

	# ---------------- MOVEMENT ----------------
	if abs(dist) > 220:
		velocity.x = direction * SPEED * 0.8
		state = State.RUN
		if not is_attacking:
			play_anim("walk")
	else:
		velocity.x = direction * SPEED * 0.8
		state = State.RUN
		if not is_attacking:
			play_anim("walk")

	# ---------------- AI ACTIONS ----------------
	if ai_timer <= 0:

		match Game.difficulty:

			# ================= HARD =================
			"Hard":
				ai_timer = randf_range(0.05, 0.15)

				var choice = randi() % 100

				if choice < 25:
					do_action("punch")
				elif choice < 50:
					do_action("kick")
				elif choice < 70:
					do_action("uppercut")
				elif choice < 90:
					do_action("roundhousekick")
				else:
					shoot_player()

			# ================= EASY =================
			"Easy":
				ai_timer = randf_range(0.5, 0.9)

				var choice = randi() % 100

				if choice < 45:
					do_action("punch")
				elif choice < 75:
					do_action("kick")
				elif choice < 90:
					do_action("uppercut")
				else:
					do_action("roundhousekick")

# ---------------- ACID SHOOT ----------------
func shoot_acid():

	if shoot_cooldown > 0:
		return

	shoot_cooldown = shoot_cooldown_time

	is_attacking = true
	action_locked = true

	play_anim("shoot")

	# 🔥 SET SHOOT POSITION FIRST
	$KanoShoot.position = Vector2(-3.9 * facing, -14.6)

	# 🟢 SPAWN BULLET
	var bullet = REPTILES_ACID.instantiate()
	get_tree().current_scene.add_child(bullet)

	# IMPORTANT: spawn at marker GLOBAL position
	bullet.global_position = $KanoShoot.global_position

	# 🔫 direction
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	# 🔴 RED ONLY FOR KANO BULLET
	var sprite = bullet.get_node_or_null("Sprite2D")
	if sprite:
		sprite.modulate = Color(1, 0.2, 0.2)

	var anim = bullet.get_node_or_null("AnimatedSprite2D")
	if anim:
		anim.modulate = Color(1, 0.2, 0.2)

	await get_tree().create_timer(0.25).timeout

	is_attacking = false
	action_locked = false

	play_anim("idle")

# ---------------- ACTION ----------------
func do_action(anim_name: String):

	if is_finish_state:
		return

	if state == State.DEAD:
		return

	if action_locked:
		return

	$AttackMarker.visible = true

	action_locked = true
	is_attacking = true
	lock_timer = 0.6

	play_anim(anim_name)

	# ---------------- NORMAL ATTACKS ----------------
	if anim_name in [
		"punch",
		"kick",
		"uppercut",
		"roundhousekick"
	]:
		spawn_attack(anim_name)

	# ---------------- SUBZERO SPECIAL (NO NEW NAME) ----------------
	if has_node("AttackMarker"):
		$AttackMarker.call_deferred("emit_signal", "trigger_attack")

# ---------------- CANNONBALL ----------------
	if anim_name == "cannonball":
		start_cannonball(facing)
		return

	await sprite.animation_finished

	$AttackMarker.visible = false

	is_attacking = false
	action_locked = false
	hurt_locked = false

# ---------------- ATTACK ----------------
func spawn_attack(anim_name: String):
	print("spawning kano attack")
	update_attack_marker()

	if anim_name not in [
		"punch",
		"kick",
		"uppercut",
		"roundhousekick"
	]:
		return

	var attack = KANO_ATTACK.instantiate()
	get_tree().current_scene.add_child(attack)

	attack.add_to_group("HitBox")
	attack.global_position = $AttackMarker.global_position
	attack.scale.x = facing

	var dmg := 1

	match anim_name:
		"punch":
			dmg = 1
		"kick":
			dmg = 1
		"uppercut":
			dmg = 1
		"roundhousekick":
			dmg = 1

	attack.damage = dmg
	attack.attack_owner = self

func start_cannonball(dir: float):

	if state == State.DEAD:
		return

	facing = dir
	sprite.flip_h = facing > 0

	# LOCK MOVE
	cannonball_active = true
	spawn_protection = true
	is_attacking = true
	action_locked = true

	play_anim("cannonball")

	# LAUNCH SPEED
	velocity = Vector2(facing * 2200, 0)

	# KEEP MOVING
	await get_tree().create_timer(1.0).timeout

	# END CANNONBALL
	cannonball_active = false
	spawn_protection = false

	is_attacking = false
	action_locked = false

	velocity.x = 0

	if state != State.DEAD:
		play_anim("idle")

# ---------------- SHOOT ----------------
func shoot_player():
	if is_finish_state:
		return
	if is_shooting:
		return

	is_shooting = true
	is_attacking = true
	action_locked = true

	play_anim("shoot")

	var bullet_scene: PackedScene

	# ---------------- SPECIAL BULLET ----------------
	if special_bullet != null:

		bullet_scene = special_bullet

		# reset after one shot
		special_bullet = null

	else:

		bullet_scene = BULLET_SCENE

	var bullet = bullet_scene.instantiate()

	get_tree().current_scene.add_child(bullet)

	$KanoShoot.position = Vector2(-3.9 * facing, -14.6)

	bullet.global_position = $KanoShoot.global_position
	bullet.velocity = Vector2(facing, 0) * bullet.speed

	await get_tree().create_timer(0.25).timeout

	is_shooting = false

	if is_hurting or state == State.DEAD:
		return

	is_attacking = false
	action_locked = false
	play_anim("idle")

# ---------------- DAMAGE ----------------
func take_damage(amount: int):

	if not can_take_damage:
		return

	can_take_damage = false

	await get_tree().create_timer(0.25).timeout

	can_take_damage = true

	if state == State.DEAD:
		return

	if spawn_protection:
		return

	# BLOCK REDUCTION
	if is_blocking:
		amount = max(amount - 1, 0)

	if amount <= 0:
		return

	health -= amount
	health = max(health, 0)

	print("Kano took damage: ", amount, " HP=", health)

	health_changed.emit(health)
	hit_sound.play()

# ---------------- FINISH HIM ----------------
	if health == 1 and not is_finish_state:
		trigger_finish_state()
		return

	# ---------------- FINAL HIT ----------------
	if health <= 0:

		finish_label.visible = false
		die()
		await get_tree().create_timer(0.5).timeout

		get_tree().change_scene_to_file("res://Scenes/MainMenu.tscn")
		return

	# ---------------- NORMAL HURT ----------------
	is_hurting = true
	hurt_locked = true
	action_locked = true

	state = State.IDLE

	play_anim("hurt")

	var blood = BLOOD_EFFECT.instantiate()
	get_tree().current_scene.add_child(blood)
	blood.global_position = $BloodMarker.global_position

	await get_tree().create_timer(0.25).timeout

	is_hurting = false
	hurt_locked = false
	action_locked = false

func trigger_finish_state():

	if is_finish_state:
		return

	is_finish_state = true

	state = State.IDLE
	velocity = Vector2.ZERO

	action_locked = true
	hurt_locked = false
	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

	play_anim("idle")

	finish_label.visible = true

	if finish_label.has_method("start_flicker"):
		finish_label.start_flicker(2.0, 0.05)
		die()
	await get_tree().create_timer(2.0).timeout

	if is_instance_valid(finish_label):
		finish_label.visible = false

	state = State.IDLE
	velocity = Vector2.ZERO

	is_attacking = false
	is_shooting = false
	is_hurting = false
	is_blocking = false

# ---------------- COMBOS ----------------
func register_input(input: String):
	combo.append(input)

	combo_timer = 0.0

	check_combos()

func spawn_fx(scene: PackedScene):
	var fx = scene.instantiate()

	# IMPORTANT: set owner BEFORE it can collide
	fx.owner_character = self
	fx.damage_done = false

	get_tree().current_scene.call_deferred("add_child", fx)

	await get_tree().process_frame

	if target and is_instance_valid(target):
		fx.fire_spawn_position = $KanoShoot.global_position + Vector2(240 * facing, 0)
	else:
		fx.fire_spawn_position = $KanoShoot.global_position + Vector2(240 * facing, 0)

func check_combos():
	# ---------------- ACID ----------------
	if combo == ACID_COMBO:

		combo_used.emit("acid")

		special_bullet = ACID_BULLET

		combo.clear()
		return

	# ---------------- FIRE ----------------
	elif combo == FIRE_COMBO:

		combo_used.emit("fire")

		var fx = FIRE_DEATH.instantiate()
		get_tree().current_scene.add_child(fx)

		# FX happens on CPU
		if target and is_instance_valid(target):
			fx.global_position = target.global_position
		else:
			fx.global_position = global_position

		# GIVE FIREDEATH CONTROL
		fx.owner_character = self

		# 🔥 Spawn position from P1
		fx.fire_spawn_position = $KanoShoot.global_position

		# 🔥 Direction from P1
		fx.fire_direction = facing

		combo.clear()
		return

	# ---------------- ICE ----------------
	elif combo == ICE_COMBO:

		combo_used.emit("ice")

		spawn_fx(ICE_DEATH)

		special_bullet = ICE_BULLET

		combo.clear()
		return

	# ---------------- ELECTRIC ----------------
	elif combo == ELECTRIC_COMBO:

		combo_used.emit("electric")

		spawn_fx(ELECTRIC_DEATH)

		special_bullet = ELECTRIC_BULLET

		combo.clear()
		return

	elif combo == PUNCH_COMBO:

		combo_used.emit("punch_combo")

		combo.clear()

		start_punch_combo()
		return

func start_punch_combo():

	if action_locked:
		return

	await combo_attack([
		"punch",
		"kick",
		"punch",
		"roundhousekick",
		"uppercut"
	])

func combo_attack(attacks: Array):

	action_locked = true
	is_attacking = true

	for attack in attacks:

		play_anim(attack)
		spawn_attack(attack)

		await sprite.animation_finished

	is_attacking = false
	action_locked = false

# ---------------- DEATH ----------------
func die():

	if state == State.DEAD:
		return

	state = State.DEAD

	var death = BLOOD_DEATH.instantiate()
	get_tree().current_scene.add_child(death)
	death.global_position = global_position

	# stop everything
	velocity = Vector2.ZERO
	is_attacking = false
	is_shooting = false
	action_locked = true
	hurt_locked = true
	is_hurting = false

	# 🔥 HARD SWAP SPRITES
	$Sprite.visible = false          # AnimatedSprite2D OFF
	$Crispy.visible = true         # static image ON

	# optional delay before menu
	await get_tree().create_timer(1.5).timeout

	get_tree().change_scene_to_file("res://Scenes/MainMenu.tscn")

# ---------------- ANIMATION ----------------
func play_anim(anim_name: String):

	if current_anim == anim_name and sprite.is_playing():
		return

	current_anim = anim_name
	sprite.play(anim_name)

# ---------------- HURT BOX ----------------
func _on_kano_hurt_box_area_entered(area: Area2D) -> void:


	if hurt_cooldown:
		return

	if area == null or !is_instance_valid(area):
		return

	if not can_take_damage:
		return

	$Hurt.play()
	# ---------------- SPEAR PRIORITY ----------------
	if area.is_in_group("ReptileSpear"):
		hurt_cooldown = true
		knockback_x = -facing * -600
		health -= 1
		health_changed.emit(health)

		is_spear_pulled = true
		is_hurting = true
		action_locked = true

		await get_tree().create_timer(0.8).timeout

		is_spear_pulled = false
		is_hurting = false
		action_locked = false
		hurt_cooldown = false
		return

	if area.is_in_group("HitBox") \
		or area.is_in_group("ReptileAcid") \
		or area.is_in_group("RaidenElectricBullet") \
		or area.is_in_group("FireBullet") \
